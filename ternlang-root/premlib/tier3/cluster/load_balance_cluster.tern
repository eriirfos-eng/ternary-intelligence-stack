// License: BSL 1.1 - Industrial

fn balance_cluster_load(skew: float) -> trit {
    if skew < 0.2 { return affirm; }
    if skew < 0.5 { return tend; }
    return reject;
}

fn main() -> trit {
    let result: trit = balance_cluster_load(0.1);
    match result {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
