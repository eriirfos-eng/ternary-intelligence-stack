fn dispatch_cluster_task(available_nodes: int) -> trit {
    if available_nodes > 5 { return affirm; }
    if available_nodes > 0 { return tend; }
    return reject;
}

fn main() -> trit {
    let result: trit = dispatch_cluster_task(8);
    match result {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
