fn reach_cluster_consensus(agreement: float) -> trit {
    if agreement > 0.9 { return affirm; }
    if agreement > 0.6 { return tend; }
    return reject;
}

fn main() -> trit {
    let result: trit = reach_cluster_consensus(0.95);
    match result {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
