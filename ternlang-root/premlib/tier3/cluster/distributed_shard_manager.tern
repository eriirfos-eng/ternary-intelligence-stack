fn manage_shards(active_shards: int, total_shards: int) -> trit {
    if active_shards == total_shards { return affirm; }
    if active_shards > (total_shards / 2) { return tend; }
    return reject;
}

fn main() -> trit {
    let result: trit = manage_shards(8, 10);
    match result {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
