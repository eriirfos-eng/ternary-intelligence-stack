fn orchestrate_titan(cluster_health: int) -> trit {
    if cluster_health > 90 { return affirm; }
    if cluster_health > 50 { return tend; }
    return reject;
}

fn main() -> trit {
    let result: trit = orchestrate_titan(95);
    match result {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
