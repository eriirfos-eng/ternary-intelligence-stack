fn test_paxos(nodes_synced: int, total_nodes: int) -> trit {
    if nodes_synced == total_nodes { return affirm; }
    if nodes_synced >= ((2 * total_nodes) / 3) { return tend; }
    return reject;
}

fn main() -> trit {
    let result: trit = test_paxos(7, 9);
    match result {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
