// Module: tier2/memory/decay_controller.tern
// License: BSL 1.1 - Restricted API

fn control_decay(age: int, threshold: int) -> trit {
    if age > threshold { return reject; }
    return tend;
}

fn main() -> trit {
    let result: trit = control_decay(50, 100);
    match result {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
