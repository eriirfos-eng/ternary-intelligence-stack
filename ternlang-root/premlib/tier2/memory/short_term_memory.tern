// --- RFI-IRFOS TIER 2 PROPRIETARY ---
// Module: tier2/memory/short_term_memory.tern
// License: BSL 1.1 - Restricted API

fn consolidate_short_term(importance: float) -> trit {
    if importance > 0.8 { return affirm; }
    if importance < 0.2 { return reject; }
    return tend; // Passive decay
}

fn main() -> trit {
    let result: trit = consolidate_short_term(0.9);
    match result {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
