// Module: tier2/memory/retrieval_gate.tern
// License: BSL 1.1 - Restricted API

fn guard_retrieval(auth_level: int) -> trit {
    if auth_level > 3 { return affirm; }
    return reject;
}

fn main() -> trit {
    let result: trit = guard_retrieval(5);
    match result {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
