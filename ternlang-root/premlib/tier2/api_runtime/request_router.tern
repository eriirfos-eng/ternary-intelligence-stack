fn route_request(load: float, capacity: float) -> trit {
    if load < (capacity * 0.7) { return affirm; } // Route normally
    if load > capacity { return reject; } // Spillover to fallback
    return tend; // Throttled state
}

fn main() -> trit {
    let result: trit = route_request(50.0, 100.0);
    match result {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
