// License: BSL 1.1 - Restricted API

fn schedule_context(priority: int, available_slots: int) -> trit {
    if available_slots > 0 {
        if priority > 5 { return affirm; }
        return tend;
    }
    return reject;
}

fn main() -> trit {
    let result: trit = schedule_context(8, 2);
    match result {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
