// License: BSL 1.1 - Restricted API

fn check_quota(used: float, limit: float) -> trit {
    if used < limit { return affirm; }
    if used > (limit * 1.05) { return reject; }
    return tend;
}

fn main() -> trit {
    let result: trit = check_quota(90.0, 100.0);
    match result {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
