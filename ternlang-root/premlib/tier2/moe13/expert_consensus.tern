fn reach_consensus(votes: int, total_experts: int) -> trit {
    if votes > (total_experts / 2) { return affirm; }
    if votes < (total_experts / 4) { return reject; }
    return tend;
}

fn main() -> trit {
    let result: trit = reach_consensus(10, 13);
    match result {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
