fn route_to_expert(expert_id: int) -> trit {
    if expert_id >= 0 {
        if expert_id < 13 { return affirm; }
    }
    return reject;
}

fn main() -> trit {
    let result: trit = route_to_expert(5);
    match result {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
