fn run_moe13_orchestration(experts_ready: int) -> trit {
    if experts_ready == 13 { return affirm; }
    if experts_ready > 7 { return tend; }
    return reject;
}

fn main() -> trit {
    let result: trit = run_moe13_orchestration(13);
    match result {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
