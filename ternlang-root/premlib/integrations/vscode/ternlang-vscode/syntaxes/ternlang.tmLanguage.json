{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ternlang",
  "scopeName": "source.tern",
  "fileTypes": [".tern"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#trits" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#attributes" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ternlang",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.ternlang",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.ternlang",
          "match": "\\\\."
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ternlang",
          "match": "\\b(if|else|match|return|while|for|in|break|continue|import|from|let|const|mut|pub)\\b"
        },
        {
          "name": "keyword.declaration.ternlang",
          "match": "\\b(fn|struct|enum|impl|trait|module|use)\\b"
        },
        {
          "name": "keyword.other.ternlang",
          "match": "\\b(cast|hold|truth|conflict|tend|affirm|reject)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.ternlang",
          "match": "\\b(trit|int|float|bool|string|void|tensor|agent|trit_vec|trit_matrix)\\b"
        }
      ]
    },
    "trits": {
      "patterns": [
        {
          "name": "constant.language.trit.affirm.ternlang",
          "match": "\\b(affirm|truth|true)\\b"
        },
        {
          "name": "constant.language.trit.tend.ternlang",
          "match": "\\b(tend|hold)\\b"
        },
        {
          "name": "constant.language.trit.reject.ternlang",
          "match": "\\b(reject|conflict|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.trit.ternlang",
          "match": "\\b(-1|\\+1)\\b(?!\\s*=>)"
        },
        {
          "name": "constant.numeric.integer.ternlang",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "constant.numeric.float.ternlang",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.ternlang",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.ternlang",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.ternlang",
          "match": "=>"
        },
        {
          "name": "keyword.operator.return-type.ternlang",
          "match": "->"
        },
        {
          "name": "keyword.operator.arithmetic.ternlang",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.comparison.ternlang",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.ternlang",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.assign.ternlang",
          "match": "="
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.ternlang",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
