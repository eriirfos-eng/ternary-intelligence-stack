/*
 * Sparse Ternary Tensor
 * Implementation using a coordinate list (COO) format.
 * Optimized for high-dimensional tensors where most values are 0 (tend/hold).
 */

// Fixed size arena for sparse entries
// Since we can't return structs yet, we use two arrays.
fn sparse_set(indices: int[], values: trit[], size: int, target_idx: int, val: trit) -> int {
    let i: int = 0;
    while i < 20 { // Using hardcoded limit for safety in this version
        if indices[i] == target_idx {
            values[i] = val;
            return size; // Updated existing
        }
        if indices[i] == -1 {
            indices[i] = target_idx;
            values[i] = val;
            return size + 1; // New entry
        }
        i = i + 1;
    }
    return -1; // Overflow
}

fn sparse_get(indices: int[], values: trit[], target_idx: int) -> trit {
    let i: int = 0;
    while i < 20 {
        if indices[i] == target_idx {
            return values[i];
        }
        if indices[i] == -1 {
            return 0; // End of list, default to hold
        }
        i = i + 1;
    }
    return 0; // Not found, default to hold
}

fn main() -> trit {
    let indices: int[20];
    let values: trit[20];
    let count: int = 0;
    
    // Initialize indices with -1 (empty)
    let k: int = 0;
    while k < 20 {
        indices[k] = -1;
        values[k] = 0;
        k = k + 1;
    }
    
    println("Sparse Tensor (COO) Demo");
    println("Setting index 500 to 1");
    count = sparse_set(indices, values, count, 500, 1);
    
    println("Setting index 1024 to -1");
    count = sparse_set(indices, values, count, 1024, -1);
    
    println("Reading index 500:");
    let v1: trit = sparse_get(indices, values, 500);
    println(v1);
    
    println("Reading index 100 (empty, should be 0):");
    let v2: trit = sparse_get(indices, values, 100);
    println(v2);
    
    println("Reading index 1024:");
    let v3: trit = sparse_get(indices, values, 1024);
    println(v3);
    
    if v1 == 1 && v2 == 0 && v3 == -1 {
        println("Sparse Tensor operations verified.");
        return 1;
    }
    
    return -1;
}
