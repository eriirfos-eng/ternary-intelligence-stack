/*
 * Balanced Ternary Search Tree (BST)
 * Implementation using a flat arena-backed array.
 * Each node has a value (int) and pointers (int) to left, middle, and right children.
 * Ternary because we are in Ternlang: < val (left), == val (middle - for multi-sets), > val (right).
 */

// Node structure simulation in arena
// val: int_pool[i]
// left: next_pool[i*3 + 0]
// mid:  next_pool[i*3 + 1]
// right: next_pool[i*3 + 2]

fn tst_insert(val_pool: int[], next_pool: int[], root: int, val: int, free_p: int) -> int {
    if root == -1 {
        // Tree was empty, this shouldn't happen if called correctly but we handle it
        return -1; 
    }
    
    let curr: int = root;
    let p: int = free_p;
    
    while 1 == 1 {
        if val < val_pool[curr] {
            let left_idx: int = curr * 3 + 0;
            if next_pool[left_idx] == -1 {
                next_pool[left_idx] = p;
                val_pool[p] = val;
                return p + 1; // Return new free_p
            }
            curr = next_pool[left_idx];
        } else {
            if val == val_pool[curr] {
                let mid_idx: int = curr * 3 + 1;
                if next_pool[mid_idx] == -1 {
                    next_pool[mid_idx] = p;
                    val_pool[p] = val;
                    return p + 1;
                }
                curr = next_pool[mid_idx];
            } else {
                // val > val_pool[curr]
                let right_idx: int = curr * 3 + 2;
                if next_pool[right_idx] == -1 {
                    next_pool[right_idx] = p;
                    val_pool[p] = val;
                    return p + 1;
                }
                curr = next_pool[right_idx];
            }
        }
    }
    return p;
}

fn tst_search(val_pool: int[], next_pool: int[], root: int, val: int) -> trit {
    let curr: int = root;
    while curr != -1 {
        if val == val_pool[curr] {
            return 1;
        }
        if val < val_pool[curr] {
            curr = next_pool[curr * 3 + 0];
        } else {
            curr = next_pool[curr * 3 + 2];
        }
    }
    return -1;
}

fn main() -> trit {
    let val_pool: int[10];
    let next_pool: int[30]; // 10 nodes * 3 children
    
    // Initialize pools
    let i: int = 0;
    while i < 30 {
        next_pool[i] = -1;
        if i < 10 { val_pool[i] = 0; }
        i = i + 1;
    }
    
    let root: int = 0;
    val_pool[root] = 50;
    let free_p: int = 1;
    
    println("Inserting: 30, 70, 50, 20 into Ternary Search Tree...");
    free_p = tst_insert(val_pool, next_pool, root, 30, free_p);
    free_p = tst_insert(val_pool, next_pool, root, 70, free_p);
    free_p = tst_insert(val_pool, next_pool, root, 50, free_p); // middle child
    free_p = tst_insert(val_pool, next_pool, root, 20, free_p);
    
    println("Searching for 70:");
    let s1: trit = tst_search(val_pool, next_pool, root, 70);
    println(s1);
    
    println("Searching for 40 (missing):");
    let s2: trit = tst_search(val_pool, next_pool, root, 40);
    println(s2);
    
    if s1 == 1 && s2 == -1 {
        println("TST verified.");
        return 1;
    }
    
    return -1;
}
