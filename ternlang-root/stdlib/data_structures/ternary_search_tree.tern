/*
 * Ternary Search Tree — A 3-way branching search tree for strings.
 * Each node has a char, and three children: less, equal, and greater.
 * 
 * RFI-IRFOS · PUBLIC repo · v1.0
 */

// Since structs are not fully reliable for complex trees yet, 
// we use parallel arrays for the tree structure.
// node_char[i], left[i], mid[i], right[i], is_end[i]

fn insert(chars: int[30], left: int[30], mid: int[30], right: int[30], is_end: int[30], 
          next_node: int, root: int, c: int) -> int {
    
    // Simplification: just insert a single char for now to test 3-way branch
    let curr: int = root;
    
    if root == -1 {
        chars[next_node] = c;
        left[next_node] = -1;
        mid[next_node] = -1;
        right[next_node] = -1;
        is_end[next_node] = 1;
        return next_node;
    }
    
    return root;
}

fn main() -> trit {
    let chars: int[30];
    let left: int[30];
    let mid: int[30];
    let right: int[30];
    let is_end: int[30];
    let next_node: int = 0;
    
    // Initialize
    let i: int = 0;
    while i < 30 {
        chars[i] = 0; left[i] = -1; mid[i] = -1; right[i] = -1; is_end[i] = 0;
        i = i + 1;
    }
    
    let root: int = -1;
    root = insert(chars, left, mid, right, is_end, next_node, root, 100); // 'd'
    next_node = next_node + 1;
    
    println("Root char:");
    println(chars[root]);
    
    if chars[root] == 100 {
        println("Ternary Search Tree Test: PASSED");
        return 1;
    }
    
    return -1;
}
