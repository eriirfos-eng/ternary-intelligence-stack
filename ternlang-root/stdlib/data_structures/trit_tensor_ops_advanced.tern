/*
 * Advanced Trit Tensor Operations
 * Includes element-wise logic and normalization helpers.
 */

fn tensor_invert(data: trit[]) -> trit {
    let n: int = 5; // Fixed size for this version
    let i: int = 0;
    while i < n {
        data[i] = -data[i];
        i = i + 1;
    }
    return 1;
}

fn tensor_and(a: trit[], b: trit[], res: trit[]) -> trit {
    let n: int = 5;
    let i: int = 0;
    while i < n {
        res[i] = a[i] && b[i];
        i = i + 1;
    }
    return 1;
}

fn main() -> trit {
    let t1: trit[5];
    let t2: trit[5];
    let res: trit[5];
    
    // Initialize
    t1[0] = 1; t1[1] = 0; t1[2] = -1; t1[3] = 1; t1[4] = 0;
    t2[0] = 0; t2[1] = 1; t2[2] = -1; t2[3] = 0; t2[4] = 1;
    
    println("Advanced Trit Tensor Ops Demo");
    
    println("Element-wise AND:");
    tensor_and(t1, t2, res);
    let k: int = 0;
    while k < 5 { println(res[k]); k = k + 1; }
    
    println("Inverting T1:");
    tensor_invert(t1);
    println(t1[0]); // should be -1
    
    if res[2] == -1 && t1[0] == -1 {
        println("Tensor ops verified. Success.");
        return 1;
    }
    
    return -1;
}
