/*
 * Float LRU Cache
 * LRU cache implementation for floating point values.
 * Uses a flat array with shifts for eviction and access update.
 */

fn lru_float_access(keys: int[], vals: float[], size: int, key: int) -> int {
    let found_pos: int = -1;
    let i: int = 0;
    while i < size {
        if keys[i] == key {
            found_pos = i;
        }
        i = i + 1;
    }
    
    if found_pos == -1 { return -1; }
    
    let target_val: float = vals[found_pos];
    
    // Shift others
    let j: int = found_pos;
    while j > 0 {
        keys[j] = keys[j-1];
        vals[j] = vals[j-1];
        j = j - 1;
    }
    
    keys[0] = key;
    vals[0] = target_val;
    return 0;
}

fn main() -> trit {
    let keys: int[5];
    let vals: float[5];
    
    // Initial data
    keys[0] = 1; vals[0] = 1.1;
    keys[1] = 2; vals[1] = 2.2;
    keys[2] = 3; vals[2] = 3.3;
    keys[3] = 4; vals[3] = 4.4;
    keys[4] = 5; vals[4] = 5.5;
    
    println("Float LRU Cache Demo");
    println("Accessing Key 4");
    lru_float_access(keys, vals, 5, 4);
    
    println("Head Key (should be 4):");
    println(keys[0]);
    
    println("Head Value (should be 4.4):");
    println(vals[0]);
    
    if keys[0] == 4 && vals[0] == 4.4 {
        println("LRU Access OK.");
        return 1;
    }
    
    return -1;
}
