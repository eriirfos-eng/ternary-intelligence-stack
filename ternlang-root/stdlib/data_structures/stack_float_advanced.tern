/*
 * Advanced Float Stack
 * Robust implementation of a LIFO stack for float values.
 * Optimized for numerical computation layers.
 */

fn stack_push(buffer: float[], ptr: int, val: float) -> int {
    if ptr >= 10 {
        return -1; // Overflow
    }
    buffer[ptr] = val;
    return ptr + 1;
}

fn stack_pop(ptr: int) -> int {
    if ptr <= 0 {
        return -1; // Underflow
    }
    return ptr - 1;
}

fn main() -> trit {
    let buffer: float[10];
    let ptr: int = 0;
    
    // Initialize
    let k: int = 0;
    while k < 10 { buffer[k] = 0.0; k = k + 1; }
    
    println("Advanced Float Stack Demo");
    
    println("Pushing: 1.23, 4.56, 7.89");
    ptr = stack_push(buffer, ptr, 1.23);
    ptr = stack_push(buffer, ptr, 4.56);
    ptr = stack_push(buffer, ptr, 7.89);
    
    println("Ptr after pushes (expected 3):");
    println(ptr);
    
    if ptr == 3 {
        println("Push OK.");
    } else { return -1; }
    
    println("Popping top element:");
    ptr = stack_pop(ptr);
    let top: float = buffer[ptr];
    println(top);
    
    if top == 7.89 && ptr == 2 {
        println("Pop OK.");
    } else { return -1; }
    
    println("Popping next element:");
    ptr = stack_pop(ptr);
    let top2: float = buffer[ptr];
    println(top2);
    
    if top2 == 4.56 && ptr == 1 {
        println("Stack sequence verified. Success.");
        return 1;
    }
    
    return -1;
}
