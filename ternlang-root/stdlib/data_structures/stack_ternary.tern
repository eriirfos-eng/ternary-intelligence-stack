/*
 * Stack (Ternary)
 * Robust implementation of a LIFO stack for trits.
 * Includes bounds checking and clear overflow/underflow signals.
 */

// Since we can't return multiple values yet, we use pointer-like indices
fn stack_push(buffer: trit[], ptr: int, val: trit) -> int {
    if ptr >= 10 {
        return -1; // Overflow
    }
    buffer[ptr] = val;
    return ptr + 1;
}

fn stack_pop(ptr: int) -> int {
    if ptr <= 0 {
        return -1; // Underflow
    }
    return ptr - 1;
}

fn main() -> trit {
    let buffer: trit[10];
    let ptr: int = 0;
    
    // Initialize
    let k: int = 0;
    while k < 10 {
        buffer[k] = 0;
        k = k + 1;
    }
    
    println("Stack (Ternary) Demo");
    
    println("Pushing: 1, 0, -1");
    ptr = stack_push(buffer, ptr, 1);
    ptr = stack_push(buffer, ptr, 0);
    ptr = stack_push(buffer, ptr, -1);
    
    println("Ptr after pushes (expected 3):");
    println(ptr);
    
    if ptr == 3 {
        println("Push OK.");
    } else { return -1; }
    
    println("Popping top element:");
    ptr = stack_pop(ptr);
    let top: trit = buffer[ptr];
    println(top);
    
    if top == -1 && ptr == 2 {
        println("Pop OK.");
    } else { return -1; }
    
    println("Popping next element:");
    ptr = stack_pop(ptr);
    let top2: trit = buffer[ptr];
    println(top2);
    
    if top2 == 0 && ptr == 1 {
        println("Stack sequence verified. Success.");
        return 1;
    }
    
    return -1;
}
