// stdlib/showcase/logic_gate_simulator.tern
// Simulator for Kleene's strong 3-valued logic (AND, OR, NOT).
// Tier: 1 - Open Core

fn k_not(a: trit) -> trit {
    return invert(a);
}

fn k_and(a: trit, b: trit) -> trit {
    if a == -1 || b == -1 { return -1; }
    if a == 1 && b == 1 { return 1; }
    return 0;
}

fn k_or(a: trit, b: trit) -> trit {
    if a == 1 || b == 1 { return 1; }
    if a == -1 && b == -1 { return -1; }
    return 0;
}

fn main() -> trit {
    println("Kleene Strong 3-valued Logic Simulator");
    
    println("AND Table:");
    let t: trit[] = [1, 0, -1];
    let i: int = 0;
    while i < 3 {
        let j: int = 0;
        while j < 3 {
            let res: trit = k_and(t[i], t[j]);
            print(t[i]); print(" AND "); print(t[j]); print(" = "); println(res);
            j = j + 1;
        }
        i = i + 1;
    }
    
    // Verification
    if k_and(0, -1) == -1 && k_or(0, 1) == 1 {
        println("Logic gates validated.");
        return 1;
    }
    
    return -1;
}
