// stdlib/showcase/consensus_voting_sim.tern
// Consensus voting simulation for multi-agent systems.
// Tier: 1 - Open Core

fn get_consensus(votes: trit[], n: int) -> trit {
    let support: int = 0;
    let opposition: int = 0;
    
    let i: int = 0;
    while i < n {
        match votes[i] {
            1 => { support = support + 1; }
           -1 => { opposition = opposition + 1; }
            0 => { /* Abstain */ }
        }
        i = i + 1;
    }
    
    // Threshold consensus (e.g. support must outweigh opposition)
    if support > opposition { return 1; }
    if opposition > support { return -1; }
    return 0;
}

fn main() -> trit {
    println("Multi-Agent Consensus Voting Simulator");
    
    let agents: trit[5];
    agents[0] = 1; agents[1] = 1; agents[2] = 0; agents[3] = -1; agents[4] = 1;
    
    println("Votes: [1, 1, 0, -1, 1]");
    let res: trit = get_consensus(agents, 5);
    
    print("Consensus Outcome: ");
    match res {
        1 => { println("AFFIRMATIVE (Pass)"); }
        0 => { println("TENTATIVE (Hold)"); }
       -1 => { println("REJECTED (Fail)"); }
    }
    
    if res == 1 {
        println("Consensus validation successful.");
        return 1;
    }
    
    return -1;
}
