// stdlib/showcase/monte_carlo_trit.tern
// Demonstrates: Monte Carlo estimation of ternary probability distribution
// Tier: 1 — Open Core

fn get_random_trit(seed: int) -> trit {
    let val: int = seed % 3;
    if val == 0 { return reject; }
    if val == 1 { return tend;   }
    return affirm;
}

fn estimate_affirm_ratio(iterations: int) -> float {
    let count: int = 0;
    let i: int = 0;
    
    while i < iterations {
        let r: trit = get_random_trit(i);
        match r {
            -1 => { /* skip */ }
             0 => { /* skip */ }
             1 => { count = count + 1; }
        }
        i = i + 1;
    }
    
    return (count * 1.0) / (iterations * 1.0);
}

fn main() -> trit {
    let ratio: float = estimate_affirm_ratio(100);
    print("Estimated Affirm Ratio for 100 iterations: ");
    print(ratio);
    
    match ratio > 0.3 {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
