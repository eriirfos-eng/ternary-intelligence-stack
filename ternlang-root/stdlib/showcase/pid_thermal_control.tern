/*
 * PIDThermalControl — Simulation of a thermal controller using PID logic.
 * Demonstrates how ternary signals can be used for discrete control.
 * 
 * RFI-IRFOS · PUBLIC repo · v1.0
 */

fn main() -> trit {
    let target_temp: float = 25.0;
    let current_temp: float = 20.0;
    
    let kp: float = 1.0;
    let ki: float = 0.1;
    let kd: float = 0.05;
    
    let prev_error: float = 0.0;
    let integral: float = 0.0;
    
    println("Starting PID Thermal Control Simulation...");
    println("Target: 25.0, Start: 20.0");
    
    let step: int = 0;
    while step < 5 {
        let error: float = target_temp - current_temp;
        integral = integral + error;
        let derivative: float = error - prev_error;
        
        let output: float = (kp * error) + (ki * integral) + (kd * derivative);
        
        println("Step:"); println(step);
        println("Current Temp:"); println(current_temp);
        
        // Ternary decision based on PID output
        let control_signal: trit = 0;
        if output > 0.5 {
            control_signal = 1; // Heat
            println("Action: HEAT (+1)");
        } else if output < -0.5 {
            control_signal = -1; // Cool
            println("Action: COOL (-1)");
        } else {
            control_signal = 0; // Hold
            println("Action: HOLD (0)");
        }
        
        // Simulate physical response (simple gain)
        let s_val: float = cast(control_signal);
        current_temp = current_temp + (s_val * 2.0);
        
        prev_error = error;
        step = step + 1;
    }
    
    println("Final Temp:");
    println(current_temp);
    
    if current_temp > 23.0 && current_temp < 27.0 {
        println("PIDThermalControl Test: PASSED");
        return 1;
    }
    
    println("PIDThermalControl Test: FAILED (Target not reached)");
    return -1;
}
