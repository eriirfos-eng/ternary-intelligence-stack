/*
 * VotingSystemTernary — Consensus decision making using ternary votes.
 * Aggregates Affirm, Tend, and Reject votes to determine a final outcome.
 * 
 * RFI-IRFOS · PUBLIC repo · v1.0
 */

fn aggregate_votes(votes: trit[], count: int) -> trit {
    let affirm_count: int = 0;
    let reject_count: int = 0;
    
    let i: int = 0;
    while i < count {
        match votes[i] {
             1 => { affirm_count = affirm_count + 1; }
            -1 => { reject_count = reject_count + 1; }
             0 => { } // Tend votes abstain
        }
        i = i + 1;
    }
    
    println("Affirm votes:"); println(affirm_count);
    println("Reject votes:"); println(reject_count);
    
    // Absolute majority needed
    if affirm_count > reject_count {
        return 1;
    } else if reject_count > affirm_count {
        return -1;
    }
    
    return 0; // Tie or only Tend votes
}

fn main() -> trit {
    let votes: trittensor<5> = [1, 0, 1, -1, 1];
    
    println("Votes: [Affirm, Tend, Affirm, Reject, Affirm]");
    
    let result: trit = aggregate_votes(votes, 5);
    
    match result {
         1 => { println("Final Decision: APPROVED (Affirm)"); }
         0 => { println("Final Decision: UNDECIDED (Tend)"); }
        -1 => { println("Final Decision: REJECTED (Reject)"); }
    }
    
    if result == 1 {
        println("VotingSystemTernary Test: PASSED");
        return 1;
    }
    
    println("VotingSystemTernary Test: FAILED");
    return -1;
}
