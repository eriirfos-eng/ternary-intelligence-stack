// stdlib/control/redundant_throttle_gate.tern
// Demonstrates: Redundant Throttle Safety Gate
// Tier: 2 — Pro Standard

// throttle_gate: Compares primary and secondary throttle inputs via consensus.
// If the inputs conflict (one forward, one reverse/neutral), it defaults to neutral (0).
fn throttle_gate(primary: trit, secondary: trit) -> trit {
    let combined: trit = consensus(primary, secondary);
    
    match combined {
        -1 => { 
            // Both agree on reverse/negative throttle.
            return -1; 
        }
         0 => {
            // Discord between throttles detected. 
            // Safety rule: Revert to neutral (0) to prevent unintended acceleration.
            return 0; 
        }
         1 => { 
            // Both agree on forward/positive throttle.
            return 1; 
        }
    }
}

// compute_throttle_value: Translates the gated trit signal into a floating-point throttle value.
fn compute_throttle_value(status: trit) -> float {
    match status {
        -1 => { return -1.0; } // Reverse thrust
         0 => { return 0.0; }  // Neutral / Engine braking
         1 => { return 1.0; }  // Forward thrust
    }
}

fn main() -> trit {
    let t1: trit = 1;  // Primary: Forward
    let t2: trit = -1; // Secondary: Reverse (Faulty or conflicting command)
    
    // Conflicting inputs should result in a safe neutral throttle (0).
    let gated: trit = throttle_gate(t1, t2);
    
    match gated {
        -1 => { return conflict(); }
         0 => { return truth(); } // Pass test: Safety neutral fallback correctly selected
         1 => { return conflict(); }
    }
}
