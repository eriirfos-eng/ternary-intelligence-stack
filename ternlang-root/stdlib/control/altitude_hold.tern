// stdlib/control/altitude_hold.tern
// Demonstrates: Altitude hold logic for aerial vehicles
// Tier: 2

from "control_utils.tern" import error_state;

fn compute_thrust_adjustment(altitude: float, setpoint: float) -> trit {
    let tolerance: float = 0.2;
    let state: trit = error_state(setpoint, altitude, tolerance);
    
    match state {
        1  => { return 1;  } // Too low, increase thrust
        0  => { return 0;  } // At target altitude, maintain thrust
        -1 => { return -1; } // Too high, decrease thrust
    }
}

fn main() -> trit {
    let current_alt: float = 9.5;
    let target_alt: float = 10.0;
    
    let adjust: trit = compute_thrust_adjustment(current_alt, target_alt);
    
    match adjust {
        1  => { return truth();    }
        0  => { return hold();     }
        -1 => { return conflict(); }
    }
}
