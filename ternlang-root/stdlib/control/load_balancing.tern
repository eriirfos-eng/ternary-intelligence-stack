// stdlib/control/load_balancing.tern
// Demonstrates: Resource load balancing among two nodes
// Tier: 2

from "control_utils.tern" import ternary_signal;

fn balance_load(load_a: float, load_b: float) -> trit {
    let diff: float = load_a - load_b;
    let threshold: float = 0.2;
    
    // Positive result means Node A is more loaded -> shift to Node B (+1)
    // Negative result means Node B is more loaded -> shift to Node A (-1)
    return ternary_signal(diff, threshold);
}

fn main() -> trit {
    let a: float = 0.8;
    let b: float = 0.4;
    
    let shift: trit = balance_load(a, b);
    
    match shift {
        1  => { return truth();    }
        0  => { return hold();     }
        -1 => { return conflict(); }
    }
}
