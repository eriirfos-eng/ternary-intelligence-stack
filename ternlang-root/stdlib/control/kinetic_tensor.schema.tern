// Module:  stdlib/control/kinetic_tensor.schema.tern
// Purpose: T-SON serialization schema for kinetic_tensor
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Kinetic_tensorSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Kinetic_tensorSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
