// Module:  stdlib/control/acoustic_engine.schema.tern
// Purpose: T-SON serialization schema for acoustic_engine
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Acoustic_engineSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Acoustic_engineSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
