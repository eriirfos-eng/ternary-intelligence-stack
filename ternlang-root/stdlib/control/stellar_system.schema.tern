// Module:  stdlib/control/stellar_system.schema.tern
// Purpose: T-SON serialization schema for stellar_system
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Stellar_systemSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Stellar_systemSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
