// stdlib/control/feedback_stability_gate.tern
// Demonstrates: Stability monitoring for feedback control loops
// Tier: 2

from "./_utils.tern" import *;

fn stability_gate(oscillation_amplitude: float, damping_ratio: float) -> trit {
    let osc_status: trit = saturation_check(oscillation_amplitude, 10.0);
    // If oscillation is high (affirm), stability is reject
    
    match osc_status {
        affirm => {
            return reject; // Unstable
        }
        tend => {
            return tend; // Uncertain
        }
        reject => {
            // Oscillation is low (within limits)
            if damping_ratio > 0.7 ? {
                return affirm; // Stable/Damped
            } else {
                return tend;
            } else {
                return tend; // Underdamped but not necessarily unstable yet
            }
        }
    }
}

fn main() -> trit {
    let amp: float = 2.5;
    let damp: float = 0.85;
    
    let stability: trit = stability_gate(amp, damp);
    
    match stability {
        affirm => {
            println("System is STABLE.");
        }
        tend => {
            println("System stability is MARGINAL.");
        }
        reject => {
            println("System is UNSTABLE - DANGER.");
        }
    }
    
    return stability;
}
