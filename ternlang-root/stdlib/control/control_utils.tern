// stdlib/control/control_utils.tern
// Demonstrates: Reusable control logic for Tier 2 Pro Standard
// Tier: 2

fn clamp(val: float, min_v: float, max_v: float) -> float {
    if val < min_v { return min_v; }
    if val > max_v { return max_v; }
    return val;
}

fn deadband(val: float, threshold: float) -> float {
    if val > threshold { return val; }
    let neg_threshold: float = 0.0 - threshold;
    if val < neg_threshold { return val; }
    return 0.0;
}

fn ternary_signal(val: float, threshold: float) -> trit {
    if val > threshold { return affirm; }
    let neg_threshold: float = 0.0 - threshold;
    if val < neg_threshold { return reject; }
    return tend;
}

fn error_state(target: float, actual: float, tolerance: float) -> trit {
    let diff: float = target - actual;
    if diff > tolerance { return affirm; }
    let neg_tolerance: float = 0.0 - tolerance;
    if diff < neg_tolerance { return reject; }
    return tend;
}
