// stdlib/control/pressure_regulation.tern
// Demonstrates: Pressure regulation logic with tolerance checking
// Tier: 2

from "control_utils.tern" import error_state;

fn check_pressure(actual: float, target: float) -> trit {
    let tolerance: float = 0.05;
    let state: trit = error_state(target, actual, tolerance);
    
    // Reverse the logic for regulation: 
    // If error > tolerance (affirm), pressure is low -> increase (+1)
    // If error < -tolerance (reject), pressure is high -> decrease (-1)
    
    match state {
        1  => { return 1;  } // Low pressure
        0  => { return 0;  } // Optimal
        -1 => { return -1; } // High pressure
    }
}

fn main() -> trit {
    let current_p: float = 1.1;
    let target_p: float = 1.0;
    
    let adjustment: trit = check_pressure(current_p, target_p);
    
    match adjustment {
        1  => { return truth();    }
        0  => { return hold();     }
        -1 => { return conflict(); }
    }
}
