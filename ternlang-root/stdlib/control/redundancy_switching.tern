// stdlib/control/redundancy_switching.tern
// Demonstrates: Automated failover/redundancy switching
// Tier: 2

fn evaluate_health(ping_ms: float, error_rate: float) -> trit {
    if error_rate > 0.1 { return -1; } // Critical failure
    if ping_ms > 200.0 { return 0;  } // Degraded
    return 1; // Healthy
}

fn switch_node(primary: trit, secondary: trit) -> trit {
    match primary {
        1  => { return 1; } // Stay on primary
        0  => { 
            // Primary degraded, check secondary
            match secondary {
                1  => { return -1; } // Switch to secondary
                0  => { return 1;  } // Both degraded, stay on primary (best effort)
                -1 => { return 1;  } // Secondary failed, stay on primary
            }
        }
        -1 => {
            // Primary failed, check secondary
            match secondary {
                1  => { return -1; } // Switch to secondary
                0  => { return -1; } // Switch to secondary (degraded is better than failed)
                -1 => { return 0;  } // Both failed, hold/panic
            }
        }
    }
}

fn main() -> trit {
    let p_ping: float = 250.0;
    let p_err: float = 0.01;
    let s_ping: float = 20.0;
    let s_err: float = 0.0;
    
    let p_health: trit = evaluate_health(p_ping, p_err);
    let s_health: trit = evaluate_health(s_ping, s_err);
    
    let choice: trit = switch_node(p_health, s_health);
    
    match choice {
        1  => { return truth();    } // Primary
        0  => { return hold();     } // Panic
        -1 => { return conflict(); } // Secondary (Reject primary)
    }
}
