// stdlib/shadow_tern/bloom_filter_check.tern
// Demonstrates: Ternary Bloom filter membership check
// Tier: 3 - Industrial

fn bloom_check(filter: trittensor<10>, hash1: int, hash2: int) -> trit {
    // Membership: all hashed positions must be affirm
    let p1: trit = filter[hash1];
    let p2: trit = filter[hash2];
    
    return p1 && p2;
}

fn main() -> trit {
    // Filter with some trits set
    let filter: trittensor<10> = [1, 0, 1, 0, 1, -1, 0, 1, 1, 0];
    
    // Check if hashes 0 and 2 are in the set
    let res: trit = bloom_check(filter, 0, 2);

    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
