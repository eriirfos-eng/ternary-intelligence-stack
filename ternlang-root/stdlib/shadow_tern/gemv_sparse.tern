// --- RFI-IRFOS SHADOW-TERN KERNEL ---
// Module: stdlib/shadow_tern/gemv_sparse.tern
// Purpose: GGML Matrix-Vector Multiplication with @sparseskip
// License: BSL-1.1 - Proprietary RFI-IRFOS IP
// Efficiency: η = 0.8 (TRCE)

fn gemv_sparse(matrix: trit_tensor, vector: trit_tensor) -> trit_tensor {
    @sparseskip
    return matrix.matmul(vector);
}
