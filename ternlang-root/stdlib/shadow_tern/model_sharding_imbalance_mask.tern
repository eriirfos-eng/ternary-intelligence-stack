// stdlib/shadow_tern/model_sharding_imbalance_mask.tern
// Demonstrates: Identifying load imbalance in sharded model training
// Tier: 4

fn parameter_imbalance_eval(diff_percent: int) -> trit {
    if diff_percent > 50 { return -1; } // High memory imbalance
    if diff_percent > 10 { return 0; }
    return 1;
}

fn compute_imbalance_check(t_diff_ms: int) -> trit {
    if t_diff_ms > 100 { return -1; } // Straggler detected
    if t_diff_ms > 20 { return 0; }
    return 1;
}

fn main() -> trit {
    let p: int = 15;
    let c: int = 50;
    
    let p_trit: trit = parameter_imbalance_eval(p);
    let c_trit: trit = compute_imbalance_check(c);
    
    match p_trit {
        -1 => { return -1; }
        1  => { return c_trit; }
        0  => { return 0; }
    }
}
