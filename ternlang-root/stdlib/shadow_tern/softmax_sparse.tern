// --- RFI-IRFOS SHADOW-TERN KERNEL ---
// Module: stdlib/shadow_tern/softmax_sparse.tern
// Purpose: Llama.cpp Sparse Softmax
// License: BSL-1.1 - Proprietary RFI-IRFOS IP
// Efficiency: η = 0.8 (TRCE)

fn softmax_sparse(input: trit_tensor) -> trit_tensor {
    @sparseskip
    let exp: trit_tensor = input.exp();
    return exp.divide(exp.sum());
}
