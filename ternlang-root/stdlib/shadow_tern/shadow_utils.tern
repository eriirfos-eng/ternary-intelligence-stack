// stdlib/shadow_tern/shadow_utils.tern
// Demonstrates: Core utility functions for high-performance optimization modules
// Tier: 4

fn consensus(a: trit, b: trit) -> trit {
    match a {
        -1 => { return -1; }
        0 => { return b; }
        1 => {
            match b {
                -1 => { return -1; }
                0 => { return 1; }
                1 => { return 1; }
            }
        }
    }
}

fn map_performance_to_trit(speedup: float) -> trit {
    if speedup > 1.5 { return 1; }  // Significant speedup
    if speedup < 0.9 { return -1; } // Performance regression
    return 0; // Neutral
}

fn main() -> trit {
    let s: float = 2.3;
    let t: trit = map_performance_to_trit(s);
    
    match t {
        1  => { return 1; }
        0  => { return 0; }
        -1 => { return -1; }
    }
}
