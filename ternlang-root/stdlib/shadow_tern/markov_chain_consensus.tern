// stdlib/shadow_tern/markov_chain_consensus.tern
// Demonstrates: Markov chain state transition consensus
// Tier: 3 - Industrial

fn transition_check(current: trit, next: trit) -> trit {
    match current {
        -1 => {
            if next == 0 { return truth(); }
            return conflict();
        }
        0 => {
            if next == 1 { return truth(); }
            if next == -1 { return truth(); }
            return hold();
        }
        1 => {
            if next == 0 { return truth(); }
            return conflict();
        }
    }
}

fn main() -> trit {
    let s0: trit = -1;
    let s1: trit = 0;
    let s2: trit = 1;

    let v1: trit = transition_check(s0, s1);
    let v2: trit = transition_check(s1, s2);

    let res: trit = v1 && v2;

    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
