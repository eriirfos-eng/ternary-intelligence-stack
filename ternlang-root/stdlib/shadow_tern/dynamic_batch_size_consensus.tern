// stdlib/shadow_tern/dynamic_batch_size_consensus.tern
// Demonstrates: Deciding on batch size adjustments based on throughput/latency
// Tier: 4

fn throughput_eval(tokens_per_sec: int, target: int) -> trit {
    if tokens_per_sec < (target / 2) { return 1; } // Increase batch size (Affirm)
    if tokens_per_sec > target { return -1; } // Maxed out (Reject increase)
    return 0;
}

fn latency_limit_check(ms: int, max_ms: int) -> trit {
    if ms > max_ms { return -1; } // Too slow, must reduce (Reject increase)
    if ms < (max_ms / 2) { return 1; } // Low latency, can increase (Affirm)
    return 0;
}

fn main() -> trit {
    let tps: int = 500;
    let tgt: int = 1000;
    let lat: int = 150;
    let maxl: int = 200;
    
    let tp: trit = throughput_eval(tps, tgt);
    let l: trit = latency_limit_check(lat, maxl);
    
    match tp {
        1  => { return l; } // Try to increase if latency allows
        -1 => { return -1; }
        0  => { return 0; }
    }
}
