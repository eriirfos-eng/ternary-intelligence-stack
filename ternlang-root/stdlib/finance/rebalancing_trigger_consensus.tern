// proprietary/finance/rebalancing_trigger_consensus.tern
// Demonstrates: A consensus-based trigger for portfolio rebalancing.
// Tier: 2

fn drift_check(current_alloc: float, target_alloc: float, drift_limit: float) -> trit {
    let drift: float = current_alloc - target_alloc;
    if drift < 0.0 { drift = drift * -1.0; }

    if drift > drift_limit {
        return affirm; // Rebalance recommended
    }
    
    // Within 20% of drift limit is "hold"
    let tolerance: float = drift_limit * 0.2;
    if drift < tolerance {
        return reject; // Rebalance definitely not needed
    }
    
    return tend;
}

fn main() -> trit {
    let current_equity: float = 0.65;
    let target_equity: float = 0.60;
    let limit: float = 0.03;

    let trigger: trit = drift_check(current_equity, target_equity, limit);

    match trigger {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
