// proprietary/finance/option_premium_mask.tern
// Demonstrates: Masking unreasonable option premiums relative to intrinsic value.
// Tier: 2

fn check_premium(premium: float, strike: float, underlying: float, is_call: trit) -> trit {
    let intrinsic: float = 0.0;
    
    match is_call {
        1 => { 
            let diff: float = underlying - strike;
            if diff > 0.0 { intrinsic = diff; }
        }
        -1 => { 
            let diff: float = strike - underlying;
            if diff > 0.0 { intrinsic = diff; }
        }
        0 => { return tend; }
    }

    // Time value = Premium - Intrinsic
    let time_value: float = premium - intrinsic;

    if time_value < 0.0 {
        return reject; // Impossible premium (arbitrage opportunity or data error)
    }
    
    if time_value > (underlying * 0.1) {
        return reject; // Excessively high time value
    }
    
    return affirm;
}

fn main() -> trit {
    let p: float = 5.5;
    let k: float = 100.0;
    let s: float = 102.0;
    let call: trit = affirm;

    let valid: trit = check_premium(p, k, s, call);

    match valid {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
