fn main() -> trit {
    let p1: float = 10.0; let p2: float = 11.0; let p3: float = 12.0;
    let p4: float = 13.0; let p5: float = 14.0;
    let ema3: float = (p3 + p4 + p5) / 3.0;
    let ema5: float = (p1 + p2 + p3 + p4 + p5) / 5.0;
    println("EMA3:"); println(ema3);
    println("EMA5:"); println(ema5);
    if ema3 > ema5 {
        println("Golden Cross Detected");
        return 1;
    }
    return -1;
}
