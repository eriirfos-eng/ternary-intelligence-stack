// proprietary/finance/var_threshold_gate.tern
// Demonstrates: A Value at Risk (VaR) threshold gate.
// Tier: 2

fn check_var(current_var: float, capital: float, limit_pct: float) -> trit {
    let var_ratio: float = current_var / capital;

    if var_ratio > limit_pct {
        return reject; // VaR exceeds allowable limit
    }
    
    // We are comfortable if VaR is less than half the limit
    let comfort_zone: float = limit_pct * 0.5;
    if var_ratio < comfort_zone {
        return affirm;
    }
    
    return tend;
}

fn main() -> trit {
    let var_val: float = 5000.0;
    let cap: float = 1000000.0;
    let limit: float = 0.01; // 1% of capital

    let result: trit = check_var(var_val, cap, limit);

    match result {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
