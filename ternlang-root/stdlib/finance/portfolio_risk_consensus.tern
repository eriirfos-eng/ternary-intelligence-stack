// proprietary/finance/portfolio_risk_consensus.tern
// Demonstrates: Reaching consensus on portfolio risk across multiple risk models.
// Tier: 2

fn model_a_risk(volatility: float) -> trit {
    if volatility > 0.4 { return reject; }
    if volatility < 0.2 { return affirm; }
    return tend;
}

fn model_b_risk(drawdown: float) -> trit {
    if drawdown > 0.15 { return reject; }
    if drawdown < 0.05 { return affirm; }
    return tend;
}

fn main() -> trit {
    let vol: float = 0.25;
    let dd: float = 0.08;

    let risk_a: trit = model_a_risk(vol);
    let risk_b: trit = model_b_risk(dd);

    // consensus(tend, tend) -> tend
    // consensus(affirm, reject) -> tend (conflict)
    let final_risk: trit = consensus(risk_a, risk_b);

    match final_risk {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
