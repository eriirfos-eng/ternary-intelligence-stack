// proprietary/finance/yield_spread_detector.tern
// Demonstrates: Detecting anomalous yield spreads between two instruments.
// Tier: 2

from "finance_utils.tern" import abs_diff;

fn detect_anomaly(yield1: float, yield2: float, historical_spread: float) -> trit {
    let current_spread: float = abs_diff(yield1, yield2);
    let deviation: float = abs_diff(current_spread, historical_spread);

    // If deviation > 0.05, it's an anomaly (reject)
    // If deviation < 0.01, it's normal (affirm)
    if deviation > 0.05 {
        return reject;
    }
    if deviation < 0.01 {
        return affirm;
    }
    return tend;
}

fn main() -> trit {
    let y1: float = 0.045; // 4.5%
    let y2: float = 0.032; // 3.2%
    let hist: float = 0.012; // 1.2% historical spread

    let result: trit = detect_anomaly(y1, y2, hist);

    match result {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
