// stdlib/finance/margin_call_trigger.tern
// Demonstrates: multi-stage margin warnings and liquidation
// Tier: 2 — Pro Standard

fn margin_status(equity: float, maintenance: float) -> trit {
    if equity < maintenance * 0.5 {
        return conflict(); // Immediate liquidation
    }
    if equity < maintenance {
        return hold();     // Warning / Margin call
    }
    return truth();        // Position healthy
}

fn main() -> trit {
    let eq: float = 1200.0;
    let mnt: float = 2000.0;
    
    let status: trit = margin_status(eq, mnt);
    
    match status {
        -1 => { return conflict(); } // LIQUIDATE
         0 => { return hold();     } // ALERT
         1 => { return truth();    } // OK
    }
}
