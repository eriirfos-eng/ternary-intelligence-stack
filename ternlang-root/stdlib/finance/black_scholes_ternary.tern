fn main() -> trit {
    let s0: float = 100.0;
    let k: float = 100.0;
    let u: float = 1.1;
    let s: float = 1.0;
    let d: float = 0.90909; 
    
    let pu: float = 0.4;
    let ps: float = 0.2;
    let pd: float = 0.4;
    
    let discount: float = 0.95; 
    
    // Step 3 Price Nodes
    let s3_3: float = s0 * u * u * u;
    let s3_2: float = s0 * u * u * s;
    let s3_1: float = s0 * u * u * d;
    let s3_0: float = s0 * u * s * d;
    let s3_m1: float = s0 * u * d * d;
    let s3_m2: float = s0 * s * d * d;
    let s3_m3: float = s0 * d * d * d;

    // Step 3 Option Values (Call)
    let mut v3_3: float = 0.0;
    if s3_3 > k { v3_3 = s3_3 - k; } else { v3_3 = 0.0; }
    let mut v3_2: float = 0.0;
    if s3_2 > k { v3_2 = s3_2 - k; } else { v3_2 = 0.0; }
    let mut v3_1: float = 0.0;
    if s3_1 > k { v3_1 = s3_1 - k; } else { v3_1 = 0.0; }
    let mut v3_0: float = 0.0;
    if s3_0 > k { v3_0 = s3_0 - k; } else { v3_0 = 0.0; }
    let mut v3_m1: float = 0.0;
    if s3_m1 > k { v3_m1 = s3_m1 - k; } else { v3_m1 = 0.0; }
    let mut v3_m2: float = 0.0;
    if s3_m2 > k { v3_m2 = s3_m2 - k; } else { v3_m2 = 0.0; }
    let mut v3_m3: float = 0.0;
    if s3_m3 > k { v3_m3 = s3_m3 - k; } else { v3_m3 = 0.0; }

    // Step 2
    let v2_2: float = discount * (pu * v3_3 + ps * v3_2 + pd * v3_1);
    let v2_1: float = discount * (pu * v3_2 + ps * v3_1 + pd * v3_0);
    let v2_0: float = discount * (pu * v3_1 + ps * v3_0 + pd * v3_m1);
    let v2_m1: float = discount * (pu * v3_0 + ps * v3_m1 + pd * v3_m2);
    let v2_m2: float = discount * (pu * v3_m1 + ps * v3_m2 + pd * v3_m3);

    // Step 1
    let v1_1: float = discount * (pu * v2_2 + ps * v2_1 + pd * v2_0);
    let v1_0: float = discount * (pu * v2_1 + ps * v2_0 + pd * v2_m1);
    let v1_m1: float = discount * (pu * v2_0 + ps * v2_m1 + pd * v2_m2);

    // Step 0
    let v0: float = discount * (pu * v1_1 + ps * v1_0 + pd * v1_m1);

    println("Option Price:");
    println(v0);
    
    if v0 > 0.0 {
        return 1;
    }
    return -1;
}
