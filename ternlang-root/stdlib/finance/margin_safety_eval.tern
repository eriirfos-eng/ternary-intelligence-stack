// proprietary/finance/margin_safety_eval.tern
// Demonstrates: Evaluating the margin of safety for a position.
// Tier: 2

from "finance_utils.tern" import clamp_to_trit;

fn evaluate_margin(equity: float, maintenance_margin: float) -> trit {
    let ratio: float = equity / maintenance_margin;
    // We want a ratio > 2.0 for affirm, < 1.1 for reject, else tend
    if ratio > 2.0 {
        return affirm;
    }
    if ratio < 1.1 {
        return reject;
    }
    return tend;
}

fn main() -> trit {
    let my_equity: float = 50000.0;
    let required_margin: float = 20000.0;

    let safety: trit = evaluate_margin(my_equity, required_margin);

    match safety {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
