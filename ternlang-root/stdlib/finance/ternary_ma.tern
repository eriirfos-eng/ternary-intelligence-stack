// stdlib/finance/ternary_ma.tern
// Demonstrates: Ternary signal generation based on Moving Average crossover.
// Tier: 2 — Pro Standard

fn calculate_sma(prices: float[], start: int, window: int) -> float {
    let sum: float = 0.0;
    let i: int = 0;
    while i < window {
        sum = sum + prices[start + i];
        i = i + 1;
    }
    return sum / window;
}

fn main() -> trit {
    let prices: float[] = [10.0, 11.0, 10.5, 12.0, 13.0, 12.5];
    let window: int = 3;
    
    // SMA for last 3: (12.0 + 13.0 + 12.5) / 3 = 37.5 / 3 = 12.5
    let current_sma: float = calculate_sma(prices, 3, 3);
    let current_price: float = 12.5; // prices[5]
    
    if current_price > current_sma {
        return truth(); // Bullish
    }
    if current_price < current_sma {
        return conflict(); // Bearish
    }
    return hold(); // Neutral
}
