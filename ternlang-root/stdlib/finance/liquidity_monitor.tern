// stdlib/finance/liquidity_monitor.tern
// Demonstrates: Real-time Liquidity Monitoring logic
// Tier: 2 — Pro Standard

// check_liquidity: Evaluates market liquidity based on spread and volume.
// If spread is too high OR volume is too low, return warning (-1).
fn check_liquidity(spread: float, max_spread: float, volume: int, min_volume: int) -> trit {
    // Check spread
    if spread > max_spread {
        return -1; // Illiquid (high spread)
    }
    
    // Check volume
    let v: float = cast(volume);
    let mv: float = cast(min_volume);
    if v < mv {
        return -1; // Illiquid (low volume)
    }
    
    return 1; // Liquid
}

// liquidity_consensus: Aggregates liquidity status from three venues.
fn liquidity_consensus(v1: trit, v2: trit, v3: trit) -> trit {
    let c12: trit = consensus(v1, v2);
    let final_c: trit = consensus(c12, v3);
    
    match final_c {
        -1 => { return -1; }
         0 => { return 0; }
         1 => { return 1; }
    }
}

fn main() -> trit {
    let s: float = 0.05;
    let ms: float = 0.03;
    let vol: int = 1000;
    let mvol: int = 500;
    
    // spread (0.05) > max_spread (0.03). Should return -1.
    let status: trit = check_liquidity(s, ms, vol, mvol);
    
    match status {
        -1 => { return truth(); } // Pass test: detected illiquidity
         0 => { return hold(); }
         1 => { return conflict(); }
    }
}
