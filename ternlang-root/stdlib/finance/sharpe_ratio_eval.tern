// proprietary/finance/sharpe_ratio_eval.tern
// Demonstrates: Evaluating performance via risk-adjusted return (Sharpe-like).
// Tier: 2

fn evaluate_performance(avg_return: float, risk_free_rate: float, std_dev: float) -> trit {
    let excess_return: float = avg_return - risk_free_rate;
    let ratio: float = excess_return / std_dev;

    // ratio > 1.0 -> Excellent (affirm)
    // ratio < 0.0 -> Poor (reject)
    // else -> Adequate (tend)
    if ratio > 1.0 {
        return affirm;
    }
    if ratio < 0.0 {
        return reject;
    }
    return tend;
}

fn main() -> trit {
    let ret: float = 0.12;
    let rf: float = 0.03;
    let vol: float = 0.15;

    let perf: trit = evaluate_performance(ret, rf, vol);

    match perf {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
