// proprietary/finance/liquidity_crunch_gate.tern
// Demonstrates: A gate that identifies liquidity crunch conditions.
// Tier: 2

fn evaluate_liquidity(bid_ask_spread: float, volume: float, avg_volume: float) -> trit {
    let vol_ratio: float = volume / avg_volume;
    
    // Spread > 0.05 AND Volume < 30% of average -> Crunch (reject)
    // Spread < 0.001 AND Volume > 80% of average -> Healthy (affirm)
    if bid_ask_spread > 0.05 {
        if vol_ratio < 0.3 {
            return reject;
        }
    }
    
    if bid_ask_spread < 0.001 {
        if vol_ratio > 0.8 {
            return affirm;
        }
    }
    
    return tend;
}

fn main() -> trit {
    let spread: float = 0.06;
    let vol: float = 1000.0;
    let avg: float = 5000.0;

    let result: trit = evaluate_liquidity(spread, vol, avg);

    match result {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
