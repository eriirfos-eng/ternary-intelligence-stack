// stdlib/rl/curiosity_bonus_consensus.tern
// Demonstrates: Consensus on curiosity-driven exploration bonuses
// Tier: 2 — Pro Standard

from "rl_utils.tern" import clip_reward;

fn main() -> trit {
    let novelty_score: float = 0.8;
    let prediction_error: float = 0.4;
    
    let bonus1: trit = clip_reward(novelty_score - 0.5);
    let bonus2: trit = clip_reward(prediction_error - 0.2);
    
    // Consensus bonus
    let final_bonus: trit = consensus(bonus1, bonus2);
    
    match final_bonus {
        -1 => { return hold(); }      // No curiosity
         0 => { return hold(); }      // Weak curiosity
         1 => { return truth(); }     // Strong curiosity (Explore)
    }
}
