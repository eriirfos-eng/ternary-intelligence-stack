// stdlib/rl/experience_prioritization.tern
// Demonstrates: Prioritized Experience Replay (PER) importance sampling
// Tier: 2

from "rl_utils.tern" import *;

fn calculate_priority(td_error: float, threshold: float) -> trit {
    // If error is high, prioritize (+1). If low, hold (0). If negligible, reject (-1).
    if td_error > threshold ? {
        return affirm;
    } else {
        if td_error > (threshold * 0.5) ? {
            return tend;
        } else {
            return reject;
        } else {
            return reject;
        }
    } else {
        return reject;
    }
}

fn main() -> trit {
    let err: float = 0.8;
    let thresh: float = 0.5;
    
    let priority: trit = calculate_priority(err, thresh);
    
    match priority {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
