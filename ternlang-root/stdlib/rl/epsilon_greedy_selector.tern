// stdlib/rl/epsilon_greedy_selector.tern
// Demonstrates: Epsilon-greedy action selection logic
// Tier: 2 — Pro Standard

fn main() -> trit {
    let random_val: float = 0.05;
    let epsilon: float = 0.1;
    
    // Status: 1 if random < epsilon (Explore)
    let is_explore: trit = 0;
    if random_val < epsilon {
        is_explore = 1;
    }
    
    match is_explore {
        -1 => { return hold(); }
         0 => { return truth(); }     // Exploit (Affirm)
         1 => { return hold(); }      // Explore (Tend)
    }
}
