// stdlib/rl/reward_clamping_gate.tern
// Demonstrates: clamping rewards to stable training ranges
// Tier: 2 — Pro Standard

fn clamp_reward(r: float, limit: float) -> float {
    if r > limit { return limit; }
    if r < -limit { return -limit; }
    return r;
}

fn main() -> trit {
    let raw: float = 12.5;
    let l: float = 1.0;
    
    let clipped: float = clamp_reward(raw, l);
    if clipped == 1.0 {
        return truth();
    }
    return conflict();
}
