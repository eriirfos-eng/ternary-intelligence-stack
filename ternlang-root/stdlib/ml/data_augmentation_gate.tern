// stdlib/ml/data_augmentation_gate.tern
// Demonstrates: Gating data augmentation based on sample difficulty
// Tier: 2 — Pro Standard

from "ml_utils.tern" import clip_signal;

fn main() -> trit {
    let loss_per_sample: float = 2.5;
    let high_loss_threshold: float = 2.0;
    
    // Status: 1 if loss is high (hard sample) -> augment
    let needs_augmentation: trit = clip_signal(loss_per_sample, high_loss_threshold);
    
    match needs_augmentation {
        -1 => { return hold(); }      // Very low loss (Skip)
         0 => { return hold(); }      // Moderate loss
         1 => { return truth(); }     // High loss (Augment)
    }
}
