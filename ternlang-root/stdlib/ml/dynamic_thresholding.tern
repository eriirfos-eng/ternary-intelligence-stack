// stdlib/ml/dynamic_thresholding.tern
// Demonstrates: Adaptive Threshold for Weight Ternarization
// Tier: 2 — Pro Standard

// adaptive_ternarize: Converts a float value to a trit based on a dynamic threshold.
// threshold = k * mean(|W|)
fn adaptive_ternarize(val: float, threshold: float) -> trit {
    if val > threshold {
        return 1;
    }
    
    let neg_threshold: float = 0.0 - threshold;
    if val < neg_threshold {
        return -1;
    }
    
    return 0; // Hold (tend)
}

// compute_threshold_consensus: Aggregates thresholds from multiple learners.
fn compute_threshold_consensus(t1: float, t2: float) -> float {
    // If t1 and t2 differ significantly, use the more conservative (higher) one.
    if t1 > t2 {
        return t1;
    }
    return t2;
}

fn main() -> trit {
    let weight: float = 0.4;
    let t: float = 0.5;
    
    // weight (0.4) < threshold (0.5), should return 0.
    let res: trit = adaptive_ternarize(weight, t);
    
    match res {
        -1 => { return conflict(); }
         0 => { return truth(); } // Pass test
         1 => { return conflict(); }
    }
}
