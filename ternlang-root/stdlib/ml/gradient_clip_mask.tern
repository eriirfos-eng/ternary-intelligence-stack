// stdlib/ml/gradient_clip_mask.tern
// Demonstrates: preventing exploding gradients by clipping to a range
// Tier: 2 — Pro Standard

fn clip_gradient(grad: float, limit: float) -> float {
    if grad > limit { return limit; }
    if grad < -limit { return -limit; }
    return grad;
}

fn main() -> trit {
    let g: float = 100.5;
    let l: float = 5.0;
    
    let clipped: float = clip_gradient(g, l);
    if clipped == 5.0 {
        return truth();
    }
    return conflict();
}
