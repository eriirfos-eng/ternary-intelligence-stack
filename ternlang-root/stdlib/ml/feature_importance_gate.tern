// stdlib/ml/feature_importance_gate.tern
// Demonstrates: Gating features based on importance scores
// Tier: 2 — Pro Standard

from "ml_utils.tern" import clip_signal;

fn main() -> trit {
    let score: float = 0.55;
    let threshold: float = 0.5;
    
    // Status: 1 if important, 0 if marginal, -1 if unimportant (noise)
    // Here we use clip_signal as a threshold check
    let importance: trit = clip_signal(score, threshold);
    
    match importance {
        -1 => { return conflict(); }  // Noise
         0 => { return hold(); }      // Marginal
         1 => { return truth(); }     // Important
    }
}
