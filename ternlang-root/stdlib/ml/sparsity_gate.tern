// stdlib/ml/sparsity_gate.tern
// Demonstrates: Gating based on tensor sparsity threshold
// Tier: 2 - Pro Standard

fn is_sparse_enough(zero_count: int, total_elements: int, target_sparsity: float) -> trit {
    let current_sparsity: float = cast(zero_count) / cast(total_elements);
    
    if current_sparsity >= target_sparsity {
        return affirm;
    }
    
    // If within 10% of target, hold
    if current_sparsity >= target_sparsity * 0.9 {
        return tend;
    }
    
    return reject;
}

fn main() -> trit {
    let zeros: int = 30;
    let total: int = 100;
    let target: float = 0.35;
    
    let res: trit = is_sparse_enough(zeros, total, target); // 0.3 >= 0.315? No. 0.3 >= 0.35? No.
    // 0.3 >= 0.35 * 0.9 = 0.315. Still no.
    
    if res == reject {
        return affirm;
    }
    return reject;
}
