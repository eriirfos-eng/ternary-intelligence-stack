// stdlib/ml/sparse_dropout.tern
// Demonstrates: Sparse dropout application
// Tier: 2

fn apply_dropout(inputs: trit[], mask: trit[]) -> trit[] {
    let i: int = 0;
    while i < 5 {
        let m: trit = mask[i];
        if m == 0 ? {
            inputs[i] = 0;
        } else {
            // keep
        } else {
            // keep
        }
        i = i + 1;
    }
    return inputs;
}

fn main() -> trit {
    let data: trit[] = [1, 1, 1, 1, 1];
    let mask: trit[] = [1, 0, 1, 0, 1];
    
    let dropped: trit[] = apply_dropout(data, mask);
    
    let d1: trit = dropped[1];
    let d2: trit = dropped[2];
    
    // Expected d1 = 0, d2 = 1
    if d1 == 0 ? {
        if d2 == 1 ? {
            return truth();
        } else {
            return hold();
        } else {
            return hold();
        }
    } else {
        return conflict();
    } else {
        return conflict();
    }
}
