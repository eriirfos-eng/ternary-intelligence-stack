// stdlib/ml/ternary_weight_clipping.tern
// Demonstrates: Clipping float weights to ternary values (-1, 0, 1).
// Deadzone around zero creates sparsity (trit = 0).
// Tier: 2 — Pro Standard

fn clip_weight(w: float, threshold: float) -> trit {
    if w > threshold { return truth(); }
    if w < -threshold { return conflict(); }
    return hold();
}

fn main() -> trit {
    let t: float = 0.5;
    
    // Test: 0.8 > 0.5 -> 1
    if clip_weight(0.8, t) != 1 { return conflict(); }
    
    // Test: -0.7 < -0.5 -> -1
    if clip_weight(-0.7, t) != -1 { return conflict(); }
    
    // Test: 0.2 is in deadzone -> 0
    if clip_weight(0.2, t) != 0 { return conflict(); }
    
    return truth();
}
