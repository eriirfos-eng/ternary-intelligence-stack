// stdlib/ml/weight_decay_mask.tern
// Demonstrates: Applying a mask based on weight magnitude
// Tier: 2 — Pro Standard

from "ml_utils.tern" import clip_signal;

fn main() -> trit {
    let weight: float = 0.0001;
    let lambda: float = 0.001;
    
    // Status: 0 if weight is small (near zero), 1 if large
    let mask: trit = clip_signal(weight, lambda);
    
    match mask {
        -1 => { return truth(); }     // Negative large
         0 => { return hold(); }      // Decay region
         1 => { return truth(); }     // Positive large
    }
}
