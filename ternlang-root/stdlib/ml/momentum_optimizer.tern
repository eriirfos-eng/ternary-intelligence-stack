// stdlib/ml/momentum_optimizer.tern
// Demonstrates: Momentum-based optimization update logic
// Tier: 2

from "ml_utils.tern" import *;

fn momentum_update(grad: trit, velocity: trit) -> trit {
    // Logic: if gradient and velocity align, affirm the direction.
    // If they conflict, hold or tend.
    match grad {
        affirm => {
            match velocity {
                affirm => { return affirm; }
                tend   => { return affirm; }
                reject => { return tend; }
            }
        }
        tend => {
            return velocity;
        }
        reject => {
            match velocity {
                affirm => { return tend; }
                tend   => { return reject; }
                reject => { return reject; }
            }
        }
    }
}

fn main() -> trit {
    let g: trit = affirm;
    let v: trit = tend;
    let update: trit = momentum_update(g, v);
    
    match update {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
