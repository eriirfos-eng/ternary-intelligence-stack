// stdlib/ml/ml_utils.tern
// Demonstrates: Reusable utilities for ML modules
// Tier: 2 — Pro Standard

// Evaluates a loss signal: 1 (increasing), 0 (stable), -1 (decreasing/improving)
fn eval_loss_delta(current: float, previous: float) -> trit {
    if current > previous {
        return 1;
    }
    if current < previous {
        return -1;
    }
    return 0;
}

// Clips a signal based on a threshold
fn clip_signal(val: float, threshold: float) -> trit {
    if val > threshold {
        return 1;
    }
    if val < (0.0 - threshold) {
        return -1;
    }
    return 0;
}

// Aggregates multiple training signals into a consensus
fn train_consensus(s1: trit, s2: trit, s3: trit) -> trit {
    let c1: trit = consensus(s1, s2);
    return consensus(c1, s3);
}

fn main() -> trit {
    let d: trit = eval_loss_delta(0.5, 0.6); // -1 (improving)
    match d {
        -1 => { return truth(); }
         0 => { return hold(); }
         1 => { return conflict(); }
    }
}
