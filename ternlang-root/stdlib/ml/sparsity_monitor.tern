// stdlib/ml/sparsity_monitor.tern
// Demonstrates: Real-time Sparsity Monitoring logic
// Tier: 2 — Pro Standard

// monitor_sparsity: Checks if a layer's output is becoming too dense.
// If sparsity (ratio of zeros) drops below threshold, return warning (-1).
fn monitor_sparsity(zero_count: int, total_count: int, target_sparsity: float) -> trit {
    // Workaround: Use intermediate variables for cast() calls
    let z: float = cast(zero_count);
    let t: float = cast(total_count);
    let s: float = z / t;
    
    if s < target_sparsity {
        return -1; // Too dense (alert)
    }
    
    return 1; // Optimal
}

// aggregate_sparsity: Consensus between multiple layer monitors.
fn aggregate_sparsity(m1: trit, m2: trit) -> trit {
    let res: trit = consensus(m1, m2);
    match res {
        -1 => { return -1; }
         0 => { return 0; }
         1 => { return 1; }
    }
}

fn main() -> trit {
    let zeros: int = 50;
    let total: int = 100;
    let target: float = 0.6;
    
    // 50/100 = 0.5. 0.5 < 0.6. Should return -1 (too dense).
    let status: trit = monitor_sparsity(zeros, total, target);
    
    match status {
        -1 => { return truth(); } // Pass test
         0 => { return hold(); }
         1 => { return conflict(); }
    }
}
