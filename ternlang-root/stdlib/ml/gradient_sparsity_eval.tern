// stdlib/ml/gradient_sparsity_eval.tern
// Demonstrates: Evaluating gradient sparsity for @sparseskip optimization
// Tier: 2 — Pro Standard

from "ml_utils.tern" import clip_signal;

fn main() -> trit {
    let grad: float = 0.00001;
    let epsilon: float = 0.0001;
    
    // Evaluate if gradient is effectively zero
    let is_sparse: trit = clip_signal(grad, epsilon);
    
    match is_sparse {
        -1 => { return truth(); }     // Significant negative
         0 => { return hold(); }      // Effectively sparse (Zero)
         1 => { return truth(); }     // Significant positive
    }
}
