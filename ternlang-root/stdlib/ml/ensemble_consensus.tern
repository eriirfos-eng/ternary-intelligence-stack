// stdlib/ml/ensemble_consensus.tern
// Demonstrates: Multi-model Ensemble Consensus logic
// Tier: 2 — Pro Standard

// ensemble_consensus: Combines outputs from three diverse models via majority rule.
// If all three differ or no majority exists, returns 'tend' (0).
fn ensemble_consensus(m1: trit, m2: trit, m3: trit) -> trit {
    let c12: trit = consensus(m1, m2);
    
    match c12 {
        -1 => { 
            // Models 1 and 2 agree on rejection.
            return -1; 
        }
         0 => {
            // Models 1 and 2 differ. Check if model 3 matches either for a majority.
            if m3 == m1 { return m1; }
            if m3 == m2 { return m2; }
            return 0; // Deadlock
        }
         1 => { 
            // Models 1 and 2 agree on affirmation.
            return 1; 
        }
    }
}

// weighted_ensemble: Gathers signal only if a model meets a confidence threshold.
fn weighted_ensemble(m: trit, confidence: float) -> trit {
    if confidence < 0.7 {
        return 0; // Suppress low-confidence expert
    }
    return m;
}

fn main() -> trit {
    let m1: trit = 1;
    let m2: trit = 0;
    let m3: trit = 1;
    
    // Models 1 and 3 agree on Affirm (1). Final consensus should be 1.
    let winner: trit = ensemble_consensus(m1, m2, m3);
    
    match winner {
        1 => { return truth(); } // Pass test: Ensemble winner identified
        0 => { return hold(); }
        -1 => { return conflict(); }
    }
}
