// stdlib/bio/ternary_dna_match_test.tern
// Demonstrates: Ternary logic for DNA sequence alignment.
// Maps base matches to affirm, mismatches to reject, 
// and uncertainty (e.g. unknown base 'N') to tend.
// Tier: 3 — Industrial

fn dna_match(base1: trit, base2: trit) -> trit {
    if base1 == 0 { return tend; }
    if base2 == 0 { return tend; }
    if base1 == base2 { return affirm; }
    return reject;
}

fn main() -> trit {
    // Perfect match (A-A)
    if dna_match(1, 1) != 1 { return -1; }

    // Mismatch (A-G)
    if dna_match(1, -1) != -1 { return -1; }

    // Uncertain match (A-N)
    if dna_match(1, 0) != 0 { return -1; }

    // Double uncertainty (N-N)
    if dna_match(0, 0) != 0 { return -1; }

    return 1;
}
