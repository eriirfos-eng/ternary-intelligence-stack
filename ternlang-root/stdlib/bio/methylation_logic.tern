// stdlib/bio/methylation_logic.tern
// Demonstrates: Ternary logic for genomic methylation calls.
// Tier: 3 — Industrial
// DNA methylation is a biochemical process where methyl groups are added to DNA.
// In epigenetic sequencing, a CpG site can be classified into three states:
// - Methylated (+1): High signal, high confidence.
// - Unmethylated (-1): Low signal, high confidence.
// - Ambiguous (0): Intermediate signal or low quality — requires hold/re-seq.

fn call_methylation(signal_intensity: float, quality_score: float) -> trit {
    // Hard quality gate: if quality is low, we cannot make a call.
    if quality_score < 0.7 {
        return tend; // ESCALATE: Request more evidence (secondary pass)
    }
    
    // Decision based on bimodal intensity distribution
    if signal_intensity > 0.8 {
        return affirm; // Methylated
    }
    
    if signal_intensity < 0.2 {
        return reject; // Unmethylated
    }
    
    return tend; // Ambiguous state: might be partially methylated or noisy
}

fn main() -> trit {
    // Case 1: High quality methylated site
    if call_methylation(0.9, 0.95) != affirm { return reject; }
    
    // Case 2: High quality unmethylated site
    if call_methylation(0.05, 0.8) != reject { return reject; }
    
    // Case 3: Low quality triggers hold regardless of intensity
    if call_methylation(0.85, 0.4) != tend   { return reject; }
    
    // Case 4: Ambiguous intensity triggers hold
    if call_methylation(0.5, 0.9)  != tend   { return reject; }
    
    return affirm;
}
