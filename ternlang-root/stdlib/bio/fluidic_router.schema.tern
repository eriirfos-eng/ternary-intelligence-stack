// Module:  stdlib/bio/fluidic_router.schema.tern
// Purpose: T-SON serialization schema for fluidic_router
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Fluidic_routerSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Fluidic_routerSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
