// stdlib/bio/sequence_alignment.tern
// Demonstrates: Ternary logic for sequence_alignment
// Tier: 3

fn sequence_alignment_process(a: trit, b: trit) -> trit {
    let state: trit = consensus(a, b);
    match state {
        -1 => { return conflict(); }
         0 => { return hold(); }
         1 => { return truth(); }
    }
}

fn main() -> trit {
    let val1: trit = 1;
    let val2: trit = 0;
    let res: trit = sequence_alignment_process(val1, val2);
    return truth();
}
