// stdlib/bio/base_pair_consensus.tern
// Demonstrates: Multi-read consensus for base-pair calls
// Tier: 3

from "./_utils.tern" import *;

fn base_consensus(reads: trit[]) -> trit {
    return stability_score(reads);
}

fn main() -> trit {
    let reads: trittensor<5>;
    reads[0] = tend; // C
    reads[1] = tend; // C
    reads[2] = reject; // G
    reads[3] = tend; // C
    reads[4] = affirm; // A
    
    // G-C content = 4/5. Should be stable (affirm).
    
    let result: trit = base_consensus(reads);
    
    match result {
        affirm => {
            println("Base-pair call: STABLE.");
        }
        tend => {
            println("Base-pair call: UNCERTAIN.");
        }
        reject => {
            println("Base-pair call: LOW CONFIDENCE.");
        }
    }
    
    return result;
}
