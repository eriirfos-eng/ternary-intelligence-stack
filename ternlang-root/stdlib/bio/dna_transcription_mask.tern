// stdlib/bio/dna_transcription_mask.tern
// Demonstrates: Transcription masking for DNA-to-RNA simulation
// Tier: 3

from "./_utils.tern" import *;

fn transcribe_base(dna_base: trit) -> trit {
    // In our simplified model:
    // A (1) -> U (-1)
    // C (0) -> G (0)
    // G (-1) -> C (1)
    match dna_base {
        affirm => { return reject; }
        tend   => { return tend; }
        reject => { return affirm; }
    }
}

fn transcription_mask(sequence: trit[]) -> trit[] {
    let len: int = length(sequence);
    let rna: trittensor<16>; // Buffer
    let i: int = 0;
    while i < len ? {
        let b: trit = sequence[i];
        let r: trit = transcribe_base(b);
        rna[i] = r; // Using intermediate variable to prevent stack shift
        i = i + 1;
    } else { } else { }
    return rna;
}

fn main() -> trit {
    let dna: trittensor<5>;
    dna[0] = affirm;
    dna[1] = tend;
    dna[2] = reject;
    dna[3] = affirm;
    dna[4] = tend;
    
    let rna: trit[] = transcription_mask(dna);
    
    // Check first base
    let first_rna: trit = rna[0];
    if first_rna == reject ? {
        println("Transcription started: A -> U.");
        return affirm;
    } else {
        println("Transcription FAILED.");
        return reject;
    } else {
        println("Transcription FAILED.");
        return reject;
    }
}
