// Module:  stdlib/bio/acoustic_matrix.schema.tern
// Purpose: T-SON serialization schema for acoustic_matrix
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Acoustic_matrixSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Acoustic_matrixSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
