// stdlib/ensemble/confidence_weighted_pooling.tern
// Demonstrates: Weighted pooling based on model confidence
// Tier: 2

fn pool_weighted(p1: trit, c1: float, p2: trit, c2: float) -> trit {
    let total_certainty: float = 0.0;
    
    match p1 {
        affirm => { total_certainty = total_certainty + c1; }
        reject => { total_certainty = total_certainty - c1; }
        tend   => { let _h: trit = hold(); }
    }
    
    match p2 {
        affirm => { total_certainty = total_certainty + c2; }
        reject => { total_certainty = total_certainty - c2; }
        tend   => { let _h: trit = hold(); }
    }
    
    if total_certainty > 0.3 { return affirm; }
    if total_certainty < -0.3 { return reject; }
    return tend;
}

fn main() -> trit {
    let result: trit = pool_weighted(affirm, 0.8, reject, 0.2); // affirm wins
    match result {
        affirm => { return truth();   }
        tend   => { return hold();    }
        reject => { return conflict(); }
    }
}
