// stdlib/ensemble/diversity_mask.tern
// Demonstrates: Diversity masking for ensemble learning
// Tier: 2

from "ensemble_utils.tern" import *;

fn diversity_gate(experts: trit[]) -> trit {
    // Logic: if all experts agree, diversity is low (+1).
    // If they disagree, diversity is high (-1).
    let first: trit = experts[0];
    let i: int = 1;
    let len: int = length(experts);
    
    while i < len {
        if experts[i] != first ? {
            return reject; // High diversity (disagreement)
        } else {} else {}
        i = i + 1;
    }
    return affirm; // Low diversity (unanimous)
}

fn main() -> trit {
    let experts: trit[] = [1, 1, 1, 1];
    let res: trit = diversity_gate(experts);
    
    match res {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
