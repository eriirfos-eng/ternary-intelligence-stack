// stdlib/ensemble/rank_aggregation.tern
// Demonstrates: rank aggregation from multiple expert signals
// Tier: 2 — Pro Standard

fn majority(a: trit, b: trit, c: trit) -> trit {
    let count: int = 0;
    if a == truth() { count = count + 1; }
    if a == conflict() { count = count - 1; }
    
    if b == truth() { count = count + 1; }
    if b == conflict() { count = count - 1; }
    
    if c == truth() { count = count + 1; }
    if c == conflict() { count = count - 1; }
    
    if count > 0 { return truth(); }
    if count < 0 { return conflict(); }
    return hold();
}

fn aggregate_ranks(expert1: trit[], expert2: trit[], expert3: trit[]) -> trittensor<6> {
    let n: int = length(expert1);
    let res: trittensor<6>;
    
    let i: int = 0;
    while i < n {
        let e1: trit = expert1[i];
        let e2: trit = expert2[i];
        let e3: trit = expert3[i];
        
        // Simple majority vote for each rank position
        let v: trit = majority(e1, e2, e3);
        res[i] = v;
        i = i + 1;
    }
    
    return res;
}

fn main() -> trit {
    let e1: trit[] = [1, 1, 0, 0, -1, -1];
    let e2: trit[] = [1, 0, 1, 0, -1, 0];
    let e3: trit[] = [0, 1, 1, -1, -1, 1];
    
    let consensus: trittensor<6> = aggregate_ranks(e1, e2, e3);
    
    // consensus[0] should be 1 (two 1s)
    if consensus[0] == truth() {
        return truth();
    }
    
    return conflict();
}
