// stdlib/ensemble/weighted_consensus_mask.tern
// Demonstrates: Weighted voting between primary and secondary experts
// Tier: 2 — Pro Standard

from "ensemble_utils.tern" import weighted_vote;

fn main() -> trit {
    let expert_main: trit = 1;
    let weight_main: float = 0.8;
    let expert_sub: trit = -1;
    let weight_sub: float = 0.2;
    
    // Status: should follow expert_main due to higher weight
    let final_decision: trit = weighted_vote(expert_main, weight_main, expert_sub, weight_sub);
    
    match final_decision {
        -1 => { return conflict(); }  // Primary Reject
         0 => { return hold(); }      // Split/Uncertain
         1 => { return truth(); }     // Primary Affirm
    }
}
