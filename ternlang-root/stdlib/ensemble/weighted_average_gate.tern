// stdlib/ensemble/weighted_average_gate.tern
// Demonstrates: Weighted average ensemble of 3 signals
// Tier: 2

fn ensemble_avg(s1: trit, w1: float, s2: trit, w2: float, s3: trit, w3: float) -> trit {
    let sum: float = 0.0;
    
    match s1 {
        affirm => { sum = sum + w1; }
        reject => { sum = sum - w1; }
        tend   => { let _h: trit = hold(); }
    }
    
    match s2 {
        affirm => { sum = sum + w2; }
        reject => { sum = sum - w2; }
        tend   => { let _h: trit = hold(); }
    }
    
    match s3 {
        affirm => { sum = sum + w3; }
        reject => { sum = sum - w3; }
        tend   => { let _h: trit = hold(); }
    }
    
    if sum > 0.5 { return affirm; }
    if sum < -0.5 { return reject; }
    return tend;
}

fn main() -> trit {
    let result: trit = ensemble_avg(affirm, 0.6, reject, 0.2, tend, 0.2);
    match result {
        reject => { return conflict(); }
        tend   => { return hold();    }
        affirm => { return truth();   }
    }
}
