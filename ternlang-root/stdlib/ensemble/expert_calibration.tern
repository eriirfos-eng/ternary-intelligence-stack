// stdlib/ensemble/expert_calibration.tern
// Demonstrates: weighted consensus using individual expert weights
// Tier: 2 — Pro Standard

fn weighted_consensus_3(s1: trit, s2: trit, s3: trit, w1: float, w2: float, w3: float) -> trit {
    let weighted_sum: float = 0.0;
    
    match s1 { 1 => { weighted_sum = weighted_sum + w1; } -1 => { weighted_sum = weighted_sum - w1; } 0 => { } }
    match s2 { 1 => { weighted_sum = weighted_sum + w2; } -1 => { weighted_sum = weighted_sum - w2; } 0 => { } }
    match s3 { 1 => { weighted_sum = weighted_sum + w3; } -1 => { weighted_sum = weighted_sum - w3; } 0 => { } }
    
    if weighted_sum > 0.5 { return truth(); }
    if weighted_sum < -0.5 { return conflict(); }
    return hold();
}

fn main() -> trit {
    let s1: trit = 1;
    let s2: trit = -1;
    let s3: trit = 1;
    let w1: float = 0.8;
    let w2: float = 0.2;
    let w3: float = 0.9;
    
    let result: trit = weighted_consensus_3(s1, s2, s3, w1, w2, w3);
    
    if result == truth() {
        return truth();
    }
    
    return conflict();
}
