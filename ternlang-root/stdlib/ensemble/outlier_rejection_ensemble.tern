// stdlib/ensemble/outlier_rejection_ensemble.tern
// Demonstrates: Rejecting ensemble members that deviate significantly
// Tier: 2

fn reject_outliers(consensus: trit, member_a: trit, member_b: trit) -> trit {
    // If consensus is certain, members that disagree are outliers.
    if consensus != tend {
        if member_a != consensus && member_a != tend {
            // member_a is an outlier
            return member_b;
        }
        if member_b != consensus && member_b != tend {
            // member_b is an outlier
            return member_a;
        }
    }
    
    // Default to the original consensus if no clear outliers or both are outliers
    return consensus;
}

fn main() -> trit {
    let r1: trit = reject_outliers(affirm, affirm, reject); // reject is outlier
    let r2: trit = reject_outliers(affirm, tend, affirm);   // tend is not outlier
    
    if r1 == affirm && r2 == affirm {
        return truth();
    }
    return conflict();
}
