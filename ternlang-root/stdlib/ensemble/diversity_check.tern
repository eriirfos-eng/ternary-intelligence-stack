// stdlib/ensemble/diversity_check.tern
// Demonstrates: Measure diversity (disagreement) in an ensemble
// Tier: 2

fn check_diversity(s1: trit, s2: trit, s3: trit) -> trit {
    // If all are the same, diversity is low (reject)
    // If all are different, diversity is high (affirm)
    if s1 == s2 && s2 == s3 {
        return reject;
    }
    
    if s1 != s2 && s2 != s3 && s1 != s3 {
        return affirm;
    }
    
    return tend;
}

fn main() -> trit {
    let div: trit = check_diversity(affirm, reject, tend);
    match div {
        reject => { return conflict(); }
        tend   => { return hold();    }
        affirm => { return truth();   }
    }
}
