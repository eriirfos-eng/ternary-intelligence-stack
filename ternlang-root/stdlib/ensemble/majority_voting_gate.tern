// stdlib/ensemble/majority_voting_gate.tern
// Demonstrates: Majority voting gate across three expert agents
// Tier: 2 — Pro Standard

fn main() -> trit {
    let expert1: trit = 1;  // Affirm
    let expert2: trit = 1;  // Affirm
    let expert3: trit = -1; // Reject
    
    // Majority vote using consensus chain
    let final_vote: trit = consensus(consensus(expert1, expert2), expert3);
    
    match final_vote {
        -1 => { return conflict(); }  // Majority Reject
         0 => { return hold(); }      // No majority/Split
         1 => { return truth(); }     // Majority Affirm
    }
}
