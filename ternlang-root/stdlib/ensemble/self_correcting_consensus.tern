// stdlib/ensemble/self_correcting_consensus.tern
// Demonstrates: A consensus mechanism that self-corrects weights over time
// Tier: 2

fn correct_weights(old_weight: float, pred: trit, actual: trit) -> float {
    // If prediction matches actual, increase weight
    if pred == actual {
        if old_weight < 1.0 {
            return old_weight + 0.05;
        }
    }
    
    // If prediction conflicts with actual, decrease weight
    if pred != tend && actual != tend {
        if pred != actual {
            if old_weight > 0.0 {
                return old_weight - 0.1;
            }
        }
    }
    
    return old_weight;
}

fn main() -> trit {
    let w: float = 0.5;
    let new_w: float = correct_weights(w, affirm, affirm); // Correct pred: 0.55
    let bad_w: float = correct_weights(w, affirm, reject); // Bad pred: 0.4
    
    if new_w > 0.5 && bad_w < 0.5 {
        return truth();
    }
    return conflict();
}
