// stdlib/ensemble/expert_conflict_detector.tern
// Demonstrates: Detecting direct conflict between expert agents
// Tier: 2 — Pro Standard

fn main() -> trit {
    let expert1: trit = 1;
    let expert2: trit = -1;
    
    // Consensus returns 0 (hold) if signals are in direct conflict
    let status: trit = consensus(expert1, expert2);
    
    match status {
        -1 => { return hold(); }      // No conflict
         0 => { return conflict(); }  // Direct conflict (Reject)
         1 => { return hold(); }      // No conflict
    }
}
