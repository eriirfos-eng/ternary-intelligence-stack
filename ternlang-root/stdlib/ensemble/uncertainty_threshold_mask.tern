// stdlib/ensemble/uncertainty_threshold_mask.tern
// Demonstrates: Masking ensemble predictions with high uncertainty (tend states)
// Tier: 2 — Pro Standard

fn main() -> trit {
    let expert1: trit = 0; // Unsure
    let expert2: trit = 0; // Unsure
    let expert3: trit = 1; // Affirm
    
    // Aggregate uncertainty
    let consensus_val: trit = consensus(consensus(expert1, expert2), expert3);
    
    match consensus_val {
        -1 => { return truth(); }     // Consistent Reject
         0 => { return hold(); }      // High uncertainty (Mask)
         1 => { return truth(); }     // Consistent Affirm
    }
}
