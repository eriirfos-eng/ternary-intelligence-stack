// stdlib/societal/community_trust_gate.tern
// Demonstrates: community trust threshold logic
// Tier: 2

fn main() -> trit {
    // [1, 1, 0] -> trust affirm
    // [-1, -1, 0] -> trust reject
    
    let scores: trit[] = [1, 1, 0];
    
    // Logic: if more affirm than reject, return 1
    // if equal, return 0
    // else return -1
    
    let balance: int = 0;
    for s in scores {
        match s {
            1 => { balance = balance + 1; }
            0 => { balance = balance + 0; }
            -1 => { balance = balance - 1; }
        }
    }
    
    if balance > 0 {
        return 1;
    } else {
        if balance == 0 {
            return 0;
        } else {
            return -1;
        }
    }
}
