// stdlib/societal/welfare_allocator.tern
// Demonstrates: resource allocation based on need levels
// Tier: 2 — Pro Standard

fn allocate(need: trit) -> float {
    match need {
        1 => { return 100.0; } // High need: max allocation
        0 => { return 50.0;  } // Moderate need: half allocation
       -1 => { return 0.0;   } // No need: zero allocation
    }
}

fn main() -> trit {
    let r1: float = allocate(1);
    let r2: float = allocate(0);
    let r3: float = allocate(-1);
    
    if r1 == 100.0 && r2 == 50.0 && r3 == 0.0 {
        return truth();
    }
    
    match cast(r1) {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
