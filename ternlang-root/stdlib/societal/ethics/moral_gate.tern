// stdlib/societal/ethics/moral_gate.tern
// Demonstrates: ethical veto gate for decision making
// Tier: 2 — Pro Standard

fn evaluate_ethics(action_impact: float) -> trit {
    if action_impact < -0.5 { return conflict(); } // harmful
    if action_impact > 0.5  { return truth();    } // beneficial
    return hold(); // neutral or uncertain
}

fn decision_gate(is_profitable: trit, is_ethical: trit) -> trit {
    // Ethics is a hard gate — cannot proceed if conflict
    match is_ethical {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return is_profitable; }
    }
}

fn main() -> trit {
    let profit: trit = 1;
    let impact: float = -0.8;
    
    let ethical: trit = evaluate_ethics(impact);
    let decision: trit = decision_gate(profit, ethical);
    
    // Impact is -0.8 -> ethical is -1 -> decision is -1
    if decision == -1 {
        return truth();
    }
    
    match decision {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
