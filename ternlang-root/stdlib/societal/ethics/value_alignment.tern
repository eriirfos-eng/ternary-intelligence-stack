// stdlib/societal/ethics/value_alignment.tern
// Demonstrates: alignment check between proposal and core values
// Tier: 2 — Pro Standard

fn alignment_check(core_values: trit[], proposal: trit[]) -> trit {
    let match_count: int = 0;
    let conflict_count: int = 0;
    
    // Assume same length
    let i: int = 0;
    while i < 3 {
        let v: trit = core_values[i];
        let p: trit = proposal[i];
        
        if v == p && v != 0 {
            match_count = match_count + 1;
        }
        if v == -p && v != 0 {
            conflict_count = conflict_count + 1;
        }
        i = i + 1;
    }
    
    if conflict_count > 0 { return conflict(); }
    if match_count >= 2  { return truth();    }
    return hold();
}

fn main() -> trit {
    let core: trit[] = [1, 1, 0];
    let prop: trit[] = [1, 1, 0]; // aligns (2 matches, 0 conflict)
    
    let result: trit = alignment_check(core, prop);
    
    if result == 1 {
        return truth();
    }
    
    match result {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
