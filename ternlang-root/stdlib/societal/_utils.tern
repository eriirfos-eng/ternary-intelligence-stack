// stdlib/societal/_utils.tern
// Utility functions for Societal systems
// Tier: 2

fn calculate_gini_trit(shares: int[]) -> trit {
    // Simplified Gini: check if max share is > 3x min share
    let count: int = length(shares);
    let min_v: int = 1000000;
    let max_v: int = 0;
    let i: int = 0;
    
    while i < count ? {
        let v: int = shares[i];
        if v > max_v ? { max_v = v; } else { } else { }
        if v < min_v ? { min_v = v; } else { } else { }
        i = i + 1;
    } else { } else { }
    
    if max_v > (min_v * 3) ? {
        return reject; // Unfair
    } else {
        return tend;
    } else {
        // Not unfair (>3x)
        if max_v > (min_v * 2) ? {
            return tend; // Marginal
        } else {
            return tend;
        } else {
            return affirm; // Fair (<2x)
        }
    }
}
