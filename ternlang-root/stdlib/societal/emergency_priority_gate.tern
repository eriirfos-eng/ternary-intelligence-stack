// stdlib/societal/emergency_priority_gate.tern
// Demonstrates: emergency resource prioritization logic
// Tier: 2

fn check_priority(urgency: int, severity: int) -> trit {
    // Urgency and Severity range 1-10
    if urgency >= 8 && severity >= 8 {
        return truth();   // Immediate critical response
    }
    if urgency <= 3 && severity <= 3 {
        return conflict(); // Routine/Low priority
    }
    return hold();        // Standard monitoring needed
}

fn main() -> trit {
    // Life-threatening immediate
    let res1: trit = check_priority(10, 10); // 1
    // Minor administrative
    let res2: trit = check_priority(2, 1);   // -1
    // Urgent but not severe
    let res3: trit = check_priority(7, 4);   // 0

    match res1 {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => {
             match res2 {
                 -1 => {
                     match res3 {
                         -1 => { return conflict(); }
                          0 => { return truth(); }
                          1 => { return conflict(); }
                     }
                 }
                 0 => { return hold(); }
                 1 => { return conflict(); }
             }
         }
    }
}
