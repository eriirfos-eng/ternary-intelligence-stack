// stdlib/societal/reputation_decay_mask.tern
// Demonstrates: Masking reputation scores based on time decay
// Tier: 2

from "./_utils.tern" import *;

fn decay_mask(initial_rep: trit, months_passed: int) -> trit {
    if months_passed > 12 ? {
        // Significant decay
        match initial_rep {
            affirm => { return tend; }
            tend   => { return reject; }
            reject => { return reject; }
        }
    } else {
        return tend;
    } else {
        // Less than 12 months passed
        if months_passed > 6 ? {
            match initial_rep {
                affirm => { return affirm; }
                tend   => { return tend; }
                reject => { return reject; }
            }
        } else {
            return initial_rep;
        } else {
            return initial_rep;
        }
    }
}

fn main() -> trit {
    let rep: trit = affirm;
    let months: int = 15;
    
    let current_rep: trit = decay_mask(rep, months);
    
    match current_rep {
        affirm => {
            println("Reputation remains HIGH.");
        }
        tend => {
            println("Reputation has DECAYED to neutral.");
        }
        reject => {
            println("Reputation has EXPIRED or is negative.");
        }
    }
    
    return current_rep;
}
