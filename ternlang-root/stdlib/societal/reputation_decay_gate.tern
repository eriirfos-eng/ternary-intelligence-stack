// stdlib/societal/reputation_decay_gate.tern
// Demonstrates: reputation score decay logic based on inactivity
// Tier: 2

fn check_decay(last_active_days: int, current_score: float) -> trit {
    if last_active_days > 365 {
        return truth();   // Long-term inactivity (Major decay)
    }
    if last_active_days < 30 {
        return conflict(); // Active (No decay)
    }
    return hold();        // Mid-term inactivity (Minor decay)
}

fn main() -> trit {
    // 2 years inactive
    let res1: trit = check_decay(730, 0.8); // 1
    // Recently active
    let res2: trit = check_decay(5, 0.9);   // -1
    // 3 months inactive
    let res3: trit = check_decay(90, 0.5);  // 0

    match res1 {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => {
             match res2 {
                 -1 => {
                     match res3 {
                         -1 => { return conflict(); }
                          0 => { return truth(); }
                          1 => { return conflict(); }
                     }
                 }
                 0 => { return hold(); }
                 1 => { return conflict(); }
             }
         }
    }
}
