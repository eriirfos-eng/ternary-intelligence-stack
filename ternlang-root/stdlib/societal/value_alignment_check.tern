// stdlib/societal/value_alignment_check.tern
// Demonstrates: checking alignment between agent actions and societal values
// Tier: 2 — Pro Standard

fn is_aligned(action: trit, value_mask: trit) -> trit {
    if action == value_mask { return truth(); }
    if action == 0 { return hold(); }
    return conflict();
}

fn main() -> trit {
    let act: trit = 1;
    let val: trit = -1;
    
    let res: trit = is_aligned(act, val);
    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
