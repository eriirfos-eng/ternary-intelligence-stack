// stdlib/societal/governance/veto_power.tern
// Demonstrates: veto power mechanism in ternary logic
// Tier: 2 — Pro Standard

fn check_veto(votes: trit[]) -> trit {
    for v in votes {
        if v == -1 {
            return conflict(); // Vetoed!
        }
    }
    return truth();
}

fn main() -> trit {
    let votes1: trit[] = [1, 1, 0, 1];
    let votes2: trit[] = [1, -1, 1];
    
    let r1: trit = check_veto(votes1); // 1
    let r2: trit = check_veto(votes2); // -1
    
    if r1 == 1 && r2 == -1 {
        return truth();
    }
    
    match r1 {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
