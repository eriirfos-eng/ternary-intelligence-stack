// stdlib/societal/social_stability_index.tern
// Demonstrates: calculating a social stability index from multi-agent signals
// Tier: 2 — Pro Standard

fn eval_stability(economic: trit, security: trit, trust: trit) -> trit {
    let combined: trit = consensus(economic, consensus(security, trust));
    return combined;
}

fn main() -> trit {
    let e: trit = 1;
    let s: trit = 0;
    let t: trit = 1;
    
    let res: trit = eval_stability(e, s, t);
    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
