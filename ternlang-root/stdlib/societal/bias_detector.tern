// stdlib/societal/bias_detector.tern
// Demonstrates: Consensus-based Bias Detection logic
// Tier: 2 — Pro Standard

// detect_bias: Compares a prediction against a known fair baseline.
// If the prediction significantly conflicts with the fair baseline, return bias alert (-1).
fn detect_bias(prediction: trit, baseline: trit, confidence: float) -> trit {
    if confidence < 0.6 {
        return 0; // Insufficient data to reliably detect bias
    }
    
    let comparison: trit = consensus(prediction, baseline);
    
    match comparison {
        -1 => { 
            // Both agree on rejection - likely unbiased within this scope.
            return 1; 
        }
         0 => {
            // Conflict between prediction and fair baseline - bias suspected.
            return -1; // Bias alert
        }
         1 => {
            // Both agree on affirmation - likely unbiased within this scope.
            return 1;
        }
    }
}

// aggregate_bias_status: Merges bias alerts from three independent auditors.
fn aggregate_bias_status(a1: trit, a2: trit, a3: trit) -> trit {
    let c12: trit = consensus(a1, a2);
    let final_c: trit = consensus(c12, a3);
    
    match final_c {
        -1 => { return -1; }
         0 => { return 0; }
         1 => { return 1; }
    }
}

fn main() -> trit {
    let p: trit = 1;
    let b: trit = -1;
    let conf: float = 0.8;
    
    // Prediction (1) conflicts with Fair Baseline (-1). Should return -1 (Bias alert).
    let status: trit = detect_bias(p, b, conf);
    
    match status {
        -1 => { return truth(); } // Pass test: bias alert correctly triggered
         0 => { return hold(); }
         1 => { return conflict(); }
    }
}
