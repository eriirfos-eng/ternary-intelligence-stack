// stdlib/societal/consensus_voting_gate.tern
// Demonstrates: consensus voting logic for decision-making
// Tier: 2

fn evaluate_vote(affirmative: int, negative: int, neutral: int) -> trit {
    let total: int = affirmative + negative + neutral;
    if total == 0 { return hold(); }
    
    // Clear majority (> 60%)
    if affirmative * 10 > total * 6 {
        return truth();
    }
    // Clear rejection (> 60%)
    if negative * 10 > total * 6 {
        return conflict();
    }
    // Stalemate or weak consensus
    return hold();
}

fn main() -> trit {
    // Strong yes
    let res1: trit = evaluate_vote(70, 10, 20); // 1
    // Strong no
    let res2: trit = evaluate_vote(5, 75, 20);  // -1
    // Split
    let res3: trit = evaluate_vote(33, 33, 34); // 0

    match res1 {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => {
             match res2 {
                 -1 => {
                     match res3 {
                         -1 => { return conflict(); }
                          0 => { return truth(); }
                          1 => { return conflict(); }
                     }
                 }
                 0 => { return hold(); }
                 1 => { return conflict(); }
             }
         }
    }
}
