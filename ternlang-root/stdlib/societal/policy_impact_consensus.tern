// stdlib/societal/policy_impact_consensus.tern
// Demonstrates: policy outcome evaluation via metric consensus
// Tier: 2

fn evaluate_policy(metrics: trit[]) -> trit {
    let positive: int = 0;
    let negative: int = 0;
    
    // Manual loop/check for trit array (simple cases)
    if metrics[0] == 1 { positive = positive + 1; }
    if metrics[0] == -1 { negative = negative + 1; }
    if metrics[1] == 1 { positive = positive + 1; }
    if metrics[1] == -1 { negative = negative + 1; }
    if metrics[2] == 1 { positive = positive + 1; }
    if metrics[2] == -1 { negative = negative + 1; }

    if positive > negative {
        return truth();
    }
    if negative > positive {
        return conflict();
    }
    return hold();
}

fn main() -> trit {
    // Mostly positive metrics
    let m1: trit[] = [1, 1, 0];
    let res1: trit = evaluate_policy(m1); // 1
    
    // Mostly negative metrics
    let m2: trit[] = [-1, -1, 1];
    let res2: trit = evaluate_policy(m2); // -1
    
    // Balanced metrics
    let m3: trit[] = [1, -1, 0];
    let res3: trit = evaluate_policy(m3); // 0

    match res1 {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => {
             match res2 {
                 -1 => {
                     match res3 {
                         -1 => { return conflict(); }
                          0 => { return truth(); }
                          1 => { return conflict(); }
                     }
                 }
                 0 => { return hold(); }
                 1 => { return conflict(); }
             }
         }
    }
}
