// stdlib/societal/trust_consensus_mask.tern
// Demonstrates: merging trust signals from multiple peers
// Tier: 2 — Pro Standard

fn aggregate_trust(t1: trit, t2: trit, t3: trit) -> trit {
    return consensus(t1, consensus(t2, t3));
}

fn main() -> trit {
    let t1: trit = 1;
    let t2: trit = 1;
    let t3: trit = 0;
    
    let res: trit = aggregate_trust(t1, t2, t3);
    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
