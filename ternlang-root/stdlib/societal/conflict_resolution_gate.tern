// stdlib/societal/conflict_resolution_gate.tern
// Demonstrates: resolve social conflicts through consensus or cooling-off periods
// Tier: 2 — Pro Standard

fn resolve_conflict(p1: trit, p2: trit, cooling_off: trit) -> trit {
    if p1 == -p2 { 
        if cooling_off == 1 { return hold(); }
        return conflict(); // Irreconcilable
    }
    return consensus(p1, p2);
}

fn main() -> trit {
    let p1: trit = 1;
    let p2: trit = -1;
    let cool: trit = 1;
    
    let res: trit = resolve_conflict(p1, p2, cool);
    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
