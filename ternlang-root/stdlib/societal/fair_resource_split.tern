// stdlib/societal/fair_resource_split.tern
// Demonstrates: splitting a total pool based on participant counts
// Tier: 2

fn allocate(total: float, count: int) -> float {
    if count > 0 {
        return total / count;
    } else {
        return 0.0;
    }
}

fn main() -> trit {
    let pool: float = 1000.0;
    let people: int = 5;
    
    let share: float = allocate(pool, people);
    
    if (share * people) == pool {
        return 1;
    } else {
        // Floating point precision might be an issue, but for simple numbers it should be ok
        return 0;
    }
}
