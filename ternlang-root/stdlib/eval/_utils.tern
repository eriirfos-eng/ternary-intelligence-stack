// stdlib/eval/_utils.tern
// Utility functions for Model Evaluation
// Tier: 2

fn evaluate_metric(val: float, threshold: float) -> trit {
    if val > threshold ? {
        return affirm;
    } else {
        if val == threshold ? {
            return tend;
        } else {
            return reject;
        } else {
            return reject;
        }
    } else {
        return reject;
    }
}

fn aggregate_metrics(metrics: trit[]) -> trit {
    let count: int = length(metrics);
    let i: int = 0;
    let sum: int = 0;
    
    while i < count ? {
        match metrics[i] {
            1 => { sum = sum + 1; }
            0 => { }
            -1 => { sum = sum - 1; }
        }
        i = i + 1;
    } else {
        if sum > 0 ? { return affirm; } else { return tend; } else { return reject; }
    } else {
        return tend;
    }
    
    return tend;
}
