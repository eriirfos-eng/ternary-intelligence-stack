// stdlib/eval/f1_score_consensus.tern
// Demonstrates: combined F1 score evaluation from precision and recall
// Tier: 2 — Pro Standard

fn f1_gate(prec: float, recall: float, target: float) -> trit {
    let f1: float = 2.0 * (prec * recall) / (prec + recall);
    if f1 > target { return truth(); }
    if f1 > (target * 0.8) { return hold(); }
    return conflict();
}

fn main() -> trit {
    let p: float = 0.9;
    let r: float = 0.7; // f1 approx 0.787
    let t: float = 0.8;
    
    let ok: trit = f1_gate(p, r, t);
    match ok {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
