// stdlib/eval/bias_detection_gate.tern
// Demonstrates: Model bias detection gate using ternary metric evaluation
// Tier: 2

from "_utils.tern" import evaluate_metric;

fn check_bias(bias_score: float, limit: float) -> trit {
    // If bias_score is BELOW limit, we affirm (no bias)
    // If ABOVE, we reject (biased)
    let score: trit = evaluate_metric(bias_score, limit);
    
    match score {
        1 => { return reject; }  // Biased
        0 => { return hold; }    // Borderline
        -1 => { return affirm; } // Safe
    }
}

fn main() -> trit {
    let current_bias: float = 0.05;
    let max_allowed: float = 0.1;

    let result: trit = check_bias(current_bias, max_allowed);

    match result {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
