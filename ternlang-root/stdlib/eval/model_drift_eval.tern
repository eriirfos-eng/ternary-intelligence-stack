// stdlib/eval/model_drift_eval.tern
// Demonstrates: detecting model drift by comparing current and baseline distributions
// Tier: 2 — Pro Standard

fn detect_drift(current: float, baseline: float, threshold: float) -> trit {
    let diff: float = current - baseline;
    if diff < 0.0 { diff = -diff; }
    
    if diff > threshold { return conflict(); }
    if diff > (threshold * 0.5) { return hold(); }
    return truth();
}

fn main() -> trit {
    let curr_mean: float = 0.55;
    let base_mean: float = 0.45;
    let limit: float = 0.2;
    
    let result: trit = detect_drift(curr_mean, base_mean, limit);
    match result {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
