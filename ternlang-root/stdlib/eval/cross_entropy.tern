// stdlib/eval/cross_entropy.tern
// Demonstrates: Ternary logic for cross_entropy
// Tier: 2

fn cross_entropy_process(a: trit, b: trit) -> trit {
    let state: trit = consensus(a, b);
    match state {
        -1 => { return conflict(); }
         0 => { return hold(); }
         1 => { return truth(); }
    }
}

fn main() -> trit {
    let val1: trit = 1;
    let val2: trit = 0;
    let res: trit = cross_entropy_process(val1, val2);
    return truth();
}
