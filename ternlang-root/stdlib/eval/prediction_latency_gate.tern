// stdlib/eval/prediction_latency_gate.tern
// Demonstrates: evaluating prediction latency against SLA requirements
// Tier: 2 — Pro Standard

fn latency_check(ms: float, sla: float) -> trit {
    if ms < sla { return truth(); }
    if ms < (sla * 1.5) { return hold(); }
    return conflict();
}

fn main() -> trit {
    let lat: float = 45.0;
    let limit: float = 100.0;
    
    let ok: trit = latency_check(lat, limit);
    match ok {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
