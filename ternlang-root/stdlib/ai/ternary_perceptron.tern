fn sign_float(x: float) -> trit {
    if x > 0.0 {
        return 1;
    }
    if x < 0.0 {
        return -1;
    }
    return 0;
}

fn main() -> trit {
    let mut w: [float; 3] = [0.0, 0.0, 0.0];
    w[0] = 0.5;
    w[1] = -0.5;
    w[2] = 0.8;
    
    let mut x: [float; 3] = [0.0, 0.0, 0.0];
    x[0] = 1.0;
    x[1] = 1.0;
    x[2] = -1.0;
    
    let b: float = 0.1;
    
    let mut sum: float = 0.0;
    let mut i: int = 0;
    while i < 3 {
        sum = sum + (w[i] * x[i]);
        i = i + 1;
    }
    sum = sum + b;
    
    let y: trit = sign_float(sum);
    
    // Expected sum: (0.5 * 1.0) + (-0.5 * 1.0) + (0.8 * -1.0) + 0.1 = -0.7
    // sign(-0.7) should be -1
    
    if y == -1 {
        println("Perceptron test passed");
        return 1;
    } else {
        println("Perceptron test failed");
        return -1;
    }
}
