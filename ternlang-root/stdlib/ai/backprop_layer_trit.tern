fn main() -> trit {
    let mut w: float = 0.5;
    let x: float = 1.0;
    let target: float = 1.0;
    let lr: float = 0.1;
    
    let y: float = w * x;
    let err: float = target - y;
    
    let dw: float = err * x;
    w = w + lr * dw;
    
    println("Updated Weight:");
    println(w);
    
    if w > 0.5 { return 1; }
    return -1;
}
