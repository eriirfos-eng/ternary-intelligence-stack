// Module:  stdlib/causal/acoustic_optimizer.schema.tern
// Purpose: T-SON serialization schema for acoustic_optimizer
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Acoustic_optimizerSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Acoustic_optimizerSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
