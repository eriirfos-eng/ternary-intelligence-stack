// stdlib/causal/treatment_effect_aggregator.tern
// Demonstrates: Aggregation of causal treatment effects
// Tier: 3

fn aggregate_ate(effects: trit[]) -> trit {
    let pos: int = 0;
    let neg: int = 0;
    
    for e in effects {
        match e {
            1  => { pos = pos + 1; }
            0  => { }
            -1 => { neg = neg + 1; }
        }
    }
    
    if pos > neg { return 1; }
    if neg > pos { return -1; }
    return 0;
}

fn main() -> trit {
    let effects: trittensor<5>;
    effects[0]=1; effects[1]=1; effects[2]=0; effects[3]=-1; effects[4]=1;
    
    let ate: trit = aggregate_ate(effects);
    
    match ate {
        1  => { return truth();    }
        0  => { return hold();     }
        -1 => { return conflict(); }
    }
}
