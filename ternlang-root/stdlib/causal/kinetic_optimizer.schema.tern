// Module:  stdlib/causal/kinetic_optimizer.schema.tern
// Purpose: T-SON serialization schema for kinetic_optimizer
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Kinetic_optimizerSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Kinetic_optimizerSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
