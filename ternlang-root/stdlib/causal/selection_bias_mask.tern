// stdlib/causal/selection_bias_mask.tern
// Demonstrates: Masking results affected by selection bias
// Tier: 3

fn apply_bias_mask(raw_result: trit, selection_bias_present: trit) -> trit {
    match selection_bias_present {
        1  => { return 0; } // Mask with Hold (uncertainty)
        0  => { return raw_result; } // Low bias, passthrough
        -1 => { return raw_result; } // No bias, passthrough
    }
}

fn main() -> trit {
    let raw: trit = 1;
    let bias: trit = 1;
    
    let result: trit = apply_bias_mask(raw, bias);
    
    match result {
        1  => { return truth();    }
        0  => { return hold();     }
        -1 => { return conflict(); }
    }
}
