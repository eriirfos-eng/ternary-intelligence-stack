// stdlib/causal/instrumental_gate.tern
// Demonstrates: Gating instrumental variable validity in causal analysis
// Tier: 3 - Industrial

fn is_valid_instrument(relevance: float, exclusion: float) -> trit {
    // Relevance must be high (Instrument affects Treatment)
    // Exclusion must be high (Instrument affects Outcome ONLY via Treatment)
    if relevance < 0.4 { return reject; }
    if exclusion < 0.9 { return reject; }
    
    if relevance > 0.7 && exclusion > 0.95 {
        return affirm;
    }
    
    return tend;
}

fn main() -> trit {
    let rel: float = 0.75;
    let excl: float = 0.98;
    
    let res: trit = is_valid_instrument(rel, excl); // should be affirm (+1)
    
    match res {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
