// stdlib/causal/do_calculus.tern
// Demonstrates: Ternary logic for do_calculus
// Tier: 3

fn do_calculus_process(a: trit, b: trit) -> trit {
    let state: trit = consensus(a, b);
    match state {
        -1 => { return conflict(); }
         0 => { return hold(); }
         1 => { return truth(); }
    }
}

fn main() -> trit {
    let val1: trit = 1;
    let val2: trit = 0;
    let res: trit = do_calculus_process(val1, val2);
    return truth();
}
