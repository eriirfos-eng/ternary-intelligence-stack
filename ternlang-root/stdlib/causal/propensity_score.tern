// stdlib/causal/propensity_score.tern
// Demonstrates: Ternary logic for propensity_score
// Tier: 3

fn propensity_score_process(a: trit, b: trit) -> trit {
    let state: trit = consensus(a, b);
    match state {
        -1 => { return conflict(); }
         0 => { return hold(); }
         1 => { return truth(); }
    }
}

fn main() -> trit {
    let val1: trit = 1;
    let val2: trit = 0;
    let res: trit = propensity_score_process(val1, val2);
    return truth();
}
