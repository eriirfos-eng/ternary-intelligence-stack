// Module:  stdlib/causal/quantum_tensor.schema.tern
// Purpose: T-SON serialization schema for quantum_tensor
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Quantum_tensorSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Quantum_tensorSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
