// stdlib/causal/instrumental_variable_check.tern
// Demonstrates: Validation of instrumental variable (IV) assumptions
// Tier: 3

fn validate_iv(z_to_x: trit, z_to_y_direct: trit) -> trit {
    // Assumption 1: Z affects X (relevance)
    if z_to_x != 1 {
        return -1; // Weak or no instrument
    }
    
    // Assumption 2: Z has no direct effect on Y (exclusion restriction)
    if z_to_y_direct != -1 {
        return 0; // Violation suspected
    }
    
    return 1; // Valid IV
}

fn main() -> trit {
    let zx: trit = 1;
    let zy: trit = -1; // No direct effect
    
    let result: trit = validate_iv(zx, zy);
    
    match result {
        1  => { return truth();    }
        0  => { return hold();     }
        -1 => { return conflict(); }
    }
}
