// stdlib/distributed/consensus_timeout_mask.tern
// Demonstrates: Distributed consensus timeout logic
// Tier: 2 — Pro Standard

fn check_consensus_timeout(elapsed_ms: float, limit_ms: float) -> trit {
    if elapsed_ms > limit_ms {
        return affirm; // Timeout
    }
    // Warning at 75%
    if elapsed_ms > (limit_ms * 0.75) {
        return tend; // Late
    }
    return reject; // OK
}

fn main() -> trit {
    // Current: 300ms, Limit: 500ms
    let status: trit = check_consensus_timeout(300.0, 500.0);
    
    // Status should be reject (300 < 375)
    match status {
        affirm => { 
            // Abort consensus
            return conflict(); 
        }
        tend => { 
            // Warning
            return hold(); 
        }
        reject => { 
            // Normal
            return truth(); 
        }
    }
}
