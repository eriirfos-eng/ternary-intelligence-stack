// stdlib/distributed/liveness_probe.tern
// Demonstrates: Liveness monitoring with timeout and error threshold
// Tier: 2

fn check_node(latency: int, error_count: int) -> trit {
    if error_count > 5 {
        return reject;
    }
    if latency > 1000 {
        return tend;
    }
    return affirm;
}

fn main() -> trit {
    let state: trit = check_node(1200, 2);
    match state {
        reject => { return conflict(); }
        tend   => { return hold();    }
        affirm => { return truth();   }
    }
}
