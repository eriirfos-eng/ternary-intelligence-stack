// stdlib/distributed/message_retry_backoff.tern
// Demonstrates: Calculation of retry delay with attempt clamping.
// Tier: 2 — Pro Standard

fn calculate_delay(attempt: int, base_ms: int, max_ms: int) -> int {
    let delay: int = base_ms;
    let i: int = 0;
    
    while i < attempt {
        delay = delay * 2;
        i = i + 1;
    }

    if delay > max_ms {
        return max_ms;
    }

    return delay;
}

fn main() -> trit {
    let current_attempt: int = 3;
    let base: int = 100;
    let limit: int = 1000;

    let delay: int = calculate_delay(current_attempt, base, limit);

    if delay == 800 {
        return truth();
    }
    
    if delay > 1000 {
        return conflict();
    }

    return hold();
}
