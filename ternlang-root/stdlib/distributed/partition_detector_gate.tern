// stdlib/distributed/partition_detector_gate.tern
// Demonstrates: Partition detection via node count consensus.
// Tier: 2 — Pro Standard

fn check_partition(visible_nodes: int, total_nodes: int) -> trit {
    let quorum: int = total_nodes / 2 + 1;

    if visible_nodes >= quorum {
        return truth(); // Quorum reached, in majority partition
    }

    if visible_nodes > 1 {
        return hold(); // No quorum, but not isolated
    }

    return conflict(); // Isolated node
}

fn main() -> trit {
    let visible: int = 2;
    let total: int = 5;

    let partition: trit = check_partition(visible, total);

    match partition {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
