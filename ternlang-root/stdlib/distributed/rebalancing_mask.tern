// stdlib/distributed/rebalancing_mask.tern
// Demonstrates: Rebalancing decision based on node load imbalance.
// Tier: 2 — Pro Standard

fn decide_rebalance(local_load: float, avg_load: float, tolerance: float) -> trit {
    let diff: float = local_load - avg_load;

    if diff > tolerance {
        return affirm; // High load, push data away
    }

    if diff < -tolerance {
        return reject; // Low load, pull data in
    }

    return tend; // Balanced
}

fn main() -> trit {
    let my_load: float = 0.85;
    let avg: float = 0.50;
    let tol: float = 0.10;

    let decision: trit = decide_rebalance(my_load, avg, tol);

    match decision {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
