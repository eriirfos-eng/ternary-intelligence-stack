// stdlib/distributed/anti_entropy_sync_mask.tern
// Demonstrates: Anti-entropy synchronization logic
// Tier: 2 — Pro Standard

fn eval_sync_need(local_version: int, remote_version: int) -> trit {
    if local_version == remote_version {
        return reject; // In sync
    }
    let diff: int = remote_version - local_version;
    if diff > 10 {
        return affirm; // Major divergence
    }
    return tend; // Minor divergence
}

fn main() -> trit {
    // Local: 100, Remote: 115
    let status: trit = eval_sync_need(100, 115);
    
    // Status should be affirm (15 > 10)
    match status {
        affirm => { 
            // Initiate full sync
            return truth(); 
        }
        tend => { 
            // Initiate incremental sync
            return hold(); 
        }
        reject => { 
            // OK
            return hold(); 
        }
    }
}
