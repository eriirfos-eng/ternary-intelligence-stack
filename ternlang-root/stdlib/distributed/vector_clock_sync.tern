// stdlib/distributed/vector_clock_sync.tern
// Demonstrates: synchronizing vector clocks and detecting causality
// Tier: 2 — Pro Standard

fn check_causality(c1: int, c2: int) -> trit {
    if c1 < c2 { return truth(); } // c1 happened before c2
    if c1 > c2 { return conflict(); } // c2 happened before c1
    return hold(); // Concurrent or same
}

fn main() -> trit {
    let clock1: int = 5;
    let clock2: int = 10;
    
    let res: trit = check_causality(clock1, clock2);
    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
