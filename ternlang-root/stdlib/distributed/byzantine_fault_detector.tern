// stdlib/distributed/byzantine_fault_detector.tern
// Demonstrates: detecting nodes providing inconsistent data
// Tier: 2 — Pro Standard

fn detect_fault(v1: trit, v2: trit, v3: trit) -> trit {
    let agg: trit = consensus(v1, consensus(v2, v3));
    if agg == 0 { return truth(); } // Disagreement detected
    return conflict(); // No fault detected
}

fn main() -> trit {
    let n1: trit = 1;
    let n2: trit = -1;
    let n3: trit = 1;
    
    let fault: trit = detect_fault(n1, n2, n3);
    match fault {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
