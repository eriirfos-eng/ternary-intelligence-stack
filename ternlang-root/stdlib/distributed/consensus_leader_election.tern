// stdlib/distributed/consensus_leader_election.tern
// Demonstrates: Leader election logic using node priority and uptime.
// Tier: 2 — Pro Standard

fn select_leader(prio_a: int, uptime_a: float, prio_b: int, uptime_b: float) -> trit {
    if prio_a > prio_b {
        return truth(); // A is leader
    }

    if prio_b > prio_a {
        return conflict(); // B is leader
    }

    // Ties broken by uptime
    if uptime_a > uptime_b {
        return truth();
    }

    if uptime_b > uptime_a {
        return conflict();
    }

    return hold(); // Deadlock or identical
}

fn main() -> trit {
    let p_a: int = 10;
    let u_a: float = 100.5;
    let p_b: int = 10;
    let u_b: float = 120.3;

    let leader: trit = select_leader(p_a, u_a, p_b, u_b);

    match leader {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
