// stdlib/distributed/causal_order_validator.tern
// Demonstrates: Causal message ordering validation using sequence numbers.
// Tier: 2 — Pro Standard

fn validate_sequence(last_seen: int, incoming: int) -> trit {
    if incoming == last_seen + 1 {
        return truth(); // Correct sequence, process immediately
    }

    if incoming > last_seen + 1 {
        return hold(); // Gap detected, must buffer/wait
    }

    return conflict(); // Duplicate or out-of-order, reject
}

fn main() -> trit {
    let last: int = 10;
    let next: int = 11;

    let res: trit = validate_sequence(last, next);

    match res {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
