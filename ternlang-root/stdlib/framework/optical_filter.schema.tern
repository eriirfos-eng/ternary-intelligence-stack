// Module:  stdlib/framework/optical_filter.schema.tern
// Purpose: T-SON serialization schema for optical_filter
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Optical_filterSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Optical_filterSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
