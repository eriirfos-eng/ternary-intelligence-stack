// Module:  stdlib/framework/plasma_system.schema.tern
// Purpose: T-SON serialization schema for plasma_system
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Plasma_systemSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Plasma_systemSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
