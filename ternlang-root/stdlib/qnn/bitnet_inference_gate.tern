// stdlib/qnn/bitnet_inference_gate.tern
// Demonstrates: BitNet-style (-1, 0, 1) weight inference gate
// Tier: 3 — Industrial

fn infer_bitnet(w: trit, x: trit) -> trit {
    let res: trit = w * x;
    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}

fn main() -> trit {
    let weight: trit = 1;
    let input: trit = 1;
    
    let ok: trit = infer_bitnet(weight, input);
    
    match ok {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
