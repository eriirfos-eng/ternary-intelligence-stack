// stdlib/qnn/quantize_float_gate.tern
// Demonstrates: Floating point to ternary quantization (Quantized Neural Nets)
// Tier: 3 — Industrial

fn quantize(val: float, threshold: float) -> trit {
    if val > threshold {
        return truth();    // Quantized to +1
    }
    if val < -threshold {
        return conflict(); // Quantized to -1
    }
    return hold();        // Quantized to 0
}

fn main() -> trit {
    let raw: float = 0.85;
    let t: float = 0.5;
    
    let q: trit = quantize(raw, t);
    
    match q {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
