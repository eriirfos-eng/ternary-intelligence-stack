// stdlib/crypto/ternary_hash_gate_test.tern
// Demonstrates: Cryptographic hash validity gate in ternary.
// Rejects immediately on any mismatch (conflict).
// Tier: 3 — Industrial

fn verify_trits(h0: trit, h1: trit, h2: trit, e0: trit, e1: trit, e2: trit) -> trit {
    if h0 != e0 { return reject; }
    if h1 != e1 { return reject; }
    if h2 != e2 { return reject; }
    return affirm;
}

fn main() -> trit {
    // Valid match
    if verify_trits(1, 0, -1, 1, 0, -1) != 1 { return -1; }

    // Invalid match (one mismatch)
    if verify_trits(1, 1, -1, 1, 0, -1) != -1 { return -1; }

    // Fully wrong
    if verify_trits(-1, -1, -1, 1, 1, 1) != -1 { return -1; }

    return 1;
}
