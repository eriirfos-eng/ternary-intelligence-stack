// stdlib/crypto/merkle_root_consensus.tern
// Demonstrates: Ternary Merkle Root calculation via layer consensus
// Tier: 3

from "_utils.tern" import trit_hash;

fn compute_merkle_root(leaves: trit[]) -> trit {
    let count: int = length(leaves);
    let i: int = 0;
    let current_layer_hash: trit = tend;
    
    while i < count ? {
        current_layer_hash = consensus(current_layer_hash, leaves[i]);
        i = i + 1;
    } else {
        return trit_hash(leaves); // Use helper for final hash
    } else {
        return tend;
    }
    
    return current_layer_hash;
}

fn main() -> trit {
    let data: trittensor<4>;
    data[0] = 1;
    data[1] = 0;
    data[2] = -1;
    data[3] = 1;

    let root: trit = compute_merkle_root(data);

    match root {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
