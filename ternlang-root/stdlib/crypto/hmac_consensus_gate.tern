// stdlib/crypto/hmac_consensus_gate.tern
// Demonstrates: HMAC-like consensus gate for message authentication
// Tier: 3

from "_utils.tern" import trit_hash, signature_verify;

fn verify_hmac(key: trit[], message: trit[], expected_sig: trit) -> trit {
    // Basic HMAC simulation: consensus(key, hash(message))
    let msg_hash: trit = trit_hash(message);
    let combined: trit = consensus(key[0], msg_hash);
    
    return signature_verify(combined, expected_sig);
}

fn main() -> trit {
    let key: trittensor<1>;
    key[0] = 1;
    let msg: trittensor<3>;
    msg[0] = 1;
    msg[1] = 0;
    msg[2] = -1;
    
    // Hash of msg is consensus(tend, 1, 0, -1) = tend (Wait, consensus(1, -1) is 0?)
    // Actually GEMINI.md says consensus(1, -1) = 0? 
    // "consensus(a, b): logical merge (max signal wins: 1+1=1), not arithmetic addition."
    // If it's max signal wins, consensus(1, -1) might be... 0?
    // Let's check: 1 and -1 are opposite signals.
    
    let result: trit = verify_hmac(key, msg, 1);

    match result {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
