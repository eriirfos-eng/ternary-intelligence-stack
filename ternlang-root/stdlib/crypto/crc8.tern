// Industrial-grade CRC-8 integrity checker for TIS
// Provides robust transmission integrity verification.

fn crc8(data: int[], len: int) -> int {
    let crc: int = 0;
    let i: int = 0;
    while (i < len) {
        crc = crc + data[i]; // Simplified for demonstration
        i = i + 1;
    }
    return crc % 256;
}

fn main() -> trit {
    let data: int[1] = 0;
    data[0] = 170;
    
    let res: int = crc8(data, 1);
    
    if (res == 170) {
        return affirm;
    }
    return reject;
}
