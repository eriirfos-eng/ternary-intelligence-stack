// stdlib/crypto/ternary_mac.tern
// Demonstrates: A Message Authentication Code using ternary XOR and key mixing.
// Tier: 3

from "../logic/ternary_xor.tern" import t_xor;

fn compute_mac(key: trit, data: trit) -> trit {
    // A simple one-trit MAC for demonstration
    // Mix data and key using cyclic XOR
    let step1: trit = t_xor(data, key);
    
    // Non-linear step: multiply by key to strengthen (if key is 0, it holds)
    let step2: trit = step1 * key;
    
    // Add data back in to ensure message sensitivity
    let mac: trit = t_xor(step2, data);
    
    return mac;
}

fn main() -> trit {
    let key: trit = 1;      // affirm
    let message: trit = -1; // reject
    
    let mac1: trit = compute_mac(key, message);
    
    // mac1 = t_xor((-1 xor 1) * 1, -1)
    // -1 xor 1 = 0
    // 0 * 1 = 0
    // 0 xor -1 = -1
    
    if mac1 != -1 { return conflict(); }
    
    // Test that changing the message changes the MAC
    let message2: trit = 1;
    let mac2: trit = compute_mac(key, message2);
    
    // mac2 = t_xor((1 xor 1) * 1, 1)
    // 1 xor 1 = -1
    // -1 * 1 = -1
    // -1 xor 1 = 0
    
    if mac2 == mac1 { return conflict(); } // MAC should be different
    if mac2 != 0 { return conflict(); }    // Expected 0 (hold)
    
    return truth();
}
