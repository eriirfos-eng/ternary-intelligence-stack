// stdlib/crypto/digital_signature_mask.tern
// Demonstrates: Ternary mask for digital signature verification
// Tier: 3

from "./_utils.tern" import *;

fn signature_mask(msg: trit[], sig: trit) -> trit {
    let hash: trit = trit_hash(msg);
    return signature_verify(hash, sig);
}

fn main() -> trit {
    let message: trittensor<4>;
    message[0] = affirm;
    message[1] = reject;
    message[2] = tend;
    message[3] = affirm;
    
    // Hash of message will be consensus(affirm, reject, tend, affirm) -> affirm
    let signature: trit = affirm;
    
    let is_valid: trit = signature_mask(message, signature);
    
    match is_valid {
        affirm => {
            println("Digital Signature: VALID.");
        }
        tend => {
            println("Digital Signature: UNCERTAIN - Verification required.");
        }
        reject => {
            println("Digital Signature: INVALID - Potential forgery.");
        }
    }
    
    return is_valid;
}
