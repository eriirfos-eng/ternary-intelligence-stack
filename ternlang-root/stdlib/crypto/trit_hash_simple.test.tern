from "./trit_hash_simple.tern" import simple_hash;
from "../testing/assert.tern" import assert_equal;

fn main() -> trit {
    let input: int[3] = 0;
    input[0] = 1;
    input[1] = 0;
    input[2] = -1;
    
    let h1: int = simple_hash(input, 3);
    let h2: int = simple_hash(input, 3);
    
    if (assert_equal(h1, h2) == affirm) {
        print("Test passed: Deterministic hash.");
        return affirm;
    }
    return reject;
}
