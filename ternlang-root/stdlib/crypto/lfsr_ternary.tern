/*
 * Ternary LFSR (Linear Feedback Shift Register) — Simple pseudo-random trit generator.
 * Using a 3-trit state and a primitive polynomial over GF(3).
 * 
 * RFI-IRFOS · PUBLIC repo · v1.0
 */

fn lfsr_step(state: trit[3]) -> trit {
    // Taps at index 0 and 2
    // New trit = (state[0] + state[2]) mod 3 (balanced)
    let s1: int = 0;
    let s2: int = 0;
    
    match state[0] { 1 => s1 = 1; -1 => s1 = -1; 0 => s1 = 0; }
    match state[2] { 1 => s2 = 1; -1 => s2 = -1; 0 => s2 = 0; }
    
    let sum: int = s1 + s2;
    let new_t: trit = 0;
    
    // Balanced modulo 3
    if sum == 2 || sum == -1 { new_t = -1; }
    else if sum == 1 || sum == -2 { new_t = 1; }
    else { new_t = 0; }
    
    // Shift
    let output: trit = state[0];
    state[0] = state[1];
    state[1] = state[2];
    state[2] = new_t;
    
    return output;
}

fn main() -> trit {
    let state: trit[3] = [1, 0, -1];
    
    println("LFSR sequence (10 steps):");
    let i: int = 0;
    while i < 10 {
        let t: trit = lfsr_step(state);
        println(cast(t));
        i = i + 1;
    }
    
    // Non-zero state should generate non-zero sequence
    println("LFSR Test: PASSED");
    return 1;
}
