fn main() -> trit {
    let mut state: trit[4];
    state[0] = 1; state[1] = 0; state[2] = -1; state[3] = 1;
    
    let mut i: int = 0;
    while i < 10 {
        let feedback: trit = consensus(state[0], state[3]);
        state[0] = state[1];
        state[1] = state[2];
        state[2] = state[3];
        state[3] = feedback;
        i = i + 1;
    }
    println("LFSR state after 10 steps:");
    println(state[0]); println(state[1]); println(state[2]); println(state[3]);
    return 1;
}
