// stdlib/programs/ml_utils.tern
// Helper functions for federated learning and model aggregation
// Tier: 2 — Pro Standard

fn weighted_avg_3(v1: float, v2: float, v3: float, w1: float, w2: float, w3: float) -> float {
    let sum_w: float = w1 + w2 + w3;
    if sum_w == 0.0 { return 0.0; }
    return (v1 * w1 + v2 * w2 + v3 * w3) / sum_w;
}

fn delta_check(v1: float, v2: float, t: float) -> trit {
    let diff: float = v1 - v2;
    if diff < 0.0 { diff = -diff; }
    if diff < t { return truth(); }
    return conflict();
}

fn participation_gate(samples: int, min_s: int) -> trit {
    if samples >= min_s { return truth(); }
    if samples >= (min_s / 2) { return hold(); }
    return conflict();
}
