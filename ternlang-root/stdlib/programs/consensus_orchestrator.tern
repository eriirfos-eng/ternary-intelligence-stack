// stdlib/programs/consensus_orchestrator.tern
// Demonstrates: A consensus orchestrator using multiple agents and structs.
// Tier: 2 — Pro Standard

struct Signal {
    val: trit,
    weight: int,
}

agent Worker {
    fn handle(msg: trit) -> trit {
        return msg;
    }
}

fn create_signal(v: trit, w: int) -> Signal {
    let s: Signal = Signal { val: v, weight: w };
    return s;
}

fn process_signal_fields(v: trit, w: int) -> trit {
    if w > 50 {
        return v;
    }
    return hold();
}

fn aggregate_votes(v1: trit, v2: trit, v3: trit) -> trit {
    return consensus(consensus(v1, v2), v3);
}

fn log_orchestration(res: trit) -> int {
    println(res);
    return 1;
}

fn main() -> trit {
    let w1: agentref = spawn Worker;
    let w2: agentref = spawn Worker;
    
    send w1 1;
    send w2 0;
    
    let res1: trit = await w1;
    let res2: trit = await w2;
    
    let s1: Signal = create_signal(res1, 60);
    let s2: Signal = create_signal(res2, 40);
    
    // Access fields before passing
    let s1_v: trit = s1.val;
    let s1_w: int = s1.weight;
    let s2_v: trit = s2.val;
    let s2_w: int = s2.weight;
    
    let p1: trit = process_signal_fields(s1_v, s1_w);
    let p2: trit = process_signal_fields(s2_v, s2_w);
    
    let result: trit = aggregate_votes(p1, p2, 1);
    let _log: int = log_orchestration(result);
    
    if result == 1 { return truth(); }
    if result == -1 { return conflict(); }
    return hold();
}
