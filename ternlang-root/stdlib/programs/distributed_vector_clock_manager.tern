// stdlib/programs/distributed_vector_clock_manager.tern
// Demonstrates: Vector clock management, merging, and causality comparison.
// Tier: 4 — Enterprise

from std::trit import *;

struct VectorClock {
    n1: int,
    n2: int,
    n3: int,
}

fn increment_clock(v: VectorClock, node_id: int) -> VectorClock {
    let n1: int = v.n1;
    let n2: int = v.n2;
    let n3: int = v.n3;
    
    if node_id == 1 { n1 = n1 + 1; }
    if node_id == 2 { n2 = n2 + 1; }
    if node_id == 3 { n3 = n3 + 1; }
    
    return VectorClock { n1: n1, n2: n2, n3: n3 };
}

fn merge_clocks(v1: VectorClock, v2: VectorClock) -> VectorClock {
    let n1: int = v1.n1;
    if v2.n1 > n1 { n1 = v2.n1; }
    
    let n2: int = v1.n2;
    if v2.n2 > n2 { n2 = v2.n2; }
    
    let n3: int = v1.n3;
    if v2.n3 > n3 { n3 = v2.n3; }
    
    return VectorClock { n1: n1, n2: n2, n3: n3 };
}

fn compare_clocks(v1: VectorClock, v2: VectorClock) -> trit {
    let v1_greater: trit = reject;
    let v2_greater: trit = reject;
    
    if v1.n1 > v2.n1 { v1_greater = affirm; }
    if v2.n1 > v1.n1 { v2_greater = affirm; }
    
    if v1.n2 > v2.n2 { v1_greater = affirm; }
    if v2.n2 > v1.n2 { v2_greater = affirm; }
    
    if v1.n3 > v2.n3 { v1_greater = affirm; }
    if v2.n3 > v1.n3 { v2_greater = affirm; }
    
    if v1_greater == 1 && v2_greater == 1 {
        return hold(); // Concurrent
    }
    
    if v1_greater == 1 { return affirm; } // v1 > v2
    if v2_greater == 1 { return reject; } // v2 > v1
    
    return tend; // Equal
}

fn main() -> trit {
    let c1: VectorClock = VectorClock { n1: 1, n2: 0, n3: 0 };
    let c2: VectorClock = VectorClock { n1: 0, n2: 1, n3: 0 };
    
    let res: trit = compare_clocks(c1, c2);
    
    match res {
        1 => {
            // c1 after c2
            return truth();
        }
        0 => {
            // concurrent
            return hold();
        }
        -1 => {
            // c2 after c1
            return conflict();
        }
    }
}
