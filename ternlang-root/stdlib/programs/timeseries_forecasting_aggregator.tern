// stdlib/programs/timeseries_forecasting_aggregator.tern
// Demonstrates: Multi-model forecasting aggregation and error validation.
// Tier: 4 — Enterprise

from std::trit import *;

fn forecast_linear(t1: float, t2: float) -> float {
    let slope: float = t2 - t1;
    return t2 + slope;
}

fn forecast_ewma(prev_f: float, curr_v: float, alpha: float) -> float {
    return alpha * curr_v + (1.0 - alpha) * prev_f;
}

fn weighted_aggregate(f1: float, w1: float, f2: float, w2: float) -> float {
    return (f1 * w1 + f2 * w2) / (w1 + w2);
}

fn validate_error(actual: float, predicted: float, threshold: float) -> trit {
    let diff: float = actual - predicted;
    if diff < 0.0 { diff = -diff; }
    
    if diff > threshold {
        return reject; // Large error
    }
    
    if diff > threshold / 2.0 {
        return tend; // Moderate error
    }
    
    return affirm; // Accurate forecast
}

fn main() -> trit {
    let val_1: float = 10.0;
    let val_2: float = 12.0;
    
    let f_lin: float = forecast_linear(val_1, val_2);
    let f_ewma: float = forecast_ewma(11.0, 12.0, 0.2);
    
    let w_l: float = 0.6;
    let w_e: float = 0.4;
    
    let final_f: float = weighted_aggregate(f_lin, w_l, f_ewma, w_e);
    
    let actual_next: float = 13.5;
    let accuracy: trit = validate_error(actual_next, final_f, 2.0);
    
    match accuracy {
        1 => { return truth(); }
        0 => { return hold();  }
       -1 => { return conflict(); }
    }
}
