// stdlib/programs/ternary_neural_inference_pipeline.tern
// Demonstrates: Multi-layer ternary neural inference pipeline
// Tier: 2 - Pro Standard

from std::trit import min, max, consensus;

fn activation(x: float) -> trit {
    if x > 0.5 { return 1; }
    if x < -0.5 { return -1; }
    return 0;
}

fn normalize(x: float) -> float {
    if x > 10.0 { return 1.0; }
    if x < -10.0 { return -1.0; }
    return x / 10.0;
}

@sparseskip
fn layer1_neuron(input: trittensor<3>, weights: trittensor<3>) -> float {
    let acc: float = 0.0;
    let i: int = 0;
    
    // Manual unroll for 3 elements
    acc = acc + input[0] * weights[0];
    acc = acc + input[1] * weights[1];
    acc = acc + input[2] * weights[2];
    
    return acc;
}

fn layer2_output(hidden: trit, bias: float) -> float {
    return hidden + bias;
}

fn inference_orchestrator(input: trittensor<3>) -> trit {
    let weights: trittensor<3> = [1, 0, -1];
    
    let raw_hidden: float = layer1_neuron(input, weights);
    let hidden: trit = activation(normalize(raw_hidden));
    
    let raw_out: float = layer2_output(hidden, 0.2);
    return activation(normalize(raw_out));
}

fn main() -> trit {
    let input: trittensor<3> = [1, 1, 1];
    let result: trit = inference_orchestrator(input);
    
    println("Neural inference complete.");
    
    match result {
        -1 => { return -1; }
         0 => { return 0; }
         1 => { return 1; }
    }
}
