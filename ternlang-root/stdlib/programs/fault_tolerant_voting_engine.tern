// stdlib/programs/fault_tolerant_voting_engine.tern
// Demonstrates: Fault-tolerant multi-voter consensus system
// Tier: 2 - Pro Standard

from std::trit import min, max, consensus;

fn voter_node(health: float, vote: trit) -> trit {
    if health < 0.5 { return 0; } // Unreliable node
    return vote;
}

fn collect_votes(v1: trit, v2: trit, v3: trit) -> trittensor<3> {
    let t: trittensor<3> = [0, 0, 0];
    t[0] = v1;
    t[1] = v2;
    t[2] = v3;
    return t;
}

fn majority_vote(votes: trittensor<3>) -> trit {
    let sum_val: int = 0;
    for v in votes {
        match v {
            -1 => { sum_val = sum_val - 1; }
             0 => { sum_val = sum_val + 0; }
             1 => { sum_val = sum_val + 1; }
        }
    }
    
    if sum_val > 0 { return 1; }
    if sum_val < 0 { return -1; }
    return 0;
}

fn validate_integrity(res: trit, nodes: trittensor<3>) -> trit {
    let alive_count: int = 0;
    for n in nodes {
        if n != 0 { alive_count = alive_count + 1; }
    }
    
    if alive_count < 2 { return 0; } // Insufficient reliable nodes
    return res;
}

fn voting_system_orchestrator(h1: float, h2: float, h3: float, v1: trit, v2: trit, v3: trit) -> trit {
    let n1: trit = voter_node(h1, v1);
    let n2: trit = voter_node(h2, v2);
    let n3: trit = voter_node(h3, v3);
    
    let votes: trittensor<3> = collect_votes(n1, n2, n3);
    let res: trit = majority_vote(votes);
    
    let health_mask: trittensor<3> = [0, 0, 0];
    health_mask[0] = n1;
    health_mask[1] = n2;
    health_mask[2] = n3;

    return validate_integrity(res, health_mask);
}

fn main() -> trit {
    let result: trit = voting_system_orchestrator(0.9, 0.8, 0.4, 1, 1, -1);
    
    println("Consensus result reached.");
    
    match result {
        -1 => { return -1; }
         0 => { return 0; }
         1 => { return 1; }
    }
}
