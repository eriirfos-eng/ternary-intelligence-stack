// stdlib/programs/ternary_sort_pipeline.tern
// Demonstrates: A multi-phase sorting and verification pipeline for ternary tensors.
// Tier: 3 - Industrial

from std::trit import *;

// Swaps two elements in a 1D trit tensor.
fn swap(t: trit[], i: int, j: int) -> trit {
    let temp: trit = t[i];
    t[i] = t[j];
    t[j] = temp;
    return affirm;
}

// Performs a single bubble sort pass over the tensor.
fn bubble_pass(t: trit[], len: int) -> int {
    let swapped: int = 0;
    let i: int = 0;
    while i < (len - 1) {
        if t[i] > t[i + 1] {
            swap(t, i, i + 1);
            swapped = 1;
        }
        i = i + 1;
    }
    return swapped;
}

// Full bubble sort until no swaps are needed.
fn ternary_sort(t: trit[], len: int) -> trit {
    let running: int = 1;
    while running == 1 {
        running = bubble_pass(t, len);
    }
    return affirm;
}

// Verifies if the tensor is sorted and counts occurrences.
fn verify_sorted(t: trit[], len: int) -> trit {
    let i: int = 0;
    while i < (len - 1) {
        if t[i] > t[i + 1] {
            return reject;
        }
        i = i + 1;
    }
    return affirm;
}

// High-level pipeline entry point.
fn sort_pipeline(data: trittensor<5>) -> trit {
    println("Initial data:");
    let k: int = 0;
    while k < 5 {
        println(data[k]);
        k = k + 1;
    }
    
    ternary_sort(data, 5);
    
    println("Sorted data:");
    k = 0;
    while k < 5 {
        println(data[k]);
        k = k + 1;
    }
    
    let ok: trit = verify_sorted(data, 5);
    return ok;
}

fn main() -> trit {
    let data: trittensor<5>;
    data[0] = affirm;
    data[1] = reject;
    data[2] = tend;
    data[3] = reject;
    data[4] = affirm;
    
    let result: trit = sort_pipeline(data);
    
    match result {
        -1 => { println("Pipeline: FAILED"); }
         0 => { println("Pipeline: PENDING"); }
         1 => { println("Pipeline: SUCCESS"); }
    }
    
    return result;
}
