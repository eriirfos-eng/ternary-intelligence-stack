// stdlib/programs/autonomous_drone_navigation.tern
// Demonstrates: autonomous navigation logic with obstacle avoidance and imports
// Tier: 2 — Pro Standard

from "drone_utils.tern" import dist_f, obstacle_gate, battery_check;

fn move_drone(cur_x: float, cur_y: float, target_x: float, target_y: float, speed: float) -> float {
    let next_x: float = cur_x;
    if cur_x < target_x { next_x = cur_x + speed; }
    if cur_x > target_x { next_x = cur_x - speed; }
    return next_x;
}

fn decide_action(b_stat: trit, o_stat: trit, at_goal: trit) -> trit {
    if b_stat == -1 { return -1; } // Emergency landing
    if o_stat == -1 { return 0; }  // Halt / Avoid
    if at_goal == 1 { return 1; }  // Success
    return 1; // Continue
}

fn run_mission(tx: float, ty: float) -> trit {
    let x: float = 0.0;
    let y: float = 0.0;
    let bat: float = 1.0;
    let i: int = 0;
    
    while i < 20 {
        let obs_dist: float = dist_f(x, y, 5.0, 5.0);
        let b_stat: trit = battery_check(bat);
        let o_stat: trit = obstacle_gate(obs_dist, 1.0);
        let at_goal: trit = 0;
        if dist_f(x, y, tx, ty) < 0.5 { at_goal = 1; }
        
        let action: trit = decide_action(b_stat, o_stat, at_goal);
        if action == -1 { return conflict(); }
        if action == 0 { 
            // Mock avoidance: just wait
        } else {
            if at_goal == 1 { return truth(); }
            x = move_drone(x, y, tx, ty, 1.0);
            y = move_drone(y, x, ty, tx, 1.0); // Simple y update
        }
        
        bat = bat - 0.02;
        i = i + 1;
    }
    return hold(); // Timeout
}

fn main() -> trit {
    let res: trit = run_mission(10.0, 10.0);
    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
