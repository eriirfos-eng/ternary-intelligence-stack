// stdlib/programs/supply_chain_integrity_gate.tern
// Demonstrates: validating shipment integrity using environmental and logistics data
// Tier: 2 — Pro Standard

from "logistics_utils.tern" import temp_ok, location_match, weight_check;

fn verify_shipment(t: float, lat: float, lon: float, w: float) -> trit {
    let t_stat: trit = temp_ok(t, 2.0, 8.0); // cold chain
    let l_stat: trit = location_match(lat, lon, 48.2, 16.3); // Vienna
    let w_stat: trit = weight_check(w, 500.0);
    
    // Integrity requires ALL to be truth() or hold()
    let combined: trit = t_stat && l_stat && w_stat;
    return combined;
}

fn handle_result(res: trit) -> trit {
    match res {
        1 => { return truth(); } // Approved
        0 => { return hold(); }  // Inspection required
        -1 => { return conflict(); } // Rejected
    }
}

fn main() -> trit {
    let temp: float = 4.5;
    let lat: float = 48.21;
    let lon: float = 16.32;
    let weight: float = 498.0;
    
    let ok: trit = verify_shipment(temp, lat, lon, weight);
    match handle_result(ok) {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
