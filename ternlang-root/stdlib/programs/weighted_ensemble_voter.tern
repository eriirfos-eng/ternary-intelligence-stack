// stdlib/programs/weighted_ensemble_voter.tern
// Demonstrates: Weighted ensemble voting across 3 expert signals
// Tier: 2 — Pro Standard

from "ml_utils.tern" import weighted_avg_3;

fn trit_to_float(s: trit) -> float {
    match s {
        -1 => { return -1.0; }
         0 => { return 0.0;  }
         1 => { return 1.0;  }
    }
}

fn float_to_trit(v: float, t: float) -> trit {
    if v > t { return truth(); }
    if v < -t { return conflict(); }
    return hold();
}

fn ensemble_vote(s1: trit, s2: trit, s3: trit, w1: float, w2: float, w3: float) -> trit {
    let v1: float = trit_to_float(s1);
    let v2: float = trit_to_float(s2);
    let v3: float = trit_to_float(s3);
    
    let avg: float = weighted_avg_3(v1, v2, v3, w1, w2, w3);
    return float_to_trit(avg, 0.2);
}

fn main() -> trit {
    let s1: trit = 1;
    let s2: trit = 0;
    let s3: trit = -1;
    
    let w1: float = 0.8;
    let w2: float = 0.5;
    let w3: float = 0.2;
    
    let result: trit = ensemble_vote(s1, s2, s3, w1, w2, w3);
    
    match result {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
