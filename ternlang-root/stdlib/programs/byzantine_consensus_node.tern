// stdlib/programs/byzantine_consensus_node.tern
// Demonstrates: a consensus node that filters votes by reputation and signature
// Tier: 2 — Pro Standard

from "network_utils.tern" import verify_signature, node_weight, aggregate_votes;

fn process_vote(msg: int, sig: int, rep: float, vote: trit) -> trit {
    let valid: trit = verify_signature(msg, sig);
    if valid == -1 { return 0; } // Ignore invalid signatures
    
    let weight: float = node_weight(rep);
    if weight < 0.2 { return 0; } // Ignore low reputation
    
    return vote;
}

fn final_decision(v1: trit, v2: trit, v3: trit) -> trit {
    let agg: trit = aggregate_votes(v1, v2, v3);
    match agg {
        1 => { return truth(); }
        -1 => { return conflict(); }
        0 => { return hold(); }
    }
}

fn main() -> trit {
    // Node 1: Valid, High Rep, Affirm
    let res1: trit = process_vote(100, 100, 0.9, 1);
    // Node 2: Invalid Sig, High Rep, Affirm
    let res2: trit = process_vote(100, 101, 0.9, 1);
    // Node 3: Valid, Low Rep, Reject
    let res3: trit = process_vote(100, 100, 0.1, -1);
    
    let outcome: trit = final_decision(res1, res2, res3);
    match outcome {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
