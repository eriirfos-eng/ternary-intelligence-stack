// stdlib/programs/kernel_process_scheduler_sim.tern
// Demonstrates: Process state management, priority calculation, and preemption.
// Tier: 4 — Enterprise

from std::trit import *;

struct Process {
    id: int,
    prio: int,
    state: int,
    cpu_time: int,
}

fn calculate_priority(base: int, age: int, io_boost: trit) -> int {
    let bonus: int = 0;
    if io_boost == 1 { bonus = 2; }
    
    let p: int = base + (age / 10) + bonus;
    if p > 20 { return 20; }
    return p;
}

fn should_preempt(running_prio: int, waiting_prio: int) -> trit {
    if waiting_prio > running_prio + 5 {
        return affirm; // Urgent preemption
    }
    
    if waiting_prio > running_prio {
        return tend; // Optional context switch
    }
    
    return reject; // No preemption
}

fn update_process_state(p: Process, event: trit) -> int {
    // states: 0=ready, 1=running, 2=blocked, -1=zombie
    match event {
        1 => { return 1; } // Run event
        0 => { return 2; } // Wait/IO event
       -1 => { return -1; } // Exit event
    }
}

fn simulate_scheduler_tick(p: Process, waiting_prio: int) -> trit {
    let p_new: int = calculate_priority(p.prio, p.cpu_time, tend);
    let pre: trit = should_preempt(p_new, waiting_prio);
    
    return pre;
}

fn main() -> trit {
    let p1: Process = Process {
        id: 101,
        prio: 5,
        state: 1,
        cpu_time: 150,
    };
    
    let waiting_p: int = 15;
    
    let decision: trit = simulate_scheduler_tick(p1, waiting_p);
    
    match decision {
        1 => {
            // Context switch!
            return truth();
        }
        0 => {
            // Optional/Wait
            return hold();
        }
        -1 => {
            // Keep running
            return conflict();
        }
    }
}
