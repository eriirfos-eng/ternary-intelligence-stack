// stdlib/programs/fault_tolerant_gate_chain.tern
// Demonstrates: Multi-layer fault tolerance with primary, backup, and fallback
// Tier: 2

fn primary_system(input: trit) -> trit {
    return input; // Simple pass-through for demo
}

fn backup_system(input: trit) -> trit {
    return input; 
}

fn fallback_system() -> trit {
    return tend; // Default safe state
}

fn execute_chain(input: trit, primary_fail: trit, backup_fail: trit) -> trit {
    if primary_fail == reject {
        if backup_fail == reject {
            return fallback_system();
        }
        return backup_system(input);
    }
    return primary_system(input);
}

fn main() -> trit {
    // Scenario: Primary failed, Backup ok
    let result: trit = execute_chain(affirm, reject, affirm);
    match result {
        reject => { return conflict(); }
        tend   => { return hold();    }
        affirm => { return truth();   }
    }
}
