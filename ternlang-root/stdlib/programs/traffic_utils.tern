// stdlib/programs/traffic_utils.tern
// Helper functions for traffic flow and signal control
// Tier: 2 — Pro Standard

fn car_density(count: int, max_c: int) -> float {
    return count / (max_c * 1.0);
}

fn signal_priority(density: float, wait_time: float) -> trit {
    if density > 0.8 { return truth(); } // High priority
    if wait_time > 60.0 { return truth(); } // Urgent
    if density < 0.2 { return conflict(); } // Low priority
    return hold();
}

fn needs_change(cur_p: trit, other_p: trit) -> trit {
    if other_p > cur_p { return truth(); }
    return conflict();
}
