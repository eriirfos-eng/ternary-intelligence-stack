// stdlib/programs/ternary_search_tree.tern
// Demonstrates: A mock search process using integers, trits, and strings.
// Tier: 2 — Pro Standard

fn compare_vals(a: int, b: int) -> trit {
    if a > b { 
        return 1; 
    }
    if a < b { 
        return -1; 
    }
    return 0;
}

fn get_status_msg(res: trit) -> string {
    match res {
        -1 => { 
            return "Less"; 
        }
         0 => { 
            return "Equal"; 
        }
         1 => { 
            return "Greater"; 
        }
    }
}

fn process_comparison(a: int, b: int) -> string {
    let res: trit = compare_vals(a, b);
    return get_status_msg(res);
}

fn log_result(msg: string, val: int) -> int {
    println(msg);
    println(val);
    return val;
}

fn check_bounds(v: int, min: int, max: int) -> trit {
    if v < min { 
        return -1; 
    }
    if v > max { 
        return -1; 
    }
    return 1;
}

fn main() -> trit {
    let a: int = 10;
    let b: int = 20;
    let min_val: int = 0;
    let max_val: int = 100;
    
    let bounds_ok: trit = check_bounds(a, min_val, max_val);
    if bounds_ok == 1 {
        let msg: string = process_comparison(a, b);
        let _v: int = log_result(msg, a);
        
        let res: trit = compare_vals(a, b);
        match res {
            -1 => { return conflict(); }
             0 => { return hold();    }
             1 => { return truth();   }
        }
    }
    
    return conflict();
}
