// stdlib/programs/ternary_kalman_filter.tern
// Demonstrates: Ternary-assisted state estimation (simplified Kalman)
// Tier: 3 — Industrial

from "math_utils.tern" import abs_f, clamp_f;

fn predict(state: float, process_noise: float) -> float {
    return state + process_noise;
}

fn update(est: float, meas: float, gain: float) -> float {
    let residual: float = meas - est;
    return est + (gain * residual);
}

fn compute_gain(error_cov: float, meas_noise: float) -> float {
    let total: float = error_cov + meas_noise;
    if total == 0.0 { return 1.0; }
    return error_cov / total;
}

fn evaluate_state(s: float, min: float, max: float) -> trit {
    if s < min { return conflict(); }
    if s > max { return conflict(); }
    
    // Within range, check stability
    if s > (min + (max - min) * 0.2) && s < (max - (max - min) * 0.2) {
        return truth();
    }
    return hold();
}

fn main() -> trit {
    let s_prev: float = 100.0;
    let meas: float = 105.0;
    let noise: float = 2.0;
    let r_noise: float = 5.0;
    
    let predicted: float = predict(s_prev, noise);
    let k_gain: float = compute_gain(noise, r_noise);
    let s_new: float = update(predicted, meas, k_gain);
    
    let result: trit = evaluate_state(s_new, 80.0, 120.0);
    
    match result {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
