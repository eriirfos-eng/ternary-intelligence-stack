// stdlib/programs/network_load_balancer_simulation.tern
// Demonstrates: A 3-node network load balancer with health monitoring
// Tier: 2 — Pro Standard

from "network_utils.tern" import aggregate_votes, node_weight;

fn evaluate_node(health: trit, load: int, capacity: int) -> float {
    let hw: float = 0.0;
    match health {
        1 => { hw = 1.0; }
        0 => { hw = 0.5; }
        -1 => { hw = -1.0; }
    }
    
    if hw < 0.0 { return -1.0; } // Node dead
    
    let load_ratio: float = cast(load) / cast(capacity);
    return hw - load_ratio; // Higher is better
}

fn select_best(s1: float, s2: float, s3: float) -> int {
    if s1 >= s2 && s1 >= s3 { return 1; }
    if s2 >= s1 && s2 >= s3 { return 2; }
    return 3;
}

fn balancer_status(n1: trit, n2: trit, n3: trit) -> trit {
    return aggregate_votes(n1, n2, n3);
}

fn main() -> trit {
    let h1: trit = 1;
    let l1: int = 40;
    
    let h2: trit = 1;
    let l2: int = 10;
    
    let h3: trit = 0;
    let l3: int = 5;
    
    let cap: int = 100;
    
    let score1: float = evaluate_node(h1, l1, cap);
    let score2: float = evaluate_node(h2, l2, cap);
    let score3: float = evaluate_node(h3, l3, cap);
    
    let best: int = select_best(score1, score2, score3);
    let ok: trit = balancer_status(h1, h2, h3);
    
    match ok {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
