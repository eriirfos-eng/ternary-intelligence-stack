// stdlib/programs/distributed_consensus_engine.tern
// Demonstrates: A multi-agent consensus engine using spawn, send, and await.
// Tier: 2 — Pro Standard

agent Voter {
    fn handle(msg: trit) -> trit {
        return msg;
    }
}

fn pre_process_vote(v: trit) -> trit {
    // Identity mapping for now
    return v;
}

fn score_voter(id: int, vote: trit) -> int {
    if vote == 1 { 
        return 10; 
    }
    if vote == 0 { 
        return 5; 
    }
    return -5;
}

fn collect_vote(v: agentref, signal: trit) -> trit {
    let processed: trit = pre_process_vote(signal);
    send v processed;
    return await v;
}

fn majority_gate(v1: trit, v2: trit, v3: trit) -> trit {
    let sum: int = cast(v1) + cast(v2) + cast(v3);
    if sum > 0 { 
        return truth(); 
    }
    if sum < 0 { 
        return conflict(); 
    }
    return hold();
}

fn log_consensus(res: trit, total_score: int) -> trit {
    println(res);
    if total_score > 20 {
        return res;
    }
    return hold();
}

fn final_process(res: trit) -> trit {
    match res {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}

fn main() -> trit {
    let v1: agentref = spawn Voter;
    let v2: agentref = spawn Voter;
    let v3: agentref = spawn Voter;
    
    let vote1: trit = collect_vote(v1, 1);
    let vote2: trit = collect_vote(v2, 0);
    let vote3: trit = collect_vote(v3, 1);
    
    let s1: int = score_voter(1, vote1);
    let s2: int = score_voter(2, vote2);
    let s3: int = score_voter(3, vote3);
    let total_score: int = s1 + s2 + s3;
    
    let result: trit = majority_gate(vote1, vote2, vote3);
    let logged: trit = log_consensus(result, total_score);
    
    return final_process(logged);
}
