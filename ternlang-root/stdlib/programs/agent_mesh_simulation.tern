// stdlib/programs/agent_mesh_simulation.tern
// Demonstrates: A simulation of an agent mesh using structs in main.
// Tier: 2 — Pro Standard

struct Agent {
    id: int,
    power: float,
    status: trit,
}

fn main() -> trit {
    let a1: Agent = Agent { id: 1, power: 0.9, status: 1 };
    let a2: Agent = Agent { id: 2, power: 0.4, status: 0 };
    let a3: Agent = Agent { id: 3, power: 0.1, status: -1 };
    
    let p1: float = a1.power;
    let p2: float = a2.power;
    let p3: float = a3.power;
    
    let s1: trit = a1.status;
    let s2: trit = a2.status;
    let s3: trit = a3.status;
    
    let active_count: int = 0;
    if s1 == 1 { active_count = active_count + 1; }
    if s2 == 1 { active_count = active_count + 1; }
    if s3 == 1 { active_count = active_count + 1; }
    
    let total_power: float = 0.0;
    if s1 != -1 { total_power = total_power + p1; }
    if s2 != -1 { total_power = total_power + p2; }
    if s3 != -1 { total_power = total_power + p3; }
    
    println(active_count);
    println(total_power);
    
    let mesh_status: trit = 0;
    if total_power > 1.0 { mesh_status = 1; }
    if total_power < 0.5 { mesh_status = -1; }
    
    if mesh_status == 1 { return 1; }
    if mesh_status == -1 { return -1; }
    return 0;
}
