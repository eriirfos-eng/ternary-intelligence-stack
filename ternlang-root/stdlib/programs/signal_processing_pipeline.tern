// stdlib/programs/signal_processing_pipeline.tern
// Demonstrates: A signal processing pipeline with EMA smoothing and thresholding.
// Tier: 2 — Pro Standard

fn ema_smooth(prior: float, current: float, alpha: float) -> float {
    return alpha * current + (1.0 - alpha) * prior;
}

fn high_pass_filter(val: float, cutoff: float) -> float {
    if val > cutoff {
        return val;
    }
    return 0.0;
}

fn ternary_threshold(val: float, high: float, low: float) -> trit {
    if val > high { 
        return truth(); 
    }
    if val < low { 
        return conflict(); 
    }
    return hold();
}

fn aggregate_pipeline(s1: trit, s2: trit) -> trit {
    return consensus(s1, s2);
}

fn log_pipeline_step(id: int, val: float) -> int {
    println(val);
    return id + 1;
}

fn main() -> trit {
    let raw1: float = 0.8;
    let raw2: float = 0.2;
    let prior: float = 0.5;
    let alpha: float = 0.3;
    
    let s1: float = ema_smooth(prior, raw1, alpha);
    let s2: float = ema_smooth(prior, raw2, alpha);
    
    let next_id: int = 0;
    next_id = log_pipeline_step(next_id, s1);
    next_id = log_pipeline_step(next_id, s2);
    
    let f1: float = high_pass_filter(s1, 0.4);
    let f2: float = high_pass_filter(s2, 0.4);
    
    let t1: trit = ternary_threshold(f1, 0.6, 0.2);
    let t2: trit = ternary_threshold(f2, 0.6, 0.2);
    
    let result: trit = aggregate_pipeline(t1, t2);
    
    match result {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
