// stdlib/programs/ternary_calculator_system.tern
// Demonstrates: Complex ternary calculator system with multi-type processing
// Tier: 2 - Pro Standard

from std::trit import abs, min, max;
from std::math import step;

fn validate_input(a: float, b: float) -> trit {
    if a > 1000.0 { return conflict(); }
    if b < -1000.0 { return conflict(); }
    if a == b { return hold(); }
    return truth();
}

fn perform_operation(op: int, a: float, b: float) -> float {
    // 1: Add, 2: Mul, 3: Div, 4: Mod
    if op == 1 { return a + b; }
    if op == 2 { return a * b; }
    if op == 3 { 
        if b != 0.0 { return a / b; }
        return 0.0;
    }
    if op == 4 { 
        if b != 0.0 { return a % b; }
        return 0.0;
    }
    return 0.0;
}

fn calculate_score(res: float, target: float) -> trit {
    let diff: float = res - target;
    if diff > 10.0 { return truth(); }
    if diff < -10.0 { return conflict(); }
    return hold();
}

fn decision_gate(res_trit: trit, val_trit: trit) -> trit {
    // Combine result score with input validation
    let combined: trit = min(res_trit, val_trit);
    return step(combined);
}

fn logger(msg: string, status: trit) -> trit {
    println(msg);
    match status {
        -1 => { println("ERROR: Operation rejected."); return conflict(); }
         0 => { println("WARN: Operation inconclusive."); return hold(); }
         1 => { println("INFO: Operation confirmed."); return truth(); }
    }
}

fn main() -> trit {
    let a: float = 50.5;
    let b: float = 20.0;
    let target: float = 60.0;
    
    let val: trit = validate_input(a, b);
    let res: float = perform_operation(1, a, b); // 50.5 + 20.0 = 70.5
    
    let score: trit = calculate_score(res, target); // 70.5 - 60.0 = 10.5 > 10.0 -> truth()
    
    let final_decision: trit = decision_gate(score, val);
    
    return logger("Ternary Calculator System Execution Complete", final_decision);
}
