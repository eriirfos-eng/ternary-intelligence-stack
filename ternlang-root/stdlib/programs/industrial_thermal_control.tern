// stdlib/programs/industrial_thermal_control.tern
// Demonstrates: Industrial thermal control system with local state management.
// Tier: 3 - Industrial

from std::trit import *;

struct SensorState {
    temperature: float,
    pressure: float,
    status: trit,
}

// Evaluates heat action based on temperature and target.
fn evaluate_heat(temp: float, target: float) -> trit {
    let diff: float = target - temp;
    if diff > 5.0 { return affirm; }
    if diff < -5.0 { return reject; }
    return tend;
}

// Safety override based on pressure.
fn safety_override(pressure: float) -> trit {
    if pressure > 100.0 { return reject; }
    return affirm;
}

fn thermal_control_loop(s: SensorState, target: float, iterations: int) -> trit {
    let i: int = 0;
    while i < iterations {
        // Evaluate logic locally to ensure state updates persist in this scope
        let heat_action: trit = evaluate_heat(s.temperature, target);
        let safety: trit = safety_override(s.pressure);
        
        if safety == reject {
            s.status = reject;
            println("Status: SAFETY VETO");
        } else {
            s.status = heat_action;
            println("Status: ADJUSTING");
        }
        
        // Simulate temp adjustment
        match s.status {
            1 => { s.temperature = s.temperature + 2.0; }
           -1 => { s.temperature = s.temperature - 2.0; }
            0 => { s.temperature = s.temperature + 0.1; }
        }
        
        println("Current Temp:");
        println(s.temperature);
        
        i = i + 1;
    }
    return s.status;
}

fn main() -> trit {
    let s: SensorState;
    s.temperature = 20.0;
    s.pressure = 50.0;
    s.status = tend;
    
    let target: float = 25.0;
    
    println("Starting control loop...");
    let final_res: trit = thermal_control_loop(s, target, 5);
    
    println("Final result:");
    println(final_res);
    
    return affirm;
}
