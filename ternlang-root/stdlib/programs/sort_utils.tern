// stdlib/programs/sort_utils.tern
// Demonstrates: reusable helper for sorting algorithms
// Tier: 1 — Open Core

fn swap_t(t: trittensor<10>, i: int, j: int) -> trit {
    let temp: trit = t[i];
    t[i] = t[j];
    t[j] = temp;
    return truth();
}

fn compare_t(a: trit, b: trit) -> trit {
    if a > b { return truth(); }
    return conflict();
}
