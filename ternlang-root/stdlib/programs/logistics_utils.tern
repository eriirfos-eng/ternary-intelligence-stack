// stdlib/programs/logistics_utils.tern
// Helper functions for logistics and supply chain tracking
// Tier: 2 — Pro Standard

fn temp_ok(t: float, min_t: float, max_t: float) -> trit {
    if t < min_t { return conflict(); }
    if t > max_t { return conflict(); }
    return truth();
}

fn location_match(lat1: float, lon1: float, lat2: float, lon2: float) -> trit {
    let d_lat: float = lat1 - lat2;
    let d_lon: float = lon1 - lon2;
    if d_lat < 0.0 { d_lat = -d_lat; }
    if d_lon < 0.0 { d_lon = -d_lon; }
    
    if (d_lat + d_lon) < 0.1 { return truth(); }
    return conflict();
}

fn weight_check(actual: float, expected: float) -> trit {
    let diff: float = actual - expected;
    if diff < 0.0 { diff = -diff; }
    if diff < (expected * 0.05) { return truth(); }
    return hold();
}
