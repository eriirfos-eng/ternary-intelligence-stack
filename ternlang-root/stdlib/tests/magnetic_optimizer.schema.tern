// Module:  stdlib/tests/magnetic_optimizer.schema.tern
// Purpose: T-SON serialization schema for magnetic_optimizer
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Magnetic_optimizerSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Magnetic_optimizerSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
