// Module:  stdlib/tests/nuclear_tensor.schema.tern
// Purpose: T-SON serialization schema for nuclear_tensor
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Nuclear_tensorSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Nuclear_tensorSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
