// Module:  stdlib/tests/kinetic_router.schema.tern
// Purpose: T-SON serialization schema for kinetic_router
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Kinetic_routerSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Kinetic_routerSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
