// Module:  stdlib/tests/quantum_system.schema.tern
// Purpose: T-SON serialization schema for quantum_system
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Quantum_systemSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Quantum_systemSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
