// Module:  stdlib/tests/optical_tensor.schema.tern
// Purpose: T-SON serialization schema for optical_tensor
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Optical_tensorSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Optical_tensorSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
