// stdlib/math/trit_vector_normalization.tern
// L2 normalization for ternary signal vectors.
// Tier: 1 - Open Core

fn sqrt_float(x: float) -> float {
    if x <= 0.0 { return 0.0; }
    let res: float = x;
    let i: int = 0;
    while i < 10 {
        res = 0.5 * (res + x / res);
        i = i + 1;
    }
    return res;
}

fn normalize_vector(input: trit[], n: int, output: float[]) -> trit {
    let sum_sq: float = 0.0;
    let i: int = 0;
    while i < n {
        let val: float = cast(input[i]);
        sum_sq = sum_sq + val * val;
        i = i + 1;
    }
    
    let norm: float = sqrt_float(sum_sq);
    if norm == 0.0 {
        let j: int = 0;
        while j < n { output[j] = 0.0; j = j + 1; }
        return 0;
    }
    
    let k: int = 0;
    while k < n {
        output[k] = cast(input[k]) / norm;
        k = k + 1;
    }
    return 1;
}

fn main() -> trit {
    let input: trit[] = [1, 1, 1, 1]; // Magnitude 2.0
    let output: float[4];
    
    println("Normalizing [1, 1, 1, 1]...");
    normalize_vector(input, 4, output);
    
    println("Normalized output (expected all 0.5):");
    let m: int = 0;
    while m < 4 {
        println(output[m]);
        m = m + 1;
    }
    
    if output[0] > 0.49 && output[0] < 0.51 {
        println("Normalization successful.");
        return 1;
    }
    
    return -1;
}
