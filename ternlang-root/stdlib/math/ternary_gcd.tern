// stdlib/math/ternary_gcd.tern
// Demonstrates: Euclidean algorithm for Greatest Common Divisor.
// Tier: 1 — Open Core

fn t_gcd(a: int, b: int) -> int {
    let x: int = a;
    let y: int = b;
    
    // Ensure positive inputs
    if x < 0 { x = -x; }
    if y < 0 { y = -y; }
    
    while y != 0 {
        let temp: int = y;
        y = x % y;
        x = temp;
    }
    return x;
}

fn main() -> trit {
    let result: int = t_gcd(48, 18);
    // gcd(48, 18) = 6
    if result == 6 {
        let r2: int = t_gcd(101, 10);
        // gcd(101, 10) = 1
        if r2 == 1 {
            return truth();
        }
    }
    return conflict();
}
