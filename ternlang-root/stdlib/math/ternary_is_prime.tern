// stdlib/math/ternary_is_prime.tern
// Demonstrates: Primality testing using a ternary loop.
// Tier: 1 — Open Core

fn is_prime(n: int) -> trit {
    if n <= 1 { return conflict(); }
    if n <= 3 { return truth(); }
    if n % 2 == 0 { return conflict(); }
    if n % 3 == 0 { return conflict(); }
    
    let i: int = 5;
    while i * i <= n {
        if n % i == 0 { return conflict(); }
        if n % (i + 2) == 0 { return conflict(); }
        i = i + 6;
    }
    return truth();
}

fn main() -> trit {
    let p7: trit = is_prime(7);
    if p7 == 1 {
        let p15: trit = is_prime(15);
        if p15 == -1 {
            let p97: trit = is_prime(97);
            if p97 == 1 {
                return truth();
            }
        }
    }
    return conflict();
}
