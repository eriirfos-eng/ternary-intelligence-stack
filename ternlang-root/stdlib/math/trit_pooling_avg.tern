// stdlib/math/trit_pooling_avg.tern
// Average pooling activation for ternary signal windows.
// Tier: 1 - Open Core

fn avg_pool_trit(input: trit[], n: int, window_size: int, output: float[]) -> trit {
    let i: int = 0;
    let out_idx: int = 0;
    while i <= (n - window_size) {
        let sum: float = 0.0;
        let j: int = 0;
        while j < window_size {
            sum = sum + cast(input[i + j]);
            j = j + 1;
        }
        output[out_idx] = sum / cast(window_size);
        out_idx = out_idx + 1;
        i = i + window_size;
    }
    return 1;
}

fn main() -> trit {
    let input: trit[] = [1, 1, 0, -1, 1, 0, -1, -1];
    let output: float[4];
    
    println("Performing Average Pooling (window size 2) on [1, 1, 0, -1, 1, 0, -1, -1]...");
    avg_pool_trit(input, 8, 2, output);
    
    println("Output (expected [1.0, -0.5, 0.5, -1.0]):");
    let k: int = 0;
    while k < 4 {
        print(output[k]); print(" ");
        k = k + 1;
    }
    println("");
    
    if output[0] > 0.99 && output[1] < -0.49 && output[2] > 0.49 && output[3] < -0.99 {
        println("Average pooling OK.");
        return 1;
    }
    
    return -1;
}
