// stdlib/math/ternary_fibonacci.tern
// Demonstrates: Iterative Fibonacci sequence calculation.
// Tier: 1 — Open Core

fn t_fib(n: int) -> int {
    if n <= 0 { return 0; }
    if n == 1 { return 1; }
    
    let prev: int = 0;
    let curr: int = 1;
    let i: int = 2;
    
    while i <= n {
        let next: int = prev + curr;
        prev = curr;
        curr = next;
        i = i + 1;
    }
    return curr;
}

fn main() -> trit {
    let f7: int = t_fib(7);
    // 0, 1, 1, 2, 3, 5, 8, 13
    if f7 == 13 {
        let f10: int = t_fib(10);
        // ... 21, 34, 55
        if f10 == 55 {
            return truth();
        }
    }
    return conflict();
}
