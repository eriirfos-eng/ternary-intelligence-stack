// stdlib/math/ternary_median.tern
// Demonstrates: Median of 3 trits (majority aggregation).
// Tier: 1 — Open Core
// Returns the median value of three trits.

fn median3(a: trit, b: trit, c: trit) -> trit {
    // There are 27 combinations, but we can simplify:
    // If any two are the same, that's the median.
    if a == b { return a; }
    if a == c { return a; }
    if b == c { return b; }
    
    // If all are different, they must be [-1, 0, 1] in some order.
    // The median is then always 0.
    return 0;
}

// Test cases
let m1: trit = median3(1, 1, -1);  // Should be 1
let m2: trit = median3(1, 0, -1);  // Should be 0
let m3: trit = median3(-1, 0, -1); // Should be -1

println("Median(1, 1, -1): ", m1);
println("Median(1, 0, -1): ", m2);
println("Median(-1, 0, -1): ", m3);

if m1 == 1 {
    if m2 == 0 {
        if m3 == -1 {
            println("Median Test Passed.");
        }
    }
}
