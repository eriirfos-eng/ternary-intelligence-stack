// stdlib/math/pow3_int.tern
// Demonstrates: Integer exponentiation base 3
// Tier: 1 - Open Core

fn pow3(exponent: int) -> int {
    let res: int = 1;
    let i: int = 0;
    while i < exponent {
        res = res * 3;
        i = i + 1;
    }
    return res;
}

fn main() -> trit {
    let val: int = pow3(2); // 9
    
    if val == 9 {
        return affirm;
    } else {
        return reject;
    }
}
