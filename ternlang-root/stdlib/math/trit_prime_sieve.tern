/*
 * Sieve of Eratosthenes (Ternary)
 * Generates prime numbers using a trit array for marking.
 * Affirm (1) = prime candidate, Reject (-1) = composite.
 */

fn sieve_primes(is_prime: trit[], n: int) -> int {
    let i: int = 0;
    while i <= n {
        is_prime[i] = 1;
        i = i + 1;
    }
    
    is_prime[0] = -1;
    is_prime[1] = -1;
    
    let p: int = 2;
    while p * p <= n {
        // If is_prime[p] is not changed, then it is a prime
        if is_prime[p] == 1 {
            // Update all multiples of p
            let i: int = p * p;
            while i <= n {
                is_prime[i] = -1;
                i = i + p;
            }
        }
        p = p + 1;
    }
    
    let count: int = 0;
    let j: int = 0;
    while j <= n {
        if is_prime[j] == 1 {
            count = count + 1;
        }
        j = j + 1;
    }
    return count;
}

fn main() -> trit {
    let limit: int = 20;
    let is_prime: trit[21];
    
    println("Sieve of Eratosthenes (up to 20)");
    let count: int = sieve_primes(is_prime, limit);
    
    println("Number of primes found:");
    println(count);
    
    // Primes up to 20: 2, 3, 5, 7, 11, 13, 17, 19 (total 8)
    if count == 8 {
        println("Prime count OK.");
        
        println("Checking some values:");
        println("Is 7 prime?"); println(is_prime[7]);
        println("Is 15 prime?"); println(is_prime[15]);
        
        if is_prime[7] == 1 && is_prime[15] == -1 {
            println("Sieve verified. Success.");
            return 1;
        }
    }
    
    return -1;
}
