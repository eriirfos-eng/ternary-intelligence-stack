/*
 * Trit Vector Norms
 * Calculation of L1 and L2 (analogs) norms for trit tensors.
 */

fn vector_l1_norm(data: trit[]) -> int {
    let sum: int = 0;
    let n: int = 5;
    let i: int = 0;
    while i < n {
        let val: int = cast(data[i]);
        if val < 0 { val = -val; }
        sum = sum + val;
        i = i + 1;
    }
    return sum;
}

fn vector_l2_norm_sq(data: trit[]) -> int {
    let sum: int = 0;
    let n: int = 5;
    let i: int = 0;
    while i < n {
        let val: int = cast(data[i]);
        sum = sum + (val * val);
        i = i + 1;
    }
    return sum;
}

fn main() -> trit {
    let v: trit[5];
    v[0] = 1; v[1] = -1; v[2] = 1; v[3] = 0; v[4] = -1;
    
    println("Trit Vector Norms Demo");
    
    println("L1 Norm (expected 4):");
    let l1: int = vector_l1_norm(v);
    println(l1);
    
    println("L2 Norm Squared (expected 4):");
    let l2: int = vector_l2_norm_sq(v);
    println(l2);
    
    if l1 == 4 && l2 == 4 {
        println("Vector norms verified. Success.");
        return 1;
    }
    
    return -1;
}
