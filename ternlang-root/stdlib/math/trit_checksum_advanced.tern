/*
 * Advanced Trit Checksum
 * Robust checksum algorithm for trit tensors using alternating weights.
 * Optimized for identifying transposition errors in signal transmission.
 */

fn trit_checksum_adv(data: trit[]) -> int {
    let sum: int = 0;
    let n: int = 5;
    let i: int = 0;
    while i < n {
        let val: int = cast(data[i]);
        // Alternating weight: 1, 3, 1, 3...
        let weight: int = 1;
        if i % 2 == 1 { weight = 3; }
        
        sum = sum + (val * weight);
        i = i + 1;
    }
    return sum;
}

fn main() -> trit {
    let v1: trit[5];
    v1[0] = 1; v1[1] = -1; v1[2] = 0; v1[3] = 1; v1[4] = 1;
    
    let v2: trit[5]; // Transposed 0 and 1
    v2[0] = 1; v2[1] = -1; v2[2] = 1; v2[3] = 0; v2[4] = 1;
    
    println("Advanced Trit Checksum Demo");
    
    println("Checksum V1:");
    let c1: int = trit_checksum_adv(v1);
    println(c1);
    
    println("Checksum V2 (transposed):");
    let c2: int = trit_checksum_adv(v2);
    println(c2);
    
    if c1 != c2 {
        println("Transposition error detected correctly.");
        println("Checksum verified. Success.");
        return 1;
    }
    
    return -1;
}
