// stdlib/math/ternary_is_zero.tern
// Demonstrates: A boolean-like check for zero trit values.
// Tier: 1 — Open Core

fn is_zero(val: trit) -> trit {
    match val {
         0 => { return truth();    }
         1 => { return conflict(); }
        -1 => { return conflict(); }
    }
}

fn main() -> trit {
    if is_zero(0) != truth() { return conflict(); }
    if is_zero(1) == truth() { return conflict(); }
    if is_zero(-1) == truth() { return conflict(); }
    
    return truth();
}
