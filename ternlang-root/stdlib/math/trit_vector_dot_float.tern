/*
 * Trit-Float Vector Dot Product
 * Mixed-type dot product between a trit vector and a float vector.
 */

fn vector_dot_mixed(t: trit[], f: float[]) -> float {
    let sum: float = 0.0;
    let n: int = 5;
    let i: int = 0;
    while i < n {
        sum = sum + (cast(t[i]) * f[i]);
        i = i + 1;
    }
    return sum;
}

fn main() -> trit {
    let t: trit[5];
    let f: float[5];
    
    t[0] = 1; t[1] = -1; t[2] = 1; t[3] = 0; t[4] = 1;
    f[0] = 0.5; f[1] = 1.5; f[2] = 2.0; f[3] = 3.0; f[4] = 4.0;
    
    println("Trit-Float Mixed Dot Product Demo");
    
    println("Dot Product (expected 1*0.5 + -1*1.5 + 1*2.0 + 0*3.0 + 1*4.0 = 0.5 - 1.5 + 2.0 + 4.0 = 5.0):");
    let dot: float = vector_dot_mixed(t, f);
    println(dot);
    
    if dot == 5.0 {
        println("Mixed dot product verified. Success.");
        return 1;
    }
    
    return -1;
}
