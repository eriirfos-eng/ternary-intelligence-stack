// stdlib/math/ternary_is_negative.tern
// Demonstrates: A boolean-like check for negative trit values.
// Tier: 1 — Open Core

fn is_negative(val: trit) -> trit {
    match val {
        -1 => { return truth();    }
         0 => { return conflict(); }
         1 => { return conflict(); }
    }
}

fn main() -> trit {
    let test_val: trit = -1;
    let result: trit = is_negative(test_val);

    match result {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
