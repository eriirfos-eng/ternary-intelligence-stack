// stdlib/math/root3_int.tern
// Demonstrates: Simple integer cube root search
// Tier: 1 - Open Core

fn root3(n: int) -> int {
    let i: int = 0;
    while i * i * i <= n {
        i = i + 1;
    }
    return i - 1;
}

fn main() -> trit {
    let r: int = root3(27); // should be 3
    
    if r == 3 {
        return affirm;
    } else {
        return reject;
    }
}
