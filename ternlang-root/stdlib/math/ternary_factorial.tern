// stdlib/math/ternary_factorial.tern
// Demonstrates: Factorial calculation using a ternary loop.
// Tier: 1 — Open Core

fn t_factorial(n: int) -> int {
    if n < 0 { return -1; } // undefined for negative
    if n == 0 { return 1; }
    
    let result: int = 1;
    let i: int = 1;
    while i <= n {
        result = result * i;
        i = i + 1;
    }
    return result;
}

fn main() -> trit {
    let f5: int = t_factorial(5);
    // 5! = 120
    if f5 == 120 {
        let f0: int = t_factorial(0);
        if f0 == 1 {
            return truth();
        }
    }
    return conflict();
}
