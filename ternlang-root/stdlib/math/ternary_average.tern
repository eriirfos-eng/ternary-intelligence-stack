// stdlib/math/ternary_average.tern
// Demonstrates: Calculating the floating-point average of a trit array.
// Tier: 1 — Open Core
// This proves that trits can be coerced into floats for precise aggregation.

fn calculate_average(data: trit[]) -> float {
    let sum: float = 0.0;
    let count: int = 0;
    let i: int = 0;
    
    // Manual loop because length is fixed in current VM 1D implementation
    // For this example we assume a fixed size of 5 for the demo
    while i < 5 {
        let val: trit = data[i];
        
        // Polymorphic addition: float + trit
        sum = sum + val;
        count = count + 1;
        i = i + 1;
    }
    
    // Polymorphic division: float / int
    return sum / count;
}

// Setup a trit array: [+1, 0, -1, +1, +1] -> Sum = 2.0, Count = 5 -> Average = 0.4
let signals: trit[] = [1, 0, -1, 1, 1];
let avg: float = calculate_average(signals);

println("Trit Array: [+1, 0, -1, +1, +1]");
println("Calculated Average: ", avg);

// Verification match
if avg > 0.3 {
    println("Average is positive. Result: Affirm.");
} else {
    println("Average is low. Result: Hold/Reject.");
}
