// stdlib/math/trit_pooling_max.tern
// Max pooling activation for ternary signal windows.
// Tier: 1 - Open Core

fn max_pool_trit(input: trit[], n: int, window_size: int, output: trit[]) -> trit {
    let i: int = 0;
    let out_idx: int = 0;
    while i <= (n - window_size) {
        let max_val: trit = -1;
        let j: int = 0;
        while j < window_size {
            if input[i + j] > max_val { max_val = input[i + j]; }
            j = j + 1;
        }
        output[out_idx] = max_val;
        out_idx = out_idx + 1;
        i = i + window_size; // Non-overlapping for this demo
    }
    return 1;
}

fn main() -> trit {
    let input: trit[] = [1, 0, -1, -1, 1, 0, 0, -1];
    let output: trit[4];
    
    println("Performing Max Pooling (window size 2) on [1, 0, -1, -1, 1, 0, 0, -1]...");
    max_pool_trit(input, 8, 2, output);
    
    println("Output (expected [1, -1, 1, 0]):");
    let k: int = 0;
    while k < 4 {
        print(output[k]); print(" ");
        k = k + 1;
    }
    println("");
    
    if output[0] == 1 && output[1] == -1 && output[2] == 1 && output[3] == 0 {
        println("Max pooling OK.");
        return 1;
    }
    
    return -1;
}
