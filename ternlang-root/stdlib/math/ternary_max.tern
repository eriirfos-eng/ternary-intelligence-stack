// stdlib/math/ternary_max.tern
// Demonstrates: Maximum of two trits (higher signal wins).
// Tier: 1 — Open Core

fn t_max(a: trit, b: trit) -> trit {
    if a > b { return a; }
    return b;
}

fn main() -> trit {
    // Test: max(1, 0) = 1
    if t_max(1, 0) != 1 { return conflict(); }
    
    // Test: max(-1, 0) = 0
    if t_max(-1, 0) != 0 { return conflict(); }
    
    // Test: max(1, 1) = 1
    if t_max(1, 1) != 1 { return conflict(); }
    
    // Test: max(-1, -1) = -1
    if t_max(-1, -1) != -1 { return conflict(); }
    
    return truth();
}
