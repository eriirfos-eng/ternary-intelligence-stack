// stdlib/math/ternary_is_positive.tern
// Demonstrates: A boolean-like check for positive trit values.
// Tier: 1 — Open Core

fn is_positive(val: trit) -> trit {
    match val {
         1 => { return truth();    }
         0 => { return conflict(); }
        -1 => { return conflict(); }
    }
}

fn main() -> trit {
    if is_positive(1) != truth() { return conflict(); }
    if is_positive(0) == truth() { return conflict(); }
    if is_positive(-1) == truth() { return conflict(); }
    
    return truth();
}
