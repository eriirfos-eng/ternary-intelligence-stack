// stdlib/math/ternary_range_check.tern
// Demonstrates: Range check with boundary ambiguity.
// Tier: 1 — Open Core
// Checks if a value is within [min, max].
// Returns:
//   1: Inside the range
//   0: On the boundary
//  -1: Outside the range

fn range_check(value: float, min: float, max: float) -> trit {
    if value > max {
        return -1;
    }
    if value < min {
        return -1;
    }
    // Check boundaries
    if value == max {
        return 0;
    }
    if value == min {
        return 0;
    }
    
    // Must be inside
    return 1;
}

// Test Cases
let r1: trit = range_check(5.0, 0.0, 10.0);  // Should be 1
let r2: trit = range_check(15.0, 0.0, 10.0); // Should be -1
let r3: trit = range_check(0.0, 0.0, 10.0);  // Should be 0

println("Value 5 in [0, 10]: ", r1);
println("Value 15 in [0, 10]: ", r2);
println("Value 0 in [0, 10]: ", r3);

if r1 == 1 {
    if r2 == -1 {
        if r3 == 0 {
            println("Range Check Test Passed.");
        }
    }
}
