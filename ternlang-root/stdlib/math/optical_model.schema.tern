// Module:  stdlib/math/optical_model.schema.tern
// Purpose: T-SON serialization schema for optical_model
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Optical_modelSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Optical_modelSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
