// stdlib/math/ternary_sqrt_int.tern
// Demonstrates: Integer square root using Heron's method.
// Tier: 1 — Open Core

fn t_sqrt(n: int) -> int {
    if n < 0 { return -1; }
    if n == 0 { return 0; }
    if n < 4 { return 1; }
    
    let x: int = n / 2;
    let y: int = (x + n / x) / 2;
    
    while y < x {
        x = y;
        y = (x + n / x) / 2;
    }
    return x;
}

fn main() -> trit {
    let s16: int = t_sqrt(16);
    if s16 == 4 {
        let s100: int = t_sqrt(100);
        if s100 == 10 {
            let s2: int = t_sqrt(2);
            if s2 == 1 {
                return truth();
            }
        }
    }
    return conflict();
}
