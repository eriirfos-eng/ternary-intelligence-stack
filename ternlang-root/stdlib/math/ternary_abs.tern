// stdlib/math/ternary_abs.tern
// Demonstrates: Ternary absolute value.
// Tier: 1 — Open Core

fn ternary_abs(x: trit) -> trit {
    match x {
        -1 => { return truth();   }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}

fn main() -> trit {
    let a: trit = -1;
    let b: trit = 0;
    let c: trit = 1;
    
    let abs_a: trit = ternary_abs(a);
    let abs_b: trit = ternary_abs(b);
    let abs_c: trit = ternary_abs(c);
    
    // abs(-1) should be 1
    match abs_a {
        1 => { 
            // abs(0) should be 0
            match abs_b {
                0 => {
                    // abs(1) should be 1
                    match abs_c {
                        1 => { return truth(); }
                        0 => { return conflict(); }
                        -1 => { return conflict(); }
                    }
                }
                1 => { return conflict(); }
                -1 => { return conflict(); }
            }
        }
        0 => { return conflict(); }
        -1 => { return conflict(); }
    }
}
