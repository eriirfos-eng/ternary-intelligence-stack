// stdlib/math/ternary_even_odd.tern
// Demonstrates: Parity check for integers returning ternary signal.
// Tier: 1 — Open Core

fn is_even(val: int) -> trit {
    let remainder: int = val % 2;
    if remainder == 0 {
        return truth();
    }
    return conflict(); // Odd
}

fn main() -> trit {
    if is_even(2) != 1 { return conflict(); }
    if is_even(3) == 1 { return conflict(); }
    if is_even(0) != 1 { return conflict(); }
    if is_even(-2) != 1 { return conflict(); }
    if is_even(-1) == 1 { return conflict(); }
    
    return truth();
}
