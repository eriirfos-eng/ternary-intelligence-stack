// stdlib/logic/ternary_conjunction.tern
// Demonstrates: Kleene three-valued conjunction (AND) in ternary.
// Tier: 1 — Open Core
// Kleene AND: reject (-1) is dominant, affirm (1) is identity, tend (0) is uncertain.

fn ternary_and(a: trit, b: trit) -> trit {
    match a {
        -1 => { return reject; }
         0 => { 
            match b {
                -1 => { return reject; }
                 0 => { return tend;   }
                 1 => { return tend;   }
            }
         }
         1 => { return b; }
    }
}

fn main() -> trit {
    // Test cases
    if ternary_and(affirm, affirm) != affirm { return reject; }
    if ternary_and(affirm, tend)   != tend   { return reject; }
    if ternary_and(affirm, reject) != reject { return reject; }
    if ternary_and(tend, tend)     != tend   { return reject; }
    if ternary_and(tend, reject)   != reject { return reject; }
    if ternary_and(reject, tend)   != reject { return reject; }

    return affirm;
}
