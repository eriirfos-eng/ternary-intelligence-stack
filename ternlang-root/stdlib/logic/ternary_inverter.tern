// stdlib/logic/ternary_inverter.tern
// Demonstrates: Ternary inverter (NOT gate) logic for balanced ternary.
// Tier: 1

fn ternary_not(x: trit) -> trit {
    // In balanced ternary NOT is simply negation: -x
    // +1 -> -1, 0 -> 0, -1 -> +1
    let result: trit = 0;
    match x {
        1  => { result = -1; }
        0  => { result = 0;  }
        -1 => { result = 1;  }
    }
    return result;
}

fn main() -> trit {
    let a: trit = 1;
    let b: trit = 0;
    let c: trit = -1;
    
    println("NOT 1:");
    println(ternary_not(a));
    println("NOT 0:");
    println(ternary_not(b));
    println("NOT -1:");
    println(ternary_not(c));
    
    println("Program exited successfully.");
    return 1;
}
