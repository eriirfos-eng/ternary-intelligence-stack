/*
 * Ternary Comparator — Compares two 3-trit words and returns relationship.
 * Returns: 1 (A > B), -1 (A < B), 0 (A == B).
 * 
 * RFI-IRFOS · PUBLIC repo · v1.0
 */

fn compare_words(a: trit[3], b: trit[3]) -> trit {
    // Most significant trit first (index 0)
    let i: int = 0;
    while i < 3 {
        if a[i] > b[i] { return 1; }
        if a[i] < b[i] { return -1; }
        i = i + 1;
    }
    return 0; // All equal
}

fn main() -> trit {
    // A: 1 0 -1 (Decimal: 9 + 0 - 1 = 8)
    // B: 1 -1 1 (Decimal: 9 - 3 + 1 = 7)
    let a: trit[3] = [1, 0, -1];
    let b: trit[3] = [1, -1, 1];
    
    // C: 1 0 -1
    let c: trit[3] = [1, 0, -1];
    
    println("Compare A and B (Expected 1):");
    let r1: trit = compare_words(a, b);
    println(cast(r1));
    
    println("Compare B and A (Expected -1):");
    let r2: trit = compare_words(b, a);
    println(cast(r2));
    
    println("Compare A and C (Expected 0):");
    let r3: trit = compare_words(a, c);
    println(cast(r3));
    
    if r1 == 1 && r2 == -1 && r3 == 0 {
        println("Ternary Comparator Test: PASSED");
        return 1;
    }
    
    return -1;
}
