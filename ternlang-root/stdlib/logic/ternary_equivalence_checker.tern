// stdlib/logic/ternary_equivalence_checker.tern
// Exhaustive equivalence checker for small ternary logic functions.
// Tier: 1 - Open Core

fn circuit1(a: trit, b: trit) -> trit {
    // a AND b (using min)
    if a < b { return a; }
    return b;
}

fn circuit2(a: trit, b: trit) -> trit {
    // a AND b (using if-else)
    if a == 1 && b == 1 { return 1; }
    if a == -1 || b == -1 { return -1; }
    return 0;
}

fn check_equivalence_2() -> trit {
    let trits: trit[] = [1, 0, -1];
    let i: int = 0;
    while i < 3 {
        let j: int = 0;
        while j < 3 {
            let a: trit = trits[i];
            let b: trit = trits[j];
            if circuit1(a, b) != circuit2(a, b) {
                println("Inequivalence found at:");
                print("a="); print(a); print(", b="); println(b);
                return -1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return 1;
}

fn main() -> trit {
    println("Checking equivalence of two implementations of Ternary AND...");
    let res: trit = check_equivalence_2();
    
    if res == 1 {
        println("Circuits are equivalent.");
        return 1;
    } else {
        println("Circuits are NOT equivalent.");
        return -1;
    }
}
