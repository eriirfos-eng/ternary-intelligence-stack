// stdlib/logic/fuzzy_membership.tern
// Demonstrates: Fuzzy set membership using ternary logic.
// Tier: 1 — Open Core
// Maps a continuous membership score (0.0 to 1.0) to a discrete trit.
// - High score (> 0.8) -> Affirm (Member)
// - Low score (< 0.2) -> Reject (Not a Member)
// - Middle zone -> Tend (Uncertain / Partial Member)

fn fuzzy_member(score: float) -> trit {
    if score > 0.8 {
        return affirm;
    }
    if score < 0.2 {
        return reject;
    }
    return tend;
}

fn main() -> trit {
    if fuzzy_member(0.95) != affirm { return reject; }
    if fuzzy_member(0.05) != reject { return reject; }
    if fuzzy_member(0.5)  != tend   { return reject; }
    
    return affirm;
}
