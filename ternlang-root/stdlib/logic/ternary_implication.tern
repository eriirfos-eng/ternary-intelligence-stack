// stdlib/logic/ternary_implication.tern
// Demonstrates: Kleene three-valued implication logic.
// Tier: 1 — Open Core
// Kleene Implication (a -> b) is defined as NOT(a) OR b.
// If premise is reject (-1), result is affirm (1).
// If premise is affirm (1), result is b.
// If premise is tend (0), result is 1 if b is 1, else 0.

fn ternary_implies(a: trit, b: trit) -> trit {
    match a {
        -1 => { return affirm; }
         0 => { 
            match b {
                 1 => { return affirm; }
                 0 => { return tend;   }
                -1 => { return tend;   }
            }
         }
         1 => { return b; }
    }
}

fn main() -> trit {
    // Test cases
    if ternary_implies(reject, reject) != affirm { return reject; }
    if ternary_implies(reject, tend)   != affirm { return reject; }
    if ternary_implies(reject, affirm) != affirm { return reject; }
    if ternary_implies(tend, reject)   != tend   { return reject; }
    if ternary_implies(tend, tend)     != tend   { return reject; }
    if ternary_implies(tend, affirm)   != affirm { return reject; }
    if ternary_implies(affirm, reject) != reject { return reject; }
    if ternary_implies(affirm, tend)   != tend   { return reject; }
    if ternary_implies(affirm, affirm) != affirm { return reject; }

    return affirm;
}
