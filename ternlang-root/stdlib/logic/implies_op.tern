// stdlib/logic/implies_op.tern
// Demonstrates: Ternary implication (if A then B)
// Tier: 1 - Open Core

fn implies(a: trit, b: trit) -> trit {
    // Implication A -> B is (~A OR B)
    // -1 -> X = 1
    // 0 -> 1 = 1, 0 -> 0 = 0, 0 -> -1 = 0
    // 1 -> X = X
    if a == -1 {
        return affirm;
    }
    if a == 0 {
        if b == 1 { return affirm; }
        return tend;
    }
    return b;
}

fn main() -> trit {
    let a: trit = tend;
    let b: trit = reject;
    
    let res: trit = implies(a, b);
    
    match res {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
