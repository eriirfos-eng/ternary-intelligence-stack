// stdlib/logic/not_equal.tern
// Demonstrates: Ternary inequality operator wrapper
// Tier: 1 - Open Core

fn is_not_equal(a: trit, b: trit) -> trit {
    if a == b {
        return reject;
    } else {
        return affirm;
    }
}

fn main() -> trit {
    let a: trit = affirm;
    let b: trit = reject;
    
    let res: trit = is_not_equal(a, b);
    
    match res {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
