// stdlib/logic/ternary_vote_aggregation.tern
// Demonstrates: Three-way vote aggregation (Yes/No/Abstain).
// Tier: 1 — Open Core
// Aggregates an array of trits into a single consensus decision.

fn aggregate_votes(votes: trit[]) -> trit {
    let yes_count: int = 0;
    let no_count: int = 0;
    let abstain_count: int = 0;
    let i: int = 0;
    
    // Aggregation loop for 10 voters
    while i < 10 {
        match votes[i] {
            1  => { yes_count = yes_count + 1; }
            0  => { abstain_count = abstain_count + 1; }
            -1 => { no_count = no_count + 1; }
        }
        i = i + 1;
    }
    
    // Simple logic:
    // If Yes > No + Abstain -> Strong Yes (+1)
    // If No > Yes + Abstain -> Strong No (-1)
    // Else -> Uncertain (0)
    
    if yes_count > (no_count + abstain_count) {
        return 1;
    }
    if no_count > (yes_count + abstain_count) {
        return -1;
    }
    
    return 0;
}

// Setup 10 votes: [1, 1, 1, 1, 1, 1, 0, 0, -1, -1] -> 6 Yes, 2 Abstain, 2 No
let votes: trit[] = [1, 1, 1, 1, 1, 1, 0, 0, -1, -1];
let decision: trit = aggregate_votes(votes);

match decision {
    1 => { println("Consensus: Strong Yes."); }
    0 => { println("Consensus: Uncertain/Hold."); }
    -1 => { println("Consensus: Strong No."); }
}

// This should be 1
if decision == 1 {
    println("Test Passed.");
} else {
    println("Test Failed.");
}
