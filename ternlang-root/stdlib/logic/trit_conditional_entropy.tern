// stdlib/logic/trit_conditional_entropy.tern
// Calculation of conditional entropy for ternary signals.
// Tier: 1 - Open Core

fn log2_float(x: float) -> float {
    // ln(x) / ln(2)
    // Using a simple Taylor series for ln(x) around 1.0 is not great for large x,
    // but here probabilities are [0, 1].
    // ln(x) = (x-1) - (x-1)^2/2 + (x-1)^3/3 - ...
    if x <= 0.0 { return 0.0; }
    let val: float = x - 1.0;
    let res: float = val - (val * val) / 2.0 + (val * val * val) / 3.0;
    return res / 0.693147;
}

fn conditional_entropy(joint: float[9], marginal_x: float[3]) -> float {
    let entropy: float = 0.0;
    let i: int = 0;
    while i < 3 {
        let j: int = 0;
        while j < 3 {
            let p_xy: float = joint[i * 3 + j];
            if p_xy > 0.0 {
                let p_y_given_x: float = p_xy / marginal_x[i];
                entropy = entropy - p_xy * log2_float(p_y_given_x);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return entropy;
}

fn main() -> trit {
    // Joint distribution P(X, Y)
    let joint: float[9];
    // X=row, Y=col
    joint[0] = 0.4; joint[1] = 0.0; joint[2] = 0.0; // P(X=1, Y)
    joint[3] = 0.0; joint[4] = 0.4; joint[5] = 0.0; // P(X=0, Y)
    joint[6] = 0.0; joint[7] = 0.0; joint[8] = 0.2; // P(X=-1, Y)
    
    // Marginal P(X)
    let marginal_x: float[3];
    marginal_x[0] = 0.4;
    marginal_x[1] = 0.4;
    marginal_x[2] = 0.2;
    
    println("Calculating conditional entropy H(Y|X)...");
    let h: float = conditional_entropy(joint, marginal_x);
    
    print("H(Y|X) (expected 0.0 for deterministic): "); println(h);
    
    if h > -0.01 && h < 0.01 {
        println("Conditional entropy OK.");
        return 1;
    }
    
    return -1;
}
