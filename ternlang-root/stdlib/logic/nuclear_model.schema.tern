// Module:  stdlib/logic/nuclear_model.schema.tern
// Purpose: T-SON serialization schema for nuclear_model
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Nuclear_modelSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Nuclear_modelSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
