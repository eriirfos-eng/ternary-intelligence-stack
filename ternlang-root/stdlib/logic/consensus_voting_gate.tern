// stdlib/logic/consensus_voting_gate.tern
// Demonstrates: Three-input consensus voting gate.
// Tier: 1

fn consensus_vote(a: trit, b: trit, c: trit) -> trit {
    // Returns 1 if at least two inputs are 1
    // Returns -1 if at least two inputs are -1
    // Returns 0 otherwise (lack of clear majority)
    let sum: int = 0;
    sum = sum + cast(a);
    sum = sum + cast(b);
    sum = sum + cast(c);
    
    let res: trit = 0;
    if sum > 0 {
        res = 1;
    } else {
        if sum < 0 {
            res = -1;
        }
    }
    return res;
}

fn main() -> trit {
    let a: trit = 1;
    let b: trit = -1;
    let c: trit = 1;
    
    let vote: trit = consensus_vote(a, b, c);
    println("Vote result for [1, -1, 1]:");
    println(vote);
    
    println("Program exited successfully.");
    return 1;
}
