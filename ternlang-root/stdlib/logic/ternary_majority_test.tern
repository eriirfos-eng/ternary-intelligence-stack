// stdlib/logic/ternary_majority_test.tern
// Demonstrates: Three-way majority voting in ternary logic.
// Returns the value that appears at least twice.
// If all three are different, returns tend (0).
// Tier: 1 — Open Core

fn t_majority(a: trit, b: trit, c: trit) -> trit {
    if a == b { return a; }
    if a == c { return a; }
    if b == c { return b; }
    return tend;
}

fn main() -> trit {
    if t_majority(affirm, affirm, reject) != affirm { return reject; }
    if t_majority(reject, tend, reject)   != reject { return reject; }
    if t_majority(affirm, tend, reject)   != tend   { return reject; }
    if t_majority(tend, tend, tend)       != tend   { return reject; }
    
    return affirm;
}
