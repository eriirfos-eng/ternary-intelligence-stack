// stdlib/logic/ternary_flip_flop.tern
// Demonstrates: Ternary JK-style flip-flop logic (toggle on conflicting input).
// Tier: 1

fn update_flip_flop(q: trit, j: trit, k: trit) -> trit {
    // Balanced ternary JK:
    // J=1, K=0 -> 1
    // J=0, K=1 -> -1
    // J=1, K=1 -> -q (toggle)
    // J=0, K=0 -> q (hold)
    let result: trit = q;
    if j == 1 {
        if k == 1 {
            result = -q;
        } else {
            result = 1;
        }
    } else {
        if k == 1 {
            result = -1;
        }
    }
    return result;
}

fn main() -> trit {
    let q: trit = 0;
    
    println("Initial Q:");
    println(q);
    
    q = update_flip_flop(q, 1, 0);
    println("After J=1, K=0:");
    println(q);
    
    q = update_flip_flop(q, 1, 1);
    println("After J=1, K=1 (Toggle):");
    println(q);
    
    println("Program exited successfully.");
    return 1;
}
