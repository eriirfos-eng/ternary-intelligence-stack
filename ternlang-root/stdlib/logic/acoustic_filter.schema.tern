// Module:  stdlib/logic/acoustic_filter.schema.tern
// Purpose: T-SON serialization schema for acoustic_filter
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Acoustic_filterSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Acoustic_filterSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
