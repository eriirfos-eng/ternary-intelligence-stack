// stdlib/logic/ternary_xor_test.tern
// Demonstrates: Kleene-style Ternary XOR (exclusive or).
// In ternary XOR, if either input is 0 (tend), the output is 0.
// If both are 1 or both are -1, output is -1 (reject).
// If one is 1 and other is -1, output is 1 (affirm).
// Tier: 1 — Open Core

fn t_xor(a: trit, b: trit) -> trit {
    match a {
        0 => { return tend; }
        1 => {
            match b {
                0 => { return tend; }
                1 => { return reject; }
                -1 => { return affirm; }
            }
        }
        -1 => {
            match b {
                0 => { return tend; }
                1 => { return affirm; }
                -1 => { return reject; }
            }
        }
    }
}

fn main() -> trit {
    // Test cases
    if t_xor(affirm, reject) != affirm { return reject; }
    if t_xor(affirm, affirm) != reject { return reject; }
    if t_xor(tend, affirm)   != tend   { return reject; }
    if t_xor(reject, reject) != reject { return reject; }
    
    return affirm;
}
