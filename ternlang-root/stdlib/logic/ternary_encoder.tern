// stdlib/logic/ternary_encoder.tern
// Demonstrates: Ternary 3-to-1 encoder (converts one-hot encoding back to trit).
// Tier: 1

fn encode_one_hot(one_hot: trittensor<3>) -> trit {
    let result: trit = 0;
    if one_hot[0] == 1 {
        result = -1;
    } else {
        if one_hot[1] == 1 {
            result = 0;
        } else {
            if one_hot[2] == 1 {
                result = 1;
            }
        }
    }
    return result;
}

fn main() -> trit {
    let input: trittensor<3>;
    input[0] = 0;
    input[1] = 0;
    input[2] = 1;
    
    let res: trit = encode_one_hot(input);
    println("One-hot [0, 0, 1] encoded to:");
    println(res);
    
    println("Program exited successfully.");
    return 1;
}
