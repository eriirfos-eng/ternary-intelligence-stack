// Module:  stdlib/logic/stellar_solver.schema.tern
// Purpose: T-SON serialization schema for stellar_solver
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Stellar_solverSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Stellar_solverSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
