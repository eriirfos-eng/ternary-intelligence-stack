// Module:  stdlib/science/nuclear_system.schema.tern
// Purpose: T-SON serialization schema for nuclear_system
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Nuclear_systemSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Nuclear_systemSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
