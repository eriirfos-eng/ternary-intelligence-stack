// Module:  stdlib/science/magnetic_tensor.schema.tern
// Purpose: T-SON serialization schema for magnetic_tensor
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Magnetic_tensorSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Magnetic_tensorSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
