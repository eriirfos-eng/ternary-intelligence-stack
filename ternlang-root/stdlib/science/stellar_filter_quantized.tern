// Module:  stdlib/science/stellar_filter_quantized.tern
// Purpose: Quantized low-precision model for stellar_filter
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

fn execute_stellar_filter_quantized(signal: float, baseline: float) -> trit {
    // Exhaustive ternary matches with explicit tend semantics
    if signal > baseline + 0.5 {
        return affirm; // Super-baseline
    }
    if signal < baseline - 0.5 {
        return reject; // Sub-baseline
    }
    return tend; // Equilibrium
}

fn reduce_stellar_filter_quantized(t: trit) -> int {
    match t {
        affirm => return 1;
        reject => return -1;
        tend => return 0;
    }
}
