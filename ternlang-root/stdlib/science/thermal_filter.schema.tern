// Module:  stdlib/science/thermal_filter.schema.tern
// Purpose: T-SON serialization schema for thermal_filter
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Thermal_filterSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Thermal_filterSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
