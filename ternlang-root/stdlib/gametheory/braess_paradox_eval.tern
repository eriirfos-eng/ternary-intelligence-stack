// stdlib/gametheory/braess_paradox_eval.tern
// Demonstrates: Braess Paradox evaluation in selfish network routing.
// Tier: 3 — Industrial

fn evaluate_new_route(old_latency: float, new_latency: float, congestion_factor: float) -> trit {
    // If new route plus congestion makes total latency worse than old
    if new_latency * congestion_factor > old_latency {
        return conflict(); // Paradox triggered: new route slows everyone down
    }

    if new_latency * congestion_factor < old_latency * 0.9 {
        return truth(); // Significant improvement
    }

    return hold(); // Marginal or no change
}

fn main() -> trit {
    let old_l: float = 10.0;
    let new_l: float = 6.0;
    let cong: float = 2.0;

    let eval: trit = evaluate_new_route(old_l, new_l, cong);

    match eval {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
