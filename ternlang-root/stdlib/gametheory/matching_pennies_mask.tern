// stdlib/gametheory/matching_pennies_mask.tern
// Demonstrates: Prediction logic in a Matching Pennies zero-sum game.
// Tier: 3 — Industrial

fn predict_opponent(past_moves: trit[]) -> trit {
    let sum: int = 0;
    for m in past_moves {
        if m == 1 { sum = sum + 1; }
        if m == -1 { sum = sum - 1; }
    }

    if sum > 0 {
        return truth(); // Opponent prefers heads (+1)
    }

    if sum < 0 {
        return conflict(); // Opponent prefers tails (-1)
    }

    return hold(); // No preference detected
}

fn main() -> trit {
    let history: trit[];
    history = [1, 1, -1, 1, 0];

    let p: trit = predict_opponent(history);

    match p {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
