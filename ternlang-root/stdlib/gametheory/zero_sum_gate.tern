// stdlib/gametheory/zero_sum_gate.tern
// Demonstrates: Zero-sum outcome validation between two players
// Tier: 3

fn validate_zero_sum(gain_a: float, loss_b: float) -> trit {
    let diff: float = gain_a - loss_b;
    
    // epsilon-based zero check
    if diff < 0.001 && diff > -0.001 {
        return affirm; // matches perfectly
    }
    
    if diff > 0.0 {
        return tend; // a gained more than b lost
    }
    
    return reject; // b lost more than a gained
}

fn main() -> trit {
    let valid: trit = validate_zero_sum(100.0, 100.0);
    match valid {
        reject => { return conflict(); }
        tend   => { return hold();    }
        affirm => { return truth();   }
    }
}
