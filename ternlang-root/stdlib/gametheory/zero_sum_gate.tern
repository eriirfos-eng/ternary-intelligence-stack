// stdlib/gametheory/zero_sum_gate.tern
// Demonstrates: checking if two agent outcomes sum to zero
// Tier: 2 — Pro Standard

fn is_zero_sum(p1: int, p2: int) -> trit {
    if (p1 + p2) == 0 { return truth(); }
    return conflict();
}

fn main() -> trit {
    let pay1: int = 10;
    let pay2: int = -10;
    
    let ok: trit = is_zero_sum(pay1, pay2);
    match ok {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
