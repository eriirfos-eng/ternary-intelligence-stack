// stdlib/gametheory/hawk_dove_strategy.tern
// Demonstrates: Hawk-Dove resource competition game
// Tier: 3

fn hawk_dove(me: trit, other: trit) -> float {
    // 1: Hawk (Aggressive), -1: Dove (Passive)
    // Payoffs: Value=10, Cost=20
    
    if me == reject && other == reject {
        return 5.0; // Both Doves: split value (V/2)
    }
    
    if me == reject && other == affirm {
        return 0.0; // Me Dove, Other Hawk: I get nothing
    }
    
    if me == affirm && other == reject {
        return 10.0; // Me Hawk, Other Dove: I get all (V)
    }
    
    if me == affirm && other == affirm {
        return -5.0; // Both Hawks: fight (V-C)/2 = (10-20)/2 = -5
    }
    
    return 0.0;
}

fn main() -> trit {
    let payoff: float = hawk_dove(affirm, affirm);
    if payoff < 0.0 {
        return reject; // loss
    }
    if payoff > 0.0 {
        return affirm; // gain
    }
    return tend; // neutral
}
