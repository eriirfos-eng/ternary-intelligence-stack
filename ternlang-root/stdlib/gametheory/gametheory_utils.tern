// stdlib/gametheory/gametheory_utils.tern
// Demonstrates: Utilities for game theory analysis
// Tier: 3 — Industrial

// Returns 1 if strategy is optimal, -1 if suboptimal, 0 if unsure
fn evaluate_strategy(payoff: float, best_possible: float) -> trit {
    if payoff > (best_possible * 0.95) {
        return 1;
    }
    if payoff < (best_possible * 0.5) {
        return -1;
    }
    return 0;
}

// Consensus for strategy agreement
fn strategy_consensus(s1: trit, s2: trit) -> trit {
    return consensus(s1, s2);
}

fn main() -> trit {
    let s: trit = evaluate_strategy(10.0, 10.0);
    match s {
        -1 => { return conflict(); }
         0 => { return hold(); }
         1 => { return truth(); }
    }
}
