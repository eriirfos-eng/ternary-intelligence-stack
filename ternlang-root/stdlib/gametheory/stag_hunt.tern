// stdlib/gametheory/stag_hunt.tern
// Demonstrates: Stag Hunt coordination game logic
// Tier: 3

fn evaluate_hunt(p1_choice: trit, p2_choice: trit) -> trit {
    // 1: Stag (High reward, requires coop)
    // -1: Hare (Low reward, safe, works solo)
    
    if p1_choice == affirm && p2_choice == affirm {
        return affirm; // Both hunt stag - maximum payoff
    }
    
    if p1_choice == reject || p2_choice == reject {
        return reject; // At least one went for hare - coordination failed
    }
    
    return tend; // Uncertain/neutral
}

fn main() -> trit {
    let result: trit = evaluate_hunt(affirm, affirm);
    match result {
        reject => { return conflict(); }
        tend   => { return hold();    }
        affirm => { return truth();   }
    }
}
