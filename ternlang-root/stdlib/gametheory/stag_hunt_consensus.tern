// stdlib/gametheory/stag_hunt_consensus.tern
// Demonstrates: reaching consensus on a high-risk high-reward strategy
// Tier: 2 — Pro Standard

fn decide_strategy(p1: trit, p2: trit) -> trit {
    // Both must agree on Affirm (Stag) or both on Reject (Hare)
    if p1 == p2 { return p1; }
    return hold(); // Coordination failure
}

fn main() -> trit {
    let agent1: trit = 1;
    let agent2: trit = 1;
    
    let res: trit = decide_strategy(agent1, agent2);
    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
