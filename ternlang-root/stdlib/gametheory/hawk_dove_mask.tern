// stdlib/gametheory/hawk_dove_mask.tern
// Demonstrates: masking agent types in a Hawk-Dove simulation
// Tier: 2 — Pro Standard

fn get_type(aggression: float, threshold: float) -> trit {
    if aggression > threshold { return 1; } // Hawk
    if aggression < (threshold * 0.5) { return -1; } // Dove
    return 0; // Neutral / Transition
}

fn main() -> trit {
    let agg: float = 0.8;
    let t: float = 0.5;
    
    let res: trit = get_type(agg, t);
    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
