// stdlib/gametheory/pavlov_strategy.tern
// Demonstrates: Pavlov (Win-Stay, Lose-Shift) strategy in iterated games.
// Tier: 3 — Industrial

fn next_move(my_last: trit, other_last: trit) -> trit {
    // Both cooperate (+1, +1) -> Win -> Stay (+1)
    // Both defect (-1, -1) -> Win (relative to mutual) -> Stay (+1)
    // One cooperates, one defects (+1, -1) -> Loss for cooperator -> Shift
    
    if my_last == other_last {
        return truth(); // Cooperate next
    }

    return conflict(); // Defect next
}

fn main() -> trit {
    let mine: trit = truth();
    let other: trit = conflict();

    let res: trit = next_move(mine, other);

    match res {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
