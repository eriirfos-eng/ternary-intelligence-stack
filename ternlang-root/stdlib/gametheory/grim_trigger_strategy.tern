// stdlib/gametheory/grim_trigger_strategy.tern
// Demonstrates: Grim Trigger strategy in repeated games.
// Tier: 3 — Industrial

fn next_move(any_past_defection: trit) -> trit {
    match any_past_defection {
        1 => { return conflict(); } // A defection occurred, defect forever
        0 => { return truth();    } // Cooperate by default
       -1 => { return conflict(); } // Error state, defect for safety
    }
}

fn main() -> trit {
    let defection_occurred: trit = 0; // No defection yet
    let move: trit = next_move(defection_occurred);

    if move == 1 {
        return truth();
    }
    
    return hold();
}
