// stdlib/physical/mass_spring_sim.tern
// Demonstrates: A simple mass-spring simulation step using Hooke's law.
// Tier: 3 — Industrial

fn calculate_force(k: float, x: float, rest_x: float) -> float {
    return -k * (x - rest_x);
}

fn main() -> trit {
    let k: float = 10.0;
    let x: float = 1.5;
    let rest_x: float = 1.0;
    
    let force: float = calculate_force(k, x, rest_x);
    
    // Check if force is within safety limits
    if force < -10.0 { 
        return conflict(); 
    }
    if force > 10.0 { 
        return conflict(); 
    }
    
    return truth();
}
