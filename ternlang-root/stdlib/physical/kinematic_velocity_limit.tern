// stdlib/physical/kinematic_velocity_limit.tern
// Demonstrates: checking if a moving object exceeds safe velocity limits
// Tier: 3 — Industrial

fn check_velocity(v: float, max_v: float) -> trit {
    if v < 0.0 { v = -v; }
    
    if v > max_v { return conflict(); } // Too fast
    if v > (max_v * 0.9) { return hold(); } // Near limit
    
    return truth(); // Safe speed
}

fn main() -> trit {
    let speed: float = -15.5; // Moving backwards
    let limit: float = 20.0;
    
    let is_safe: trit = check_velocity(speed, limit);
    match is_safe {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
