// stdlib/physical/stress_strain_limit_check.tern
// Demonstrates: Checking stress and strain limits
// Tier: 3

fn check_material_limit(stress: float, strain: float, yield_stress: float, yield_strain: float) -> trit {
    // If either stress or strain exceed yield point, material fails (reject)
    if stress > yield_stress {
        return reject;
    }
    if strain > yield_strain {
        return reject;
    }
    
    // Safety buffer (90%)
    if stress > yield_stress * 0.9 {
        return tend;
    }
    
    return affirm; // Safe range
}

fn main() -> trit {
    let s: float = 100.0;
    let st: float = 0.001;
    let ys: float = 120.0;
    let yst: float = 0.002;
    
    let res: trit = check_material_limit(s, st, ys, yst);
    
    if res == affirm {
        return truth();
    }
    return hold();
}
