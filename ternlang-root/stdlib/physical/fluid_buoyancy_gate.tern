// stdlib/physical/fluid_buoyancy_gate.tern
// Demonstrates: Gating buoyancy in a fluid
// Tier: 3

fn buoyancy_gate(obj_density: float, fluid_density: float) -> trit {
    // If object density < fluid density, it floats (affirm)
    if obj_density < fluid_density {
        return affirm;
    }
    // If object density > fluid density, it sinks (reject)
    if obj_density > fluid_density {
        return reject;
    }
    // Neutral buoyancy
    return tend;
}

fn main() -> trit {
    let d_obj: float = 0.9;
    let d_flu: float = 1.0;
    
    let res: trit = buoyancy_gate(d_obj, d_flu);
    
    if res == affirm {
        return truth();
    }
    return hold();
}
