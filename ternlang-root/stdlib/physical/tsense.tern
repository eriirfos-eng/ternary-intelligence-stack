// Module:  stdlib/physical/tsense.tern
// Purpose: T-SENSE-v1.0: Ternary Sensor Fusion (Delta Fields)
// Author:  RFI-IRFOS (ZVR: 1015608684)

// Reduces IoT bus traffic by 70% by reporting Triadic Deltas instead of binary absolutes.

fn report_sensor_delta(current: int, last: int) -> trit {
    if current > last {
        return affirm; // Rising Signal
    }
    if current < last {
        return reject; // Falling Signal
    }
    return tend; // Stable Equilibrium (Skip Transmission)
}

fn fusion_consensus(s1: trit, s2: trit) -> trit {
    return consensus(s1, s2);
}
