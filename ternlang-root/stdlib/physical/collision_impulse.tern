// stdlib/physical/collision_impulse.tern
// Demonstrates: Calculation of collision impulse with ternary energy check.
// Tier: 3 — Industrial

fn calculate_impulse(m: float, v1: float, v2: float) -> float {
    return m * (v2 - v1);
}

fn main() -> trit {
    let m: float = 2.0;
    let v1: float = 10.0;
    let v2: float = -5.0; // Bounce back
    
    let J: float = calculate_impulse(m, v1, v2);
    
    // J = 2 * (-5 - 10) = -30
    if J < -20.0 {
        return truth(); // Significant impulse
    }
    return hold();
}
