// stdlib/physical/pendulum_oscillation_gate.tern
// Demonstrates: Gating based on pendulum phase
// Tier: 3

fn pendulum_gate(theta: float, omega: float) -> trit {
    // If pendulum is near peak (theta max, omega 0), affirm peak
    let peak_threshold: float = 0.1;
    let vel_threshold: float = 0.05;
    
    let vel_abs: float = omega;
    if vel_abs < 0.0 { vel_abs = 0.0 - vel_abs; }
    
    if vel_abs < vel_threshold {
        return affirm;
    }
    
    // If it's at maximum speed (theta 0, omega max), reject center
    let pos_abs: float = theta;
    if pos_abs < 0.0 { pos_abs = 0.0 - pos_abs; }
    
    if pos_abs < peak_threshold {
        return reject;
    }
    
    return tend;
}

fn main() -> trit {
    let theta: float = 0.01; // Near center
    let omega: float = 1.0;  // High velocity
    
    let res: trit = pendulum_gate(theta, omega); // should be reject
    
    if res == reject {
        return truth();
    }
    return hold();
}
