// stdlib/data/record_consensus_mask.tern
// Demonstrates: merging data records from multiple sources via consensus
// Tier: 2 — Pro Standard

fn merge_record(r1: trit, r2: trit, r3: trit) -> trit {
    return consensus(r1, consensus(r2, r3));
}

fn main() -> trit {
    let source1: trit = 1;
    let source2: trit = 1;
    let source3: trit = -1; // Outlier
    
    let res: trit = merge_record(source1, source2, source3);
    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
