// stdlib/data/duplicate_detection_gate.tern
// Demonstrates: gating data records to prevent duplicates
// Tier: 2 — Pro Standard

fn is_duplicate(id1: int, id2: int) -> trit {
    if id1 == id2 { return truth(); }
    return conflict();
}

fn main() -> trit {
    let r1: int = 1001;
    let r2: int = 1002;
    
    let res: trit = is_duplicate(r1, r2);
    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
