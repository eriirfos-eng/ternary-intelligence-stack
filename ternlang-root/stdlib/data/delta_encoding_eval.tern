// stdlib/data/delta_encoding_eval.tern
// Demonstrates: Evaluating delta encoding benefit based on sparsity.
// Tier: 2 - Pro Standard

// Returns 1 (use delta), 0 (marginal), -1 (don't use delta/full encode).
fn evaluate_delta(total_elements: int, changed_elements: int) -> trit {
    if total_elements == 0 { return hold(); }
    
    let sparsity: float = 1.0 - (1.0 * cast(changed_elements)) / cast(total_elements);
    
    // If > 90% is unchanged, delta is very efficient
    if sparsity > 0.9 {
        return affirm;
    }
    
    // If > 50% changed, full encode is better
    if sparsity < 0.5 {
        return reject;
    }
    
    return tend;
}

fn main() -> trit {
    let total: int = 1000;
    let changed: int = 45;
    
    let result: trit = evaluate_delta(total, changed);
    
    match result {
        -1 => { println("Full Encode Preferred"); }
         0 => { println("Marginal Delta Benefit"); }
         1 => { println("Delta Encode Preferred"); }
    }
    
    return result;
}
