// stdlib/data/stream_consistency_eval.tern
// Demonstrates: evaluating data stream consistency over time
// Tier: 2 — Pro Standard

fn check_consistency(prev: float, curr: float, max_jump: float) -> trit {
    let diff: float = curr - prev;
    if diff < 0.0 { diff = -diff; }
    
    if diff > max_jump { return conflict(); }
    if diff > (max_jump * 0.7) { return hold(); }
    return truth();
}

fn main() -> trit {
    let v1: float = 10.5;
    let v2: float = 11.2;
    let limit: float = 2.0;
    
    let res: trit = check_consistency(v1, v2, limit);
    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
