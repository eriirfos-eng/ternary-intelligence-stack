// stdlib/data/null_value_handler.tern
// Demonstrates: handling null/unknown values (represented by 0)
// Tier: 2 — Pro Standard

fn handle_null(val: trit, default_val: trit) -> trit {
    if val == 0 { return default_val; }
    return val;
}

fn main() -> trit {
    let raw_data: trit = 0;
    let def: trit = 1;
    
    let result: trit = handle_null(raw_data, def);
    match result {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
