// stdlib/scientific/chemical_reaction_equilibrium_eval.tern
// Demonstrates: Evaluating chemical reaction directionality (Le Chatelier)
// Tier: 3

fn gibbs_free_energy(delta_g: float) -> trit {
    if delta_g < -10.0 { return 1; }  // Spontaneous
    if delta_g > 10.0 { return -1; } // Non-spontaneous
    return 0; // Near equilibrium
}

fn reaction_quotient_eval(q: float, k: float) -> trit {
    if q < (k * 0.1) { return 1; }  // Forward favored
    if q > (k * 10.0) { return -1; } // Reverse favored
    return 0; // Equilibrium reached
}

fn main() -> trit {
    let dg: float = -20.0;
    let q: float = 1.0;
    let k: float = 100.0;
    
    let g_trit: trit = gibbs_free_energy(dg);
    let q_trit: trit = reaction_quotient_eval(q, k);
    
    match g_trit {
        -1 => { return -1; }
        0  => { return q_trit; }
        1  => {
            match q_trit {
                -1 => { return 0; } // Conflicting thermodynamic and kinetic indicators
                0  => { return 1; }
                1  => { return 1; }
            }
        }
    }
}
