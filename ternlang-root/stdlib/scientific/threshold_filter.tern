// stdlib/scientific/threshold_filter.tern
// Demonstrates: scientific signal filtering via noise threshold
// Tier: 3 — Industrial

fn filter_noise(signal: float, noise_floor: float) -> trit {
    if signal > noise_floor { return truth(); }
    if signal < -noise_floor { return conflict(); }
    return hold();
}

fn main() -> trit {
    let s1: float = 0.5;
    let s2: float = 0.1;
    let floor: float = 0.3;
    
    let r1: trit = filter_noise(s1, floor); // 1
    let r2: trit = filter_noise(s2, floor); // 0
    
    if r1 == 1 && r2 == 0 {
        return truth();
    }
    
    match r1 {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
