// stdlib/scientific/molecular_bond_consensus.tern
// Demonstrates: Stability of molecular configuration via energy thresholding.
// Tier: 3 — Industrial

fn check_stability(potential_energy: float, activation_energy: float) -> trit {
    if potential_energy < -activation_energy {
        return truth(); // Stable bond
    }
    if potential_energy < 0.0 {
        return hold(); // Meta-stable
    }
    return conflict(); // Dissociated
}

fn main() -> trit {
    let u_sys: float = -15.0;
    let u_threshold: float = 10.0;
    
    let state: trit = check_stability(u_sys, u_threshold);
    
    match state {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
