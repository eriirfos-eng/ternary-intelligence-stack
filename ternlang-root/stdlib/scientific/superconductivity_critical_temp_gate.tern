// stdlib/scientific/superconductivity_critical_temp_gate.tern
// Demonstrates: Evaluating phase transitions in superconductors
// Tier: 3

fn temp_phase_check(t: float, tc: float) -> trit {
    if t < (tc * 0.9) { return 1; } // Superconducting state
    if t > (tc * 1.1) { return -1; } // Normal state
    return 0; // Transitioning
}

fn magnetic_interference(b: float, bc: float) -> trit {
    if b > bc { return -1; } // Field destroys superconductivity
    if b < (bc * 0.5) { return 1; }
    return 0;
}

fn main() -> trit {
    let t: float = 4.0;
    let tc: float = 9.2; // Niobium
    let b: float = 100.0;
    let bc: float = 2000.0;
    
    let phase: trit = temp_phase_check(t, tc);
    let mag: trit = magnetic_interference(b, bc);
    
    match phase {
        1 => { return mag; }
        0 => { return 0; }
        -1 => { return -1; }
    }
}
