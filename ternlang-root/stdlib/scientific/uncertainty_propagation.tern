// stdlib/scientific/uncertainty_propagation.tern
// Demonstrates: uncertainty (0) propagation through arithmetic
// Tier: 3 — Industrial

fn main() -> trit {
    let precise: trit = 1;
    let uncertain: trit = 0;
    
    // In balanced ternary AND (min), 1 && 0 = 0
    let r1: trit = precise && uncertain;
    
    // In balanced ternary OR (max), 1 || 0 = 1
    let r2: trit = precise || uncertain;
    
    // In arithmetic, 1 + 0 = 1 (sum), 0 (carry)
    let r3: trit = precise + uncertain;
    
    if r1 == 0 && r2 == 1 && r3 == 1 {
        return truth();
    }
    
    match r1 {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
