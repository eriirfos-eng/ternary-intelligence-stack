// stdlib/scientific/thermodynamic_equilibrium_gate.tern
// Demonstrates: check for local thermodynamic equilibrium (LTE)
// Tier: 3 — Industrial

fn is_in_equilibrium(temp_a: float, temp_b: float, threshold: float) -> trit {
    let diff: float = temp_a - temp_b;
    if diff < 0.0 { diff = -diff; }

    if diff < threshold {
        return truth();   // Equilibrium reached
    }
    if diff > threshold * 10.0 {
        return conflict(); // Severe gradient
    }
    return hold();        // Transient state
}

fn main() -> trit {
    // Steady state
    let res1: trit = is_in_equilibrium(273.15, 273.16, 0.05); // 1
    // Violent gradient
    let res2: trit = is_in_equilibrium(300.0, 1000.0, 1.0);   // -1
    // Slight shift
    let res3: trit = is_in_equilibrium(300.0, 305.0, 1.0);    // 0

    match res1 {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => {
             match res2 {
                 -1 => {
                     match res3 {
                         -1 => { return conflict(); }
                          0 => { return truth(); }
                          1 => { return conflict(); }
                     }
                 }
                 0 => { return hold(); }
                 1 => { return conflict(); }
             }
         }
    }
}
