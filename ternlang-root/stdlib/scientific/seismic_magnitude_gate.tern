// stdlib/scientific/seismic_magnitude_gate.tern
// Demonstrates: seismic activity categorization (Minor/Moderate/Major)
// Tier: 3 — Industrial

fn categorize_seismic(magnitude: float) -> trit {
    if magnitude > 7.0 {
        return truth();   // Major/Critical event
    }
    if magnitude < 3.0 {
        return conflict(); // Minor/Noise
    }
    return hold();        // Moderate/Active
}

fn main() -> trit {
    // Large earthquake
    let res1: trit = categorize_seismic(8.2); // 1
    // Micro-tremor
    let res2: trit = categorize_seismic(1.5); // -1
    // Local quake
    let res3: trit = categorize_seismic(5.1); // 0

    match res1 {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => {
             match res2 {
                 -1 => {
                     match res3 {
                         -1 => { return conflict(); }
                          0 => { return truth(); }
                          1 => { return conflict(); }
                     }
                 }
                 0 => { return hold(); }
                 1 => { return conflict(); }
             }
         }
    }
}
