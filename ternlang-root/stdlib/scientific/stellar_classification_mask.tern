// stdlib/scientific/stellar_classification_mask.tern
// Demonstrates: Categorizing stars based on spectral and luminosity data
// Tier: 3

fn spectral_type_eval(temp_k: int) -> trit {
    if temp_k > 30000 { return 1; }  // Type O (Affirm hot)
    if temp_k < 3500 { return -1; } // Type M (Reject hot)
    return 0; // Type A-K (Moderate)
}

fn luminosity_check(lum_solar: float) -> trit {
    if lum_solar > 1000.0 { return 1; }  // Giant/Supergiant
    if lum_solar < 0.01 { return -1; } // Dwarf
    return 0; // Main sequence
}

fn main() -> trit {
    let t: int = 5800; // Sun
    let l: float = 1.0;
    
    let spec: trit = spectral_type_eval(t);
    let lum: trit = luminosity_check(l);
    
    match spec {
        -1 => { return -1; }
        1  => { return 1; }
        0  => { return lum; }
    }
}
