// stdlib/scientific/particle_trajectory_mask.tern
// Demonstrates: Collision path evaluation for particle simulators.
// Tier: 3 — Industrial

fn predict_collision(impact_param: float, collision_radius: float) -> trit {
    if impact_param < (collision_radius * 0.5) {
        return truth(); // Direct hit
    }
    if impact_param < collision_radius {
        return hold(); // Grazing collision
    }
    return conflict(); // Miss
}

fn main() -> trit {
    let b: float = 0.8;
    let r_coll: float = 1.0;
    
    let outcome: trit = predict_collision(b, r_coll);
    
    match outcome {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
