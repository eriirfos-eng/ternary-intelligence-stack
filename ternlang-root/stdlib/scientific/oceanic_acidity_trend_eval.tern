// stdlib/scientific/oceanic_acidity_trend_eval.tern
// Demonstrates: Analyzing environmental shifts in ocean pH
// Tier: 3

fn ph_health_check(ph: float) -> trit {
    if ph < 7.8 { return -1; } // Dangerously acidic for coral
    if ph > 8.2 { return 1; }  // Healthy alkalinity
    return 0; // Marginal
}

fn rate_of_change(delta_ph_per_decade: float) -> trit {
    if delta_ph_per_decade < -0.1 { return -1; } // Rapid acidification
    if delta_ph_per_decade < -0.01 { return 0; }
    return 1; // Stable
}

fn main() -> trit {
    let p: float = 8.1;
    let d: float = -0.05;
    
    let health: trit = ph_health_check(p);
    let trend: trit = rate_of_change(d);
    
    match health {
        -1 => { return -1; }
        0  => { return trend; }
        1  => {
            match trend {
                -1 => { return 0; }
                0  => { return 1; }
                1  => { return 1; }
            }
        }
    }
}
