// stdlib/scientific/neutron_star_density_check.tern
// Demonstrates: Analyzing extreme matter states in stellar remnants
// Tier: 3

fn nuclear_density_eval(rho_g_cm3: float) -> trit {
    let nsd: float = 230000000000000.0; // 2.3e14 g/cm3
    if rho_g_cm3 > (nsd * 10.0) { return -1; } // Quark-gluon plasma/Black hole
    if rho_g_cm3 > nsd { return 1; } // Neutron star matter
    return 0; // White dwarf / degenerate matter
}

fn magnetic_field_strength(b_gauss: float) -> trit {
    if b_gauss > 1000000000000.0 { return 1; } // Magnetar
    if b_gauss > 100000000.0 { return 0; } // Normal pulsar
    return -1; // Non-magnetic
}

fn main() -> trit {
    let r: float = 250000000000000.0;
    let b: float = 10000000000000.0;
    
    let rho: trit = nuclear_density_eval(r);
    let mag: trit = magnetic_field_strength(b);
    
    match rho {
        1 => { return mag; }
        0 => { return 0; }
        -1 => { return -1; }
    }
}
