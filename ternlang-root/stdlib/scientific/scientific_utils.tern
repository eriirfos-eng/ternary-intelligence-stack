// stdlib/scientific/scientific_utils.tern
// Demonstrates: Common utility functions for scientific modeling
// Tier: 3

fn consensus(a: trit, b: trit) -> trit {
    match a {
        -1 => { return -1; }
        0 => { return b; }
        1 => {
            match b {
                -1 => { return -1; }
                0 => { return 1; }
                1 => { return 1; }
            }
        }
    }
}

fn map_probability_to_trit(prob: float) -> trit {
    if prob > 0.9 { return 1; }
    if prob < 0.1 { return -1; }
    return 0;
}

fn main() -> trit {
    let p1: float = 0.95;
    let t1: trit = map_probability_to_trit(p1);
    
    match t1 {
        -1 => { return -1; }
        0  => { return 0;  }
        1  => { return 1;  }
    }
}
