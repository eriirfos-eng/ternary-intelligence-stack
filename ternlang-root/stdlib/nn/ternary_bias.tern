// stdlib/nn/ternary_bias.tern
// Demonstrates: Applying bias to a ternary neuron activation using consensus.
// Tier: 3 — Industrial

fn apply_bias(activation: trit, bias: trit) -> trit {
    // Bias in ternary can be modeled as a consensus with a fixed signal.
    return consensus(activation, bias);
}

fn main() -> trit {
    // Test: Neutral activation + positive bias -> 1
    if apply_bias(0, 1) != 1 { return conflict(); }
    
    // Test: Positive activation + negative bias -> 0 (Consensus(1, -1) = 0)
    if apply_bias(1, -1) != 0 { return conflict(); }
    
    // Test: Negative activation + negative bias -> -1
    if apply_bias(-1, -1) != -1 { return conflict(); }
    
    return truth();
}
