// stdlib/nn/nn_utils.tern
// Demonstrates: Utilities for neural network layers
// Tier: 3 — Industrial

// Trit-based ReLU: 1 -> 1, 0 -> 0, -1 -> 0
fn ternary_relu(x: trit) -> trit {
    match x {
         1 => { return 1; }
         0 => { return 0; }
        -1 => { return 0; }
    }
}

// Sigmoid-like threshold: 1 -> 1, 0 -> 0, -1 -> -1 (linear in ternary)
fn ternary_activation(x: trit) -> trit {
    return x;
}

// Checks if a float value exceeds a safety bound
fn check_bound(val: float, bound: float) -> trit {
    if val > bound {
        return 1;
    }
    if val < (0.0 - bound) {
        return -1;
    }
    return 0;
}

fn main() -> trit {
    let r: trit = ternary_relu(-1);
    match r {
        -1 => { return conflict(); }
         0 => { return truth(); }
         1 => { return conflict(); }
    }
}
