// stdlib/nn/layer_output_clamping.tern
// Demonstrates: Clamping layer outputs to prevent divergence
// Tier: 3 — Industrial

from "nn_utils.tern" import check_bound;

fn main() -> trit {
    let output: float = -5.0;
    let clamp_limit: float = 4.0;
    
    // Status: -1 if below lower clamp, 1 if above upper clamp
    let status: trit = check_bound(output, clamp_limit);
    
    match status {
        -1 => { return conflict(); }  // Below limit (Reject)
         0 => { return truth(); }     // Within safe range
         1 => { return conflict(); }  // Above limit (Reject)
    }
}
