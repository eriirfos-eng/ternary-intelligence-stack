// stdlib/nn/ternary_gradient_clipping.tern
// Demonstrates: Gradient clipping for ternary neural network training.
// Tier: 3 — Industrial
// Clipping gradients is essential for stabilizing training in quantized networks.
// This logic uses a ternary mask to zero out updates in high-uncertainty zones.

fn clip_update(weight: float, gradient: float, threshold: float) -> float {
    // If gradient is within the uncertainty threshold, we skip the update.
    if gradient < threshold && gradient > -threshold {
        return weight; // No change
    }
    
    // Apply ternary-inspired clipping: scale large updates to a fixed delta.
    let delta: float = 0.01;
    if gradient > 0.0 {
        return weight + delta;
    }
    return weight - delta;
}

fn main() -> trit {
    let w: float = 0.5;
    
    // Case 1: Gradient below threshold - should skip update
    if clip_update(w, 0.001, 0.05) != 0.5 { return reject; }
    
    // Case 2: Positive gradient - update by delta
    if clip_update(w, 0.1, 0.05)   != 0.51 { return reject; }
    
    // Case 3: Negative gradient - update by delta
    if clip_update(w, -0.1, 0.05)  != 0.49 { return reject; }

    return affirm;
}
