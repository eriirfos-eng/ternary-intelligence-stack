// stdlib/nn/activation_sparsity_eval.tern
// Demonstrates: Evaluation of activation sparsity in ternary neural networks
// Tier: 3

from "nn_utils.tern" import *;

fn eval_sparsity(activations: trit[]) -> trit {
    let zeros_count: int = 0;
    let i: int = 0;
    let len: int = length(activations);
    
    while i < len {
        if activations[i] == 0 ? {
            zeros_count = zeros_count + 1;
        } else {} else {}
        i = i + 1;
    }
    
    // Logic: if sparsity > 50%, affirm (healthy). If > 20%, tend. Else reject.
    if zeros_count > (len / 2) ? {
        return affirm;
    } else {
        if zeros_count > (len / 5) ? {
            return tend;
        } else {
            return reject;
        } else {
            return reject;
        }
    } else {
        return reject;
    }
}

fn main() -> trit {
    let acts: trit[] = [1, 0, 0, -1, 0]; // 3 zeros out of 5 (60%)
    let res: trit = eval_sparsity(acts);
    
    match res {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
