// stdlib/nn/activation_sparsity_eval.tern
// Demonstrates: Evaluating activation sparsity for optimization
// Tier: 3 — Industrial

from "nn_utils.tern" import ternary_relu;

fn main() -> trit {
    let a1: trit = 1;
    let a2: trit = -1;
    let a3: trit = 0;
    
    // ReLU activations
    let r1: trit = ternary_relu(a1);  // 1
    let r2: trit = ternary_relu(a2);  // 0
    let r3: trit = ternary_relu(a3);  // 0
    
    // Consensus: returns 1 if mostly active, 0 if mostly sparse
    let consensus_active: trit = consensus(consensus(r1, r2), r3);
    
    match consensus_active {
        -1 => { return conflict(); }  // Unstable
         0 => { return hold(); }      // Sparse (Optimization target)
         1 => { return truth(); }     // Active
    }
}
