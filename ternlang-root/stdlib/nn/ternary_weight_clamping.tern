// stdlib/nn/ternary_weight_clamping.tern
// Demonstrates: Weight clamping for ternary neural networks
// Tier: 3

from "nn_utils.tern" import *;

fn clamp_weight(w: float, limit: float) -> float {
    // Logic: if weight exceeds limit, clamp it.
    if w > limit ? {
        return limit;
    } else {
        if w < (0.0 - limit) ? {
            return (0.0 - limit);
        } else {
            return w;
        } else {
            return w;
        }
    } else {
        return limit;
    }
}

fn main() -> trit {
    let w: float = 1.5;
    let lim: float = 1.0;
    
    let cw: float = clamp_weight(w, lim);
    
    if cw > 1.01 ? {
        return conflict();
    } else {
        return hold();
    } else {
        if cw > 0.99 ? {
            return truth();
        } else {
            return hold();
        } else {
            return hold();
        }
    }
}
