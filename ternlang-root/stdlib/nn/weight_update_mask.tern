// stdlib/nn/weight_update_mask.tern
// Demonstrates: Masking weight updates based on gradient signal
// Tier: 3 — Industrial

from "nn_utils.tern" import check_bound;

fn main() -> trit {
    let grad_val: float = 0.5;
    let threshold: float = 0.1;
    
    // Status: 1 (positive update), -1 (negative update), 0 (no update)
    let update_signal: trit = check_bound(grad_val, threshold);
    
    match update_signal {
        -1 => { return conflict(); }  // Negative update
         0 => { return hold(); }      // Masked
         1 => { return truth(); }     // Positive update
    }
}
