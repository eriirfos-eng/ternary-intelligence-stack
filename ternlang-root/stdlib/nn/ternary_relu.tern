// stdlib/nn/ternary_relu.tern
// Demonstrates: Ternary ReLU activation for neural networks.
// Tier: 3 — Industrial

fn t_relu(x: trit) -> trit {
    match x {
        -1 => { return hold();    }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}

// Tensor version
fn t_relu_tensor(x: trit[]) -> trit[] {
    let len: int = length(x);
    let i: int = 0;
    while i < len {
        x[i] = t_relu(x[i]);
        i = i + 1;
    }
    return x;
}

fn main() -> trit {
    let input: trit[] = [-1, 0, 1, 1, -1];
    let output: trit[] = t_relu_tensor(input);
    
    // Output should be [0, 0, 1, 1, 0]
    if output[0] == 0 {
        if output[1] == 0 {
            if output[2] == 1 {
                if output[3] == 1 {
                    if output[4] == 0 {
                        return truth();
                    }
                }
            }
        }
    }
    return conflict();
}
