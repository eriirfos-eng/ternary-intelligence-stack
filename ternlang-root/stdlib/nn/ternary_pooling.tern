// stdlib/nn/ternary_pooling.tern
// Demonstrates: Ternary Pooling logic (Max-Pooling equivalent)
// Tier: 3 — Industrial

// pool_trits: Returns the maximum signal from four trits.
// In balanced ternary, the ranking is typically 1 (Affirm) > 0 (Tend) > -1 (Reject).
fn pool_trits(t1: trit, t2: trit, t3: trit, t4: trit) -> trit {
    // Priority 1: Any Affirmation (1) in the window makes the output 1.
    if t1 == 1 { return 1; }
    if t2 == 1 { return 1; }
    if t3 == 1 { return 1; }
    if t4 == 1 { return 1; }
    
    // Priority 2: If no 1s, any Tend (0) makes the output 0.
    if t1 == 0 { return 0; }
    if t2 == 0 { return 0; }
    if t3 == 0 { return 0; }
    if t4 == 0 { return 0; }
    
    // Priority 3: All are Rejections (-1), so output is -1.
    return -1;
}

// consensus_pool: Consensus-based merge between two pooled outputs.
fn consensus_pool(p1: trit, p2: trit) -> trit {
    let res: trit = consensus(p1, p2);
    match res {
        -1 => { return -1; }
         0 => { return 0; }
         1 => { return 1; }
    }
}

fn main() -> trit {
    let a: trit = -1;
    let b: trit = 0;
    let c: trit = -1;
    let d: trit = -1;
    
    // The maximum signal among (-1, 0, -1, -1) is 0 (Tend).
    let pooled: trit = pool_trits(a, b, c, d);
    
    match pooled {
        -1 => { return conflict(); }
         0 => { return truth(); } // Pass test: Correct max signal identified
         1 => { return conflict(); }
    }
}
