/*
 * Ternary Consensus Chain — Implementation of a chain reduction for trit votes.
 * Aggregates votes in a linear chain to reach a single consensus trit.
 * 
 * RFI-IRFOS · PUBLIC repo · v1.0
 */

fn chain_reduce(votes: trit[5]) -> trit {
    let acc: trit = votes[0];
    let i: int = 1;
    while i < 5 {
        // Consensus builtin simulates majority/averaging behavior
        acc = consensus(acc, votes[i]);
        i = i + 1;
    }
    return acc;
}

fn main() -> trit {
    // [1, 1, 0, -1, 1]
    // 1 con 1 = 1
    // 1 con 0 = 1
    // 1 con -1 = 0
    // 0 con 1 = 1
    let votes: trit[5] = [1, 1, 0, -1, 1];
    
    let res: trit = chain_reduce(votes);
    println("Chain Consensus result:");
    println(cast(res));
    
    if res == 1 {
        println("Consensus Chain Test: PASSED");
        return 1;
    }
    
    return -1;
}
