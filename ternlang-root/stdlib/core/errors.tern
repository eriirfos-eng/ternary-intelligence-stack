// stdlib/core/errors.tern
// Demonstrates: BET VM + Parser error taxonomy modelled in ternary.
// Tier: 1 — Open Core (LGPL-3.0)
//
// Every error in Ternlang carries a structured code [PREFIX-NNN].
// This file is the canonical reference — it classifies every known
// diagnostic by severity using the trit scale:
//
//   +1  (truth)    = informational / execution completed normally
//    0  (hold)     = retryable / check your logic and try again
//   -1  (conflict) = fatal / the machine cannot proceed
//
// Error codes in the runtime:
//
//   [BET-001]  Stack underflow
//              "You tried to pop a truth that wasn't there."
//              Severity: -1 (fatal). Check your function call depth.
//              → See: stdlib/tutorials/05_functions.tern
//
//   [BET-002]  BET encoding fault (0b00 state)
//              "The 0b00 bit pattern is forbidden. Only 01, 10, 11 are valid trits."
//              Severity: -1 (fatal). This is a compiler or memory corruption issue.
//
//   [BET-003]  VM halted cleanly
//              "Execution reached the end. This is not an error — this is peace."
//              Severity: +1 (informational). Your program ran to completion.
//
//   [BET-004]  Unknown opcode
//              "The machine is confused. This opcode belongs to a future where binary doesn't exist."
//              Severity: -1 (fatal). Your .ternbc bytecode is malformed. Recompile.
//
//   [BET-005]  Register out of range
//              "The BET has exactly 27 registers (0–26). That's 3³. No more, no less."
//              Severity: -1 (fatal). Codegen emitted an impossible register address.
//
//   [BET-006]  PC out of bounds
//              "You jumped outside the known universe. The program counter fell off the edge."
//              Severity: -1 (fatal). A jump target overshot the bytecode buffer.
//
//   [BET-007]  Type mismatch
//              "Square peg, round hole. You passed an Int where a Trit was expected."
//              Severity: 0 (hold). Fix the type at the call site — the logic may be salvageable.
//              → See: stdlib/tutorials/01_hello_ternary.tern
//
//   [PARSE-001] Unexpected token
//              "The lexer hit something it didn't expect. Check your syntax."
//              Severity: 0 (hold). Fix the typo, recompile.
//
//   [PARSE-002] Expected token not found
//              "The grammar demands it. You left something out."
//              Severity: 0 (hold). A closing brace, a colon, a type annotation — find it.
//
//   [PARSE-003] Invalid trit literal
//              "Trits are -1, 0, or +1. No in-betweens. No 2. No true."
//              Severity: 0 (hold). You wrote a value the trit type cannot hold.
//
//   [PARSE-004] Non-exhaustive match
//              "Ternary has three states. Cover all three or the compiler won't let you through."
//              Severity: 0 (hold). Add the missing arm (-1, 0, or +1).
//              → See: stdlib/tutorials/02_match_exhaustive.tern
//
//   [TYPE-001]  Semantic type mismatch
//              "Binary types don't map cleanly to ternary space. Don't force them."
//              Severity: 0 (hold). The type checker caught a mismatch before runtime.

// ─── Severity classifier ─────────────────────────────────────────────────────
//
// Given an error class (modelled as trit), return whether the process
// should abort, retry, or log and continue.

fn bet_severity(code: trit) -> trit {
    // +1 = informational (BET-003: clean halt)
    // 0  = retryable    (BET-007, PARSE-*: type/syntax issues, fix and retry)
    // -1 = fatal        (BET-001/002/004/005/006: VM structural failure)
    match code {
        -1 => { return conflict(); }   // fatal — abort immediately
         0 => { return hold();    }   // retryable — correct the source and rerun
         1 => { return truth();   }   // informational — log only
    }
}

// ─── Retry policy ────────────────────────────────────────────────────────────
//
// In a production system, a retryable error (trit = 0) should be routed
// to a correction pass before escalating to a hard failure.
// A fatal error (trit = -1) must not be retried — it indicates a
// structural fault in the bytecode or the VM's own state.

fn should_retry(severity: trit) -> trit {
    match severity {
        -1 => { return conflict(); }   // fatal: do not retry, escalate
         0 => { return hold();    }   // retryable: hold execution, request fix
         1 => { return truth();   }   // informational: no action needed
    }
}

// ─── Entry point ─────────────────────────────────────────────────────────────
//
// Demonstrate the taxonomy with a PARSE-004 class error:
// non-exhaustive match — retryable (trit = 0 class).

let parse_error_class: trit = 0;          // 0 = retryable syntax error
let sev: trit = bet_severity(parse_error_class);
let policy: trit = should_retry(sev);

// Policy: hold — correct the source, do not abort.
match policy {
    -1 => { return conflict(); }   // should not reach: fatal errors don't retry
     0 => { return hold();    }   // correct result: retryable, hold for fix
     1 => { return truth();   }   // would mean: no action needed
}
