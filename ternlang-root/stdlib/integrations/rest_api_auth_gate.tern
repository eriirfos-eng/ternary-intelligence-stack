// stdlib/integrations/rest_api_auth_gate.tern
// Demonstrates: REST API authentication gate
// Tier: 2 - Pro Standard

fn authenticate(token_valid: trit, scope_valid: trit) -> trit {
    return token_valid && scope_valid;
}

fn rate_limit_gate(req_count: int, max_req: int) -> trit {
    if req_count > max_req { return conflict(); }
    if req_count > (max_req / 2) { return hold(); }
    return truth();
}

fn auth_orchestrator(auth: trit, rate: trit) -> trit {
    match auth {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { 
            match rate {
                -1 => { return conflict(); }
                 0 => { return hold();    }
                 1 => { return truth();   }
            }
         }
    }
}

fn main() -> trit {
    let auth_status: trit = authenticate(1, 1);
    let rate_status: trit = rate_limit_gate(45, 100);

    let final_status: trit = auth_orchestrator(auth_status, rate_status);

    match final_status {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
