// stdlib/integrations/database_sync_check.tern
// Demonstrates: checking sync status between primary and secondary databases
// Tier: 3 — Industrial

fn check_sync(p_version: int, s_version: int, latency: float) -> trit {
    if p_version != s_version { return hold(); }
    if latency > 1.0 { return hold(); }
    return truth();
}

fn main() -> trit {
    let pv: int = 1005;
    let sv: int = 1005;
    let lat: float = 0.05;
    
    let ok: trit = check_sync(pv, sv, lat);
    match ok {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
