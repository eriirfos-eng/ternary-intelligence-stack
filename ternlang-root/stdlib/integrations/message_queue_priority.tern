// stdlib/integrations/message_queue_priority.tern
// Demonstrates: prioritizing message queue processing based on task urgency
// Tier: 3 — Industrial

fn task_priority(urgency: int, tier: int) -> trit {
    if urgency > 5 { return truth(); }
    if tier > 2 { return truth(); }
    return hold();
}

fn main() -> trit {
    let u: int = 3;
    let t: int = 1;
    
    let res: trit = task_priority(u, t);
    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
