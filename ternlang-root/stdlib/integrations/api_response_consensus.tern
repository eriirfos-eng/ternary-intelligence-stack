// stdlib/integrations/api_response_consensus.tern
// Demonstrates: reaching consensus on multiple API responses
// Tier: 3 — Industrial

fn check_responses(r1: trit, r2: trit, r3: trit) -> trit {
    return consensus(r1, consensus(r2, r3));
}

fn main() -> trit {
    let api1: trit = 1;
    let api2: trit = 1;
    let api3: trit = 0;
    
    let res: trit = check_responses(api1, api2, api3);
    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
