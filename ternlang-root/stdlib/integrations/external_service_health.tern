// stdlib/integrations/external_service_health.tern
// Demonstrates: monitoring health of an external service before making calls
// Tier: 3 — Industrial

fn service_gate(status_code: int, uptime: float) -> trit {
    if status_code != 200 { return conflict(); }
    if uptime < 0.99 { return hold(); }
    return truth();
}

fn main() -> trit {
    let code: int = 200;
    let up: float = 0.995;
    
    let ok: trit = service_gate(code, up);
    match ok {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
