// stdlib/ternary/ternary_half_adder.tern
// Demonstrates: Balanced ternary half adder (sum and carry)
// Tier: 1 - Open Core

fn half_adder_sum(a: trit, b: trit) -> trit {
    match a {
        -1 => {
            match b {
                -1 => { return truth();    } // -1 + -1 = -2 -> Sum=1
                 0 => { return conflict(); } // -1 + 0 = -1 -> Sum=-1
                 1 => { return hold();     } // -1 + 1 = 0 -> Sum=0
            }
        }
        0 => {
            match b {
                -1 => { return conflict(); } // 0 + -1 = -1 -> Sum=-1
                 0 => { return hold();     } // 0 + 0 = 0 -> Sum=0
                 1 => { return truth();    } // 0 + 1 = 1 -> Sum=1
            }
        }
        1 => {
            match b {
                -1 => { return hold();     } // 1 + -1 = 0 -> Sum=0
                 0 => { return truth();    } // 1 + 0 = 1 -> Sum=1
                 1 => { return conflict(); } // 1 + 1 = 2 -> Sum=-1
            }
        }
    }
}

fn half_adder_carry(a: trit, b: trit) -> trit {
    match a {
        -1 => {
            match b {
                -1 => { return conflict(); } // -1 + -1 = -2 -> Carry=-1
                 0 => { return hold();     } // -1 + 0 = -1 -> Carry=0
                 1 => { return hold();     } // -1 + 1 = 0 -> Carry=0
            }
        }
        0 => {
            return hold(); // 0 + any = 0 carry
        }
        1 => {
            match b {
                -1 => { return hold();     } // 1 + -1 = 0 -> Carry=0
                 0 => { return hold();     } // 1 + 0 = 1 -> Carry=0
                 1 => { return truth();    } // 1 + 1 = 2 -> Carry=1
            }
        }
    }
}

fn main() -> trit {
    let a: trit = 1;
    let b: trit = 1;

    let s: trit = half_adder_sum(a, b);   // Expect -1 (conflict)
    let c: trit = half_adder_carry(a, b); // Expect 1 (truth)

    match s {
        -1 => { 
            match c {
                -1 => { return conflict(); }
                 0 => { return conflict(); }
                 1 => { return truth();    }
            }
        }
        0 => { return hold(); }
        1 => { return hold(); }
    }
}
