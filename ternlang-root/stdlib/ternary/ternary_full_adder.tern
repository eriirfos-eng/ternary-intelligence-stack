// stdlib/ternary/ternary_full_adder.tern
// Demonstrates: Balanced ternary full adder (sum and carry)
// Tier: 1 - Open Core

fn half_adder_sum(a: trit, b: trit) -> trit {
    match a {
        -1 => {
            match b {
                -1 => { return truth();    }
                 0 => { return conflict(); }
                 1 => { return hold();     }
            }
        }
        0 => {
            match b {
                -1 => { return conflict(); }
                 0 => { return hold();     }
                 1 => { return truth();    }
            }
        }
        1 => {
            match b {
                -1 => { return hold();     }
                 0 => { return truth();    }
                 1 => { return conflict(); }
            }
        }
    }
}

fn half_adder_carry(a: trit, b: trit) -> trit {
    match a {
        -1 => {
            match b {
                -1 => { return conflict(); }
                 0 => { return hold();     }
                 1 => { return hold();     }
            }
        }
        0 => { return hold(); }
        1 => {
            match b {
                -1 => { return hold();     }
                 0 => { return hold();     }
                 1 => { return truth();    }
            }
        }
    }
}

fn full_adder_sum(a: trit, b: trit, cin: trit) -> trit {
    let s1: trit = half_adder_sum(a, b);
    return half_adder_sum(s1, cin);
}

fn full_adder_carry(a: trit, b: trit, cin: trit) -> trit {
    let s1: trit = half_adder_sum(a, b);
    let c1: trit = half_adder_carry(a, b);
    let c2: trit = half_adder_carry(s1, cin);
    
    // c1 + c2 (balanced ternary sum of carries)
    // Since only one of them can be non-zero (1 or -1) at most,
    // we can use a simple match or addition.
    // Actually, in 1+1+1 case: c1=1, c2=0 -> carry=1.
    // In -1-1-1 case: c1=-1, c2=0 -> carry=-1.
    // They can't both be 1 or both be -1.
    return c1 + c2;
}

fn main() -> trit {
    let a: trit = 1;
    let b: trit = 1;
    let cin: trit = 1;

    let s: trit = full_adder_sum(a, b, cin);   // 1+1+1 = 3 -> Sum=0
    let c: trit = full_adder_carry(a, b, cin); // 1+1+1 = 3 -> Carry=1

    match s {
        -1 => { return conflict(); }
         0 => { 
            match c {
                -1 => { return conflict(); }
                 0 => { return hold();     }
                 1 => { return truth();    }
            }
         }
         1 => { return hold(); }
    }
}
