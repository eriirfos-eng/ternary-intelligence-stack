// Module:  stdlib/sim/plasma_router.schema.tern
// Purpose: T-SON serialization schema for plasma_router
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Plasma_routerSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Plasma_routerSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
