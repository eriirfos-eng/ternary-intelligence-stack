// stdlib/sim/monte_carlo_consensus.tern
// Demonstrates: Monte Carlo simulation result consensus
// Tier: 3

from "./_utils.tern" import *;

fn monte_carlo_consensus(results: trit[]) -> trit {
    return sim_consensus(results);
}

fn main() -> trit {
    let trials: trittensor<6>;
    trials[0] = affirm;
    trials[1] = affirm;
    trials[2] = affirm;
    trials[3] = affirm;
    trials[4] = tend;
    trials[5] = reject;
    
    // 4/6 = 2/3. (4*3) > (6*2) is 12 > 12 which is False.
    // So it should be tend or reject.
    
    let consensus: trit = monte_carlo_consensus(trials);
    
    match consensus {
        affirm => {
            println("Simulation: HIGH CONFIDENCE SUCCESS.");
        }
        tend => {
            println("Simulation: INCONCLUSIVE.");
        }
        reject => {
            println("Simulation: HIGH CONFIDENCE FAILURE.");
        }
    }
    
    return consensus;
}
