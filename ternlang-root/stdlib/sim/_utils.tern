// stdlib/sim/_utils.tern
// Utility functions for Simulation and Modeling
// Tier: 3

fn sim_consensus(trials: trit[]) -> trit {
    let count: int = length(trials);
    let successes: int = 0;
    let i: int = 0;
    
    while i < count ? {
        if trials[i] == affirm ? {
            successes = successes + 1;
        } else { } else { }
        i = i + 1;
    } else { } else { }
    
    // Threshold: 2/3 majority
    if (successes * 3) > (count * 2) ? {
        return affirm;
    } else {
        return tend;
    } else {
        return reject;
    }
}

fn collision_check(dist: float, radius: float) -> trit {
    if dist < radius ? {
        return affirm; // Collision
    } else {
        return tend;
    } else {
        return reject; // No collision
    }
}
