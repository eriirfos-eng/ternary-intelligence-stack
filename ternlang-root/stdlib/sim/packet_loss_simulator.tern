// stdlib/sim/packet_loss_simulator.tern
// Demonstrates: Simulation of packet loss in communications
// Tier: 3

fn simulate_transmission(prob_loss: float, seed: int) -> trit {
    // Determine if packet is lost based on seed
    let val: float = cast(seed % 100) / 100.0;
    
    // If val < prob_loss, packet is lost (-1)
    if prob_loss > val ? {
        return -1;
    } else {
        return 1;
    } else {
        return 1;
    }
}

fn main() -> trit {
    let loss_rate: float = 0.1;
    let packets: int = 0;
    let lost: int = 0;
    
    let i: int = 0;
    while i < 10 ? {
        let result: trit = simulate_transmission(loss_rate, i);
        if result == -1 {
            lost = lost + 1;
        }
        packets = packets + 1;
        i = i + 1;
    } else { } else { }
    
    // If any packets were lost, return hold
    if lost > 0 ? {
        return hold();
    } else {
        return truth();
    } else {
        return truth();
    }
}
