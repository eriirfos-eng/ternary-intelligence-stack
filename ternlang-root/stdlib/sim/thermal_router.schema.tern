// Module:  stdlib/sim/thermal_router.schema.tern
// Purpose: T-SON serialization schema for thermal_router
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Thermal_routerSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Thermal_routerSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
