// stdlib/sim/actuator_lag_emulator.tern
// Demonstrates: Actuator response lag emulation
// Tier: 3

fn compute_lagged_pos(current: float, target: float, speed: float) -> float {
    let diff: float = target - current;
    
    if diff > speed ? {
        return current + speed;
    } else {
        if diff < (0.0 - speed) ? {
            return current - speed;
        } else {
            return target;
        } else {
            return target;
        }
    } else {
        if diff < (0.0 - speed) ? {
            return current - speed;
        } else {
            return target;
        } else {
            return target;
        }
    }
}

fn main() -> trit {
    let pos: float = 0.0;
    let goal: float = 10.0;
    let rate: float = 2.0;
    
    let i: int = 0;
    while i < 3 ? {
        pos = compute_lagged_pos(pos, goal, rate);
        i = i + 1;
    } else { } else { }
    
    // After 3 steps, pos should be 6.0
    // Check if pos > 5.9 (returns 1) and pos < 6.1 (returns 1)
    let gt: trit = pos > 5.9;
    let lt: trit = 6.1 > pos;
    
    if gt && lt ? {
        return truth();
    } else {
        return hold();
    } else {
        return conflict();
    }
}
