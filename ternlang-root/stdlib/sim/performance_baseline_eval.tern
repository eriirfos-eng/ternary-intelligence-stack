// stdlib/sim/performance_baseline_eval.tern
// Demonstrates: Evaluation of simulation performance against baseline
// Tier: 3

fn evaluate_performance(current_ops: int, baseline_ops: int) -> trit {
    // If current performance is better than baseline, affirm
    if current_ops > baseline_ops {
        return 1;
    }
    
    // If significantly worse (less than 80% of baseline), reject
    let threshold: int = baseline_ops - (baseline_ops / 5);
    if current_ops < threshold {
        return -1;
    }
    
    return 0; // Nominal/Acceptable
}

fn main() -> trit {
    let current: int = 850;
    let baseline: int = 1000;
    
    let result: trit = evaluate_performance(current, baseline);
    
    match result {
        1  => { return truth();    }
        0  => { return hold();     }
        -1 => { return conflict(); }
    }
}
