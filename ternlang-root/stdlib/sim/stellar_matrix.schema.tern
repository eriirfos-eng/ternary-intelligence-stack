// Module:  stdlib/sim/stellar_matrix.schema.tern
// Purpose: T-SON serialization schema for stellar_matrix
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Stellar_matrixSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Stellar_matrixSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
