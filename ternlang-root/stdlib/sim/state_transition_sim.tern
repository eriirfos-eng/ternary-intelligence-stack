// stdlib/sim/state_transition_sim.tern
// Demonstrates: Ternary state transition simulation
// Tier: 3

fn next_state(current: trit, input: trit) -> trit {
    match current {
        1  => {
            // Truth state
            if input == -1 { return 0; }
            return 1;
        }
        0  => {
            // Hold state
            if input == 1 { return 1; }
            if input == -1 { return -1; }
            return 0;
        }
        -1 => {
            // Conflict state
            if input == 1 { return 0; }
            return -1;
        }
    }
}

fn main() -> trit {
    let state: trit = 0;
    let inputs: trittensor<3>;
    inputs[0] = 1;
    inputs[1] = 1;
    inputs[2] = -1;
    
    let i: int = 0;
    while i < 3 ? {
        state = next_state(state, inputs[i]);
        i = i + 1;
    } else { } else { }
    
    match state {
        1  => { return truth();    }
        0  => { return hold();     }
        -1 => { return conflict(); }
    }
}
