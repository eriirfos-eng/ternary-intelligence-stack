// Module:  stdlib/sim/magnetic_analyzer.schema.tern
// Purpose: T-SON serialization schema for magnetic_analyzer
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Magnetic_analyzerSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Magnetic_analyzerSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
