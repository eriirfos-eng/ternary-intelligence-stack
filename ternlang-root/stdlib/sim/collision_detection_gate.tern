// stdlib/sim/collision_detection_gate.tern
// Demonstrates: Ternary gate for object collision detection
// Tier: 3

from "./_utils.tern" import *;

fn collision_gate(x1: float, y1: float, x2: float, y2: float, r: float) -> trit {
    let dx: float = x2 - x1;
    let dy: float = y2 - y1;
    // Approximation of distance squared to avoid sqrt
    let dist_sq: float = (dx * dx) + (dy * dy);
    let r_sq: float = r * r;
    
    return collision_check(dist_sq, r_sq);
}

fn main() -> trit {
    let pos1_x: float = 0.0;
    let pos1_y: float = 0.0;
    let pos2_x: float = 3.0;
    let pos2_y: float = 4.0;
    let radius: float = 6.0; // Distance is 5.0, so 25.0 < 36.0 -> Collision!
    
    let is_collision: trit = collision_gate(pos1_x, pos1_y, pos2_x, pos2_y, radius);
    
    match is_collision {
        affirm => {
            println("COLLISION DETECTED.");
        }
        tend => {
            println("PROXIMITY WARNING - Near collision.");
        }
        reject => {
            println("Clear path - No collision.");
        }
    }
    
    return is_collision;
}
