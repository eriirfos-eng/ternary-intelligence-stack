// stdlib/sim/fault_injection_gate.tern
// Demonstrates: Fault injection for simulation testing
// Tier: 3

fn inject_fault(clean_sig: trit, fault_active: trit) -> trit {
    match fault_active {
        1  => { return -1; } // Force fault
        0  => { return 0;  } // Force neutral
        -1 => { return clean_sig; } // Passthrough
    }
}

fn main() -> trit {
    let sig: trit = 1;
    let fault: trit = 1;
    
    let result: trit = inject_fault(sig, fault);
    
    match result {
        1  => { return truth();    }
        0  => { return hold();     }
        -1 => { return conflict(); }
    }
}
