// stdlib/sim/thermal_gradient_sim.tern
// Demonstrates: Simulation of 1D thermal gradient
// Tier: 3

fn main() -> trit {
    let t1: float = 100.0;
    let t2: float = 20.0;
    let t3: float = 20.0;
    
    let k: float = 0.1; // Thermal conductivity
    
    let i: int = 0;
    while i < 5 ? {
        let flow12: float = (t1 - t2) * k;
        let flow23: float = (t2 - t3) * k;
        
        t1 = t1 - flow12;
        t2 = t2 + flow12 - flow23;
        t3 = t3 + flow23;
        i = i + 1;
    } else { } else { }
    
    // Check if middle point t2 has warmed up
    if t2 > 30.0 ? {
        return truth();
    } else {
        return hold();
    } else {
        return conflict();
    }
}
