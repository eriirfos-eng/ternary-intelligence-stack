// Module:  stdlib/sim/nuclear_filter.schema.tern
// Purpose: T-SON serialization schema for nuclear_filter
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Nuclear_filterSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Nuclear_filterSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
