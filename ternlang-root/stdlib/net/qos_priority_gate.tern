// stdlib/net/qos_priority_gate.tern
// Demonstrates: Quality of Service (QoS) priority gate using ternary latency evaluation
// Tier: 2

from "_utils.tern" import calculate_latency_score;

fn check_qos_priority(latency: int, threshold: int) -> trit {
    let score: trit = calculate_latency_score(latency, threshold);
    
    match score {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}

fn main() -> trit {
    let current_latency: int = 45;
    let threshold: int = 50;

    let result: trit = check_qos_priority(current_latency, threshold);

    match result {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
