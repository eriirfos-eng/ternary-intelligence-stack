// stdlib/net/rate_limiting_gate.tern
// Demonstrates: Request rate limiting logic
// Tier: 2 — Pro Standard

fn check_rate(requests_per_sec: int, limit: int) -> trit {
    if requests_per_sec > limit {
        return affirm; // Limit exceeded
    }
    // Warning at 80% capacity
    let warning_limit: int = (limit * 8) / 10;
    if requests_per_sec > warning_limit {
        return tend; // Warning
    }
    return reject; // Safe
}

fn main() -> trit {
    // Current: 85, Limit: 100
    let status: trit = check_rate(85, 100);
    
    // Status should be tend (85 > 80)
    match status {
        affirm => { 
            // HTTP 429 Too Many Requests
            return conflict(); 
        }
        tend => { 
            // Slow down response
            return hold(); 
        }
        reject => { 
            // Allow
            return truth(); 
        }
    }
}
