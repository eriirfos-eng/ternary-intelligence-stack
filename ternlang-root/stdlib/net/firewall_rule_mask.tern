// stdlib/net/firewall_rule_mask.tern
// Demonstrates: Ternary firewall rule evaluation (Allow/Deny/Hold)
// Tier: 2

from "_utils.tern" import aggregate_node_signals;

fn evaluate_traffic(src_ip: int, port: int, rule_results: trit[]) -> trit {
    // Basic logic: if any rule rejects, we conflict. 
    // If all affirm, we truth.
    let decision: trit = aggregate_node_signals(rule_results);
    
    match decision {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}

fn main() -> trit {
    let rules: trittensor<2>;
    rules[0] = 1; // IP check passed
    rules[1] = 0; // Port check pending deep inspection

    let result: trit = evaluate_traffic(192168, 80, rules);

    match result {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
