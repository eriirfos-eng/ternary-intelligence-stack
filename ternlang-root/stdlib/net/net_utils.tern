// stdlib/net/net_utils.tern
// Demonstrates: Reusable networking utilities
// Tier: 2 — Pro Standard

// Aggregates networking health signals
fn net_consensus(s1: trit, s2: trit, s3: trit) -> trit {
    let c12: trit = consensus(s1, s2);
    return consensus(c12, s3);
}

// Evaluates latency against a threshold: 1 (High), 0 (Elevated), -1 (Low)
fn latency_eval(latency_ms: float, limit_ms: float) -> trit {
    if latency_ms > limit_ms {
        return affirm; // High
    }
    if latency_ms > (limit_ms * 0.5) {
        return tend; // Elevated
    }
    return reject; // Low
}

// Evaluates packet loss: 1 (Critical), 0 (Warning), -1 (Normal)
fn loss_eval(loss_pct: float, threshold_pct: float) -> trit {
    if loss_pct > threshold_pct {
        return affirm; // Critical
    }
    if loss_pct > (threshold_pct * 0.5) {
        return tend; // Warning
    }
    return reject; // Normal
}

fn main() -> trit {
    let l: trit = latency_eval(40.0, 100.0);
    match l {
        affirm => { return conflict(); }
        tend   => { return hold(); }
        reject => { return truth(); }
    }
}
