// stdlib/net/bandwidth_throttle.tern
// Demonstrates: throttling logic based on capacity
// Tier: 2

fn calculate_delay(current_usage: float, max_capacity: float) -> int {
    let ratio: float = current_usage / max_capacity;
    
    if ratio > 0.9 {
        return 1000; // 1s delay
    } else {
        if ratio > 0.7 {
            return 200; // 200ms delay
        } else {
            return 0;
        }
    }
}

fn main() -> trit {
    let usage: float = 95.0;
    let cap: float = 100.0;
    
    let delay: int = calculate_delay(usage, cap);
    
    if delay == 1000 {
        return 1;
    } else {
        return -1;
    }
}
