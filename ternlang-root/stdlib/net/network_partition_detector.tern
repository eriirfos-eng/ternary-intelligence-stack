// stdlib/net/network_partition_detector.tern
// Demonstrates: detecting network partitions from connectivity signals
// Tier: 3 — Industrial

fn check_partition(c1: trit, c2: trit, c3: trit) -> trit {
    let agg: trit = consensus(c1, consensus(c2, c3));
    if agg == -1 { return truth(); } // Partition detected
    if agg == 0 { return hold(); }  // Uncertain
    return conflict(); // No partition
}

fn main() -> trit {
    let s1: trit = -1;
    let s2: trit = -1;
    let s3: trit = 0;
    
    let partition: trit = check_partition(s1, s2, s3);
    match partition {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
