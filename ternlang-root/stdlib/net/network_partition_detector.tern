// stdlib/net/network_partition_detector.tern
// Demonstrates: partition detection based on node visibility
// Tier: 2

fn is_partitioned(visible_nodes: int, total_nodes: int) -> trit {
    let majority: int = (total_nodes / 2) + 1;
    
    if visible_nodes >= majority {
        return -1; // Not partitioned (in majority) -> Reject partitioned state
    } else {
        if visible_nodes > 0 {
            return 1; // Partitioned (in minority) -> Affirm partitioned state
        } else {
            return 0; // Unknown/Isolated
        }
    }
}

fn main() -> trit {
    // 5 total nodes. Majority = 3.
    // Seeing 2 nodes -> minority -> partitioned
    let state: trit = is_partitioned(2, 5);
    
    if state == 1 {
        return 1;
    } else {
        return -1;
    }
}
