// stdlib/net/firewall_rule_consensus.tern
// Demonstrates: Firewall rule application via consensus
// Tier: 2 — Pro Standard

from "net_utils.tern" import net_consensus;

fn main() -> trit {
    // Three firewall nodes evaluate a source IP
    let node1: trit = affirm; // Block
    let node2: trit = affirm; // Block
    let node3: trit = tend;   // Neutral
    
    // Evaluate consensus
    let rule_status: trit = net_consensus(node1, node2, node3);
    
    // Result should be affirm (consensus(affirm, consensus(affirm, tend)) = affirm)
    match rule_status {
        affirm => { 
            // Block IP
            return conflict(); 
        }
        tend => { 
            // Log and monitor
            return hold(); 
        }
        reject => { 
            // Allow traffic
            return truth(); 
        }
    }
}
