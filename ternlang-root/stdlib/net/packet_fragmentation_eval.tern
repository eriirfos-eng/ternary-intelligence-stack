// stdlib/net/packet_fragmentation_eval.tern
// Demonstrates: Packet fragmentation evaluation
// Tier: 2 — Pro Standard

fn eval_fragmentation(df_flag: trit, packet_size: int, mtu: int) -> trit {
    // If DF (Don't Fragment) is set (affirm)
    if df_flag == 1 {
        if packet_size > mtu {
            return reject; // Cannot fragment
        }
        return affirm; // OK
    }
    // If DF is not set, we can fragment if needed
    if packet_size > mtu {
        return tend; // Fragmenting
    }
    return affirm; // OK
}

fn main() -> trit {
    // DF set, Packet 1600, MTU 1500
    let status: trit = eval_fragmentation(affirm, 1600, 1500);
    
    // Status should be reject
    match status {
        affirm => { 
            // Forward
            return truth(); 
        }
        tend => { 
            // Fragment and forward
            return hold(); 
        }
        reject => { 
            // ICMP Fragmentation Needed
            return conflict(); 
        }
    }
}
