// stdlib/net/latency_threshold_check.tern
// Demonstrates: latency-based quality gate
// Tier: 2

fn evaluate_latency(ms: int) -> trit {
    if ms < 50 {
        return 1;
    } else {
        if ms < 200 {
            return 0;
        } else {
            return -1;
        }
    }
}

fn main() -> trit {
    let fast: int = 35;
    let slow: int = 450;
    
    let s1: trit = evaluate_latency(fast);
    let s2: trit = evaluate_latency(slow);
    
    if s1 == 1 {
        if s2 == -1 {
            return 1;
        }
    }
    return -1;
}
