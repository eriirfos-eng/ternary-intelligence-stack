// stdlib/net/latency_threshold_check.tern
// Demonstrates: checking network latency against threshold
// Tier: 3 — Industrial

fn check_latency(ms: float, limit: float) -> trit {
    if ms > limit { return conflict(); }
    if ms > (limit * 0.7) { return hold(); }
    return truth();
}

fn main() -> trit {
    let ping: float = 120.5;
    let threshold: float = 150.0;
    
    let res: trit = check_latency(ping, threshold);
    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
