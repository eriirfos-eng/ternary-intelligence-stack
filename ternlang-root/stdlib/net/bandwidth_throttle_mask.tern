// stdlib/net/bandwidth_throttle_mask.tern
// Demonstrates: masking network traffic when bandwidth limits are exceeded
// Tier: 3 — Industrial

fn should_throttle(usage: float, limit: float) -> trit {
    if usage > limit { return truth(); } // Throttling active
    if usage > (limit * 0.9) { return hold(); } // Near limit
    return conflict(); // No throttling
}

fn main() -> trit {
    let curr: float = 95.0;
    let max_bw: float = 100.0;
    
    let throttle: trit = should_throttle(curr, max_bw);
    match throttle {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
