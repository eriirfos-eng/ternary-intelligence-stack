// stdlib/net/arp_poisoning_detector.tern
// Demonstrates: ARP poisoning detection using ternary consensus among monitoring agents
// Tier: 2

from "_utils.tern" import aggregate_node_signals;

fn detect_anomaly(agent_reports: trit[]) -> trit {
    let consensus_result: trit = aggregate_node_signals(agent_reports);
    
    // Invert consensus: if consensus is affirm (+1), it means "Attack Detected"
    // So we return reject (-1) to indicate a problem (gate blocked)
    match consensus_result {
        -1 => { return truth(); }    // Most agents say NO attack
         0 => { return hold(); }     // Inconclusive
         1 => { return conflict(); } // Attack confirmed by consensus
    }
}

fn main() -> trit {
    let monitoring_agents: trittensor<3>;
    monitoring_agents[0] = -1; // Agent 1: No attack
    monitoring_agents[1] = -1; // Agent 2: No attack
    monitoring_agents[2] = 0; // Agent 3: Unsure

    let result: trit = detect_anomaly(monitoring_agents);

    match result {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
