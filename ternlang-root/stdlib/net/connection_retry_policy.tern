// stdlib/net/connection_retry_policy.tern
// Demonstrates: determining if a connection retry should be attempted
// Tier: 3 — Industrial

fn should_retry(attempts: int, max_attempts: int, last_error: trit) -> trit {
    if attempts >= max_attempts { return conflict(); }
    if last_error == -1 { return hold(); } // Wait before retry
    return truth(); // Ready to retry
}

fn main() -> trit {
    let a: int = 2;
    let m: int = 5;
    let e: trit = -1;
    
    let res: trit = should_retry(a, m, e);
    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
