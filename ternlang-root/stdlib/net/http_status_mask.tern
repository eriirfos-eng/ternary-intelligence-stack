// stdlib/net/http_status_mask.tern
// Demonstrates: Mapping HTTP status codes to ternary states
// Tier: 2 - Pro Standard

fn classify_status(code: int) -> trit {
    if code >= 200 {
        if code < 300 {
            return truth(); // Success
        }
    }
    
    if code >= 400 {
        if code < 500 {
            return conflict(); // Client Error
        }
        if code >= 500 {
            if code < 600 {
                return hold(); // Server Error (Wait/Retry)
            }
        }
    }

    return hold(); // Default: hold (Redirects or unknown)
}

fn main() -> trit {
    let code: int = 404;
    let result: trit = classify_status(code);

    match result {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
