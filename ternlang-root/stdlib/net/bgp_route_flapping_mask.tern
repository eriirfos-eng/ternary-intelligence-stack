// stdlib/net/bgp_route_flapping_mask.tern
// Demonstrates: BGP route flapping detection
// Tier: 2 — Pro Standard

fn check_route_flapping(flips_per_min: float, threshold: float) -> trit {
    if flips_per_min > threshold {
        return affirm; // Flapping!
    }
    // Dampening threshold
    if flips_per_min > (threshold * 0.5) {
        return tend; // Warning
    }
    return reject; // Stable
}

fn main() -> trit {
    // Current: 8.0 flips/min, Threshold: 10.0
    let status: trit = check_route_flapping(8.0, 10.0);
    
    // Status should be tend
    match status {
        affirm => { 
            // Dampen route
            return conflict(); 
        }
        tend => { 
            // Warning: unstable
            return hold(); 
        }
        reject => { 
            // Stable
            return truth(); 
        }
    }
}
