// stdlib/net/packet_loss_gate.tern
// Demonstrates: gating network traffic based on packet loss rates
// Tier: 3 — Industrial

fn traffic_gate(loss_rate: float, threshold: float) -> trit {
    if loss_rate > threshold { return conflict(); } // Link unusable
    if loss_rate > (threshold * 0.5) { return hold(); } // Link degraded
    return truth(); // Link healthy
}

fn main() -> trit {
    let loss: float = 0.02;
    let limit: float = 0.05;
    
    let ok: trit = traffic_gate(loss, limit);
    match ok {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
