// stdlib/net/port_scan_detector.tern
// Demonstrates: Detection of port scan activity based on frequency and diversity
// Tier: 2 - Pro Standard

fn detect_scan(port_count: int, duration_ms: int, unusual_port_flag: trit) -> trit {
    // If we see many ports in a short time, it's a potential scan
    if port_count > 100 {
        if duration_ms < 1000 {
            return conflict(); // Fast scan detected
        }
        return hold(); // Slow scan suspicion
    }
    
    match unusual_port_flag {
        -1 => { return conflict(); } // Known bad port hit
         0 => { return truth();    } // Normal traffic
         1 => { return truth();    } // Verified safe traffic
    }
}

fn main() -> trit {
    let ports: int = 150;
    let time: int = 500;
    let suspicious: trit = 0;
    
    let result: trit = detect_scan(ports, time, suspicious);
    
    match result {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
