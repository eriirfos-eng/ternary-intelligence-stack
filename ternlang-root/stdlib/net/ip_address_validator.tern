// stdlib/net/ip_address_validator.tern
// Demonstrates: Validating IP address octets (0-255)
// Tier: 2 - Pro Standard

fn validate_octet(oct: int) -> trit {
    if oct < 0 {
        return conflict();
    }
    if oct > 255 {
        return conflict();
    }
    return truth();
}

fn validate_ip(o1: int, o2: int, o3: int, o4: int) -> trit {
    let r1: trit = validate_octet(o1);
    let r2: trit = validate_octet(o2);
    let r3: trit = validate_octet(o3);
    let r4: trit = validate_octet(o4);
    
    // Balanced ternary AND: min(a, b)
    // All must be truth (1) to return truth (1)
    return r1 && r2 && r3 && r4;
}

fn main() -> trit {
    let valid: trit = validate_ip(192, 168, 0, 1);
    
    match valid {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
