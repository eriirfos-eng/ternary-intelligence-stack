// stdlib/cad/volume_centroid_check.tern
// Demonstrates: Validating centroid location against design bounds
// Tier: 3 - Industrial

fn check_centroid(x: float, y: float, z: float, limit: float) -> trit {
    // If centroid is beyond limit from origin, it's a balance conflict
    if x * x + y * y + z * z > limit * limit {
        return conflict();
    }
    
    // Warning zone: 80% of limit
    if x * x + y * y + z * z > (limit * 0.8) * (limit * 0.8) {
        return hold();
    }
    
    return truth();
}

fn main() -> trit {
    let cx: float = 10.0;
    let cy: float = 0.0;
    let cz: float = 5.0;
    let max_dist: float = 12.0;
    
    let result: trit = check_centroid(cx, cy, cz, max_dist);
    
    match result {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
