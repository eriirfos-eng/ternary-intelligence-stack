// stdlib/cad/material_yield_consensus.tern
// Demonstrates: validating if a material selection meets yield strength requirements
// Tier: 3 — Industrial

fn yield_check(material_id: int, required_yield: float) -> trit {
    let yield_str: float = 0.0;
    
    // Mock material database lookup
    if material_id == 1 { yield_str = 250.0; } // Steel A36
    if material_id == 2 { yield_str = 400.0; } // Steel 1045
    if material_id == 3 { yield_str = 276.0; } // Aluminum 6061-T6
    
    if yield_str == 0.0 { return conflict(); } // Unknown material
    
    if yield_str > required_yield { return truth(); }
    if yield_str == required_yield { return hold(); }
    return conflict();
}

fn main() -> trit {
    let mat: int = 3;
    let req: float = 250.0;
    
    let res: trit = yield_check(mat, req);
    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
