// stdlib/cad/parametric_tolerance_mask.tern
// Demonstrates: Parametric tolerance check for CAD parts
// Tier: 3

from "_utils.tern" import evaluate_tolerance, aggregate_geometric_results;

fn main() -> trit {
    // Avoiding float[] in main due to VM implementation gap
    let d1_nom: float = 10.0;
    let d1_meas: float = 10.05;
    let d2_nom: float = 5.0;
    let d2_meas: float = 5.01;
    let tol: float = 0.1;
    
    let r1: trit = evaluate_tolerance(d1_nom, d1_meas, tol);
    let r2: trit = evaluate_tolerance(d2_nom, d2_meas, tol);
    
    let results: trittensor<2>;
    results[0] = r1;
    results[1] = r2;
    
    let final_res: trit = aggregate_geometric_results(results);

    match final_res {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
