// stdlib/cad/thermal_expansion_eval.tern
// Demonstrates: calculating thermal expansion and checking limits
// Tier: 3 — Industrial

fn eval_expansion(len: float, alpha: float, dt: float, max_allowable: float) -> trit {
    let dl: float = len * alpha * dt;
    if dl < 0.0 { dl = -dl; } // Absolute expansion/contraction
    
    if dl > max_allowable { return conflict(); }
    if dl > (max_allowable * 0.8) { return hold(); }
    return truth();
}

fn main() -> trit {
    let length: float = 1000.0; // mm
    let cte: float = 0.000012;  // alpha for steel
    let temp_change: float = 50.0; // deg C
    let max_exp: float = 1.0; // mm
    
    let ok: trit = eval_expansion(length, cte, temp_change, max_exp);
    match ok {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
