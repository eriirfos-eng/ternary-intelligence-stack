// stdlib/cad/parametric_uv_mask.tern
// Demonstrates: Gating parametric UV coordinates within unit domain [0, 1]
// Tier: 3 - Industrial

fn validate_uv(u: float, v: float) -> trit {
    if u < 0.0 { return conflict(); }
    if u > 1.0 { return conflict(); }
    if v < 0.0 { return conflict(); }
    if v > 1.0 { return conflict(); }
    
    // Near boundaries (0.01 margin) we signal hold for edge handling
    if u < 0.01 { return hold(); }
    if u > 0.99 { return hold(); }
    if v < 0.01 { return hold(); }
    if v > 0.99 { return hold(); }
    
    return truth();
}

fn main() -> trit {
    let u_coord: float = 0.5;
    let v_coord: float = 0.995;
    
    let result: trit = validate_uv(u_coord, v_coord);
    
    match result {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
