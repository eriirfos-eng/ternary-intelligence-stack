// stdlib/cad/constraint_solver.tern
// Demonstrates: A simple constraint solver checking distance constraints.
// Tier: 3 — Industrial

fn solve_distance(d: float, target: float, tolerance: float) -> trit {
    let diff: float = d - target;
    if diff < 0.0 { 
        diff = -diff; 
    }
    
    if diff < tolerance {
        return truth(); // Satisfied
    }
    if diff < tolerance * 2.0 {
        return hold(); // Near satisfied
    }
    return conflict(); // Violated
}

fn main() -> trit {
    let d: float = 10.05;
    let target: float = 10.0;
    let tolerance: float = 0.1;
    
    let result: trit = solve_distance(d, target, tolerance);
    
    match result {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
