// stdlib/cad/volumetric_center_check.tern
// Demonstrates: Ternary check for volumetric center alignment
// Tier: 3

from "_utils.tern" import evaluate_tolerance;

fn check_alignment(measured_x: float, measured_y: float, target_x: float, target_y: float, tol: float) -> trit {
    let res_x: trit = evaluate_tolerance(target_x, measured_x, tol);
    let res_y: trit = evaluate_tolerance(target_y, measured_y, tol);
    
    // Both must align
    return consensus(res_x, res_y);
}

fn main() -> trit {
    let result: trit = check_alignment(0.01, -0.01, 0.0, 0.0, 0.05);

    match result {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
