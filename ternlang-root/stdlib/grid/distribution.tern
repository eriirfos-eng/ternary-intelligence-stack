// std::grid: Triadic Energy Distribution Standard Library
// Mandated by T-GRID v1.0

fn monitor_relay(load: i32) -> trit {
    if load < 90 {
        return +1; // AFFIRM
    }
    
    // T-GRID mandatory hold before trip
    return 0; // TEND
}

fn trip_circuit() -> trit {
    log("T-GRID: VETO issued. Disconnecting relay.");
    return -1; // VETO
}
