// stdlib/grid/node_discovery.tern
// Demonstrates: node discovery and health check
// Tier: 2 — Pro Standard

fn check_health(node_status: trit) -> trit {
    match node_status {
        1 => { return truth();    } // Active
        0 => { return hold();     } // Degraded/Warming
       -1 => { return conflict(); } // Offline/Failed
    }
}

fn main() -> trit {
    let nodes: trit[] = [1, 0, -1, 1];
    let healthy_count: int = 0;
    
    for n in nodes {
        if check_health(n) == 1 {
            healthy_count = healthy_count + 1;
        }
    }
    
    if healthy_count == 2 {
        return truth();
    }
    
    match cast(healthy_count) {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
