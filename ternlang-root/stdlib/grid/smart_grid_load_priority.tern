// stdlib/grid/smart_grid_load_priority.tern
// Demonstrates: Smart grid load prioritization logic
// Tier: 2

fn prioritise_load(load_type: int, available_power: float) -> trit {
    // 1: Essential (hospital, fire), 2: Critical (infra), 3: Normal (residential)
    if load_type == 1 {
        return affirm; // Always affirm essential
    }
    if load_type == 2 {
        if available_power > 10.0 {
            return affirm;
        }
        return tend;
    }
    if available_power > 50.0 {
        return affirm;
    }
    return reject; // Reject normal load if power low
}

fn main() -> trit {
    let r1: trit = prioritise_load(1, 1.0);   // Essential, power low: affirm
    let r2: trit = prioritise_load(3, 5.0);   // Normal, power low: reject
    
    if r1 == affirm && r2 == reject {
        return truth();
    }
    return conflict();
}
