// stdlib/grid/packet_router.tern
// Demonstrates: packet routing based on priority (trit)
// Tier: 2 — Pro Standard

fn route_packet(priority: trit) -> string {
    match priority {
        1 => { return "High Priority Lane"; }
        0 => { return "Standard Lane";      }
       -1 => { return "Background Lane";    }
    }
}

fn main() -> trit {
    let p1: string = route_packet(1);
    let p2: string = route_packet(-1);
    
    if p1 == "High Priority Lane" && p2 == "Background Lane" {
        return truth();
    }
    
    match cast(p1) {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
