// stdlib/grid/grid_islanding_consensus.tern
// Demonstrates: Ternary consensus for grid islanding decisions
// Tier: 3

from "_utils.tern" import grid_consensus;

fn decide_islanding(substation_reports: trit[]) -> trit {
    let final_consensus: trit = grid_consensus(substation_reports);
    
    match final_consensus {
        -1 => { return truth();   } // Island now
         0 => { return hold();    } // Monitor
         1 => { return conflict(); } // Remain grid-connected
    }
}

fn main() -> trit {
    let reports: trittensor<3>;
    reports[0] = -1; // Substation A: Island
    reports[1] = -1; // Substation B: Island
    reports[2] = 0;  // Substation C: Unsure

    let result: trit = decide_islanding(reports);

    match result {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
