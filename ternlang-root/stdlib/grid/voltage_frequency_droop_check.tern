// stdlib/grid/voltage_frequency_droop_check.tern
// Demonstrates: checking droop control parameters for grid synchronization
// Tier: 3 — Industrial

fn droop_check(v_diff: float, f_diff: float, max_v: float, max_f: float) -> trit {
    if v_diff < 0.0 { v_diff = -v_diff; }
    if f_diff < 0.0 { f_diff = -f_diff; }
    
    if v_diff > max_v { return conflict(); } // Voltage mismatch too high
    if f_diff > max_f { return conflict(); } // Frequency mismatch too high
    
    if v_diff > (max_v * 0.5) { return hold(); }
    if f_diff > (max_f * 0.5) { return hold(); }
    
    return truth(); // Safe to synchronize
}

fn main() -> trit {
    let vd: float = 2.5; // Volts difference
    let fd: float = 0.05; // Hz difference
    let mv: float = 5.0;
    let mf: float = 0.1;
    
    let res: trit = droop_check(vd, fd, mv, mf);
    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
