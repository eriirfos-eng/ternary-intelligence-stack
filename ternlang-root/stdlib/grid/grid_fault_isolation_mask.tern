// stdlib/grid/grid_fault_isolation_mask.tern
// Demonstrates: Isolating grid faults using ternary masks
// Tier: 2

fn isolate_fault(fault_detected: trit, section_id: int) -> trit {
    // If fault detected (affirm), isolate this section (reject)
    // If no fault (reject), keep active (affirm)
    // If uncertain (tend), hold state
    
    match fault_detected {
        affirm => { return reject; }
        tend   => { return tend;   }
        reject => { return affirm; }
    }
}

fn main() -> trit {
    let f1: trit = affirm; // Fault!
    let status: trit = isolate_fault(f1, 101); // should reject
    
    if status == reject {
        return truth();
    }
    return conflict();
}
