// stdlib/grid/load_balancing_mask.tern
// Demonstrates: Power grid load balancing mask using generation/load consensus
// Tier: 3

from "_utils.tern" import check_load_balance;

fn balance_grid(gen: float, load: float) -> trit {
    let margin: float = 5.0; // 5 MW margin
    let result: trit = check_load_balance(gen, load, margin);
    
    match result {
        -1 => { return conflict(); } // Load shedding required
         0 => { return hold();    } // Balanced
         1 => { return truth();   } // Surplus (Storage charging)
    }
}

fn main() -> trit {
    let current_gen: float = 105.0;
    let current_load: float = 100.0;

    let status: trit = balance_grid(current_gen, current_load);

    match status {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
