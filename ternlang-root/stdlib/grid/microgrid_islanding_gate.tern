// stdlib/grid/microgrid_islanding_gate.tern
// Demonstrates: determining if a microgrid should disconnect from the main grid
// Tier: 3 — Industrial

fn should_island(main_voltage_stable: trit, internal_generation_sufficient: trit) -> trit {
    if main_voltage_stable == -1 {
        if internal_generation_sufficient == 1 {
            return truth(); // Safe to island
        }
        return hold(); // Islanding risky, but main grid unstable
    }
    
    // Main grid is stable or holding
    return conflict(); // Stay connected
}

fn main() -> trit {
    let main_v_stable: trit = -1;
    let internal_gen: trit = 1;
    
    let island: trit = should_island(main_v_stable, internal_gen);
    match island {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
