// stdlib/grid/redundancy_check.tern
// Demonstrates: replica redundancy check
// Tier: 2 — Pro Standard

fn check_redundancy(replicas: trit[], min_required: int) -> trit {
    let count: int = 0;
    for r in replicas {
        if r == 1 {
            count = count + 1;
        }
    }
    
    if count >= min_required {
        return truth();
    }
    return conflict();
}

fn main() -> trit {
    let replicas: trit[] = [1, 1, 0, -1];
    let result: trit = check_redundancy(replicas, 2);
    
    if result == 1 {
        return truth();
    }
    
    match result {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
