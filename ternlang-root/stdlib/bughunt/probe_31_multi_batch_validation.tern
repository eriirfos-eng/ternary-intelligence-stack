// stdlib/bughunt/probe_31_multi_batch_validation.tern
// Demonstrates: Regression test for multi-batch consensus patterns
// Tier: 1 — Community

// validate_consensus_chain: Verifies that chained consensus calls resolve correctly.
fn validate_consensus_chain(a: trit, b: trit, c: trit) -> trit {
    let c12: trit = consensus(a, b);
    let final_c: trit = consensus(c12, c);
    return final_c;
}

fn main() -> trit {
    let t1: trit = 1;
    let t2: trit = 1;
    let t3: trit = 1;
    
    // Chain of affirmation should result in affirmation.
    let res: trit = validate_consensus_chain(t1, t2, t3);
    
    match res {
         1 => { return truth(); } // Pass test: Consensus chain verified
         0 => { return conflict(); }
        -1 => { return conflict(); }
    }
}
