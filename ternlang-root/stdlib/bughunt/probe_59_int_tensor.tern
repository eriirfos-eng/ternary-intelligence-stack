// stdlib/bughunt/probe_59_int_tensor.tern
// Demonstrates: Whether int[N] is supported.
// Tier: 1

fn main() -> trit {
    let items: int[3];
    items[0] = 10;
    items[1] = 20;
    items[2] = 30;
    
    println("Item 1 (expected 20):");
    println(items[1]);
    
    if items[1] == 20 {
        println("Integer array verified. Success.");
        return truth();
    }
    return conflict();
}
