// stdlib/bughunt/probe_41_casting_logic_bug.tern
// Demonstrates: Casting errors, particularly with negative numbers.
// Tier: 1

fn main() -> trit {
    // Test case 1: Casting a negative trit to float
    // trit(-1) should ideally be -1.0f
    let neg_trit: trit = reject; // reject is -1
    let neg_trit_as_float: float = cast(float) neg_trit;

    // Test case 2: Casting a negative float to int
    // float(-5.9) should ideally be -5 or -6 depending on truncation/rounding.
    // The bug description suggests this results in incorrect values.
    let neg_float: float = -5.9;
    let neg_float_as_int: int = cast(int) neg_float;

    // Test case 3: Combined trit -> float -> int casting with negative values
    // This is expected to produce incorrect results silently.
    let combined_cast: int = cast(int) (cast(float) reject); // cast(float) reject should be -1.0f. cast(int) -1.0f should be -1.

    // Check the results. If any of these casts produce unexpected results,
    // return reject.
    if neg_trit_as_float != -1.0 {
        return reject; // Expected -1.0
    }
    // The exact integer result of casting -5.9 to int is implementation-defined (truncation vs rounding).
    // If it's consistently wrong, we flag it. Let's assume it should truncate towards zero, so -5.
    // If it behaves unexpectedly (e.g., -6 or similar), it's a bug.
    if neg_float_as_int != -5 { // Assuming truncation towards zero for -5.9 -> -5
        return reject; // Unexpected integer conversion for negative float
    }
    if combined_cast != -1 {
        return reject; // Expected -1 from reject -> -1.0f -> -1
    }

    // If all checks pass, return truth.
    return truth();
}
