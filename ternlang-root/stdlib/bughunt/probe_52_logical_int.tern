// stdlib/bughunt/probe_52_logical_int.tern
// Demonstrates: Using logical operators on int instead of trit.
// Tier: 1

fn main() -> trit {
    let a: int = 1;
    let b: int = 2;
    let c: trit = a && b; 
    println("1 && 2 = ");
    println(c);
    
    let d: int = -5;
    let e: trit = a && d;
    println("1 && -5 = ");
    println(e);
    
    return truth();
}

main();
