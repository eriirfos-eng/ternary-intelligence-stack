// stdlib/bughunt/probe_92_chars.tern
// Demonstrates: Workaround for missing character literals using integers.
// Tier: 1

fn main() -> trit {
    let c: int = 65; // ASCII for 'A'
    println("Char (as ASCII): ");
    println(c);
    
    if c == 65 {
        println("Character workaround verified. Success.");
        return truth();
    }
    return conflict();
}
