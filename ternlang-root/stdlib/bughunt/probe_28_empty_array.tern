// Tier: 1

fn process_array(data: trit[]) -> trit {
    // This should be safe, as it doesn't access elements.
    println("Processing array...");
    return truth();
}

fn main() -> trit {
    let empty_array: trit[] = [];
    let empty_tensor = trittensor<0>;

    // Let's see if passing an empty array is fine.
    process_array(empty_array);
    
    // Now, let's try to access an element, which should fail.
