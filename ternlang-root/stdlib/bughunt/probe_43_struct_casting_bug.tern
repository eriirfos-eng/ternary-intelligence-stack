// stdlib/bughunt/probe_43_struct_casting_bug.tern
// Demonstrates: Stack underflow on struct return with casting.
// Tier: 1

// Define a struct
struct Point {
    x: int,
    y: int,
}

fn buggy_struct_return() -> Point {
    let final_val_int: int = -5;
    let p_with_cast: Point = Point {x: final_val_int, y: 5};
    return p_with_cast; 
}

fn main() -> trit {
    let point_result: Point = buggy_struct_return();
    
    // Accessing the field of a returned struct causes stack underflow (VM-STRUCT-001)
    let check: int = point_result.x;
    
    if check == -5 {
        return truth();
    }
    return reject; 
}
