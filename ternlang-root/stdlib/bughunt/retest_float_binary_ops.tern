// stdlib/bughunt/retest_float_binary_ops.tern
// Demonstrates: Re-testing float literals/expressions in binary operations with epsilon.
// Tier: 1

fn float_near(a: float, b: float, epsilon: float) -> trit {
    let diff: float = a - b;
    if diff < 0.0 { diff = 0.0 - diff; }
    if diff <= epsilon { return 1; }
    return -1;
}

fn main() -> trit {
    let a: float = 0.1;
    let b: float = 0.2;
    let c: float = 0.3;
    let d: float = 1.0 / 3.0; // Float expression

    // Test case 1: Addition
    let sum_ab: float = a + b;
    
    // Test case 2: Division and comparison
    let expected_d: float = 0.3333333;
    let eps: float = 0.0001;

    // Use epsilon comparison for float results
    let sum_ok: trit = float_near(sum_ab, c, eps);
    let div_ok: trit = float_near(d, expected_d, eps);

    if sum_ok == 1 && div_ok == 1 { 
        return truth();
    } else {
        return reject; // Indicates potential parsing issue or severe logic bug
    }
}
