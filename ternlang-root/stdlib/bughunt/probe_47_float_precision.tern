// stdlib/bughunt/probe_47_float_precision.tern
// Demonstrates: Testing float literal assignment and basic operations.
// Tier: 1

fn main() -> trit {
    // Test if float literals can be assigned.
    let pi: float = 3.14159;
    
    // If assignment works, attempt a very simple operation.
    // This aims to be as syntactically simple as possible to pass the parser,
    // and then test runtime behavior if parsing succeeds.
    let two: float = 2.0;
    let half_pi: float = pi / two; // Attempt simple division.

    // If the above lines parse and execute without error, we check the result.
    // We use a simple comparison that is less likely to trigger parser issues than complex checks.
    // This checks if the division produced a value roughly expected for pi/2.
    if half_pi > 1.57 && half_pi < 1.58 {
        return truth(); // Success if the value is in the expected range.
    } else {
        // If the value is outside the range, it might indicate a runtime precision issue,
        // or a comparison bug, or the division itself failed in the VM.
        return reject;
    }
}
