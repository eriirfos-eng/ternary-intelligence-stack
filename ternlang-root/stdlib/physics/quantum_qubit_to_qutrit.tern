fn main() -> trit {
    let alpha: float = 0.707;
    let beta: float = 0.707;
    let mut state: trit = 0;
    
    if alpha > 0.5 {
        state = 1;
    } else if beta > 0.5 {
        state = -1;
    } else {
        state = 0;
    }
    
    println("Measured Qutrit State:");
    println(state);
    
    if state == 1 { return 1; }
    return -1;
}
