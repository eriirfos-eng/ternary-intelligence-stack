fn main() -> trit {
    let v1: float = 1.0;
    let v2: float = -1.0;
    let m1: float = 1.0;
    let m2: float = 1.0;
    
    let v1_new: float = (v1 * (m1 - m2) + 2.0 * m2 * v2) / (m1 + m2);
    
    println("Elastic Collision v1_new:");
    println(v1_new);
    
    if v1_new == -1.0 { return 1; }
    return -1;
}
