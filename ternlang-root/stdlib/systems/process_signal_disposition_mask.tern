// stdlib/systems/process_signal_disposition_mask.tern
// Demonstrates: Evaluating how to handle a system signal (SIGTERM/SIGKILL)
// Tier: 3

fn signal_severity(sig_num: int) -> trit {
    if sig_num == 9 { return -1; } // SIGKILL (Immediate)
    if sig_num == 15 { return 0; } // SIGTERM (Graceful)
    return 1; // Others (Ignore or minor)
}

fn process_state_eval(is_critical: int) -> trit {
    if is_critical == 1 { return -1; } // Cannot terminate easily
    return 1;
}

fn grace_period_remaining(sec: int) -> trit {
    if sec < 1 { return -1; } // Time up
    if sec < 10 { return 0; }
    return 1;
}

fn main() -> trit {
    let sig: trit = signal_severity(15);
    let state: trit = process_state_eval(1);
    let grace: trit = grace_period_remaining(5);
    
    match sig {
        -1 => { return -1; } // Force kill
        0  => {
            match state {
                -1 => { return grace; } // Critical process, respect grace
                1  => { return -1; } // Non-critical, just terminate
                0  => { return 0; }
            }
        }
        1  => { return 1; }
    }
}
