// stdlib/systems/garbage_collection_consensus.tern
// Demonstrates: GC triggering logic based on memory pressure
// Tier: 3 — Industrial

fn trigger_gc(used_mem: float, total_mem: float) -> trit {
    let ratio: float = used_mem / total_mem;
    
    if ratio > 0.85 {
        return truth();   // High pressure (Trigger GC)
    }
    if ratio < 0.4 {
        return conflict(); // Low pressure (No GC)
    }
    return hold();        // Moderate pressure (Consider GC)
}

fn main() -> trit {
    // 90% used
    let res1: trit = trigger_gc(900.0, 1000.0); // 1
    // 20% used
    let res2: trit = trigger_gc(200.0, 1000.0); // -1
    // 60% used
    let res3: trit = trigger_gc(600.0, 1000.0); // 0

    match res1 {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => {
             match res2 {
                 -1 => {
                     match res3 {
                         -1 => { return conflict(); }
                          0 => { return truth(); }
                          1 => { return conflict(); }
                     }
                 }
                 0 => { return hold(); }
                 1 => { return conflict(); }
             }
         }
    }
}
