// stdlib/systems/paging_fault_rate_detector.tern
// Demonstrates: Identifying memory thrashing by analyzing page fault rates
// Tier: 3

fn fault_rate_eval(faults_per_sec: int, threshold: int) -> trit {
    if faults_per_sec > (threshold * 5) { return -1; } // Thrashing!
    if faults_per_sec > threshold { return 0; }
    return 1;
}

fn free_memory_check(free_kb: int, total_kb: int) -> trit {
    if (free_kb * 20) < total_kb { return -1; } // < 5% free
    if (free_kb * 10) < total_kb { return 0; }  // < 10% free
    return 1;
}

fn main() -> trit {
    let rate: trit = fault_rate_eval(5000, 1000);
    let mem: trit = free_memory_check(100000, 2000000);
    
    match rate {
        -1 => { return -1; } // Heavy thrashing
        0  => { return mem; }
        1  => { return 1; }
    }
}
