// stdlib/systems/raid_rebuild_priority_mask.tern
// Demonstrates: Deciding RAID rebuild priority based on IO load and redundancy
// Tier: 3

from "systems_utils.tern" import consensus;

fn io_load_impact(iops: int) -> trit {
    if iops > 5000 { return -1; } // High impact, throttle rebuild
    if iops > 1000 { return 0; }  // Moderate
    return 1; // Idle, full speed rebuild
}

fn redundancy_level(remaining_drives: int) -> trit {
    if remaining_drives < 2 { return -1; } // Critical risk of total loss
    if remaining_drives < 4 { return 0; }
    return 1; // Safe
}

fn main() -> trit {
    let io: trit = io_load_impact(1500);
    let red: trit = redundancy_level(1);
    
    // Priority should be HIGH if redundancy is low, even if IO load is high.
    // Ternary logic allows us to balance these.
    match red {
        -1 => { return -1; } // Redundancy failure is top priority
        0  => { return io; }
        1  => { return io; }
    }
}
