// stdlib/systems/thermal_throttling_consensus.tern
// Demonstrates: Deciding when to throttle CPU based on thermal sensors
// Tier: 3

from "systems_utils.tern" import consensus;

fn sensor_eval(temp_c: int) -> trit {
    if temp_c > 95 { return -1; } // Danger!
    if temp_c > 80 { return 0; }  // Hot, watch
    return 1; // Cool
}

fn fan_speed_check(rpm: int, max_rpm: int) -> trit {
    if rpm > (max_rpm * 90 / 100) { return 0; } // Fans at max, still hot?
    if rpm > (max_rpm * 50 / 100) { return 1; }
    return 1;
}

fn main() -> trit {
    let cpu_temp: trit = sensor_eval(88);
    let gpu_temp: trit = sensor_eval(75);
    let fans: trit = fan_speed_check(4500, 5000);
    
    let temp_con: trit = consensus(cpu_temp, gpu_temp);
    let final_con: trit = consensus(temp_con, fans);
    
    match final_con {
        -1 => { return -1; } // Critical Throttle
        0  => { return 0;  } // Soft Throttle
        1  => { return 1;  } // Full Performance
    }
}
