// stdlib/systems/kernel_panic_gate.tern
// Demonstrates: gating logic for kernel panics based on severity and recovery
// Tier: 3 — Industrial

fn panic_gate(severity: int, recovery_available: trit) -> trit {
    if severity > 5 {
        if recovery_available == 1 { return hold(); }
        return conflict();
    }
    if severity > 2 { return hold(); }
    return truth();
}

fn main() -> trit {
    let sev: int = 6;
    let rec: trit = 0;
    
    let res: trit = panic_gate(sev, rec);
    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
