// stdlib/systems/system_health_check.tern
// Demonstrates: A comprehensive system health check using multiple ternary signals.
// Tier: 2 — Pro Standard

fn check_health(cpu: trit, ram: trit, disk: trit) -> trit {
    // If any critical signal is -1, return -1.
    // If all are 1, return 1.
    // Otherwise return 0 (min(cpu, ram, disk)).
    return cpu && ram && disk;
}

fn main() -> trit {
    let cpu: trit = 1;
    let ram: trit = 1;
    let disk: trit = 0;
    
    let result: trit = check_health(cpu, ram, disk);
    
    match result {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
