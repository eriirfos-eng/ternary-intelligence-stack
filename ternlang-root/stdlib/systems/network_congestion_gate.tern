// stdlib/systems/network_congestion_gate.tern
// Demonstrates: network congestion detection via latency/loss bounds
// Tier: 3 — Industrial

fn check_congestion(latency: float, packet_loss: float) -> trit {
    if latency > 200.0 || packet_loss > 0.05 {
        return truth();   // Congested
    }
    if latency < 20.0 && packet_loss < 0.001 {
        return conflict(); // Clear
    }
    return hold();        // Warning/Transition
}

fn main() -> trit {
    // High latency
    let res1: trit = check_congestion(350.0, 0.02); // 1
    // Fiber line
    let res2: trit = check_congestion(10.0, 0.0);   // -1
    // Wi-Fi jitter
    let res3: trit = check_congestion(80.0, 0.005); // 0

    match res1 {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => {
             match res2 {
                 -1 => {
                     match res3 {
                         -1 => { return conflict(); }
                          0 => { return truth(); }
                          1 => { return conflict(); }
                     }
                 }
                 0 => { return hold(); }
                 1 => { return conflict(); }
             }
         }
    }
}
