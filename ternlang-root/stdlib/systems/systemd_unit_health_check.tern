// stdlib/systems/systemd_unit_health_check.tern
// Demonstrates: Evaluating a systemd-style unit's health
// Tier: 3

fn unit_active_state(is_active: int, is_failed: int) -> trit {
    if is_failed == 1 { return -1; }
    if is_active == 1 { return 1; }
    return 0; // Inactive or reloading
}

fn unit_restart_count(count: int, max: int) -> trit {
    if count >= max { return -1; } // Flapping detected
    if count > (max / 2) { return 0; }
    return 1;
}

fn unit_exit_code(code: int) -> trit {
    if code == 0 { return 1; }
    if code == 143 { return 0; } // Graceful stop
    return -1; // Crash
}

fn main() -> trit {
    let state: trit = unit_active_state(1, 0);
    let restart: trit = unit_restart_count(3, 10);
    let exit: trit = unit_exit_code(0);
    
    match state {
        -1 => { return -1; }
        1  => {
            match restart {
                1 => { return 1; }
                0 => { return 0; }
                -1 => { return -1; }
            }
        }
        0 => { return exit; }
    }
}
