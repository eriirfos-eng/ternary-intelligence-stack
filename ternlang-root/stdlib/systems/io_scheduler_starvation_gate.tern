// stdlib/systems/io_scheduler_starvation_gate.tern
// Demonstrates: Identifying and mitigating IO request starvation
// Tier: 3

fn wait_time_eval(ms: int, threshold_ms: int) -> trit {
    if ms > (threshold_ms * 10) { return -1; } // Starved!
    if ms > threshold_ms { return 0; }
    return 1;
}

fn queue_depth_check(depth: int) -> trit {
    if depth > 256 { return -1; } // Congested
    if depth > 64 { return 0; }
    return 1;
}

fn priority_boost_check(is_realtime: int) -> trit {
    if is_realtime == 1 { return 1; }
    return 0;
}

fn main() -> trit {
    let wait: trit = wait_time_eval(5000, 500);
    let depth: trit = queue_depth_check(128);
    let prio: trit = priority_boost_check(0);
    
    match wait {
        -1 => { return -1; } // Immediate intervention
        0  => {
            match prio {
                1 => { return 1; } // Boost RT process
                0 => { return 0; }
                -1 => { return 0; }
            }
        }
        1  => { return 1; }
    }
}
