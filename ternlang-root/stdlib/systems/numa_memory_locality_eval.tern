// stdlib/systems/numa_memory_locality_eval.tern
// Demonstrates: Evaluating memory access efficiency in NUMA systems
// Tier: 3

fn node_proximity(local_node: int, remote_node: int) -> trit {
    if local_node == remote_node { return 1; } // Local (Affirm)
    if (local_node - remote_node) < 2 { return 0; } // Near neighbor
    return -1; // Far node (Conflict)
}

fn memory_bandwidth_util(util: int) -> trit {
    if util > 90 { return -1; } // Saturated
    if util > 60 { return 0; }
    return 1;
}

fn main() -> trit {
    let prox: trit = node_proximity(0, 3);
    let util: trit = memory_bandwidth_util(40);
    
    match prox {
        1  => { return util; }
        0  => { return 0; }
        -1 => { return -1; }
    }
}
