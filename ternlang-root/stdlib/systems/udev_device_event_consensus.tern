// stdlib/systems/udev_device_event_consensus.tern
// Demonstrates: Evaluating hotplugged device legitimacy via udev-style events
// Tier: 3

fn device_whitelisted(vendor_id: int, product_id: int) -> trit {
    if vendor_id == 4660 { return 1; } // Known vendor
    return 0; // Unknown
}

fn property_check(has_serial: int, has_id_path: int) -> trit {
    if has_serial == 1 { return 1; }
    if has_id_path == 1 { return 0; }
    return -1; // Suspicious generic device
}

fn action_eval(action: int) -> trit {
    if action == 1 { return 1; } // "add"
    if action == 2 { return 0; } // "change"
    return -1; // "remove" (terminates connection)
}

fn main() -> trit {
    let white: trit = device_whitelisted(4660, 100);
    let prop: trit = property_check(0, 1);
    let act: trit = action_eval(1);
    
    match act {
        -1 => { return -1; }
        1  => {
            match white {
                1 => { return prop; }
                0 => { return 0; }
                -1 => { return -1; }
            }
        }
        0 => { return 0; }
    }
}
