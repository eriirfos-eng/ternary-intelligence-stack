// stdlib/systems/systems_utils.tern
// Demonstrates: Common utility functions for systems health and resource management
// Tier: 3

fn consensus(a: trit, b: trit) -> trit {
    match a {
        -1 => { return -1; }
        0 => { return b; }
        1 => {
            match b {
                -1 => { return -1; }
                0 => { return 1; }
                1 => { return 1; }
            }
        }
    }
}

fn map_utilization_to_trit(util_percent: int) -> trit {
    if util_percent > 95 { return -1; } // Critical
    if util_percent > 70 { return 0; }  // Warning
    return 1; // Healthy
}

fn main() -> trit {
    let u: int = 80;
    let t: trit = map_utilization_to_trit(u);
    
    match t {
        -1 => { return -1; }
        0  => { return 0;  }
        1  => { return 1;  }
    }
}
