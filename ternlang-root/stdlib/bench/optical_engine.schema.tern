// Module:  stdlib/bench/optical_engine.schema.tern
// Purpose: T-SON serialization schema for optical_engine
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Optical_engineSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Optical_engineSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
