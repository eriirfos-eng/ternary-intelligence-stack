// Module:  stdlib/bench/plasma_model.schema.tern
// Purpose: T-SON serialization schema for plasma_model
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Plasma_modelSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Plasma_modelSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
