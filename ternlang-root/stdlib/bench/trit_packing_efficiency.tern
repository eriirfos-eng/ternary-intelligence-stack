// stdlib/bench/trit_packing_efficiency.tern
// Demonstrates: memory overhead of large trit tensors
// Tier: 3 — Industrial

fn fill_large_tensor(t: trittensor<100>) -> trit {
    let i: int = 0;
    while i < 100 {
        t[i] = 1;
        i = i + 1;
    }
    return truth();
}

fn main() -> trit {
    let t: trittensor<100>;
    let ok: trit = fill_large_tensor(t);
    
    if ok {
        match t[99] {
            1 => { return truth();    }
            0 => { return hold();     }
            -1 => { return conflict(); }
        }
    }
    return conflict();
}
