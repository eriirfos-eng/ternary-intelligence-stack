// Module:  stdlib/bench/stellar_analyzer.schema.tern
// Purpose: T-SON serialization schema for stellar_analyzer
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Stellar_analyzerSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Stellar_analyzerSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
