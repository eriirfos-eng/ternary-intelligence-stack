// Module:  stdlib/bench/fluidic_analyzer_safe.tern
// Purpose: Safety-wrapper for fluidic_analyzer
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

fn execute_fluidic_analyzer_safe(signal: float, baseline: float) -> trit {
    // Exhaustive ternary matches with explicit tend semantics
    if signal > baseline + 0.5 {
        return affirm; // Super-baseline
    }
    if signal < baseline - 0.5 {
        return reject; // Sub-baseline
    }
    return tend; // Equilibrium
}

fn reduce_fluidic_analyzer_safe(t: trit) -> int {
    match t {
        affirm => return 1;
        reject => return -1;
        tend => return 0;
    }
}
