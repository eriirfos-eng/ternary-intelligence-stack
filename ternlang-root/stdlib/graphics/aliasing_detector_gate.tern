// stdlib/graphics/aliasing_detector_gate.tern
// Demonstrates: aliasing detection via local contrast gradient
// Tier: 3 — Industrial

fn detect_aliasing(p1: float, p2: float, p3: float) -> trit {
    // Check for high-frequency oscillation (potential aliasing)
    // Contrast p1 to p2, p2 to p3
    let d1: float = p1 - p2;
    if d1 < 0.0 { d1 = -d1; }
    
    let d2: float = p2 - p3;
    if d2 < 0.0 { d2 = -d2; }

    // If both jumps are large, high probability of aliasing
    if d1 > 0.8 && d2 > 0.8 {
        return truth();
    }
    // If very small, low probability
    if d1 < 0.1 && d2 < 0.1 {
        return conflict();
    }
    return hold();
}

fn main() -> trit {
    // High contrast oscillation
    let res1: trit = detect_aliasing(1.0, 0.0, 1.0); // 1
    // Smooth transition
    let res2: trit = detect_aliasing(0.5, 0.52, 0.54); // -1
    // Moderate change
    let res3: trit = detect_aliasing(0.5, 0.8, 0.5); // 0

    match res1 {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => {
             match res2 {
                 -1 => {
                     match res3 {
                         -1 => { return conflict(); }
                          0 => { return truth(); }
                          1 => { return conflict(); }
                     }
                 }
                 0 => { return hold(); }
                 1 => { return conflict(); }
             }
         }
    }
}
