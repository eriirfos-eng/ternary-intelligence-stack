// stdlib/graphics/alpha_composite.tern
// Demonstrates: alpha compositing via consensus merging
// Tier: 3 — Industrial

fn composite(foreground: trit, background: trit) -> trit {
    // If foreground is uncertain (0), background shows through
    return consensus(foreground, background);
}

fn main() -> trit {
    let fg: trit = 0; // Transparent
    let bg: trit = 1; // Solid
    
    let result: trit = composite(fg, bg); // 1
    
    if result == 1 {
        return truth();
    }
    
    match result {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
