// stdlib/graphics/motion_vector_consensus.tern
// Demonstrates: motion vector significance check via magnitude consensus
// Tier: 3 — Industrial

fn is_fast_motion(vx: float, vy: float) -> trit {
    // Basic squared magnitude check
    let mag_sq: float = vx * vx + vy * vy;

    if mag_sq > 25.0 {
        return truth();   // Fast motion (> 5 pixels/frame)
    }
    if mag_sq < 0.25 {
        return conflict(); // Sub-pixel motion or static
    }
    return hold();        // Standard motion
}

fn main() -> trit {
    // Rapid move
    let res1: trit = is_fast_motion(10.0, 0.0); // 1
    // Static
    let res2: trit = is_fast_motion(0.1, 0.1);  // -1
    // Walking pace
    let res3: trit = is_fast_motion(2.0, 1.0);  // 0

    match res1 {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => {
             match res2 {
                 -1 => {
                     match res3 {
                         -1 => { return conflict(); }
                          0 => { return truth(); }
                          1 => { return conflict(); }
                     }
                 }
                 0 => { return hold(); }
                 1 => { return conflict(); }
             }
         }
    }
}
