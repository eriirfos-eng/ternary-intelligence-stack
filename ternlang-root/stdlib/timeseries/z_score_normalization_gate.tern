// stdlib/timeseries/z_score_normalization_gate.tern
// Demonstrates: Z-score normalization and anomaly flagging.
// Tier: 3 — Industrial

fn z_score(val: float, mean: float, std_dev: float) -> float {
    if std_dev == 0.0 { return 0.0; }
    return (val - mean) / std_dev;
}

fn flag_anomaly(z: float, threshold: float) -> trit {
    let abs_z: float = z;
    if z < 0.0 { abs_z = -z; }

    if abs_z > threshold {
        return truth(); // Anomaly
    }

    if abs_z > threshold * 0.7 {
        return hold(); // Warning
    }

    return conflict(); // Normal
}

fn main() -> trit {
    let z_val: float = z_score(12.5, 10.0, 1.0);
    let res: trit = flag_anomaly(z_val, 2.0);

    match res {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
