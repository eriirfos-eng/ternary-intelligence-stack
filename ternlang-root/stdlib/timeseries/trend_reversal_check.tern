// stdlib/timeseries/trend_reversal_check.tern
// Demonstrates: detecting change in trend direction
// Tier: 3

fn detect_reversal(prev_trend: trit, current_signal: trit) -> trit {
    // If we were trending up (1) and now signal is down (-1) -> Reversal Affirm
    if prev_trend == 1 {
        if current_signal == -1 {
            return 1;
        }
    }
    
    // If we were trending down (-1) and now signal is up (1) -> Reversal Affirm
    if prev_trend == -1 {
        if current_signal == 1 {
            return 1;
        }
    }
    
    // Otherwise, trend continues or is uncertain
    return 0;
}

fn main() -> trit {
    let old: trit = 1;
    let new: trit = -1;
    
    let rev: trit = detect_reversal(old, new);
    
    if rev == 1 {
        return 1;
    } else {
        return -1;
    }
}
