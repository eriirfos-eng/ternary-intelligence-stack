// stdlib/timeseries/lagged_correlation_check.tern
// Demonstrates: Lagged correlation significance check between two series.
// Tier: 3 — Industrial

fn check_correlation(r: float, threshold: float) -> trit {
    let abs_r: float = r;
    if r < 0.0 { abs_r = -r; }

    if abs_r > threshold {
        return truth(); // Significant correlation
    }

    if abs_r > threshold / 2.0 {
        return hold(); // Potential leading indicator
    }

    return conflict(); // No significant correlation
}

fn main() -> trit {
    let r_lag_1: float = 0.65;
    let thresh: float = 0.5;

    let res: trit = check_correlation(r_lag_1, thresh);

    match res {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
