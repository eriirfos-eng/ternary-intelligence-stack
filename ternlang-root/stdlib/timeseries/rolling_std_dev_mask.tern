// stdlib/timeseries/rolling_std_dev_mask.tern
// Demonstrates: Outlier detection using rolling standard deviation.
// Tier: 3 — Industrial

fn is_outlier(val: float, mean: float, std_dev: float, sigma: float) -> trit {
    let diff: float = val - mean;
    if diff < 0.0 { diff = -diff; }

    if diff > sigma * std_dev {
        return truth(); // Outlier detected
    }

    if diff > (sigma - 1.0) * std_dev {
        return hold(); // Suspicious, near threshold
    }

    return conflict(); // Normal point
}

fn main() -> trit {
    let v: float = 15.0;
    let m: float = 10.0;
    let s: float = 1.5;
    let sig: float = 3.0;

    let res: trit = is_outlier(v, m, s, sig);

    match res {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
