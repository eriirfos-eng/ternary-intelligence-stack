// stdlib/timeseries/moving_average_gate.tern
// Demonstrates: SMA calculation on ternary momentum and threshold check
// Tier: 3

fn momentum_sma(data: trit[]) -> float {
    let sum: int = 0;
    let count: int = 0;
    for x in data {
        match x {
            1  => { sum = sum + 1; }
            0  => { sum = sum + 0; }
            -1 => { sum = sum - 1; }
        }
        count = count + 1;
    }
    if count > 0 {
        return cast(sum) / cast(count);
    } else {
        return 0.0;
    }
}

fn main() -> trit {
    let momentum: trit[] = [1, 1, 0, 1, -1];
    
    // Sum = 1+1+0+1-1 = 2
    // Count = 5
    // SMA = 2/5 = 0.4
    
    let avg: float = momentum_sma(momentum);
    
    if avg > 0.3 {
        return 1;
    } else {
        return -1;
    }
}
