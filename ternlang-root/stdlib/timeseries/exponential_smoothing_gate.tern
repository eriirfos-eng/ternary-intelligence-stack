// stdlib/timeseries/exponential_smoothing_gate.tern
// Demonstrates: EMA calculation on ternary signals
// Tier: 3

fn ema_step(current_ema: float, new_val: trit, alpha: float) -> float {
    let v: float = 0.0;
    match new_val {
        1  => { v = 1.0; }
        0  => { v = 0.0; }
        -1 => { v = -1.0; }
    }
    // EMA = alpha * value + (1 - alpha) * previous_ema
    return (alpha * v) + ((1.0 - alpha) * current_ema);
}

fn main() -> trit {
    let e: float = 0.0;
    let a: float = 0.5;
    
    // EMA after 1, 1, 1 with alpha 0.5
    // 0.5*1 + 0.5*0 = 0.5
    // 0.5*1 + 0.5*0.5 = 0.75
    // 0.5*1 + 0.5*0.75 = 0.875
    
    e = ema_step(e, 1, a);
    e = ema_step(e, 1, a);
    e = ema_step(e, 1, a);
    
    if e > 0.8 {
        return 1;
    } else {
        return -1;
    }
}
