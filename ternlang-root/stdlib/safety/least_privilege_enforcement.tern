// stdlib/safety/least_privilege_enforcement.tern
// Demonstrates: Ternary least-privilege enforcement
// Tier: 2

fn check_access(user_role: int, action_severity: int) -> trit {
    // 3: Admin, 2: User, 1: Guest
    // 3: Write, 2: Read, 1: Meta
    
    if user_role >= action_severity {
        return 1; // Authorized
    }
    
    if user_role == 0 {
        return -1; // Unauthenticated
    }
    
    return 0; // Escalation check needed
}

fn main() -> trit {
    let role: int = 1; // Guest
    let action: int = 2; // Read
    
    let result: trit = check_access(role, action);
    
    match result {
        1  => { return truth();    }
        0  => { return hold();     }
        -1 => { return conflict(); }
    }
}
