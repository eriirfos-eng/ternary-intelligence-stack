// stdlib/safety/uncertainty_filter.tern
// Demonstrates: A safety filter that resolves uncertainty (0) to a default safe state.
// Tier: 2 — Pro Standard

fn resolve_uncertainty(signal: trit, default_safe: trit) -> trit {
    match signal {
        -1 => { return -1; }
         1 => { return 1;  }
         0 => { return default_safe; }
    }
}

fn main() -> trit {
    // Test: Affirm passes through
    if resolve_uncertainty(1, -1) != 1 { return conflict(); }
    
    // Test: Reject passes through
    if resolve_uncertainty(-1, 1) != -1 { return conflict(); }
    
    // Test: Hold resolves to default (-1)
    if resolve_uncertainty(0, -1) != -1 { return conflict(); }
    
    // Test: Hold resolves to default (1)
    if resolve_uncertainty(0, 1) != 1 { return conflict(); }
    
    return truth();
}
