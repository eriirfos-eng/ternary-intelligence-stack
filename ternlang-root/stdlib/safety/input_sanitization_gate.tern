// stdlib/safety/input_sanitization_gate.tern
// Demonstrates: Ternary-based input sanitization
// Tier: 2

fn sanitize(input_len: int, contains_sql: trit, contains_script: trit) -> trit {
    if input_len > 1024 { return -1; }
    
    // If either contains dangerous content, reject
    // Combined via logical OR (Tor / ||) -> 1 if any is 1.
    // We want to REJECT if any is 1, so we flip the result.
    
    let dangerous: trit = contains_sql || contains_script;
    
    match dangerous {
        1  => { return -1; } // Dangerous content found
        0  => { return 0;  } // Uncertain, sanitize further
        -1 => { return 1;  } // Clean
    }
}

fn main() -> trit {
    let len: int = 500;
    let sql: trit = 0; // Suspected
    let script: trit = -1; // Clean
    
    let result: trit = sanitize(len, sql, script);
    
    match result {
        1  => { return truth();    }
        0  => { return hold();     }
        -1 => { return conflict(); }
    }
}
