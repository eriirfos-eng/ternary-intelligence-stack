// stdlib/safety/ema_deliberation_gate.tern
// Demonstrates: Exponential Moving Average (EMA) deliberation gate.
// Tier: 2 — Pro Standard
// Implements the MoE-13 deliberation formula: S_r = alpha * e_r + (1 - alpha) * S_{r-1}.

fn ema_deliberate(prior: float, current_signal: float, alpha: float) -> trit {
    let smoothed: float = alpha * current_signal + (1.0 - alpha) * prior;
    
    if smoothed > 0.85 {
        return affirm;
    }
    if smoothed < 0.15 {
        return reject;
    }
    
    return tend;
}

fn main() -> trit {
    let s1: trit = ema_deliberate(0.5, 0.9, 0.3); 
    let s2: trit = ema_deliberate(0.8, 0.95, 0.3);
    let s3: trit = ema_deliberate(0.85, 0.9, 0.3);

    if s3 != affirm { return reject; }
    if s1 != tend   { return reject; }

    return affirm;
}
