// stdlib/safety/confirmation_gate.tern
// Demonstrates: Safety gate requiring N confirmations to affirm.
// Tier: 2 — Pro Standard

fn confirmation_gate(votes: trit[], required: int) -> trit {
    let count: int = 0;
    let i: int = 0;
    let len: int = length(votes);
    
    while i < len {
        let v: trit = votes[i];
        if v == 1 {
            count = count + 1;
        }
        i = i + 1;
    }
    
    if count >= required {
        return truth();
    }
    
    if count == 0 {
        return conflict();
    }
    
    return hold();
}

fn main() -> trit {
    let votes: trit[] = [1, 0, 1, -1, 1]; // 3 confirmations
    
    let result: trit = confirmation_gate(votes, 2);
    // Should be truth() as count is 3
    match result {
        1 => {
            let r2: trit = confirmation_gate(votes, 4);
            // Should be hold() as count is 3, but required is 4, and count > 0
            match r2 {
                0 => { return truth(); }
                -1 => { return conflict(); }
                1 => { return conflict(); }
            }
        }
        0 => { return conflict(); }
        -1 => { return conflict(); }
    }
}
