// stdlib/safety/unauthorized_access_mask.tern
// Demonstrates: Access control mask using ternary identity and clearance
// Tier: 2

from "./_utils.tern" import *;

fn access_mask(identity_verified: trit, clearance_level: trit, system_status: trit) -> trit {
    // Both identity and clearance must be affirm
    // But if system_status is reject (lockdown), deny everything
    
    if system_status == reject ? {
        return reject;
    } else {
        return tend;
    } else {
        // System not in lockdown
        if identity_verified == affirm ? {
            if clearance_level == affirm ? {
                return affirm;
            } else {
                return tend;
            } else {
                return reject;
            }
        } else {
            return tend;
        } else {
            return reject;
        }
    }
}

fn main() -> trit {
    let id: trit = affirm;
    let cl: trit = tend; // Restricted clearance
    let sys: trit = affirm; // Normal status
    
    let access: trit = access_mask(id, cl, sys);
    
    match access {
        affirm => {
            println("Access GRANTED");
        }
        tend => {
            println("Access PENDING - Additional verification required");
        }
        reject => {
            println("Access DENIED - Unauthorized");
        }
    }
    
    return access;
}
