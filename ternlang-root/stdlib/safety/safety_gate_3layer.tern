// stdlib/safety/safety_gate_3layer.tern
// Demonstrates: Three-layer deliberation gate for deployment safety.
// Tier: 2 — Pro Standard

fn safety_deliberation(l1_check: trit, l2_check: trit, l3_check: trit) -> trit {
    // Layer 1: Critical Veto (High Priority)
    if l1_check == -1 { return conflict(); }
    
    // Layer 2: Secondary Check (Consensus needed)
    let consensus_val: trit = consensus(l1_check, l2_check);
    if consensus_val == -1 { return conflict(); }
    
    // Layer 3: Environment Check (Hold if uncertain)
    if l3_check == 0 { return hold(); }
    
    // Final consensus across all layers
    return consensus(consensus_val, l3_check);
}

fn main() -> trit {
    // Test: Critical veto should exit early
    if safety_deliberation(-1, 1, 1) != -1 { return conflict(); }
    
    // Test: Uncertainty in L3 should hold
    if safety_deliberation(1, 1, 0) != 0 { return conflict(); }
    
    // Test: All affirm should affirm
    if safety_deliberation(1, 1, 1) != 1 { return conflict(); }
    
    return truth();
}
