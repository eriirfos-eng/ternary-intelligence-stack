// stdlib/safety/value_alignment_audit.tern
// Demonstrates: Ternary value alignment audit
// Tier: 2

fn audit_alignment(agent_decision: trit, human_oversight: trit) -> trit {
    // If they agree, it's aligned
    if agent_decision == human_oversight {
        return 1;
    }
    
    // If human is neutral, we hold
    if human_oversight == 0 {
        return 0;
    }
    
    // If human explicitly rejects what agent affirmed, it's a conflict
    return -1;
}

fn main() -> trit {
    let agent_val: trit = 1;
    let human: trit = -1;
    
    let result: trit = audit_alignment(agent_val, human);
    
    match result {
        1  => { return truth();    }
        0  => { return hold();     }
        -1 => { return conflict(); }
    }
}
