// stdlib/safety/resource_exhaustion_guard.tern
// Demonstrates: Ternary resource exhaustion guard
// Tier: 2

fn check_resource(used: int, total: int) -> trit {
    let usage: float = cast(used) / cast(total);
    
    if usage > 0.9 {
        return -1; // Critical / Exhausted
    }
    
    if usage > 0.7 {
        return 0; // Warning / High usage
    }
    
    return 1; // Safe
}

fn main() -> trit {
    let u: int = 85;
    let t: int = 100;
    
    let result: trit = check_resource(u, t);
    
    match result {
        1  => { return truth();    }
        0  => { return hold();     }
        -1 => { return conflict(); }
    }
}
