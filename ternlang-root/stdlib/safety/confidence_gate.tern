// stdlib/safety/confidence_gate.tern
// Demonstrates: Confidence-weighted safety gate for MoE-13 orchestration.
// Tier: 2 — Pro Standard
// Implements a hard veto gate: if any safety signal is reject (-1),
// the action is blocked regardless of other signals.
// If fewer than 2 signals affirm, result is hold (0) to request more evidence.

fn check_signal(s: trit, count: int) -> int {
    match s {
        -1 => { return -1; }
         0 => { return count; }
         1 => { return count + 1; }
    }
}

fn safety_gate(s0: trit, s1: trit, s2: trit) -> trit {
    let c0: int = check_signal(s0, 0);
    if c0 < 0 { return reject; }

    let c1: int = check_signal(s1, c0);
    if c1 < 0 { return reject; }

    let c2: int = check_signal(s2, c1);
    if c2 < 0 { return reject; }

    if c2 > 1 { return affirm; }
    return tend;
}

fn main() -> trit {
    let r1: trit = safety_gate(1, 1, 0);
    let r2: trit = safety_gate(1, -1, 1);
    let r3: trit = safety_gate(0, 0, 1);

    if r1 != affirm  { return reject; }
    if r2 != reject  { return reject; }
    if r3 != tend    { return reject; }

    return affirm;
}
