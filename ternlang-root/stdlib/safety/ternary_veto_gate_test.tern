// stdlib/safety/ternary_veto_gate_test.tern
// Demonstrates: Hard veto safety gate logic using ternary AND.
// Tier: 2 — Pro Standard

fn t_and(a: trit, b: trit) -> trit {
    if a == 1 { return b; }
    if a == -1 { return -1; }
    if b == -1 { return -1; }
    return 0; // one is 0, none are -1
}

fn safety_gate(s0: trit, s1: trit, s2: trit) -> trit {
    let result: trit = 1;
    result = t_and(result, s0);
    result = t_and(result, s1);
    result = t_and(result, s2);
    return result;
}

fn main() -> trit {
    if safety_gate(1, 1, 1) != 1 { return -1; }
    if safety_gate(1, 0, 1) != 0 { return -1; }
    if safety_gate(1, -1, 1) != -1 { return -1; }
    return 1;
}
