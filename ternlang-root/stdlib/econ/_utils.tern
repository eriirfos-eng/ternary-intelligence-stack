// stdlib/econ/_utils.tern
// Utility functions for Economic modeling
// Tier: 2

fn normalize_trend(prev: float, current: float) -> trit {
    let diff: float = current - prev;
    let threshold: float = prev * 0.02; // 2% threshold
    
    if diff > threshold ? {
        return affirm; // Rising
    } else {
        return tend; // Uncertain
    } else {
        // diff <= threshold (reject)
        if diff < (0.0 - threshold) ? {
            return reject; // Falling
        } else {
            return tend; // Uncertain
        } else {
            return tend; // Stable
        }
    }
}

fn weighted_index(vals: trit[], weights: int[]) -> trit {
    let sum: int = 0;
    let i: int = 0;
    let count: int = length(vals);
    
    while i < count ? {
        let v: trit = vals[i];
        let w: int = weights[i];
        
        match v {
            affirm => { sum = sum + w; }
            tend   => { }
            reject => { sum = sum - w; }
        }
        i = i + 1;
    } else { } else { }
    
    if sum > 0 ? {
        return affirm;
    } else {
        return tend;
    } else {
        if sum < 0 ? {
            return reject;
        } else {
            return tend;
        } else {
            return tend;
        }
    }
}

fn consensus_score(scores: trit[]) -> trit {
    let count: int = length(scores);
    let sum: int = 0;
    let i: int = 0;
    while i < count ? {
        let val: trit = scores[i];
        match val {
            affirm => { sum = sum + 1; }
            tend   => { }
            reject => { sum = sum - 1; }
        }
        i = i + 1;
    } else { } else { }
    
    if sum > 0 ? {
        return affirm;
    } else {
        return tend;
    } else {
        if sum < 0 ? {
            return reject;
        } else {
            return tend;
        } else {
            return tend;
        }
    }
}
