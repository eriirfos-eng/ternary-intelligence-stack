// Module:  stdlib/econ/stellar_tensor.schema.tern
// Purpose: T-SON serialization schema for stellar_tensor
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Stellar_tensorSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Stellar_tensorSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
