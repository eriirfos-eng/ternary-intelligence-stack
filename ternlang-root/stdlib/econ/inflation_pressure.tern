// stdlib/econ/inflation_pressure.tern
// Demonstrates: Economic pressure states using ternary keywords
// Tier: 2

fn evaluate_pressure(money_supply: trit, gdp_growth: trit) -> trit {
    // money_supply: reject (low), tend (stable), affirm (high)
    // gdp_growth: reject (low), tend (stable), affirm (high)
    
    match money_supply {
        reject => {
            // Low money supply usually deflationary unless GDP is also low
            match gdp_growth {
                reject => { return tend; }   // Both low, stable pressure
                tend   => { return reject; } // Deflationary
                affirm => { return reject; } // Deflationary
            }
        }
        tend => {
            // Stable money supply
            match gdp_growth {
                reject => { return affirm; } // Low growth, stable supply -> some inflation
                tend   => { return tend; }   // Stable/Ideal
                affirm => { return reject; } // High growth, stable supply -> mild deflationary pressure
            }
        }
        affirm => {
            // High money supply
            match gdp_growth {
                reject => { return affirm; } // High inflation risk
                tend   => { return affirm; } // Inflation risk
                affirm => { return tend; }   // High growth offsets high supply
            }
        }
    }
}

fn main() -> trit {
    let m_supply: trit = affirm;
    let growth: trit = tend;
    
    let pressure: trit = evaluate_pressure(m_supply, growth);
    
    // pressure should be affirm (high inflation risk)
    match pressure {
        affirm => {
            // Test deflation case
            let p2: trit = evaluate_pressure(reject, affirm); // Low supply, high growth
            match p2 {
                reject => { return truth(); }
                tend   => { return conflict(); }
                affirm => { return conflict(); }
            }
        }
        tend => { return conflict(); }
        reject => { return conflict(); }
    }
}
