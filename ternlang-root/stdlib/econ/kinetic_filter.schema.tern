// Module:  stdlib/econ/kinetic_filter.schema.tern
// Purpose: T-SON serialization schema for kinetic_filter
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Kinetic_filterSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Kinetic_filterSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
