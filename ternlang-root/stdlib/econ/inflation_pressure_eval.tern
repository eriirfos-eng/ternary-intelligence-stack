// stdlib/econ/inflation_pressure_eval.tern
// Demonstrates: Evaluating inflation pressure across sectors
// Tier: 2

from "./_utils.tern" import *;

fn evaluate_inflation(cpi_trend: trit, ppi_trend: trit, wage_trend: trit) -> trit {
    let scores: trittensor<3>;
    scores[0] = cpi_trend;
    scores[1] = ppi_trend;
    scores[2] = wage_trend;
    
    let weights: trittensor<3>;
    weights[0] = 5;
    weights[1] = 3;
    weights[2] = 2;
    
    // Convert to trit[] for the function
    return weighted_index(scores, weights);
}

fn main() -> trit {
    let cpi: trit = affirm; // Rising
    let ppi: trit = affirm; // Rising
    let wage: trit = tend;   // Stable
    
    let pressure: trit = evaluate_inflation(cpi, ppi, wage);
    
    match pressure {
        affirm => {
            println("High inflationary pressure detected.");
        }
        tend => {
            println("Price levels are stable.");
        }
        reject => {
            println("Deflationary pressure detected.");
        }
    }
    
    return pressure;
}
