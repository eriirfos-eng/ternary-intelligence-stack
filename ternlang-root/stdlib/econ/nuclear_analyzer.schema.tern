// Module:  stdlib/econ/nuclear_analyzer.schema.tern
// Purpose: T-SON serialization schema for nuclear_analyzer
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Nuclear_analyzerSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Nuclear_analyzerSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
