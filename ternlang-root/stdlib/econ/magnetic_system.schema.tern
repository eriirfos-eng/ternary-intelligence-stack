// Module:  stdlib/econ/magnetic_system.schema.tern
// Purpose: T-SON serialization schema for magnetic_system
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Magnetic_systemSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Magnetic_systemSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
