// stdlib/econ/supply_demand_consensus.tern
// Demonstrates: Supply-Demand Equilibrium via Consensus
// Tier: 2 — Pro Standard

// evaluate_market_balance: Compares supply and demand signals using consensus.
fn evaluate_market_balance(supply: trit, demand: trit) -> trit {
    let balance: trit = consensus(supply, demand);
    
    match balance {
        -1 => { 
            // Unified market contraction (both supply and demand are low)
            return -1; 
        }
         0 => {
            // Disequilibrium or neutral state.
            return 0;
        }
         1 => { 
            // Balanced growth (both supply and demand are strong)
            return 1; 
        }
    }
}

// price_adjustment_signal: Suggests price direction based on supply/demand mismatch.
fn price_adjustment_signal(supply: trit, demand: trit) -> trit {
    // Shortage: Supply is low (-1), Demand is high (1)
    if supply == -1 {
        if demand == 1 {
            return 1; // Increase price
        }
    }
    
    // Surplus: Supply is high (1), Demand is low (-1)
    if supply == 1 {
        if demand == -1 {
            return -1; // Decrease price
        }
    }
    
    return 0; // Stable or balanced
}

fn main() -> trit {
    let s: trit = -1; // Shortage (low supply)
    let d: trit = 1;  // High demand
    
    // Price should increase (1) due to shortage.
    let signal: trit = price_adjustment_signal(s, d);
    
    match signal {
        1 => { return truth(); } // Pass test: Increase price detected
        0 => { return hold(); }
        -1 => { return conflict(); }
    }
}
