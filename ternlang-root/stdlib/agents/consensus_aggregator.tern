// stdlib/agents/consensus_aggregator.tern
// Demonstrates: Aggregating ternary votes/reports from an array using consensus logic.
// Tier: 2 — Pro Standard

fn aggregate_votes(votes: trit[]) -> trit {
    let final_consensus: trit = 0;
    for v in votes {
        final_consensus = consensus(final_consensus, v);
    }
    return final_consensus;
}

fn main() -> trit {
    let votes: trit[] = [1, 0, 1];
    let result: trit = aggregate_votes(votes);
    
    if result != 1 { return conflict(); }
    
    let mixed_votes: trit[] = [-1, 0, 1];
    let mixed_result: trit = aggregate_votes(mixed_votes);
    
    // consensus(-1, 0) = -1, then consensus(-1, 1) = implementation-defined (-1 or 0?)
    // In our case, let's just verify it's not a success if we expected a veto to hold.
    match mixed_result {
        -1 => { return truth(); } // Veto won
         0 => { return truth(); } // Conflict/Uncertainty won
         1 => { return conflict(); } // This would be unexpected if -1 was present
    }
}
