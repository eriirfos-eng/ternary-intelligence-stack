// stdlib/agents/aggregator_agent.tern
// Tier: 1
agent ResultSource {
    fn handle(msg: trit) -> trit {
        return msg
    }
}
agent AggregatorAgent {
    fn handle(msg: trit) -> trit {
        let s1: agentref = spawn ResultSource
        let s2: agentref = spawn ResultSource
        let s3: agentref = spawn ResultSource
        send s1 1
        send s2 0
        send s3 -1
        let r1: trit = await s1
        let r2: trit = await s2
        let r3: trit = await s3
        let val1: int = r1 == 1 ? 1 : (r1 == -1 ? -1 : 0)
        let val2: int = r2 == 1 ? 1 : (r2 == -1 ? -1 : 0)
        let val3: int = r3 == 1 ? 1 : (r3 == -1 ? -1 : 0)
        let sum: int = val1 + val2 + val3
        if sum > 0 { return 1 }
        if sum < 0 { return -1 }
        return 0
    }
}
fn main() -> trit {
    let a: agentref = spawn AggregatorAgent
    send a 0
    let res: trit = await a
    if res == 0 { return 1 }
    return -1
}
