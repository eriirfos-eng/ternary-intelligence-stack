// stdlib/agents/message_broker.tern
// Demonstrates: A message broker gating messages using imported priority logic
// Tier: 2 - Pro Standard

from "message_priority_gate.tern" import filter_priority;

fn broker_dispatch(priority: int, current_load: float) -> trit {
    let gate_status: trit = filter_priority(priority, current_load);
    return gate_status;
}

fn main() -> trit {
    // Medium priority message (2), high system load (0.85)
    let res: trit = broker_dispatch(2, 0.85); // should be tend
    
    match res {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
