// stdlib/agents/rate_limiter.tern
// Demonstrates: Production-grade Rate Limiter agent
// Tier: 1 — Open Core

agent RateLimiter {
    fn handle(msg: trit) -> trit {
        // Return 1 (affirm) to signal successful pass, 0 (hold) to signal throttle
        return 1;
    }
}

fn main() -> trit {
    let rl: agentref = spawn RateLimiter;
    
    send rl 1;
    let r1: trit = await rl;
    
    if r1 == 1 { return 1; }
    return -1;
}
