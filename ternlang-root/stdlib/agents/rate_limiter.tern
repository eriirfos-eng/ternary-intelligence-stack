// stdlib/agents/rate_limiter.tern
// Demonstrates: Rate limiter agent pattern (throttling requests)
// Tier: 1

agent RateLimiter {
    count: int
    limit: int

    fn handle(input: trit) -> trit {
        // Simple initialization
        if self.limit == 0 {
            self.limit = 3;
        }

        if self.count < self.limit {
            self.count = self.count + 1;
            return affirm;
        }
        
        return hold;
    }
}

fn main() -> trit {
    let rl: agentref = spawn RateLimiter;
    
    // Request 1
    send rl affirm;
    let r1: trit = await rl;
    
    // Request 2
    send rl affirm;
    let r2: trit = await rl;
    
    // Request 3
    send rl affirm;
    let r3: trit = await rl;
    
    // Request 4 (Limit reached)
    send rl affirm;
    let r4: trit = await rl;
    
    // Verify sequence: affirm, affirm, affirm, hold
    if r1 == affirm && r2 == affirm && r3 == affirm && r4 == hold {
        return affirm;
    }
    
    return reject;
}
