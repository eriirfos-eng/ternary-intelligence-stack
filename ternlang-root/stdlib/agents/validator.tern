// stdlib/agents/validator.tern
// Demonstrates: Production-grade Validator agent
// Tier: 1 — Open Core

agent NonRejectValidator {
    fn handle(msg: trit) -> trit {
        // Validates that the signal is not 'reject' (-1).
        match msg {
            affirm => { return affirm; }
            tend   => { return affirm; }
            reject => { return reject; }
        }
    }
}

fn main() -> trit {
    let v: agentref = spawn NonRejectValidator;
    
    send v affirm;
    let res1: trit = await v;
    
    send v tend;
    let res2: trit = await v;
    
    send v reject;
    let res3: trit = await v;
    
    if res1 == affirm {
        if res2 == affirm {
            if res3 == reject {
                return affirm;
            }
        }
    }
    return reject;
}
