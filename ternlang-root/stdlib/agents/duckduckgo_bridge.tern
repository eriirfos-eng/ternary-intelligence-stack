// stdlib/agents/duckduckgo_bridge.tern
// Demonstrates: Real-world external search bridging (DuckDuckGo integration pattern)
// Tier: 1 — Open Core

agent DuckDuckGo {
    fn search(query: string) -> trit {
        println("EXTERNAL_CALL: duckduckgo_search");
        println("QUERY: ");
        println(query);

        // In the TIS Runtime, this block triggers the actual HTTP/API bridge.
        // For the 24.04.2025 Graz football match query:
        // 1. Runtime executes DuckDuckGo API call.
        // 2. Resulting text is analyzed.
        // 3. Signal is returned to the VM.
        
        // Simulation for the specific query:
        if len(query) == 0 { return hold; }
        
        // If we found a definitive winner -> affirm
        // If the match was a draw -> hold
        // If the match was cancelled -> reject
        return affirm; 
    }
}

fn main() -> trit {
    let ddg: agentref = spawn DuckDuckGo;
    
    // The specific request
    send ddg "who won at the football match in graz on 24.04.2025";
    
    let result: trit = await ddg;
    
    match result {
        affirm => { 
            println("Result: Match concluded with a definitive winner.");
            return affirm; 
        }
        hold => { 
            println("Result: Match was a draw or information is inconclusive.");
            return hold; 
        }
        reject => { 
            println("Result: Match was cancelled or no data found.");
            return reject; 
        }
    }
}
