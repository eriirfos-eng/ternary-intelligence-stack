// stdlib/agents/retry.tern
// Demonstrates: Production-grade Retry agent pattern with boundary limits
// Tier: 1 — Open Core

agent Worker {
    fn handle(input: trit) -> trit {
        if input == 1 { return 1; }
        return 0;
    }
}

agent RetryAgent {
    fn handle(input: trit) -> trit {
        let max_retries: int = 3;
        let count: int = 0;
        
        while count < max_retries {
            let worker: agentref = spawn Worker;
            send worker input;
            let res: trit = await worker;
            
            if res != 0 {
                return res;
            }
            
            count = count + 1;
        }
        
        return -1;
    }
}

fn main() -> trit {
    let r: agentref = spawn RetryAgent;
    send r 1;
    let result: trit = await r;
    
    if result == 1 { return 1; }
    if result == -1 { return -1; }
    return 0;
}
