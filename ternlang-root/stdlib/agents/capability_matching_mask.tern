// stdlib/agents/capability_matching_mask.tern
// Demonstrates: Masking agents based on their functional capabilities
// Tier: 2

fn match_capabilities(agent_caps: trit[], required_caps: trit[]) -> trit {
    // Both arrays are equal length. For each required cap, check if agent has it.
    let cap1: trit = agent_caps[0];
    let req1: trit = required_caps[0];
    
    // If agent lacks a required capability (req is affirm, agent is reject), return reject
    if req1 == affirm && cap1 == reject {
        return reject;
    }
    
    // If agent has the capability, return affirm
    if req1 == affirm && cap1 == affirm {
        return affirm;
    }
    
    return tend; // Neutral
}

fn main() -> trit {
    let a_caps: trit[] = [affirm, tend];
    let r_caps: trit[] = [affirm, affirm];
    
    let res: trit = match_capabilities(a_caps, r_caps); // should be affirm for the first one
    
    if res == affirm {
        return truth();
    }
    return conflict();
}
