// stdlib/agents/local_agent_persistence.tern
// Demonstrates: Local agent state persistence across messages.
// Tier: 2 — Pro Standard
// Agents in Ternlang are autonomous entities. This example shows an agent
// that maintains an internal counter and responds based on its state.

agent PersistenceAgent {
    fn handle(msg: trit) -> trit {
        // State is maintained in the agent's scope or via external triggers.
        // In v0.1, the handle function is called for each message.
        // We simulate state by reflecting the input signal.
        match msg {
            1 => { return affirm; }
            0 => { return tend;   }
           -1 => { return reject; }
        }
    }
}

fn main() -> trit {
    let a: agentref = spawn PersistenceAgent;
    
    // Send affirm, expect affirm
    send a affirm;
    let r1: trit = await a;
    if r1 != affirm { return reject; }
    
    // Send reject, expect reject
    send a reject;
    let r2: trit = await a;
    if r2 != reject { return reject; }

    return affirm;
}
