// stdlib/agents/message_priority_gate.tern
// Demonstrates: Gating agent messages based on priority
// Tier: 2

fn filter_priority(prio: int, system_load: float) -> trit {
    // Priority levels: 1 (High), 2 (Medium), 3 (Low)
    if prio == 1 {
        return affirm; // High priority always passes
    }
    
    // If system load is high (> 0.8), reject low priority messages
    if system_load > 0.8 {
        if prio == 3 {
            return reject;
        }
        return tend; // Medium priority: hold
    }
    
    return affirm; // Low load: all pass
}

fn main() -> trit {
    let p1: int = 1;
    let l1: float = 0.9;
    let res1: trit = filter_priority(p1, l1); // affirm
    
    let p3: int = 3;
    let res2: trit = filter_priority(p3, l1); // reject
    
    if res1 == affirm && res2 == reject {
        return truth();
    }
    return conflict();
}
