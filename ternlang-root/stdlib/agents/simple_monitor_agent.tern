// stdlib/agents/simple_monitor_agent.tern
// Demonstrates: Simple agent monitoring with threshold alerts.
// Tier: 2 — Pro Standard

agent Monitor {
    fn handle(val: int) -> trit {
        if val > 100 {
            return truth();
        }
        return hold();
    }
}

fn main() -> trit {
    let m: agentref = spawn Monitor;
    
    send m 50;
    send m 150;
    
    let r1: trit = await m; // Should be hold(0) for 50
    if r1 == 0 {
        let r2: trit = await m; // Should be truth(1) for 150
        if r2 == 1 {
            return truth();
        }
    }
    
    return conflict();
}
