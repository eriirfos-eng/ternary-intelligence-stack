// stdlib/agents/broadcast.tern
// Demonstrates: Broadcast pattern (All-or-nothing consensus)
// Tier: 1 — Open Core

agent Worker {
    fn handle(msg: trit) -> trit {
        return msg;
    }
}

agent Broadcast {
    fn handle(msg: trit) -> trit {
        let w1: agentref = spawn Worker;
        let w2: agentref = spawn Worker;
        let w3: agentref = spawn Worker;
        
        send w1 msg;
        send w2 msg;
        send w3 msg;
        
        let r1: trit = await w1;
        let r2: trit = await w2;
        let r3: trit = await w3;
        
        // Logical AND: all must be affirm (+1) to return affirm
        // Balanced Ternary AND (min): 1 && 1 && 1 = 1
        let res: trit = r1 && r2 && r3;
        return res;
    }
}

fn main() -> trit {
    let b: agentref = spawn Broadcast;
    
    // All affirm -> affirm
    send b affirm;
    let res: trit = await b;
    
    match res {
        1  => { return affirm; }
        0  => { return reject; }
        -1 => { return reject; }
    }
}
