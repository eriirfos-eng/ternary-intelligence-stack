// Agent Personality Matrix: Defines behavioral traits for agents.
// Traits: Aggressive (1), Cooperative (0), Passive (-1).

fn decide_action(traits: trit[3], social_cue: trit) -> trit {
    // traits[0]: Cooperativeness
    // If social_cue is friendly (1) and agent is cooperative (1 or 0), then respond friendly (1).
    if social_cue == 1 {
        if traits[0] >= 0 {
            return 1;
        }
    }
    // If social_cue is hostile (-1) and agent is not passive, respond hostile (-1).
    if social_cue == -1 {
        if traits[0] > -1 {
            return -1;
        }
    }
    return 0; // Default Neutral
}

fn main() -> trit {
    let my_traits: trit[3];
    my_traits[0] = 1; // High cooperativeness
    
    let action1: trit = decide_action(my_traits, 1); // Should be 1
    let action2: trit = decide_action(my_traits, -1); // Should be -1
    
    let success: trit = 0;
    if action1 == 1 {
        if action2 == -1 {
            success = 1;
        } else { success = -1; }
    } else { success = -1; }
    
    match success {
        1 => { return 1; }
        0 => { return 0; }
        -1 => { return -1; }
    }
}
