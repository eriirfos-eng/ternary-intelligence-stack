// stdlib/agents/logger.tern
// Demonstrates: Side-effecting agent (Audit Logging)
// Tier: 1 — Open Core

agent Logger {
    fn handle(msg: trit) -> trit {
        // Open audit.trit in Append mode (2)
        let h: int = opent("audit.trit", 2);
        
        if h > -1 {
            writet(h, msg);
            return affirm;
        }
        
        return reject;
    }
}

fn main() -> trit {
    let l: agentref = spawn Logger;
    
    // Log a sequence of trits
    send l affirm;
    let r1: trit = await l;
    
    send l tend;
    let r2: trit = await l;
    
    send l reject;
    let r3: trit = await l;
    
    if r1 == affirm {
        if r2 == affirm {
            if r3 == affirm {
                return affirm;
            }
        }
    }
    
    return reject;
}
