// stdlib/agents/logger.tern
// Demonstrates: Production-grade side-effecting audit logger
// Tier: 1 — Open Core

agent Logger {
    fn handle(msg: trit) -> trit {
        // Attempt to open audit log in append mode
        let h: int = opent("audit.trit", 2);
        
        if h != -1 {
            writet(h, msg);
            return affirm;
        }
        
        // Log failure state
        return reject;
    }
}

fn main() -> trit {
    let l: agentref = spawn Logger;
    
    // Log a sequence of signals
    send l affirm;
    let r1: trit = await l;
    
    send l tend;
    let r2: trit = await l;
    
    send l reject;
    let r3: trit = await l;
    
    // Success criteria: all log operations returned affirm
    if r1 == affirm {
        if r2 == affirm {
            if r3 == affirm {
                return affirm;
            }
        }
    }
    
    return reject;
}
