// stdlib/agents/collaborative_veto.tern
// Demonstrates: Collaborative veto logic for multi-agent decision making.
// If any agent rejects (-1), the result is rejection.
// Otherwise, the consensus signal is returned.
// Tier: 2 — Pro Standard

fn agent_consensus(a1: trit, a2: trit, a3: trit) -> trit {
    // Check for any veto
    if a1 == -1 { return conflict(); }
    if a2 == -1 { return conflict(); }
    if a3 == -1 { return conflict(); }
    
    // Otherwise, find consensus
    let c1: trit = consensus(a1, a2);
    return consensus(c1, a3);
}

fn main() -> trit {
    // Test: Agent 2 vetos -> Result is -1
    if agent_consensus(1, -1, 1) != -1 { return conflict(); }
    
    // Test: Agents 1 & 3 affirm, Agent 2 holds -> Result is 1
    if agent_consensus(1, 0, 1) != 1 { return conflict(); }
    
    // Test: All hold -> Result is 0
    if agent_consensus(0, 0, 0) != 0 { return conflict(); }
    
    return truth();
}
