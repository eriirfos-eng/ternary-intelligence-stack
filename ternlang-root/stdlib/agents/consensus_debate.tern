// stdlib/agents/consensus_debate.tern
// Demonstrates: A multi-agent consensus protocol with a critic.
// Tier: 2 — Pro Standard
// Implements a synchronous debate: Agent A (proponent) proposes,
// Agent B (critic) evaluates. Action is affirm ONLY if both agree.
// This pattern is used in MoE-13 to ensure adversarial robustness.

fn debate_consensus(agent_a: trit, agent_b: trit) -> trit {
    match agent_a {
        1 => { // Proponent affirms
            match agent_b {
                1 => { return affirm; } // Both agree: Affirm
                0 => { return tend;   } // Critic uncertain: Hold
               -1 => { return reject; } // Critic vetoes: Reject
            }
        }
        0 => { // Proponent uncertain
            match agent_b {
                1 => { return tend;   } // Proponent needs more info: Hold
                0 => { return tend;   } // Both uncertain: Hold
               -1 => { return reject; } // Critic vetoes: Reject
            }
        }
        -1 => { // Proponent rejects
            return reject; // Immediate Reject
        }
    }
}

fn main() -> trit {
    // Case 1: Unanimous agreement
    if debate_consensus(affirm, affirm) != affirm { return reject; }
    
    // Case 2: Critic vetoes
    if debate_consensus(affirm, reject) != reject { return reject; }
    
    // Case 3: Proponent uncertain
    if debate_consensus(tend, affirm)   != tend   { return reject; }
    
    // Case 4: Double uncertainty
    if debate_consensus(tend, tend)     != tend   { return reject; }

    return affirm;
}
