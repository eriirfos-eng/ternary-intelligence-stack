// stdlib/agents/gatekeeper.tern
// Tier: 1
agent AuthGuard {
    fn handle(msg: trit) -> trit {
        if msg == affirm { return affirm; }
        return reject;
    }
}

agent Gatekeeper {
    fn handle(msg: trit) -> trit {
        let guard: agentref = spawn AuthGuard;
        send guard msg;
        let authorized: trit = await guard;
        
        if authorized == affirm {
            return msg;
        }
        return reject;
    }
}

fn main() -> trit {
    let g: agentref = spawn Gatekeeper;
    send g affirm;
    let res1: trit = await g;
    send g reject;
    let res2: trit = await g;
    
    if res1 == affirm {
        if res2 == reject {
            return affirm;
        }
    }
    return reject;
}
