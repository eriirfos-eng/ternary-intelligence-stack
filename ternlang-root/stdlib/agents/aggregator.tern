// stdlib/agents/aggregator.tern
// Demonstrates: Production-grade Aggregator agent pattern with error handling
// Tier: 1 — Open Core

agent Sensor {
    fn handle(input: trit) -> trit {
        // Robust sensor: accepts only valid signals
        match input {
            affirm => { return affirm; }
            reject => { return reject; }
            tend   => { return tend; }
        }
    }
}

agent Aggregator {
    fn handle(input: trit) -> trit {
        // Validate input signal
        if input == tend {
            return tend;
        }

        let s1: agentref = spawn Sensor;
        let s2: agentref = spawn Sensor;
        let s3: agentref = spawn Sensor;

        send s1 input;
        send s2 input;
        send s3 input;

        let r1: trit = await s1;
        let r2: trit = await s2;
        let r3: trit = await s3;

        // Robust consensus
        if r1 == r2 { return r1; }
        if r1 == r3 { return r1; }
        if r2 == r3 { return r2; }
        
        return tend; // Ambiguous state
    }
}

fn main() -> trit {
    let a: agentref = spawn Aggregator;
    send a affirm;
    let res: trit = await a;
    
    match res {
        affirm => { return affirm; }
        reject => { return reject; }
        tend   => { return tend; }
    }
}
