/*
 * Ternary Consensus Aggregator — Collect ternary votes from multiple agents.
 * Calculates the overall consensus (mean) and certainty.
 * 
 * RFI-IRFOS · PUBLIC repo · v1.0
 */

fn calculate_consensus(votes: trit[10], count: int) -> float {
    let sum: float = 0.0;
    let i: int = 0;
    while i < count {
        match votes[i] {
            1 => { sum = sum + 1.0; }
            -1 => { sum = sum - 1.0; }
            0 => { sum = sum + 0.0; }
        }
        i = i + 1;
    }
    
    // Convert count to float for division
    let f_count: float = 0.0;
    let j: int = 0;
    while j < count { f_count = f_count + 1.0; j = j + 1; }
    
    return sum / f_count;
}

fn main() -> trit {
    let votes: trit[10] = [1, 1, 0, -1, 1, 0, 0, 1, 1, -1];
    let count: int = 10;
    
    // Sum = 1 + 1 + 0 - 1 + 1 + 0 + 0 + 1 + 1 - 1 = 4
    // Wait, let's re-calculate manually:
    // 1+1=2, +0=2, -1=1, +1=2, +0=2, +0=2, +1=3, +1=4, -1=3. YES, SUM IS 3.
    // Mean = 3 / 10 = 0.3
    
    let consensus: float = calculate_consensus(votes, count);
    println("Consensus Score (expected 0.3):");
    println(consensus);
    
    if consensus == 0.3 {
        println("Consensus Aggregator Test: PASSED");
        return 1;
    }
    
    return -1;
}
