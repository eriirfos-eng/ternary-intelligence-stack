// stdlib/agents/watchdog.tern
// Tier: 1
agent UnreliableWorker {
    fn handle(msg: trit) -> trit { return msg; }
}

agent Watchdog {
    fn handle(msg: trit) -> trit {
        let worker: agentref = spawn UnreliableWorker;
        send worker msg;
        let res: trit = await worker;
        
        match res {
            1  => { return 1; }
            0  => { return 0; }
            -1 => { return 0; }
        }
    }
}

fn main() -> trit {
    let d: agentref = spawn Watchdog;
    send d 1;
    let r1: trit = await d;
    send d -1;
    let r2: trit = await d;
    
    if r1 == 1 {
        if r2 == 0 {
            return 1;
        }
    }
    return -1;
}
