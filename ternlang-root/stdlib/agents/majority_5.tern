// stdlib/agents/majority_5.tern
// Demonstrates: Consensus of 5 agents (Majority Vote)
// Tier: 1 — Open Core

agent Voter {
    fn handle(msg: trit) -> trit {
        return msg;
    }
}

agent Majority5 {
    fn handle(msg: trit) -> trit {
        let v1: agentref = spawn Voter;
        let v2: agentref = spawn Voter;
        let v3: agentref = spawn Voter;
        let v4: agentref = spawn Voter;
        let v5: agentref = spawn Voter;
        
        send v1 msg;
        send v2 msg;
        send v3 msg;
        send v4 msg;
        send v5 msg;
        
        let r1: trit = await v1;
        let r2: trit = await v2;
        let r3: trit = await v3;
        let r4: trit = await v4;
        let r5: trit = await v5;
        
        let sum: int = 0;
        sum = sum + r1;
        sum = sum + r2;
        sum = sum + r3;
        sum = sum + r4;
        sum = sum + r5;
        
        if sum > 1 {
            return affirm;
        }
        if sum < -1 {
            return reject;
        }
        
        return tend;
    }
}

fn main() -> trit {
    let m: agentref = spawn Majority5;
    
    send m affirm;
    let res: trit = await m;
    
    match res {
        1  => { return affirm; }
        0  => { return reject; }
        -1 => { return reject; }
    }
}
