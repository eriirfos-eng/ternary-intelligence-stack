/*
 * TritField — Utilities for packing multiple small values into a single integer.
 * This is useful for memory-efficient state representation where each field
 * can be a trit or a small range.
 * 
 * RFI-IRFOS · PUBLIC repo · v1.0
 */

// Pack three trits into a single base-3 integer (0-26)
fn pack_trits(t1: trit, t2: trit, t3: trit) -> int {
    // Map -1 -> 0, 0 -> 1, 1 -> 2 for packing
    let v1: int = 0;
    let v2: int = 0;
    let v3: int = 0;

    match t1 {
        -1 => { v1 = 0; }
         0 => { v1 = 1; }
         1 => { v1 = 2; }
    }
    match t2 {
        -1 => { v2 = 0; }
         0 => { v2 = 1; }
         1 => { v2 = 2; }
    }
    match t3 {
        -1 => { v3 = 0; }
         0 => { v3 = 1; }
         1 => { v3 = 2; }
    }
    
    return v1 + (v2 * 3) + (v3 * 9);
}

// Unpack a trit at a specific position (0, 1, or 2)
fn unpack_trit(packed: int, index: int) -> trit {
    let divisor: int = 1;
    if index == 1 {
        divisor = 3;
    } else if index == 2 {
        divisor = 9;
    }
    
    let val: int = (packed / divisor) % 3;
    
    if val == 0 { 
        return -1; 
    } else if val == 1 { 
        return 0; 
    } else if val == 2 { 
        return 1; 
    }
    
    return 0;
}

fn main() -> trit {
    let p: int = pack_trits(1, -1, 0);
    
    let t1: trit = unpack_trit(p, 0);
    let t2: trit = unpack_trit(p, 1);
    let t3: trit = unpack_trit(p, 2);
    
    println("Packed value:");
    println(p);
    
    let success: trit = 1; // affirm
    
    if t1 != 1 { success = -1; }
    if t2 != -1 { success = -1; }
    if t3 != 0 { success = -1; }
    
    match success {
        1 => { println("TritField Test: PASSED"); }
        _ => { println("TritField Test: FAILED"); }
    }
    
    return success;
}
