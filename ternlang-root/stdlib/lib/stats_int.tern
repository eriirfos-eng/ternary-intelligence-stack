// stdlib/lib/stats_int.tern
// Demonstrates: Basic statistical functions for integer arrays.
// Tier: 1 - Open Core

fn array_sum(data: int[5], size: int) -> int {
    let sum: int = 0;
    let i: int = 0;
    while i < size {
        sum = sum + data[i];
        i = i + 1;
    }
    return sum;
}

fn array_mean(data: int[5], size: int) -> float {
    let s: int = array_sum(data, size);
    return cast(s) / cast(size);
}

fn array_variance(data: int[5], size: int) -> float {
    let m: float = array_mean(data, size);
    let sum_sq_diff: float = 0.0;
    let i: int = 0;
    while i < size {
        let diff: float = cast(data[i]) - m;
        sum_sq_diff = sum_sq_diff + (diff * diff);
        i = i + 1;
    }
    return sum_sq_diff / cast(size);
}

fn main() -> trit {
    let data: int[5];
    data[0] = 10;
    data[1] = 20;
    data[2] = 30;
    data[3] = 40;
    data[4] = 50;
    
    println("Int Stats Showcase (10, 20, 30, 40, 50):");
    
    let s: int = array_sum(data, 5);
    println("Sum (expected 150):");
    println(s);
    if s == 150 { println("Sum OK."); } else { return conflict(); }
    
    let m: float = array_mean(data, 5);
    println("Mean (expected 30.0):");
    println(m);
    if m == 30.0 { println("Mean OK."); } else { return conflict(); }
    
    let v: float = array_variance(data, 5);
    println("Variance (expected 200.0):");
    println(v);
    if v == 200.0 { println("Variance OK. Success."); return truth(); }
    
    return conflict();
}
