/*
 * Trit Histogram — Generate ASCII-based frequency distribution for trits.
 * 
 * RFI-IRFOS · PUBLIC repo · v1.0
 */

fn print_histogram(data: trit[10]) -> trit {
    let reject_count: int = 0;
    let tend_count: int = 0;
    let affirm_count: int = 0;
    
    let i: int = 0;
    while i < 10 {
        match data[i] {
            1 => { affirm_count = affirm_count + 1; }
            0 => { tend_count = tend_count + 1; }
            -1 => { reject_count = reject_count + 1; }
        }
        i = i + 1;
    }
    
    println("Histogram:");
    print("Reject: "); println(reject_count);
    print("Tend:   "); println(tend_count);
    print("Affirm: "); println(affirm_count);
    
    return 1;
}

fn main() -> trit {
    let data: trit[10] = [1, 1, 1, 0, 0, -1, 1, 0, 1, -1];
    // Affirm: 5, Tend: 3, Reject: 2
    
    let d: trit = print_histogram(data);
    
    println("Trit Histogram Test: PASSED");
    return 1;
}
