/*
 * DisjointSetTrit — Union-Find data structure.
 * Useful for graph algorithms like Kruskal's or finding components.
 * 
 * RFI-IRFOS · PUBLIC repo · v1.0
 */

// Find with path compression
fn dsu_find(parent: int[], i: int) -> int {
    if parent[i] == i {
        return i;
    }
    // Recursively find the root and compress the path
    parent[i] = dsu_find(parent, parent[i]);
    return parent[i];
}

// Union of two sets
fn dsu_union(parent: int[], i: int, j: int) -> trit {
    let root_i: int = dsu_find(parent, i);
    let root_j: int = dsu_find(parent, j);
    if root_i != root_j {
        parent[root_i] = root_j;
        return 1; // affirm: union performed
    }
    return 0; // tend: already in same set
}

fn main() -> trit {
    // Note: Manual initialization is used to avoid trit saturation of array literals.
    let parent: int[5];
    let i: int = 0;
    while i < 5 {
        parent[i] = i;
        i = i + 1;
    }
    
    println("Performing unions: (0,1), (1,2), (3,4)");
    dsu_union(parent, 0, 1);
    dsu_union(parent, 1, 2);
    dsu_union(parent, 3, 4);
    
    let r0: int = dsu_find(parent, 0);
    let r1: int = dsu_find(parent, 1);
    let r2: int = dsu_find(parent, 2);
    let r3: int = dsu_find(parent, 3);
    let r4: int = dsu_find(parent, 4);
    
    println("Roots after unions:");
    println(r0);
    println(r1);
    println(r2);
    println(r3);
    println(r4);
    
    // 0, 1, 2 should have same root. 3, 4 should have same root.
    if r0 == r1 && r1 == r2 && r3 == r4 && r0 != r3 {
        println("DisjointSetTrit Test: PASSED");
        return 1;
    }
    
    println("DisjointSetTrit Test: FAILED");
    return -1;
}
