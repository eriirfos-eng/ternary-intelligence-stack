// stdlib/lib/trit_bool_conv.tern
// Demonstrates: Conversion between trits and boolean logic.
// Tier: 1 - Open Core

fn trit_to_bool(t: trit) -> int {
    if t == 1 { return 1; }
    return 0;
}

fn bool_to_trit(b: int) -> trit {
    if b == 1 { return 1; }
    return 0;
}

fn main() -> trit {
    println("Trit-Bool Conversion Showcase:");
    
    println("trit_to_bool(1):");
    let b1: int = trit_to_bool(1);
    println(b1);
    if b1 == 1 { println("OK."); } else { return conflict(); }
    
    println("trit_to_bool(-1):");
    let b2: int = trit_to_bool(-1);
    println(b2);
    if b2 == 0 { println("OK."); } else { return conflict(); }
    
    println("bool_to_trit(1):");
    let t1: trit = bool_to_trit(1);
    println(t1);
    if t1 == 1 {
        println("OK. Success.");
        return truth();
    }
    
    return conflict();
}
