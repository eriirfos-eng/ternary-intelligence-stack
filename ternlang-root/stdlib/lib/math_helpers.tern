// stdlib/lib/math_helpers.tern
// Demonstrates: Basic integer math helper functions.
// Tier: 1

fn is_even(n: int) -> trit {
    if (n % 2) == 0 {
        return 1;
    }
    return -1;
}

fn sign(n: int) -> trit {
    if n > 0 {
        return 1;
    } else {
        if n < 0 {
            return -1;
        }
    }
    return 0;
}

fn main() -> trit {
    let n1: int = 10;
    let n2: int = -5;

    println("is_even(10):");
    println(is_even(n1));

    println("sign(-5):");
    println(sign(n2));
    
    println("Program exited successfully.");
    return 1;
}
