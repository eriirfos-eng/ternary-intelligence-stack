// stdlib/lib/int_to_ternary.tern
// Conversion from standard Decimal Integers to Balanced Ternary sequences.
// Balanced Ternary uses digits (-1, 0, 1) representing powers of 3.

fn int_to_balanced_ternary(n: int, output: trit[]) -> int {
    let temp: int = n;
    let i: int = 0;
    let out_len: int = len(output);

    if n == 0 {
        if out_len > 0 { output[0] = 0; }
        return 1;
    }

    // Work with absolute values and sign separately? 
    // Balanced ternary naturally handles negatives.
    
    while temp != 0 && i < out_len {
        let rem: int = temp % 3;
        temp = temp / 3;
        
        if rem == 2 {
            output[i] = -1;
            temp = temp + 1;
        } else if rem == -2 {
            output[i] = 1;
            temp = temp - 1;
        } else if rem == 1 {
            output[i] = 1;
        } else if rem == -1 {
            output[i] = -1;
        } else {
            output[i] = 0;
        }
        
        i = i + 1;
    }
    
    return i; // Returns number of trits used
}

fn main() -> trit {
    let output: trit[10];
    let k: int = 0;
    while k < 10 { output[k] = 0; k = k + 1; }

    // Test Case: 7 in decimal
    // 7 = 9 - 3 + 1 = 1*3^2 + -1*3^1 + 1*3^0 -> [1, -1, 1]
    let n: int = 7;
    let len_used: int = int_to_balanced_ternary(n, output);
    
    print("Decimal 7 in Balanced Ternary (LSB first): ");
    let j: int = 0;
    while j < len_used {
        print(output[j]);
        j = j + 1;
    }
    println("");

    if output[0] == 1 && output[1] == -1 && output[2] == 1 {
        println("✓ Conversion (7) passed.");
    } else {
        return -1;
    }

    // Test Case: -5 in decimal
    // -5 = -9 + 3 + 1 = -1*3^2 + 1*3^1 + 1*3^0 -> [1, 1, -1]
    let n2: int = -5;
    let len_used2: int = int_to_balanced_ternary(n2, output);
    
    print("Decimal -5 in Balanced Ternary (LSB first): ");
    let j2: int = 0;
    while j2 < len_used2 {
        print(output[j2]);
        j2 = j2 + 1;
    }
    println("");

    if output[0] == 1 && output[1] == 1 && output[2] == -1 {
        println("✓ Conversion (-5) passed.");
        return 1;
    }
    
    return -1;
}
