// stdlib/lib/stack.tern
// Demonstrates: A LIFO stack implementation using a fixed-size trittensor.
// Tier: 1 - Open Core

fn stack_push(buffer: trittensor<5>, curr_ptr: int, val: trit) -> int {
    if curr_ptr >= 5 {
        return -1; // Overflow
    }
    buffer[curr_ptr] = val;
    return curr_ptr + 1;
}

fn stack_pop_index(curr_ptr: int) -> int {
    if curr_ptr <= 0 {
        return -1; // Underflow
    }
    return curr_ptr - 1;
}

fn main() -> trit {
    let buffer: trittensor<5> = [0, 0, 0, 0, 0];
    let stack_ptr: int = 0;

    // Push sequence
    stack_ptr = stack_push(buffer, stack_ptr, 1);
    stack_ptr = stack_push(buffer, stack_ptr, -1);
    
    // Pop check
    if stack_ptr == 2 {
        stack_ptr = stack_pop_index(stack_ptr);
        let val: trit = buffer[stack_ptr];
        if val == -1 {
            return truth();
        }
    }
    
    return conflict();
}
