// stdlib/lib/lru_cache.tern
// Demonstrates: A simple Least Recently Used (LRU) cache logic using indexed arrays.
// Tier: 1 - Open Core

fn lru_access(order: int[5], size: int, accessed_idx: int) -> trit {
    // Find accessed_idx in order and move it to the front (index 0)
    let found_pos: int = -1;
    let k: int = 0;
    while k < size {
        if order[k] == accessed_idx {
            found_pos = k;
        }
        k = k + 1;
    }
    
    if found_pos == -1 { return -1; }
    
    // Shift elements before found_pos to the right
    let j: int = found_pos;
    while j > 0 {
        order[j] = order[j - 1];
        j = j - 1;
    }
    order[0] = accessed_idx;
    return 1;
}

fn main() -> trit {
    let order: int[5];
    order[0] = 0;
    order[1] = 1;
    order[2] = 2;
    order[3] = 3;
    order[4] = 4;
    
    let size: int = 5;
    
    println("Initial LRU order (front to back):");
    println("0, 1, 2, 3, 4");
    
    println("Accessing item 3...");
    let r1: trit = lru_access(order, size, 3);
    
    println("New order (should be 3, 0, 1, 2, 4):");
    println(order[0]);
    println(order[1]);
    println(order[2]);
    println(order[3]);
    println(order[4]);
    
    if order[0] == 3 {
        if order[1] == 0 {
            if order[2] == 1 {
                if order[3] == 2 {
                    if order[4] == 4 {
                        println("LRU access logic verified. Success.");
                        return truth();
                    }
                }
            }
        }
    }
    
    println("LRU verification failed.");
    return conflict();
}
