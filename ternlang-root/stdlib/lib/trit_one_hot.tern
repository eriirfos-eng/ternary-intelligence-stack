/*
 * Ternary One-Hot Encoding — Convert a trit to a 3-element one-hot float vector.
 * 
 * RFI-IRFOS · PUBLIC repo · v1.0
 */

fn one_hot_trit(t: trit, res: float[3]) -> trit {
    res[0] = 0.0; res[1] = 0.0; res[2] = 0.0;
    
    match t {
        -1 => { res[0] = 1.0; }
         0 => { res[1] = 1.0; }
         1 => { res[2] = 1.0; }
    }
    return 1;
}

fn main() -> trit {
    let res: float[3];
    
    println("One-hot for Reject (-1):");
    let d: trit = one_hot_trit(-1, res);
    println(res[0]); // 1.0
    println(res[1]); // 0.0
    println(res[2]); // 0.0
    
    if res[0] == 1.0 && res[1] == 0.0 && res[2] == 0.0 {
        println("Trit One-Hot Test: PASSED");
        return 1;
    }
    
    return -1;
}
