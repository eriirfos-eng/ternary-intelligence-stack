// Ternary Logic Gates
// Standard logic gates adapted for ternary {-1, 0, 1} space.
// RFI-IRFOS · PUBLIC repo · v1.0

// Standard Inverter (NOT)
// 1 -> -1, 0 -> 0, -1 -> 1
fn trit_not(a: trit) -> trit {
    return invert(a); // uses built-in inlined opcode
}

// Consensus (AND-like / Stable Agreement)
// 1, 1 -> 1; -1, -1 -> -1; else 0
fn trit_consensus(a: trit, b: trit) -> trit {
    return consensus(a, b); // uses built-in
}

// Any (OR-like / Decision Expansion)
// If any is 1 -> 1; else if any is 0 -> 0; else -1
fn trit_any(a: trit, b: trit) -> trit {
    if a == 1 || b == 1 { return 1; }
    if a == 0 || b == 0 { return 0; }
    return -1;
}

// All (Strict Decision / Guard)
// Only if all are 1 -> 1; if any is -1 -> -1; else 0
fn trit_all(a: trit, b: trit) -> trit {
    if a == 1 && b == 1 { return 1; }
    if a == -1 || b == -1 { return -1; }
    return 0;
}

// Ternary XOR (Difference Detection)
// If same -> 0; if different -> the one that isn't 0; if opposites -> 0
fn trit_xor(a: trit, b: trit) -> trit {
    if a == b { return 0; }
    if a == 0 { return b; }
    if b == 0 { return a; }
    return 0; // 1 and -1 are opposites, so 0 (conflict/balance)
}

fn main() -> trit {
    print("Trit Logic Gates Test\n");
    print("---------------------\n");
    
    // Test NOT
    if trit_not(1) == -1 && trit_not(0) == 0 && trit_not(-1) == 1 {
        print("NOT: PASSED\n");
    } else {
        print("NOT: FAILED\n");
        return -1;
    }
    
    // Test ANY
    if trit_any(1, -1) == 1 && trit_any(0, -1) == 0 && trit_any(-1, -1) == -1 {
        print("ANY: PASSED\n");
    } else {
        print("ANY: FAILED\n");
        return -1;
    }
    
    // Test ALL
    if trit_all(1, 1) == 1 && trit_all(1, 0) == 0 && trit_all(1, -1) == -1 {
        print("ALL: PASSED\n");
    } else {
        print("ALL: FAILED\n");
        return -1;
    }
    
    // Test XOR
    if trit_xor(1, 1) == 0 && trit_xor(1, 0) == 1 && trit_xor(1, -1) == 0 {
        print("XOR: PASSED\n");
    } else {
        print("XOR: FAILED\n");
        return -1;
    }
    
    print("Summary: All ternary logic gates verified.\n");
    return 1;
}
