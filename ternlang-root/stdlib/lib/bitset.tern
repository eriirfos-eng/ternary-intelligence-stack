// stdlib/lib/bitset.tern
// Bitset implementation using integer array.
// RFI-IRFOS · PUBLIC repo · v1.0

fn set(bs: int[], idx: int) -> trit {
    let word: int = idx / 32;
    let bit: int = idx % 32;
    // Emulating bitwise OR using pow(2, bit)
    let mask: int = pow(2, bit);
    bs[word] = bs[word] + mask; 
    return affirm;
}

fn get(bs: int[], idx: int) -> trit {
    let word: int = idx / 32;
    let bit: int = idx % 32;
    // Emulating bitwise AND check
    let mask: int = pow(2, bit);
    if (bs[word] / mask) % 2 == 1 {
        return affirm;
    }
    return reject;
}

fn main() -> trit {
    let bs: int[4] = 0;
    
    println("Testing Bitset...");
    set(bs, 5);
    
    let res: trit = get(bs, 5);
    if res == affirm {
        println("Bitset test: PASSED");
        return affirm;
    }
    
    println("Bitset test: FAILED");
    return reject;
}
