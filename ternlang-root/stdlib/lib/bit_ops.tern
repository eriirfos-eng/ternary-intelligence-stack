// stdlib/lib/bit_ops.tern
// Demonstrates: Bit-wise logic simulation using balanced ternary.
// Tier: 1 - Open Core

fn bit_and(a: trit, b: trit) -> trit {
    if a == 1 {
        if b == 1 { return 1; }
    }
    return 0;
}

fn bit_or(a: trit, b: trit) -> trit {
    if a == 1 { return 1; }
    if b == 1 { return 1; }
    return 0;
}

fn bit_xor(a: trit, b: trit) -> trit {
    if a != b { return 1; }
    return 0;
}

fn main() -> trit {
    println("Bit-wise Simulation (0, 1 mapping):");
    
    println("AND(1, 0):");
    let r1: trit = bit_and(1, 0);
    println(r1); 
    
    println("OR(1, 0):");
    let r2: trit = bit_or(1, 0);
    println(r2);
    
    println("XOR(1, 1):");
    let r3: trit = bit_xor(1, 1);
    println(r3);
    
    println("XOR(1, 0):");
    let r4: trit = bit_xor(1, 0);
    println(r4);

    if r4 == 1 {
        if bit_and(1, 1) == 1 {
            println("Bit ops verified. Success.");
            return truth();
        }
    }
    
    println("Verification failed.");
    return conflict();
}
