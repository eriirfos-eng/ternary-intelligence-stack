/*
 * FrequencyMapTrit — Utilities to count frequencies of trit values.
 * 
 * RFI-IRFOS · PUBLIC repo · v1.0
 */

// Pass-by-reference simulation for counts array.
// Indices: 0 -> Reject (-1), 1 -> Tend (0), 2 -> Affirm (+1)
fn count_frequencies(data: trit[], counts: int[]) -> trit {
    counts[0] = 0;
    counts[1] = 0;
    counts[2] = 0;
    
    for t in data {
        match t {
            -1 => { counts[0] = counts[0] + 1; }
             0 => { counts[1] = counts[1] + 1; }
             1 => { counts[2] = counts[2] + 1; }
        }
    }
    return 1;
}

fn main() -> trit {
    let data: trittensor<10> = [1, 1, 0, -1, 1, 0, 0, -1, 1, 1];
    let results: int[3];
    // Manual init to avoid literal saturation
    results[0] = 0; results[1] = 0; results[2] = 0;
    
    println("Counting frequencies in: [1, 1, 0, -1, 1, 0, 0, -1, 1, 1]");
    count_frequencies(data, results);
    
    println("Results:");
    println("Reject (-1):"); println(results[0]);
    println("Tend   (0):");  println(results[1]);
    println("Affirm (+1):"); println(results[2]);
    
    if results[2] == 5 && results[1] == 3 && results[0] == 2 {
        println("FrequencyMapTrit Test: PASSED");
        return 1;
    }
    
    println("FrequencyMapTrit Test: FAILED");
    return -1;
}
