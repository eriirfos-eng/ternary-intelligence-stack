/*
 * Trit Packing Utilities — Pack and unpack 5 trits into a single 0-242 integer.
 * This corresponds to the ExaTern 5-trit-per-byte packing rule.
 * 
 * RFI-IRFOS · PUBLIC repo · v1.0
 */

// Pack 5 trits into an int (0-242)
fn pack_5_trits(t1: trit, t2: trit, t3: trit, t4: trit, t5: trit) -> int {
    let v1: int = 0; let v2: int = 0; let v3: int = 0; let v4: int = 0; let v5: int = 0;
    
    match t1 { -1 => { v1 = 0; } 0 => { v1 = 1; } 1 => { v1 = 2; } }
    match t2 { -1 => { v2 = 0; } 0 => { v2 = 1; } 1 => { v2 = 2; } }
    match t3 { -1 => { v3 = 0; } 0 => { v3 = 1; } 1 => { v3 = 2; } }
    match t4 { -1 => { v4 = 0; } 0 => { v4 = 1; } 1 => { v4 = 2; } }
    match t5 { -1 => { v5 = 0; } 0 => { v5 = 1; } 1 => { v5 = 2; } }
    
    return v1 * 81 + v2 * 27 + v3 * 9 + v4 * 3 + v5;
}

// Unpack a specific trit (0-4) from a packed byte (0-242)
fn unpack_trit(p_val: int, index: int) -> trit {
    let val: int = 0;
    
    if index == 0 { val = p_val / 81; }
    else if index == 1 { val = (p_val / 27) % 3; }
    else if index == 2 { val = (p_val / 9) % 3; }
    else if index == 3 { val = (p_val / 3) % 3; }
    else if index == 4 { val = p_val % 3; }
    
    if val == 0 { return -1; }
    if val == 1 { return 0; }
    if val == 2 { return 1; }
    return 0;
}

fn main() -> trit {
    let t1: trit = 1;
    let t2: trit = -1;
    let t3: trit = 0;
    let t4: trit = 1;
    let t5: trit = -1;
    
    // (1, -1, 0, 1, -1) -> (2, 0, 1, 2, 0)
    // 2*81 + 0*27 + 1*9 + 2*3 + 0 = 162 + 0 + 9 + 6 + 0 = 177
    
    let p_val: int = pack_5_trits(t1, t2, t3, t4, t5);
    println("Packed Value (expected 177):");
    println(p_val);
    
    let d1: trit = unpack_trit(p_val, 0);
    let d2: trit = unpack_trit(p_val, 1);
    let d3: trit = unpack_trit(p_val, 2);
    let d4: trit = unpack_trit(p_val, 3);
    let d5: trit = unpack_trit(p_val, 4);
    
    if p_val == 177 && d1 == 1 && d2 == -1 && d3 == 0 && d4 == 1 && d5 == -1 {
        println("Trit Packing Test: PASSED");
        return 1;
    }
    
    println("Trit Packing Test: FAILED");
    return -1;
}
