// stdlib/lib/type_conversion_helpers.tern
// Demonstrates: Helper functions for explicit type conversions.
// Tier: 1

fn int_to_trit(n: int) -> trit {
    // Clamps integer to trit range
    if n > 0 {
        return 1;
    } else {
        if n < 0 {
            return -1;
        }
    }
    return 0;
}

fn float_to_trit(f: float) -> trit {
    if f > 0.1 {
        return 1;
    } else {
        if f < -0.1 {
            return -1;
        }
    }
    return 0;
}

fn main() -> trit {
    let i: int = -10;
    let f: float = 0.5;

    println("int_to_trit(-10):");
    println(int_to_trit(i));

    println("float_to_trit(0.5):");
    println(float_to_trit(f));
    
    println("Program exited successfully.");
    return 1;
}
