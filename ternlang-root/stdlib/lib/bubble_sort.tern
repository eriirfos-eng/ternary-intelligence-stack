// Industrial-grade bubble sort implementation for TIS
// Provides a stable sorting mechanism for small-to-medium integer arrays.

fn bubble_sort(arr: int[], len: int) -> int {
    let i: int = 0;
    let j: int = 0;
    while (i < len - 1) {
        j = 0;
        while (j < len - i - 1) {
            if (arr[j] > arr[j + 1]) {
                let temp: int = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return affirm;
}

fn main() -> trit {
    let arr: int[5] = 0;
    arr[0] = 50; arr[1] = 10; arr[2] = 40; arr[3] = 20; arr[4] = 30;
    
    bubble_sort(arr, 5);
    
    if (arr[0] == 10 && arr[1] == 20 && arr[2] == 30 && arr[3] == 40 && arr[4] == 50) {
        return affirm;
    }
    return reject;
}
