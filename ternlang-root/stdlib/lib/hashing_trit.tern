/*
 * HashingTrit — Basic hash functions adapted for trits.
 * 
 * RFI-IRFOS · PUBLIC repo · v1.0
 */

// Simple trit-based hashing (similar to DJB2)
// Map -1 -> 1, 0 -> 2, 1 -> 3 to avoid zero-multiplication issues
fn hash_trits(data: trit[]) -> int {
    let h: int = 5381;
    for t in data {
        let val: int = 0;
        match t {
            -1 => { val = 1; }
             0 => { val = 2; }
             1 => { val = 3; }
        }
        // Using a prime-based hash mixing
        h = ((h * 33) + val) % 1000003;
    }
    return h;
}

fn main() -> trit {
    let t1: trittensor<3> = [1, 0, -1];
    let t2: trittensor<3> = [1, 0, -1];
    let t3: trittensor<3> = [-1, 0, 1];
    
    let h1: int = hash_trits(t1);
    let h2: int = hash_trits(t2);
    let h3: int = hash_trits(t3);
    
    println("Hashes:");
    println(h1);
    println(h2);
    println(h3);
    
    if h1 == h2 && h1 != h3 {
        println("HashingTrit Test: PASSED");
        return 1;
    }
    
    println("HashingTrit Test: FAILED");
    return -1;
}
