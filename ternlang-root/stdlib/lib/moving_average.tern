// moving_average.tern
// Calculate simple moving average over a window of 3

fn main() -> trit {
    let data: int[4] = 0;
    data[0] = 10;
    data[1] = 20;
    data[2] = 30;
    data[3] = 40;
    let window_size: int = 3;
    let sum: int = 0;
    
    // sum first window (indices 0, 1, 2)
    sum = data[0] + data[1] + data[2];
    
    // avg = sum / 3 = 60 / 3 = 20
    if (sum / 3 == 20) {
        return affirm;
    }
    return reject;
}
