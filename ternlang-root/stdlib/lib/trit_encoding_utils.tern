/*
 * TritEncodingUtils — Encode pairs of trits into a single 9-state integer.
 * Range: 0 to 8.
 * 
 * RFI-IRFOS · PUBLIC repo · v1.0
 */

// Encode 2 trits to 0-8
fn encode_pair(t1: trit, t2: trit) -> int {
    let v1: int = 0;
    let v2: int = 0;
    
    match t1 {
        -1 => { v1 = 0; }
         0 => { v1 = 1; }
         1 => { v1 = 2; }
    }
    match t2 {
        -1 => { v2 = 0; }
         0 => { v2 = 1; }
         1 => { v2 = 2; }
    }
    
    return v1 * 3 + v2;
}

// Decode 0-8 to the first trit
fn decode_first(val: int) -> trit {
    let v: int = val / 3;
    if v == 0 { return -1; }
    if v == 1 { return 0; }
    if v == 2 { return 1; }
    return 0;
}

// Decode 0-8 to the second trit
fn decode_second(val: int) -> trit {
    let v: int = val % 3;
    if v == 0 { return -1; }
    if v == 1 { return 0; }
    if v == 2 { return 1; }
    return 0;
}

fn main() -> trit {
    let t1: trit = 1;
    let t2: trit = -1;
    
    let encoded: int = encode_pair(t1, t2);
    println("Encoded (1, -1):");
    println(encoded); // 2*3 + 0 = 6
    
    let d1: trit = decode_first(encoded);
    let d2: trit = decode_second(encoded);
    
    println("Decoded:");
    println(cast(d1));
    println(cast(d2));
    
    if encoded == 6 && d1 == 1 && d2 == -1 {
        println("TritEncodingUtils Test: PASSED");
        return 1;
    }
    
    println("TritEncodingUtils Test: FAILED");
    return -1;
}
