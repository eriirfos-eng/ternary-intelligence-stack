// stdlib/lib/comparison_utils.tern
// Demonstrates: Comparison utilities for numeric types.
// Tier: 1

fn is_positive(n: int) -> trit {
    if n > 0 { return 1; }
    return 0;
}

fn are_equal(a: int, b: int) -> trit {
    if a == b { return 1; }
    return -1;
}

fn main() -> trit {
    println("is_positive(10):");
    println(is_positive(10));

    println("are_equal(5, 5):");
    println(are_equal(5, 5));
    
    println("Program exited successfully.");
    return 1;
}
