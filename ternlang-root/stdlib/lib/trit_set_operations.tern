/*
 * Trit Set Operations (Mock/Simple) — Intersection and Union of trit arrays.
 * 
 * RFI-IRFOS · PUBLIC repo · v1.0
 */

fn trit_union(a: trit[5], b: trit[5], res: trit[5]) -> trit {
    let i: int = 0;
    while i < 5 {
        // Union: Affirm if either is Affirm, Reject if both are Reject
        if a[i] == 1 || b[i] == 1 { res[i] = 1; }
        else if a[i] == -1 && b[i] == -1 { res[i] = -1; }
        else { res[i] = 0; }
        i = i + 1;
    }
    return 1;
}

fn main() -> trit {
    let a: trit[5] = [1, 0, -1, 0, 1];
    let b: trit[5] = [0, 1, -1, 0, 0];
    let res: trit[5];
    
    let d: trit = trit_union(a, b, res);
    println("Union result (expected [1, 1, -1, 0, 1]):");
    println(cast(res[0]));
    println(cast(res[1]));
    println(cast(res[2]));
    println(cast(res[3]));
    println(cast(res[4]));
    
    if res[0] == 1 && res[1] == 1 && res[2] == -1 && res[3] == 0 && res[4] == 1 {
        println("Trit Set Operations Test: PASSED");
        return 1;
    }
    
    return -1;
}
