// stdlib/astro/solar_panel_deploy.tern
// Demonstrates: consensus on deployment readiness
// Tier: 3 — Industrial

fn can_deploy(battery: float, light: float, orient: trit) -> trit {
    if battery < 0.2 { return conflict(); } // Critically low
    if light < 0.5 { return hold(); }       // Not enough light
    if orient != 1 { return hold(); }       // Misaligned
    return truth();
}

fn main() -> trit {
    let bat: float = 0.8;
    let lux: float = 0.9;
    let ok: trit = 1;
    
    let result: trit = can_deploy(bat, lux, ok);
    match result {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
