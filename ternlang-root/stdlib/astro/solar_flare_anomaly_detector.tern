// proprietary/astro/solar_flare_anomaly_detector.tern
// Demonstrates: Detecting sudden spikes in solar activity using a ternary detector.
// Tier: 3

fn evaluate_flare_risk(current: float, rolling_avg: float, threshold: float) -> trit {
    let increase: float = current - rolling_avg;

    if increase > threshold {
        return reject; // Potential solar flare anomaly
    }
    
    // Stable if within threshold
    if increase < (threshold * 0.1) {
        return affirm;
    }
    
    return tend;
}

fn main() -> trit {
    let cur: float = 1450.0;
    let avg: float = 1361.0; // Solar constant approx
    let t: float = 50.0;

    // increase = 89.0. 89.0 > 50.0 -> reject
    let flare_risk: trit = evaluate_flare_risk(cur, avg, t);

    match flare_risk {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
