// stdlib/astro/attitude_control_gate.tern
// Demonstrates: Evaluating gyroscopic stability for spacecraft orientation
// Tier: 1 — Open Core

fn check_stability(error_deg: float, drift_rate: float) -> trit {
    if error_deg > 5.0 {
        return conflict(); // Way off course
    }
    
    if drift_rate > 0.1 {
        return hold(); // Corrective thrust needed
    }
    
    return truth(); // Oriented correctly
}

fn main() -> trit {
    let error: float = 0.5;
    let drift: float = 0.05;
    
    let result: trit = check_stability(error, drift);
    
    match result {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
