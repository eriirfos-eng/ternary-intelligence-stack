// proprietary/astro/life_support_redundancy_consensus.tern
// Demonstrates: Reaching consensus across redundant life support systems.
// Tier: 3

fn evaluate_subsystem(o2_level: float, pressure: float) -> trit {
    if o2_level < 0.18 { return reject; } // Hypoxia risk
    if pressure < 70.0 { return reject; } // Decompression risk
    
    if o2_level > 0.20 {
        if pressure > 95.0 {
            return affirm;
        }
    }
    
    return tend;
}

fn main() -> trit {
    // 3 redundant systems
    let s1: trit = evaluate_subsystem(0.21, 101.3); // Normal
    let s2: trit = evaluate_subsystem(0.19, 98.0);  // Borderline
    let s3: trit = evaluate_subsystem(0.17, 95.0);  // Failing

    // consensus(affirm, tend) -> affirm
    // consensus(affirm, reject) -> tend
    let interim: trit = consensus(s1, s2);
    let final_consensus: trit = consensus(interim, s3);

    match final_consensus {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
