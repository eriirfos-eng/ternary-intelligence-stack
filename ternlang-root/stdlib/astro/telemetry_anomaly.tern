// stdlib/astro/telemetry_anomaly.tern
// Demonstrates: detecting anomalies in spacecraft telemetry streams
// Tier: 3 — Industrial

fn analyze_sensor(val: float, expected: float, tol: float) -> trit {
    let diff: float = val - expected;
    if diff > tol { return conflict(); }
    if diff < -tol { return conflict(); }
    if diff > (tol * 0.7) { return hold(); }
    if diff < -(tol * 0.7) { return hold(); }
    return truth();
}

fn main() -> trit {
    let temp: float = 45.2;
    let target: float = 40.0;
    let tolerance: float = 5.0;
    
    let status: trit = analyze_sensor(temp, target, tolerance);
    match status {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
