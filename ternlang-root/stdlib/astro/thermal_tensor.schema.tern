// Module:  stdlib/astro/thermal_tensor.schema.tern
// Purpose: T-SON serialization schema for thermal_tensor
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Thermal_tensorSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Thermal_tensorSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
