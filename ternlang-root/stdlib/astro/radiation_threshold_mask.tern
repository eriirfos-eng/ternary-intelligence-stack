// proprietary/astro/radiation_threshold_mask.tern
// Demonstrates: A mask for protecting sensitive instruments during high-radiation events.
// Tier: 3

fn evaluate_radiation_risk(flux: float, shielding: float, critical_limit: float) -> trit {
    let effective_flux: float = flux / shielding;

    if effective_flux > critical_limit {
        return reject; // High risk, shutdown instruments
    }
    
    // We can operate if risk is < 10% of limit
    if effective_flux < (critical_limit * 0.1) {
        return affirm;
    }
    
    return tend; // Cautionary mode
}

fn main() -> trit {
    let current_flux: float = 120.5;
    let s: float = 5.0; // 5mm Al equivalent
    let limit: float = 20.0;

    // effective_flux = 24.1. 24.1 > 20.0 -> reject
    let risk: trit = evaluate_radiation_risk(current_flux, s, limit);

    match risk {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
