// stdlib/astro/docking_approach_gate.tern
// Demonstrates: Managing relative distance and velocity during docking
// Tier: 1 — Open Core

fn evaluate_approach(dist: float, vel: float) -> trit {
    if dist < 1.0 {
        if vel > 0.1 {
            return conflict(); // Dangerously fast approach at close range
        }
        return truth(); // Ready for final capture
    }
    
    if vel > 2.0 {
        return hold(); // Braking maneuvers required
    }
    
    return truth(); // Safe approach profile
}

fn main() -> trit {
    let distance: float = 0.5;
    let relative_v: float = 0.05;
    
    let state: trit = evaluate_approach(distance, relative_v);
    
    match state {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
