// Module:  stdlib/astro/fluidic_system.schema.tern
// Purpose: T-SON serialization schema for fluidic_system
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Fluidic_systemSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Fluidic_systemSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
