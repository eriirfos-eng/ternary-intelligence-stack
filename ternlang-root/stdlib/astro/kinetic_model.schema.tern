// Module:  stdlib/astro/kinetic_model.schema.tern
// Purpose: T-SON serialization schema for kinetic_model
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Kinetic_modelSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Kinetic_modelSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
