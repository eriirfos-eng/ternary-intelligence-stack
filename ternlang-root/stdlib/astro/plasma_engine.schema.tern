// Module:  stdlib/astro/plasma_engine.schema.tern
// Purpose: T-SON serialization schema for plasma_engine
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Plasma_engineSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Plasma_engineSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
