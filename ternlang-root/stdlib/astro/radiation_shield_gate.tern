// stdlib/astro/radiation_shield_gate.tern
// Demonstrates: Checking radiation levels to decide on shield deployment
// Tier: 3 — Industrial

fn check_radiation(dose: float, threshold: float) -> trit {
    if dose > threshold {
        return conflict(); // Radiation too high, shield must be active (reject normal operation)
    }
    if dose < (threshold * 0.1) {
        return truth();    // Radiation very low, safe
    }
    return hold();        // Moderate radiation or sensor uncertainty
}

fn main() -> trit {
    let dose: float = 12.5;
    let threshold: float = 100.0;
    
    let ok: trit = check_radiation(dose, threshold);
    
    match ok {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
