// stdlib/astro/debris_collision_gate.tern
// Demonstrates: collision avoidance logic for orbital debris
// Tier: 3 — Industrial

fn collision_risk(dist: float, relative_vel: float) -> trit {
    if dist < 1.0 { return conflict(); } // Critical
    if dist < 5.0 {
        if relative_vel > 10.0 { return conflict(); }
        return hold();
    }
    return truth();
}

fn main() -> trit {
    let d: float = 3.5;
    let v: float = 12.0;
    
    let risk: trit = collision_risk(d, v);
    match risk {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
