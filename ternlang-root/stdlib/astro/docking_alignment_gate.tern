// proprietary/astro/docking_alignment_gate.tern
// Demonstrates: A gate for validating craft alignment before docking operations.
// Tier: 3

fn evaluate_alignment(offset_x: float, offset_y: float, max_allowable: float) -> trit {
    let dist_sq: float = offset_x * offset_x + offset_y * offset_y;
    let limit_sq: float = max_allowable * max_allowable;

    if dist_sq > limit_sq {
        return reject; // Miss-aligned
    }
    
    // Within 5% of limit is safe
    if dist_sq < (limit_sq * 0.05) {
        return affirm;
    }
    
    return tend; // Converging, wait
}

fn main() -> trit {
    let x: float = 0.01; // 1cm
    let y: float = 0.02; // 2cm
    let lim: float = 0.1; // 10cm tolerance

    let result: trit = evaluate_alignment(x, y, lim);

    match result {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
