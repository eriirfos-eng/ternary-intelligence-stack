// Module:  stdlib/astro/fluidic_optimizer.schema.tern
// Purpose: T-SON serialization schema for fluidic_optimizer
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Fluidic_optimizerSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Fluidic_optimizerSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
