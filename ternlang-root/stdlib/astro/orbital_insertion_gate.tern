// stdlib/astro/orbital_insertion_gate.tern
// Demonstrates: Evaluating if current velocity is within the orbital insertion window
// Tier: 1 — Open Core

fn evaluate_orbit(velocity: float, target_min: float, target_max: float) -> trit {
    if velocity > target_max {
        return conflict(); // Velocity too high, escape trajectory risk
    }
    
    if velocity < target_min {
        return hold(); // Velocity too low, falling back to atmosphere
    }
    
    return truth(); // Stable orbit achieved
}

fn main() -> trit {
    let current_v: float = 7.8; // km/s
    let min_v: float = 7.5;
    let max_v: float = 8.2;
    
    let result: trit = evaluate_orbit(current_v, min_v, max_v);
    
    match result {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
