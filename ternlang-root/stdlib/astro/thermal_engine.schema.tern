// Module:  stdlib/astro/thermal_engine.schema.tern
// Purpose: T-SON serialization schema for thermal_engine
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Thermal_engineSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Thermal_engineSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
