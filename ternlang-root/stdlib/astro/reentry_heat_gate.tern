// stdlib/astro/reentry_heat_gate.tern
// Demonstrates: Atmospheric re-entry thermal protection decision.
// Tier: 2 — Pro Standard
// hold = temperature marginal — reduce deceleration rate before committing.
// conflict = abort re-entry profile, raise periapsis.

fn tile_integrity(damage_pct: float) -> trit {
    if damage_pct < 5.0  { return truth();    }
    if damage_pct > 15.0 { return conflict(); }
    return hold();
}

fn heat_flux_gate(flux_kw: float) -> trit {
    if flux_kw < 200.0 { return truth();    }
    if flux_kw > 500.0 { return conflict(); }
    return hold();
}

fn angle_of_attack_gate(aoa_deg: float) -> trit {
    if aoa_deg > 10.0 && aoa_deg < 20.0 { return truth();    }
    if aoa_deg < 5.0                     { return conflict(); }
    return hold();
}

fn main() -> trit {
    let tiles: trit = tile_integrity(3.2);
    let flux: trit  = heat_flux_gate(180.0);
    let aoa: trit   = angle_of_attack_gate(16.0);

    let tf: trit    = consensus(tiles, flux);
    let verdict: trit = consensus(tf, aoa);

    match verdict {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
