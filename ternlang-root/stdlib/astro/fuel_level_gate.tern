// stdlib/astro/fuel_level_gate.tern
// Demonstrates: Fuel remaining monitoring for mission abort logic
// Tier: 3 — Industrial

fn check_fuel(remaining: float, abort_limit: float, caution_limit: float) -> trit {
    if remaining < abort_limit {
        return conflict(); // Must abort immediately
    }
    if remaining < caution_limit {
        return hold();     // Caution — proceed with deliberation
    }
    return truth();        // Sufficient fuel
}

fn main() -> trit {
    let fuel: float = 45.0;
    let abort: float = 20.0;
    let caution: float = 50.0;
    
    let ok: trit = check_fuel(fuel, abort, caution);
    
    match ok {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
