// stdlib/astro/launch_window_gate.tern
// Demonstrates: checking environmental conditions for a rocket launch
// Tier: 3 — Industrial

fn launch_check(wind_speed: float, humidity: float, visibility: float) -> trit {
    if wind_speed > 30.0 { return conflict(); } // Reject
    if humidity > 0.9 { return hold(); }       // Hold / Warning
    if visibility < 5.0 { return conflict(); }  // Reject
    return truth(); // Affirm
}

fn main() -> trit {
    let w: float = 12.5;
    let h: float = 0.45;
    let v: float = 10.0;
    
    let result: trit = launch_check(w, h, v);
    match result {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
