// Module:  stdlib/domains/acoustic_router.schema.tern
// Purpose: T-SON serialization schema for acoustic_router
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Acoustic_routerSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Acoustic_routerSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
