// Module:  stdlib/optimization/plasma_filter.schema.tern
// Purpose: T-SON serialization schema for plasma_filter
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Plasma_filterSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Plasma_filterSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
