// Module:  stdlib/optimization/fluidic_engine.schema.tern
// Purpose: T-SON serialization schema for fluidic_engine
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Fluidic_engineSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Fluidic_engineSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
