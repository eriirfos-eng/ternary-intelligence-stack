// Module:  stdlib/optimization/stellar_router.schema.tern
// Purpose: T-SON serialization schema for stellar_router
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Stellar_routerSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Stellar_routerSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
