// stdlib/errors/FN-002.tern
// Error: FN-002 — Return Type Mismatch
// Tier: 1 — Open Core
//
// "You promised to return a trit but handed back something else.
//  Ternary contracts are strict. The function signature is a promise."
//
// ─── What went wrong ─────────────────────────────────────────────────────────
//
// The function's '-> TYPE' declaration and the actual type of a 'return'
// expression do not agree. The compiler enforces these contracts statically.
//
// WRONG (will trigger FN-002):
//
//   fn gate(v: trit) -> trit {
//       return 42;          // 42 is int — you promised trit
//   }
//
//   fn count(v: trit) -> int {
//       return truth();     // truth() returns trit — you promised int
//   }
//
//   fn mixed(v: trit) -> trit {
//       match v {
//           -1 => { return conflict(); }   // trit ✓
//            0 => { return 0; }            // 0 as int — ambiguous, avoid this
//            1 => { return truth();   }    // trit ✓
//       }
//   }
//
// ─── The rule ─────────────────────────────────────────────────────────────────
//
// Every 'return' in a function body must return the type declared after '->'.
// ALL return paths. Including every match arm.
//
// Note on '0': the literal 0 is valid as a trit but may be interpreted as int
// in some contexts. Use hold() explicitly to make the intent unambiguous.
//
// ─── Correct pattern ─────────────────────────────────────────────────────────

fn gate(v: trit) -> trit {
    match v {
        -1 => { return conflict(); }   // trit ✓
         0 => { return hold();    }   // trit ✓ — explicit, not '0'
         1 => { return truth();   }   // trit ✓
    }
}

fn score_to_int(v: trit) -> int {
    match v {
        -1 => { return 0;  }   // int ✓
         0 => { return 1;  }   // int ✓
         1 => { return 2;  }   // int ✓
    }
}

let trit_result: trit = gate(1);
let int_result:  int  = score_to_int(trit_result);

match trit_result {
    -1 => { return conflict(); }
     0 => { return hold();    }
     1 => { return truth();   }
}
