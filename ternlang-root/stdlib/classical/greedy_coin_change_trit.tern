/*
 * Greedy Coin Change using Balanced Ternary logic.
 * Coins can be added (1), skipped (0), or subtracted (-1).
 * Let's say we have powers of 3: 1, 3, 9, 27
 * Target is 20.
 * Wait, any integer can be represented in balanced ternary.
 * This function decomposes a number into balanced ternary coefficients.
 * 
 * RFI-IRFOS · PUBLIC repo · v1.0
 */

fn int_to_balanced_ternary(val: int, coeffs: trit[10]) -> int {
    let curr: int = val;
    let i: int = 0;
    
    while curr != 0 && i < 10 {
        let rem: int = curr % 3;
        
        if rem == 0 {
            coeffs[i] = 0;
            curr = curr / 3;
        } else if rem == 1 || rem == -2 {
            coeffs[i] = 1;
            curr = (curr - 1) / 3;
        } else { // rem == 2 || rem == -1
            coeffs[i] = -1;
            curr = (curr + 1) / 3;
        }
        
        i = i + 1;
    }
    
    return i; // Number of digits
}

fn main() -> trit {
    let coeffs: trit[10];
    let i: int = 0;
    while i < 10 { coeffs[i] = 0; i = i + 1; }
    
    // Target: 20
    // 20 = 27 - 9 + 3 - 1 -> coeffs: [-1, 1, -1, 1] for powers 3^0, 3^1, 3^2, 3^3
    let len: int = int_to_balanced_ternary(20, coeffs);
    
    println("Balanced Ternary for 20:");
    println(cast(coeffs[0])); // 3^0 = 1 -> coeff -1
    println(cast(coeffs[1])); // 3^1 = 3 -> coeff 1
    println(cast(coeffs[2])); // 3^2 = 9 -> coeff -1
    println(cast(coeffs[3])); // 3^3 = 27 -> coeff 1
    
    if coeffs[0] == -1 && coeffs[1] == 1 && coeffs[2] == -1 && coeffs[3] == 1 {
        println("Balanced Ternary Change Test: PASSED");
        return 1;
    }
    
    return -1;
}
