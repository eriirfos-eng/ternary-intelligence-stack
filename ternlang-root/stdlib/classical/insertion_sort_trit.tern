// stdlib/classical/insertion_sort_trit.tern
// Demonstrates: Insertion Sort algorithm on a trit tensor.
// Tier: 1 - Open Core

fn insertion_sort(arr: trittensor<8>, n: int) -> trit {
    let i: int = 1;
    while i < n {
        let key: trit = arr[i];
        let j: int = i - 1;
        
        while j >= 0 {
            if arr[j] > key {
                arr[j + 1] = arr[j];
                j = j - 1;
            } else {
                break;
            }
        }
        arr[j + 1] = key;
        i = i + 1;
    }
    return 1;
}

fn main() -> trit {
    let arr: trittensor<8> = [1, 0, -1, 0, 1, -1, 0, 1];
    
    println("Original array:");
    let k: int = 0;
    while k < 8 {
        print(arr[k]); print(" ");
        k = k + 1;
    }
    println("");
    
    insertion_sort(arr, 8);
    
    println("Sorted array:");
    k = 0;
    while k < 8 {
        print(arr[k]); print(" ");
        k = k + 1;
    }
    println("");
    
    if arr[0] == -1 && arr[1] == -1 && arr[7] == 1 {
        println("Insertion sort successful.");
        return truth();
    }
    
    return conflict();
}
