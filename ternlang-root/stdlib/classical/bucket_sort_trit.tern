// stdlib/classical/bucket_sort_trit.tern
// Demonstrates: Bucket Sort for trit-range mapping.
// Tier: 1 - Open Core

fn bucket_sort(arr: trittensor<6>) -> trittensor<6> {
    // Map -1, 0, 1 to 0, 1, 2
    let b1: int = 0;
    let b2: int = 0;
    let b3: int = 0;
    
    let i: int = 0;
    while i < 6 {
        if arr[i] == -1 { b1 = b1 + 1; }
        else if arr[i] == 0 { b2 = b2 + 1; }
        else { b3 = b3 + 1; }
        i = i + 1;
    }
    
    let res: trittensor<6>;
    let idx: int = 0;
    
    while b1 > 0 { res[idx] = -1; idx = idx + 1; b1 = b1 - 1; }
    while b2 > 0 { res[idx] = 0; idx = idx + 1; b2 = b2 - 1; }
    while b3 > 0 { res[idx] = 1; idx = idx + 1; b3 = b3 - 1; }
    
    return res;
}

fn main() -> trit {
    let input: trittensor<6> = [1, -1, 0, 1, -1, 0];
    let sorted: trittensor<6> = bucket_sort(input);
    
    if sorted[0] == -1 && sorted[5] == 1 {
        return truth();
    }
    return conflict();
}
