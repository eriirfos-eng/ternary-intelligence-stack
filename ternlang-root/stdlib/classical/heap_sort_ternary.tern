// stdlib/classical/heap_sort_ternary.tern
// Demonstrates: Heap Sort algorithm on a trit tensor.
// Tier: 1 - Open Core

fn heapify(arr: trittensor<8>, n: int, i: int) -> trit {
    let largest: int = i;
    let l: int = 2 * i + 1;
    let r: int = 2 * i + 2;
    
    if l < n {
        if arr[largest] < arr[l] {
            largest = l;
        }
    }
    
    if r < n {
        if arr[largest] < arr[r] {
            largest = r;
        }
    }
    
    if largest != i {
        let swap: trit = arr[i];
        arr[i] = arr[largest];
        arr[largest] = swap;
        
        heapify(arr, n, largest);
    }
    return 1;
}

fn heap_sort(arr: trittensor<8>, n: int) -> trit {
    let i: int = n / 2 - 1;
    while i >= 0 {
        heapify(arr, n, i);
        i = i - 1;
    }
    
    i = n - 1;
    while i > 0 {
        let temp: trit = arr[0];
        arr[0] = arr[i];
        arr[i] = temp;
        
        heapify(arr, i, 0);
        i = i - 1;
    }
    return 1;
}

fn main() -> trit {
    let arr: trittensor<8> = [0, -1, 1, 0, 1, -1, 0, 1];
    
    println("Original array:");
    let k: int = 0;
    while k < 8 {
        print(arr[k]); print(" ");
        k = k + 1;
    }
    println("");
    
    heap_sort(arr, 8);
    
    println("Sorted array:");
    k = 0;
    while k < 8 {
        print(arr[k]); print(" ");
        k = k + 1;
    }
    println("");
    
    if arr[0] == -1 && arr[1] == -1 && arr[7] == 1 {
        println("Heap sort successful.");
        return truth();
    }
    
    return conflict();
}
