// stdlib/classical/knapsack_ternary.tern
// 0/1 Knapsack problem implementation in Ternlang.
// Demonstrates dynamic programming and ternary decision logic.

fn knapsack(weights: int[], values: int[], capacity: int) -> int {
    let n: int = len(weights);
    let dp: int[101]; // Fixed size for safety (capacity <= 100)
    
    // Initialize DP table
    let i: int = 0;
    while i <= capacity {
        dp[i] = 0;
        i = i + 1;
    }

    let item: int = 0;
    while item < n {
        let w: int = capacity;
        while w >= weights[item] {
            let val_if_included: int = dp[w - weights[item]] + values[item];
            
            // Ternary logic: Compare current max with potential new value
            let preference: trit = 0;
            if val_if_included > dp[w] {
                preference = 1; // Affirm: Better value found
            } else if val_if_included < dp[w] {
                preference = -1; // Reject: Current value is better
            } else {
                preference = 0; // Hold: Both are equal
            }

            match preference {
                1 => {
                    dp[w] = val_if_included;
                }
                _ => {
                    // Stay with current value
                    hold;
                }
            }
            w = w - 1;
        }
        item = item + 1;
    }

    return dp[capacity];
}

fn main() -> trit {
    let weights: int[4];
    weights[0] = 2;
    weights[1] = 3;
    weights[2] = 4;
    weights[3] = 5;

    let values: int[4];
    values[0] = 3;
    values[1] = 4;
    values[2] = 5;
    values[3] = 6;

    let capacity: int = 8;
    let max_val: int = knapsack(weights, values, capacity);

    print("Knapsack Capacity: ");
    print(capacity);
    print("Maximum Value: ");
    print(max_val);

    // Verify result: for cap 8, items (3, 5) -> 4+6=10, or (2, 3, ?) 
    // weights 2,3,4,5 values 3,4,5,6
    // 3+5=8 (weights) -> 4+6=10 (values)
    // 2+3=5 (weights) -> 3+4=7 (values)
    // 2+3+? No more fit.
    // 3+4=7 (weights) -> 4+5=9 (values)
    // Correct max should be 10.

    match max_val {
        10 => {
            print("✓ Knapsack test passed.");
            return 1;
        }
        _ => {
            print("✗ Knapsack test failed.");
            return -1;
        }
    }
}
