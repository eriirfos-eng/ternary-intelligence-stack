// stdlib/classical/counting_sort_ternary.tern
// Demonstrates: Counting Sort algorithm optimized for the 3-state trit.
// Tier: 1 - Open Core

fn counting_sort(arr: trittensor<8>, n: int) -> trit {
    // Counts for -1, 0, 1
    let count: int[3];
    count[0] = 0; // count for -1
    count[1] = 0; // count for 0
    count[2] = 0; // count for 1
    
    let i: int = 0;
    while i < n {
        match arr[i] {
            -1 => { count[0] = count[0] + 1; }
             0 => { count[1] = count[1] + 1; }
             1 => { count[2] = count[2] + 1; }
        }
        i = i + 1;
    }
    
    // Overwrite original array
    let k: int = 0;
    // Fill -1s
    i = 0;
    while i < count[0] {
        arr[k] = -1;
        k = k + 1;
        i = i + 1;
    }
    // Fill 0s
    i = 0;
    while i < count[1] {
        arr[k] = 0;
        k = k + 1;
        i = i + 1;
    }
    // Fill 1s
    i = 0;
    while i < count[2] {
        arr[k] = 1;
        k = k + 1;
        i = i + 1;
    }
    
    return 1;
}

fn main() -> trit {
    let arr: trittensor<8> = [1, 0, -1, 1, -1, 0, 0, 1];
    
    println("Original array:");
    let k: int = 0;
    while k < 8 {
        print(arr[k]); print(" ");
        k = k + 1;
    }
    println("");
    
    counting_sort(arr, 8);
    
    println("Sorted array:");
    k = 0;
    while k < 8 {
        print(arr[k]); print(" ");
        k = k + 1;
    }
    println("");
    
    if arr[0] == -1 && arr[1] == -1 && arr[7] == 1 {
        println("Counting sort successful.");
        return truth();
    }
    
    return conflict();
}
