/*
 * Edmonds-Karp Max Flow Algorithm — Simple implementation for Ternlang.
 * 
 * RFI-IRFOS · PUBLIC repo · v1.0
 */

// Global-ish graph state (passed as params)
// Capacity matrix: cap[u * 4 + v]
// Flow matrix: flow[u * 4 + v]

fn bfs(cap: int[16], flow: int[16], s: int, t: int, parent: int[4]) -> int {
    let visited: int[4];
    visited[0] = 0; visited[1] = 0; visited[2] = 0; visited[3] = 0;
    let queue: int[8];
    let head: int = 0;
    let tail: int = 0;
    
    queue[tail] = s;
    tail = tail + 1;
    visited[s] = 1;
    parent[s] = -1;
    
    while head < tail {
        let u: int = queue[head];
        head = head + 1;
        
        let v: int = 0;
        while v < 4 {
            if visited[v] == 0 && (cap[u * 4 + v] - flow[u * 4 + v]) > 0 {
                parent[v] = u;
                visited[v] = 1;
                queue[tail] = v;
                tail = tail + 1;
                if v == t {
                    return 1;
                }
            }
            v = v + 1;
        }
    }
    
    return 0;
}

fn edmonds_karp(cap: int[16], flow: int[16], s: int, t: int) -> int {
    let max_flow: int = 0;
    let parent: int[4];
    
    while bfs(cap, flow, s, t, parent) == 1 {
        let path_flow: int = 1000; // Infinity
        let v: int = t;
        while v != s {
            let u: int = parent[v];
            let residual: int = cap[u * 4 + v] - flow[u * 4 + v];
            if residual < path_flow {
                path_flow = residual;
            }
            v = u;
        }
        
        v = t;
        while v != s {
            let u: int = parent[v];
            flow[u * 4 + v] = flow[u * 4 + v] + path_flow;
            flow[v * 4 + u] = flow[v * 4 + u] - path_flow;
            v = u;
        }
        
        max_flow = max_flow + path_flow;
    }
    
    return max_flow;
}

fn main() -> trit {
    let cap: int[16];
    let flow: int[16];
    let i: int = 0;
    while i < 16 {
        cap[i] = 0;
        flow[i] = 0;
        i = i + 1;
    }
    
    // 0 -> 1: 10
    cap[0 * 4 + 1] = 10;
    // 0 -> 2: 5
    cap[0 * 4 + 2] = 5;
    // 1 -> 2: 2
    cap[1 * 4 + 2] = 2;
    // 1 -> 3: 10
    cap[1 * 4 + 3] = 10;
    // 2 -> 3: 5
    cap[2 * 4 + 3] = 5;
    
    let result: int = edmonds_karp(cap, flow, 0, 3);
    println("Max Flow (expected 15):");
    println(result);
    
    if result == 15 {
        println("Max Flow Test: PASSED");
        return 1;
    }
    
    println("Max Flow Test: FAILED");
    return -1;
}
