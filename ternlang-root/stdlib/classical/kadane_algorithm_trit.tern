/*
 * KadaneAlgorithmTrit — Maximum Subarray Sum for trits.
 * Finds the contiguous subarray with the largest sum.
 * 
 * RFI-IRFOS · PUBLIC repo · v1.0
 */

fn max_int(a: int, b: int) -> int {
    if a > b { return a; }
    return b;
}

fn kadane_trit(data: trit[], size: int) -> int {
    let max_so_far: int = -999999;
    let current_max: int = 0;
    
    let i: int = 0;
    while i < size {
        let val: int = cast(data[i]);
        
        current_max = current_max + val;
        
        if max_so_far < current_max {
            max_so_far = current_max;
        }
        
        if current_max < 0 {
            current_max = 0;
        }
        
        i = i + 1;
    }
    
    return max_so_far;
}

fn main() -> trit {
    let data: trittensor<8> = [-1, 1, 1, 0, -1, 1, 1, -1];
    
    println("Array: [-1, 1, 1, 0, -1, 1, 1, -1]");
    let max_sum: int = kadane_trit(data, 8);
    
    println("Maximum subarray sum (expected 3):");
    println(max_sum); // 1 + 1 + 0 + -1 + 1 + 1 = 3
    
    if max_sum == 3 {
        println("KadaneAlgorithmTrit Test: PASSED");
        return 1;
    }
    
    println("KadaneAlgorithmTrit Test: FAILED");
    return -1;
}
