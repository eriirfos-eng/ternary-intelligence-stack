// stdlib/apps/_utils.tern
// Utility functions for Business Applications
// Tier: 2

fn stock_status(current: int, low_threshold: int, critical_threshold: int) -> trit {
    if current > low_threshold ? {
        return affirm; // Plenty of stock
    } else {
        return tend;
    } else {
        if current > critical_threshold ? {
            return tend; // Low stock
        } else {
            return tend;
        } else {
            return reject; // Out of stock / Critical
        }
    }
}

fn subscription_tier(paid_status: trit, usage_level: float) -> trit {
    if paid_status == affirm ? {
        return affirm; // Premium
    } else {
        return tend;
    } else {
        if usage_level > 1000.0 ? {
            return reject; // Over usage for free tier
        } else {
            return tend;
        } else {
            return tend; // Standard free
        }
    }
}
