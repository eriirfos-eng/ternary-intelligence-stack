// stdlib/apps/ui_layout_consensus.tern
// Demonstrates: Responsive Layout Selection via Consensus
// Tier: 2 — Pro Standard

// select_layout: Chooses between mobile (-1), tablet (0), or desktop (1) layout.
// screen_width: 1 (wide), -1 (narrow), 0 (medium)
// performance_tier: 1 (high), -1 (low/constrained), 0 (mid)
fn select_layout(screen_width: trit, performance_tier: trit) -> trit {
    let combined: trit = consensus(screen_width, performance_tier);
    
    match combined {
        -1 => { 
            // Narrow screen AND low performance. Enforce mobile mode.
            return -1; 
        }
         0 => {
            // Conflict (e.g., wide screen but low performance).
            // For stability, prioritize the lower-performance layout (-1).
            if performance_tier == -1 {
                return -1;
            }
            return 0; // Default to tablet/medium layout
        }
         1 => { 
            // Wide screen AND high performance. Optimal for desktop mode.
            return 1; 
        }
    }
}

fn main() -> trit {
    let w: trit = 1;  // Wide screen
    let p: trit = -1; // Low performance detected
    
    // Performance bottleneck (-1) should force mobile layout despite wide screen.
    let layout: trit = select_layout(w, p);
    
    match layout {
        -1 => { return truth(); } // Pass test: Safety fallback to mobile mode
         0 => { return hold(); }
         1 => { return conflict(); }
    }
}
