// stdlib/apps/coupon_validation_filter.tern
// Demonstrates: Discount eligibility and expiry check for e-commerce apps.
// Tier: 2 — Pro Standard

fn validate_coupon(is_expired: trit, min_spend: float, current_total: float) -> trit {
    match is_expired {
        1 => { return conflict(); } // Expired
         0 => { return hold();     } // Status uncertain
         -1 => {
            if current_total >= min_spend {
                return truth(); // Eligible
            }
            return conflict(); // Spend threshold not met
         }
    }
}

fn main() -> trit {
    let expired: trit = -1; // Not expired
    let threshold: float = 50.0;
    let basket: float = 65.0;
    
    let result: trit = validate_coupon(expired, threshold, basket);
    
    match result {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
