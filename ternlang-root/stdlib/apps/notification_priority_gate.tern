// stdlib/apps/notification_priority_gate.tern
// Demonstrates: Smart Notification Filtering via Importance Consensus
// Tier: 2 — Pro Standard

// gate_notification: Decides if a notification should disturb the user.
// importance: 1 (high), -1 (low), 0 (normal)
// dnd_status: 1 (Do Not Disturb Active), -1 (DND Off), 0 (Auto/Neutral)
fn gate_notification(importance: trit, dnd_status: trit) -> trit {
    match dnd_status {
         1 => {
            // DND Active: Only pass if importance is high (1).
            if importance == 1 {
                return 1; // Pass critical notification
            }
            return 0; // Suppress
        }
         0 => {
            // Auto/Neutral: Use consensus between importance and "willingness to disturb" (neutral 0).
            return consensus(importance, 0);
        }
        -1 => {
            // DND Off: Pass if importance is normal (0) or high (1).
            if importance != -1 {
                return 1;
            }
            return 0; // Still suppress low importance spam
        }
    }
}

fn main() -> trit {
    let imp: trit = 1; // High importance
    let dnd: trit = 1; // DND Active
    
    // Even with DND active, high importance (1) should pass.
    let status: trit = gate_notification(imp, dnd);
    
    match status {
        1 => { return truth(); } // Pass test: Critical notification allowed
        0 => { return hold(); }
        -1 => { return conflict(); }
    }
}
