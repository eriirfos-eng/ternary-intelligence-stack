// stdlib/apps/dynamic_theme_gate.tern
// Demonstrates: UI Theme Selection via Environment Consensus
// Tier: 2 — Pro Standard

// select_theme_mode: Decides between dark (-1), light (1), or auto (0) themes.
// light_sensor: 1 (bright), -1 (dark), 0 (dim/neutral)
// energy_saver: 1 (disabled), -1 (active/prefer dark), 0 (auto)
fn select_theme_mode(light_sensor: trit, energy_saver: trit) -> trit {
    let combined: trit = consensus(light_sensor, energy_saver);
    
    match combined {
        -1 => { 
            // Both favor dark mode or energy efficiency.
            return -1; 
        }
         0 => {
            // Conflict (e.g., bright light but energy saver active).
            // Prioritize energy saver (-1) for battery longevity.
            if energy_saver == -1 {
                return -1;
            }
            return 0; // Fallback to auto
        }
         1 => { 
            // Both sensors agree on light mode being optimal.
            return 1; 
        }
    }
}

fn main() -> trit {
    let light: trit = 1;   // Bright environment (prefers light theme)
    let energy: trit = -1;  // Energy saver active (prefers dark theme)
    
    // Conflict detected. Energy saver status (-1) should be prioritized over light sensor.
    let theme: trit = select_theme_mode(light, energy);
    
    match theme {
        -1 => { return truth(); } // Pass test: Dark mode selected for energy efficiency
         0 => { return hold(); }
         1 => { return conflict(); }
    }
}
