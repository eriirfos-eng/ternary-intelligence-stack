// stdlib/apps/recommender_consensus.tern
// Demonstrates: Merging multiple recommendation signals via consensus.
// Tier: 2 — Pro Standard

fn aggregate_recs(algo_a: trit, algo_b: trit, history: trit) -> trit {
    // Consensus of two algorithms and a history bias
    let temp: trit = consensus(algo_a, algo_b);
    return consensus(temp, history);
}

fn main() -> trit {
    let rec1: trit = 1;  // Recommends
    let rec2: trit = 0;  // Uncertain
    let hist: trit = 1;  // Past preference
    
    let result: trit = aggregate_recs(rec1, rec2, hist);
    
    match result {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
