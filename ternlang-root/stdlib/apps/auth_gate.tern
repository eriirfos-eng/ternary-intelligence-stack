// stdlib/apps/auth_gate.tern
// Demonstrates: Multi-factor authentication gating using ternary trits
// Tier: 2 - Pro Standard

fn mfa_check(password_ok: trit, bio_ok: trit, token_ok: trit) -> trit {
    // Requires all three to be affirmative, or at least two with one tend
    let score: int = 0;
    
    if password_ok == 1 { score = score + 1; }
    if bio_ok == 1 { score = score + 1; }
    if token_ok == 1 { score = score + 1; }
    
    if password_ok == -1 { return reject; }
    
    if score == 3 { return affirm; }
    if score == 2 { return tend; }
    return reject;
}

fn main() -> trit {
    let p: trit = affirm;
    let b: trit = tend;
    let t: trit = affirm;
    
    let res: trit = mfa_check(p, b, t); // should be tend
    
    match res {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
