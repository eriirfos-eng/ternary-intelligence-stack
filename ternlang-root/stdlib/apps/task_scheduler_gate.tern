// stdlib/apps/task_scheduler_gate.tern
// Demonstrates: Job priority and resource availability check for application tasks.
// Tier: 2 — Pro Standard

fn schedule_task(priority: int, load: float, limit: float) -> trit {
    if load > limit {
        if priority > 8 {
            return hold(); // High priority, wait for slot
        }
        return conflict(); // Normal/Low priority, reject
    }
    
    return truth(); // Slots available, proceed
}

fn main() -> trit {
    let p: int = 9;
    let curr_load: float = 95.0;
    let max_load: float = 90.0;
    
    let result: trit = schedule_task(p, curr_load, max_load);
    
    match result {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
