// stdlib/benchmarks/float_arithmetic_bench.tern
// Demonstrates: performance of floating-point operations
// Tier: 3 — Industrial

fn float_stress(a: float, b: float) -> float {
    let c: float = a * b + (a / b);
    let d: float = c % 2.5;
    return d;
}

fn main() -> trit {
    let res: float = float_stress(10.5, 3.2);
    if res > 0.0 {
        return truth();
    }
    match res == 0.0 {
        1  => { return hold();    }
        0  => { return conflict(); }
        -1 => { return conflict(); }
    }
}
