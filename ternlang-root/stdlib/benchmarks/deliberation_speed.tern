// stdlib/benchmarks/deliberation_speed.tern
// Demonstrates: Benchmarking the EMA convergence rate in a tight loop
// Tier: 1 — Open Core

fn converge_ema(target: float, alpha: float) -> int {
    let current: float = 0.0;
    let iterations: int = 0;
    
    while (target - current) > 0.01 {
        current = alpha * target + (1.0 - alpha) * current;
        iterations = iterations + 1;
        
        if iterations > 1000 {
            return iterations; // safety break
        }
    }
    
    return iterations;
}

fn main() -> trit {
    let goal: float = 1.0;
    let rate: float = 0.1;
    
    let count: int = converge_ema(goal, rate);
    
    if count < 100 {
        return truth();
    }
    
    return hold();
}
