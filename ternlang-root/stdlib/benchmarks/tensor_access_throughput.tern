// stdlib/benchmarks/tensor_access_throughput.tern
// Demonstrates: latency of tensor index access in a loop
// Tier: 3 — Industrial

fn sum_tensor(t: trittensor<10>) -> int {
    let sum: int = 0;
    for x in t {
        match x {
            -1 => { sum = sum - 1; }
             0 => { sum = sum + 0; }
             1 => { sum = sum + 1; }
        }
    }
    return sum;
}

fn main() -> trit {
    let t: trittensor<10>;
    t[0] = 1;
    t[1] = -1;
    t[2] = 1;
    t[3] = 0;
    t[4] = 1;
    t[5] = -1;
    t[6] = 1;
    t[7] = 0;
    t[8] = 1;
    t[9] = -1;

    let total: int = sum_tensor(t);
    if total > 0 {
        return truth();
    }
    if total < 0 {
        return conflict();
    }
    return hold();
}
