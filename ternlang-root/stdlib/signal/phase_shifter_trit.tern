fn shift_stream(input: trit[9], n: int, output: trit[9]) -> trit {
    let mut i: int = 0;
    while i < 9 {
        let mut target_idx: int = (i + n) % 9;
        if target_idx < 0 {
            target_idx = target_idx + 9;
        }
        output[target_idx] = input[i];
        i = i + 1;
    }
    return 1;
}

fn main() -> trit {
    let mut input: trit[9];
    let mut k: int = 0;
    while k < 9 {
        input[k] = 0;
        k = k + 1;
    }
    input[0] = 1;
    input[1] = -1;
    
    let mut shifted: trit[9];
    let mut l: int = 0;
    while l < 9 {
        shifted[l] = 0;
        l = l + 1;
    }
    
    shift_stream(input, 2, shifted);
    
    if shifted[2] == 1 {
        if shifted[3] == -1 {
            return 1;
        }
    }
    return -1;
}
