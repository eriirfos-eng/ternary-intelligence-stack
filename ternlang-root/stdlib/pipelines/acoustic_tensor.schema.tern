// Module:  stdlib/pipelines/acoustic_tensor.schema.tern
// Purpose: T-SON serialization schema for acoustic_tensor
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Acoustic_tensorSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Acoustic_tensorSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
