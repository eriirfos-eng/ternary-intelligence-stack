// Module:  stdlib/pipelines/quantum_model.schema.tern
// Purpose: T-SON serialization schema for quantum_model
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Quantum_modelSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Quantum_modelSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
