// Module:  stdlib/pipelines/stellar_filter.schema.tern
// Purpose: T-SON serialization schema for stellar_filter
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Stellar_filterSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Stellar_filterSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
