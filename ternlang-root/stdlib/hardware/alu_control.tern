// stdlib/hardware/alu_control.tern
// Demonstrates: ALU control unit logic for ternary operations
// Tier: 3 - Industrial

fn alu_ctrl(op_code: int, a: trit, b: trit) -> trit {
    match op_code {
        0 => { return a + b; } // Add
        1 => { return a * b; } // Mul
        2 => { return consensus(a, b); } // Consensus
    }
}

fn main() -> trit {
    let a: trit = affirm;
    let b: trit = reject;
    
    let res: trit = alu_ctrl(0, a, b); // 1 + (-1) = 0
    
    if res == tend {
        return affirm;
    }
    return reject;
}
