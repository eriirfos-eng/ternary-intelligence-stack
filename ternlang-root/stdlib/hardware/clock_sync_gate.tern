// stdlib/hardware/clock_sync_gate.tern
// Demonstrates: Hardware clock synchronization gating
// Tier: 3

from "./_utils.tern" import *;

fn sync_gate(clk_a: trit, clk_b: trit) -> trit {
    // Both clocks must be in sync (both HIGH or both LOW)
    if clk_a == clk_b ? {
        return affirm;
    } else {
        return tend;
    } else {
        return reject; // Desync
    }
}

fn main() -> trit {
    let a: trit = affirm; // HIGH
    let b: trit = reject; // LOW
    
    let synchronized: trit = sync_gate(a, b);
    
    match synchronized {
        affirm => {
            println("Clocks SYNCHRONIZED.");
        }
        tend => {
            println("Clock phase UNCERTAIN.");
        }
        reject => {
            println("Clocks DESYNCHRONIZED - Halting pipeline.");
        }
    }
    
    return synchronized;
}
