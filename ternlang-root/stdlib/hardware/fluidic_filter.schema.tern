// Module:  stdlib/hardware/fluidic_filter.schema.tern
// Purpose: T-SON serialization schema for fluidic_filter
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Fluidic_filterSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Fluidic_filterSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
