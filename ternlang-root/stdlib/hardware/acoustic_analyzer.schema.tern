// Module:  stdlib/hardware/acoustic_analyzer.schema.tern
// Purpose: T-SON serialization schema for acoustic_analyzer
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Acoustic_analyzerSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Acoustic_analyzerSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
