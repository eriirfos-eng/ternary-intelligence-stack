// Module:  stdlib/hardware/thermal_matrix.schema.tern
// Purpose: T-SON serialization schema for thermal_matrix
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Thermal_matrixSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Thermal_matrixSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
