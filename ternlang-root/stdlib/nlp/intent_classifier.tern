// stdlib/nlp/intent_classifier.tern
// Demonstrates: Simple intent classification using evidence aggregation
// Tier: 2

fn classify_intent(evidence: trit[]) -> trit {
    // Manually aggregate evidence for fixed size 5
    let mut score: int = 0;
    
    let x0: trit = evidence[0];
    if x0 == 1 { score = score + 1; }
    if x0 == -1 { score = score - 1; }
    
    let x1: trit = evidence[1];
    if x1 == 1 { score = score + 1; }
    if x1 == -1 { score = score - 1; }
    
    let x2: trit = evidence[2];
    if x2 == 1 { score = score + 1; }
    if x2 == -1 { score = score - 1; }
    
    let x3: trit = evidence[3];
    if x3 == 1 { score = score + 1; }
    if x3 == -1 { score = score - 1; }
    
    let x4: trit = evidence[4];
    if x4 == 1 { score = score + 1; }
    if x4 == -1 { score = score - 1; }
    
    // Thresholds on score (total sum of 5 trits)
    // score > 2 => affirm
    // score < -2 => reject
    // else => tend
    
    if score > 2 { return 1; }
    if score < -2 { return -1; }
    return 0;
}

fn main() -> trit {
    let ev_pos: trit[] = [1, 1, 1, 0, 1]; // score = 4
    if classify_intent(ev_pos) != 1 { return conflict(); }
    
    let ev_amb: trit[] = [1, 0, -1, 0, 0]; // score = 0
    if classify_intent(ev_amb) != 0 { return conflict(); }
    
    let ev_neg: trit[] = [-1, -1, -1, 0, -1]; // score = -4
    if classify_intent(ev_neg) != -1 { return conflict(); }
    
    return truth();
}
