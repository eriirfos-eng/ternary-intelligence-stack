// stdlib/nlp/entity_recognition_mask.tern
// Demonstrates: Ternary mask for entity recognition confidence
// Tier: 2

from "./_utils.tern" import *;

fn entity_mask(scores: trit[]) -> trit {
    // Requires a consensus of affirm to confirm an entity
    let consensus: trit = consensus_score(scores);
    
    match consensus {
        affirm => {
            return affirm;
        }
        tend => {
            return tend;
        }
        reject => {
            return reject;
        }
    }
}

fn main() -> trit {
    let scores: trit[] = [affirm, tend, affirm];
    let result: trit = entity_mask(scores);
    
    match result {
        affirm => {
            println("Entity confirmed with high confidence.");
        }
        tend => {
            println("Entity recognition uncertain.");
        }
        reject => {
            println("Entity rejected.");
        }
    }
    
    return result;
}
