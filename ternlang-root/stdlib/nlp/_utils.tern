// stdlib/nlp/_utils.tern
// Utility functions for Natural Language Processing
// Tier: 2

fn normalize_signal(signal: float) -> trit {
    if signal > 0.5 ? {
        return affirm;
    } else {
        return tend;
    } else {
        if signal < -0.5 ? {
            return reject;
        } else {
            return tend;
        } else {
            return tend;
        }
    }
}

fn consensus_score(scores: trit[]) -> trit {
    let count: int = length(scores);
    let sum: int = 0;
    let i: int = 0;
    while i < count ? {
        let val: trit = scores[i];
        match val {
            affirm => { sum = sum + 1; }
            tend   => { }
            reject => { sum = sum - 1; }
        }
        i = i + 1;
    } else { } else { }
    
    if sum > 0 ? {
        return affirm;
    } else {
        return tend;
    } else {
        if sum < 0 ? {
            return reject;
        } else {
            return tend;
        } else {
            return tend;
        }
    }
}
