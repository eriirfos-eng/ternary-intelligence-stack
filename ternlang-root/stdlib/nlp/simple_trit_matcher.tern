// stdlib/nlp/simple_trit_matcher.tern
// Demonstrates: Substring matching in ternary sequences using the new 'length' built-in.
// Tier: 2 — Pro Standard

fn find_pattern(text: trit[], pattern: trit[]) -> int {
    let n: int = length(text);
    let m: int = length(pattern);
    
    if m > n { return -1; }
    
    let i: int = 0;
    while i < (n - m + 1) {
        let match_found: trit = truth();
        let j: int = 0;
        while j < m {
            if text[i + j] != pattern[j] {
                match_found = conflict();
                break;
            }
            j = j + 1;
        }
        
        if match_found == truth() {
            return i;
        }
        i = i + 1;
    }
    
    return -1;
}

fn main() -> trit {
    let text: trit[] = [1, -1, 0, 1, 1, 0];
    let pattern: trit[] = [0, 1, 1];
    
    let index: int = find_pattern(text, pattern);
    
    // Pattern [0, 1, 1] starts at index 2 (text[2]=0, text[3]=1, text[4]=1)
    if index != 2 { return conflict(); }
    
    let missing_pattern: trit[] = [-1, -1, -1];
    let missing_index: int = find_pattern(text, missing_pattern);
    if missing_index != -1 { return conflict(); }
    
    return truth();
}
