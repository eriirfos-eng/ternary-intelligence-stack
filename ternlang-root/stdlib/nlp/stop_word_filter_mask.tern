// stdlib/nlp/stop_word_filter_mask.tern
// Demonstrates: Ternary stop word filter (Keep/Drop/Pending)
// Tier: 2

fn is_stop_word(token_id: int) -> trit {
    // Example IDs: 101="the", 102="a", 103="is"
    if token_id == 101 ? {
        return reject; // Drop
    } else {
        if token_id == 102 ? {
            return reject; // Drop
        } else {
            if token_id == 103 ? {
                return reject; // Drop
            } else {
                return affirm; // Keep
            } else {
                return affirm;
            }
        } else {
            return reject;
        }
    } else {
        return reject;
    }
}

fn main() -> trit {
    let tid: int = 101; // "the"
    let result: trit = is_stop_word(tid);

    match result {
        -1 => { return truth(); } // Successfully filtered (return 1 for CLI)
         0 => { return hold();    }
         1 => { return conflict(); }
    }
}
