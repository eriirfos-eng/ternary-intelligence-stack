// stdlib/nlp/sentiment_analyzer_mask.tern
// Demonstrates: Ternary sentiment analysis mask (Positive/Negative/Neutral)
// Tier: 2

from "_utils.tern" import normalize_signal;

fn main() -> trit {
    let score: float = 0.8;
    let result: trit = normalize_signal(score);

    match result {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
