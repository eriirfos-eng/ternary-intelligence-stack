// stdlib/security/brute_force_protection_mask.tern
// Demonstrates: Identifying and mitigating brute-force attacks
// Tier: 3

fn check_attempt_count(failed_attempts: int) -> trit {
    if failed_attempts > 20 { return -1; } // Block immediately
    if failed_attempts > 5 { return 0; }  // Delay/Captcha
    return 1;
}

fn check_attempt_window(attempts_per_sec: int) -> trit {
    if attempts_per_sec > 100 { return -1; } // Massive burst
    if attempts_per_sec > 10 { return 0; } 
    return 1;
}

fn success_rate_eval(success_count: int, total_count: int) -> trit {
    if total_count < 10 { return 1; }
    if (success_count * 10) < total_count { return -1; } // Low success rate
    if (success_count * 4) < total_count { return 0; }
    return 1;
}

fn main() -> trit {
    let attempts: trit = check_attempt_count(7);
    let burst: trit = check_attempt_window(15);
    let rate: trit = success_rate_eval(1, 15);
    
    match attempts {
        -1 => { return -1; }
        0 => { 
            match burst {
                -1 => { return -1; }
                0 => { return 0; }
                1 => { return 0; }
            }
        }
        1 => {
            match rate {
                -1 => { return -1; }
                0 => { return 0; }
                1 => { return 1; }
            }
        }
    }
}
