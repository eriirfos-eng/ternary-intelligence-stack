// Module:  stdlib/security/thermal_solver.schema.tern
// Purpose: T-SON serialization schema for thermal_solver
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Thermal_solverSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Thermal_solverSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
