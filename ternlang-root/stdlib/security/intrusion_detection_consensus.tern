// stdlib/security/intrusion_detection_consensus.tern
// Demonstrates: Aggregating multiple threat signals to identify intrusions
// Tier: 3

from "security_utils.tern" import consensus;

fn network_anomaly(score: int) -> trit {
    if score > 80 { return -1; }
    if score > 40 { return 0; }
    return 1;
}

fn log_anomaly(count: int) -> trit {
    if count > 100 { return -1; }
    if count > 20 { return 0; }
    return 1;
}

fn user_behavior_eval(unusual_ops: int) -> trit {
    if unusual_ops > 5 { return -1; }
    if unusual_ops > 1 { return 0; }
    return 1;
}

fn main() -> trit {
    let net_trit: trit = network_anomaly(50);
    let log_trit: trit = log_anomaly(10);
    let user_trit: trit = user_behavior_eval(0);
    
    // Evaluate consensus in steps
    let interim: trit = consensus(net_trit, log_trit);
    let final_decision: trit = consensus(interim, user_trit);
    
    match final_decision {
        -1 => { return -1; } // High Threat detected
        0 => { return 0; }   // Suspicious activity
        1 => { return 1; }   // Clear
    }
}
