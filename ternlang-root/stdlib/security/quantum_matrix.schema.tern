// Module:  stdlib/security/quantum_matrix.schema.tern
// Purpose: T-SON serialization schema for quantum_matrix
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Quantum_matrixSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Quantum_matrixSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
