// Module:  stdlib/security/quantum_engine.schema.tern
// Purpose: T-SON serialization schema for quantum_engine
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Quantum_engineSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Quantum_engineSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
