// Module:  stdlib/security/nuclear_router.schema.tern
// Purpose: T-SON serialization schema for nuclear_router
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Nuclear_routerSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Nuclear_routerSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
