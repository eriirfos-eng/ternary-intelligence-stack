// stdlib/security/data_exfiltration_detector.tern
// Demonstrates: Identifying potential data exfiltration by analyzing traffic volume
// Tier: 3

fn byte_count_eval(bytes_out: int, baseline_avg: int) -> trit {
    if bytes_out > (baseline_avg * 100) { return -1; } // Massive Spike
    if bytes_out > (baseline_avg * 10) { return 0; }  // Significant increase
    return 1;
}

fn destination_reputation(is_malicious: int) -> trit {
    if is_malicious == 1 { return -1; }
    if is_malicious == 0 { return 1; }
    return 0; // Unknown
}

fn transfer_frequency(count_per_hour: int) -> trit {
    if count_per_hour > 1000 { return -1; } // Rapid small transfers
    if count_per_hour > 100 { return 0; }
    return 1;
}

fn main() -> trit {
    let volume: trit = byte_count_eval(5000000, 100000);
    let dest: trit = destination_reputation(0);
    let freq: trit = transfer_frequency(50);
    
    match volume {
        -1 => { return -1; }
        0 => { 
            match dest {
                -1 => { return -1; }
                0 => { return 0; }
                1 => { return 0; }
            }
        }
        1 => {
            match freq {
                -1 => { return -1; }
                0 => { return 0; }
                1 => { return 1; }
            }
        }
    }
}
