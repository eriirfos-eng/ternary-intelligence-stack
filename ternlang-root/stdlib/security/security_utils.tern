fn consensus(a: trit, b: trit) -> trit {
    match a {
        -1 => { return -1; }
        0 => { return b; }
        1 => {
            match b {
                -1 => { return -1; }
                0 => { return 1; }
                1 => { return 1; }
            }
        }
    }
}

