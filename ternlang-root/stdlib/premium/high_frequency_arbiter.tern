// stdlib/premium/high_frequency_arbiter.tern
// Demonstrates: High-frequency decision arbitration between competing signals.
// Tier: 4 - Enterprise

// Arbitrates between two high-speed signals given a priority trit.
// priority: 1 (primary), -1 (secondary), 0 (fair/consensus)
fn arbitrate(s1: trit, s2: trit, priority: trit) -> trit {
    match priority {
        1 => {
            // Primary signal s1 overrides unless it's tend
            if s1 != tend { return s1; }
            return s2;
        }
        -1 => {
            // Secondary signal s2 overrides unless it's tend
            if s2 != tend { return s2; }
            return s1;
        }
        0 => {
            // Fair consensus: both must agree or at least one must be non-neutral
            return consensus(s1, s2);
        }
    }
}

fn main() -> trit {
    let signal_a: trit = affirm;
    let signal_b: trit = reject;
    let p: trit = 1; // Primary priority for A
    
    let result: trit = arbitrate(signal_a, signal_b, p);
    
    match result {
        -1 => { println("Arbiter Result: Reject"); }
         0 => { println("Arbiter Result: Hold");   }
         1 => { println("Arbiter Result: Affirm"); }
    }
    
    return result;
}
