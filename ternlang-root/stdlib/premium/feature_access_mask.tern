// stdlib/premium/feature_access_mask.tern
// Demonstrates: masking features based on user subscription tier
// Tier: 4 — Enterprise

fn has_feature(tier: int, req: int) -> trit {
    if tier >= req { return truth(); }
    if tier == (req - 1) { return hold(); } // Upsell opportunity
    return conflict();
}

fn main() -> trit {
    let user_tier: int = 2; // Pro
    let req_tier: int = 3;  // Industrial
    
    let access: trit = has_feature(user_tier, req_tier);
    match access {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
