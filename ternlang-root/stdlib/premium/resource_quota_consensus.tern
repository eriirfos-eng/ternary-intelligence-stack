// stdlib/premium/resource_quota_consensus.tern
// Demonstrates: Distributed resource quota consensus
// Tier: 4 — Enterprise

from "premium_utils.tern" import quota_check;

fn main() -> trit {
    // Check quota on three different resource pools
    let pool1: trit = quota_check(95.0, 100.0); // tend (Near)
    let pool2: trit = quota_check(50.0, 100.0); // reject (Safe)
    let pool3: trit = quota_check(110.0, 100.0); // affirm (Over)
    
    // Aggregate status
    let status12: trit = consensus(pool1, pool2);
    let overall_status: trit = consensus(status12, pool3);
    
    // Result should be tend (consensus(tend, reject) = 0, consensus(0, affirm) = 0)
    match overall_status {
        affirm => { 
            // All pools over quota
            return conflict(); 
        }
        tend => { 
            // Mixed status - warning
            return hold(); 
        }
        reject => { 
            // All pools safe
            return truth(); 
        }
    }
}
