// stdlib/premium/high_availability_gate.tern
// Demonstrates: Failover logic for enterprise nodes with primary and secondary health checks.
// Tier: 4 — Enterprise

fn failover(primary_health: trit, secondary_health: trit, manual_override: trit) -> trit {
    match manual_override {
        -1 => { return conflict(); } // Forced shutdown
         1 => { return truth();    } // Forced up
         0 => {
            // Automatic logic
            match primary_health {
                1 => { return truth();    } // Primary is fine
                0 => { return secondary_health; } // Primary uncertain, use secondary
                -1 => { return secondary_health; } // Primary failed, use secondary
            }
         }
    }
}

fn main() -> trit {
    let p_health: trit = -1; // Primary down
    let s_health: trit = 1;  // Secondary up
    let m_override: trit = 0;
    
    let active: trit = failover(p_health, s_health, m_override);
    
    match active {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
