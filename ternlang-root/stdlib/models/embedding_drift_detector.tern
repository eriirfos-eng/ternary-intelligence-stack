// stdlib/models/embedding_drift_detector.tern
// Demonstrates: Identifying semantic drift in embedding vectors
// Tier: 3

fn cosine_similarity_eval(sim: float) -> trit {
    if sim < 0.5 { return -1; } // Significant drift
    if sim < 0.8 { return 0; }  // Noticeable change
    return 1; // Stable
}

fn embedding_norm_drift(curr_norm: float, base_norm: float) -> trit {
    let ratio: float = curr_norm / base_norm;
    if ratio > 1.5 { return -1; }
    if ratio < 0.5 { return -1; }
    if ratio > 1.2 { return 0; }
    return 1;
}

fn main() -> trit {
    let sim: float = 0.95;
    let cn: float = 10.5;
    let bn: float = 10.0;
    
    let sim_trit: trit = cosine_similarity_eval(sim);
    let drift_trit: trit = embedding_norm_drift(cn, bn);
    
    match sim_trit {
        -1 => { return -1; }
        0  => { return 0;  }
        1  => { return drift_trit; }
    }
}
