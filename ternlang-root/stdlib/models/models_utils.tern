// stdlib/models/models_utils.tern
// Demonstrates: Core utility functions for model component evaluation
// Tier: 3

fn consensus(a: trit, b: trit) -> trit {
    match a {
        -1 => { return -1; }
        0 => { return b; }
        1 => {
            match b {
                -1 => { return -1; }
                0 => { return 1; }
                1 => { return 1; }
            }
        }
    }
}

fn map_confidence_to_trit(conf: float) -> trit {
    if conf > 0.8 { return 1; }
    if conf < 0.2 { return -1; }
    return 0;
}

fn main() -> trit {
    let c: float = 0.85;
    let t: trit = map_confidence_to_trit(c);
    
    match t {
        1  => { return 1; }
        0  => { return 0; }
        -1 => { return -1; }
    }
}
