// stdlib/models/residual_link.tern
// Demonstrates: Ternary residual connection logic
// Tier: 2 — Pro Standard

fn residual_gate(main: trit, residual: trit) -> trit {
    match main {
        -1 => { return conflict(); } // Main path vetoes
         0 => { return residual;   } // Main path uncertain, use residual
         1 => { 
            return consensus(main, residual); // Both active
         }
    }
}

fn main() -> trit {
    let m: trit = 0;
    let r: trit = 1;
    
    let ok: trit = residual_gate(m, r);
    
    match ok {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
