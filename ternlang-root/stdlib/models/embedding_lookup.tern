// stdlib/models/embedding_lookup.tern
// Demonstrates: Mock embedding table lookup gate
// Tier: 2 — Pro Standard

fn check_embedding_index(idx: int, max: int) -> trit {
    if idx < 0 { return conflict(); }
    if idx >= max { return conflict(); }
    if idx == 0 { return hold(); } // Reserved for padding/null
    return truth();
}

fn main() -> trit {
    let i: int = 150;
    let table_size: int = 1000;
    
    let ok: trit = check_embedding_index(i, table_size);
    
    match ok {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
