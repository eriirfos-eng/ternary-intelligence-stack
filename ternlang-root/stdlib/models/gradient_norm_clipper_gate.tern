// stdlib/models/gradient_norm_clipper_gate.tern
// Demonstrates: Deciding when to clip gradients based on norm magnitude
// Tier: 3

fn gradient_norm_eval(norm: float, threshold: float) -> trit {
    if norm > (threshold * 10.0) { return -1; } // Massive explosion
    if norm > threshold { return 0; }  // Needs clipping
    return 1; // Healthy range
}

fn clipping_frequency_check(freq: int) -> trit {
    if freq > 100 { return -1; } // Model persistently unstable
    if freq > 10 { return 0; }
    return 1;
}

fn main() -> trit {
    let norm: float = 5.0;
    let thresh: float = 1.0;
    let freq: int = 5;
    
    let n_trit: trit = gradient_norm_eval(norm, thresh);
    let f_trit: trit = clipping_frequency_check(freq);
    
    match n_trit {
        -1 => { return -1; }
        0  => { return 0;  } // Suggest clipping (Tend)
        1  => { return f_trit; }
    }
}
