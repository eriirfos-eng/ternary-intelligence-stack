// stdlib/models/model_pruning_threshold_gate.tern
// Demonstrates: Deciding which model weights to prune
// Tier: 3

fn weight_magnitude_eval(val: float, threshold: float) -> trit {
    if val < (threshold * 0.1) { return 1; } // Prune (Affirm removal)
    if val > threshold { return -1; } // Keep (Reject removal)
    return 0; // Marginal
}

fn layer_sensitivity_check(impact: float) -> trit {
    if impact > 0.5 { return -1; } // Critical layer, do not prune
    if impact < 0.01 { return 1; } // Safe to prune
    return 0;
}

fn main() -> trit {
    let w: float = 0.005;
    let t: float = 0.1;
    let i: float = 0.05;
    
    let mag: trit = weight_magnitude_eval(w, t);
    let sens: trit = layer_sensitivity_check(i);
    
    match sens {
        -1 => { return -1; } // Layer is too sensitive
        1  => { return mag; } // Safe layer, follow magnitude
        0  => {
            match mag {
                1  => { return 0; } // Tend: prune with caution
                0  => { return -1; } // Keep
                -1 => { return -1; } // Keep
            }
        }
    }
}
