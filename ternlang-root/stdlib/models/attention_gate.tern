// stdlib/models/attention_gate.tern
// Demonstrates: Ternary attention mechanism gate
// Tier: 2 — Pro Standard

fn compute_attention(q: int, k: int, threshold: int) -> trit {
    let score: int = q * k;
    if score > threshold {
        return truth();    // Strong attention
    }
    if score > 0 {
        return hold();     // Weak attention, possibly relevant
    }
    return conflict();     // Zero or negative attention
}

fn main() -> trit {
    let query: int = 10;
    let key: int = 8;
    let limit: int = 50;
    
    let ok: trit = compute_attention(query, key, limit);
    
    match ok {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
