// Module:  stdlib/research/magnetic_filter.schema.tern
// Purpose: T-SON serialization schema for magnetic_filter
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Magnetic_filterSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Magnetic_filterSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
