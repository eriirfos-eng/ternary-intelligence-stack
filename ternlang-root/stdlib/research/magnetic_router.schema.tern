// Module:  stdlib/research/magnetic_router.schema.tern
// Purpose: T-SON serialization schema for magnetic_router
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Magnetic_routerSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Magnetic_routerSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
