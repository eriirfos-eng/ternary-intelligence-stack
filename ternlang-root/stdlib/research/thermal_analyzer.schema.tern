// Module:  stdlib/research/thermal_analyzer.schema.tern
// Purpose: T-SON serialization schema for thermal_analyzer
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Thermal_analyzerSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Thermal_analyzerSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
