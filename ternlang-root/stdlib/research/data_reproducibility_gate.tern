// stdlib/research/data_reproducibility_gate.tern
// Demonstrates: Data reproducibility check
// Tier: 3

fn check_reproducibility(original_result: trit, replication_result: trit) -> trit {
    // If they agree, the result is reproducible
    if original_result == replication_result {
        return 1;
    }
    
    // If original said Truth but replication says Conflict, fail
    if original_result == 1 {
        if replication_result == -1 {
            return -1;
        }
    }
    
    // Otherwise, reproducibility is in question (Hold)
    return 0;
}

fn main() -> trit {
    let orig: trit = 1;
    let repl: trit = 0;
    
    let state: trit = check_reproducibility(orig, repl);
    
    match state {
        1  => { return truth();    }
        0  => { return hold();     }
        -1 => { return conflict(); }
    }
}
