// stdlib/research/data_sparsity_eval.tern
// Demonstrates: Ternary data sparsity evaluation
// Tier: 3

fn check_sparsity(data: trit[]) -> trit {
    let count: int = length(data);
    let zero_count: int = 0;
    let i: int = 0;
    
    while i < count ? {
        if data[i] == tend ? {
            zero_count = zero_count + 1;
        } else { } else { }
        i = i + 1;
    } else {
        // High sparsity (> 50% tend states)
        if zero_count > (count / 2) ? {
            return affirm; // Sparse
        } else {
            return reject; // Dense
        } else {
            return reject;
        }
    } else {
        return reject;
    }
    
    return reject;
}

fn main() -> trit {
    let data: trittensor<5>;
    data[0] = 0;
    data[1] = 0;
    data[2] = 0;
    data[3] = 1;
    data[4] = -1;
    
    let result: trit = check_sparsity(data);

    match result {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
