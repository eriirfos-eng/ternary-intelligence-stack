// Module:  stdlib/research/optical_optimizer.schema.tern
// Purpose: T-SON serialization schema for optical_optimizer
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Optical_optimizerSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Optical_optimizerSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
