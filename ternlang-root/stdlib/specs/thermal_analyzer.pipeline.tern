// Module:  stdlib/specs/thermal_analyzer.pipeline.tern
// Purpose: Data pipeline stream for thermal_analyzer
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

agent Thermal_analyzerPipeline {
    fn process_stream(data_trit: trit) -> trit {
        match data_trit {
            affirm => return affirm;
            reject => return reject;
            tend => return tend; // Explicit fallback
        }
    }
}
