// Module:  stdlib/specs/kinetic_system.schema.tern
// Purpose: T-SON serialization schema for kinetic_system
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Kinetic_systemSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Kinetic_systemSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
