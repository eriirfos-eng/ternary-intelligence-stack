// Module:  stdlib/specs/fluidic_matrix.schema.tern
// Purpose: T-SON serialization schema for fluidic_matrix
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Fluidic_matrixSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Fluidic_matrixSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
