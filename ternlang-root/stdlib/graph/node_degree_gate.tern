// stdlib/graph/node_degree_gate.tern
// Demonstrates: calculating the degree of a node in a 2D adjacency matrix
// Tier: 3 — Industrial

fn get_degree(adj: trittensor<4 x 4>, node: int) -> int {
    let deg: int = 0;
    let j: int = 0;
    while j < 4 {
        if adj[node, j] == 1 {
            deg = deg + 1;
        }
        j = j + 1;
    }
    return deg;
}

fn main() -> trit {
    let t: trittensor<4 x 4>;
    t[0, 1] = 1;
    t[0, 2] = 1;
    t[0, 3] = 0;
    
    let d: int = get_degree(t, 0);
    if d >= 2 {
        return truth();
    }
    return conflict();
}
