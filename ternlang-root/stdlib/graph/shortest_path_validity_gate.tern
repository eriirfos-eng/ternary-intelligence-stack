// proprietary/graph/shortest_path_validity_gate.tern
// Demonstrates: A gate for validating proposed shortest path distances.
// Tier: 2

fn validate_distance(u: int, v: int, dist: float, matrix: trit[], size: int) -> trit {
    // If nodes are the same, distance must be 0
    if u == v {
        if dist == 0.0 { return affirm; }
        return reject;
    }

    // Direct edge case
    let idx: int = u * size + v;
    if matrix[idx] == 1 {
        // If there's an edge, the shortest path must be <= 1.0 (assuming unit weights)
        if dist <= 1.0 { return affirm; }
        return reject;
    }

    // No direct edge, distance must be > 1.0
    if dist < 1.0 {
        return reject;
    }
    
    return tend;
}

fn main() -> trit {
    let size: int = 4;
    let m: trittensor<16>;
    
    m[1] = 1; // 0-1
    
    let result: trit = validate_distance(0, 1, 0.5, m, size);

    match result {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
