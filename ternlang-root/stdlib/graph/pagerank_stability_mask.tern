// proprietary/graph/pagerank_stability_mask.tern
// Demonstrates: A mask for detecting convergence stability in PageRank iterations.
// Tier: 2

fn is_stable(ranks: float, prev_ranks: float, threshold: float) -> trit {
    let diff: float = ranks - prev_ranks;
    if diff < 0.0 { diff = diff * -1.0; }

    if diff < threshold {
        return affirm; // Stable
    }
    
    // If it's improving but still above threshold, hold
    if diff < (threshold * 5.0) {
        return tend;
    }
    
    return reject; // Unstable/Divergent
}

fn main() -> trit {
    let r1: float = 0.2505;
    let r0: float = 0.2500;
    let tol: float = 0.001;

    let stable: trit = is_stable(r1, r0, tol);

    match stable {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
