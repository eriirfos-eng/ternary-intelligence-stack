// stdlib/graph/path_validity_consensus.tern
// Demonstrates: checking if a sequential path through nodes is valid
// Tier: 3 — Industrial

fn check_path(adj: trittensor<4 x 4>, n1: int, n2: int, n3: int) -> trit {
    let e1: trit = adj[n1, n2];
    let e2: trit = adj[n2, n3];
    return e1 && e2; // both must be truth()
}

fn main() -> trit {
    let t: trittensor<4 x 4>;
    t[0, 1] = 1;
    t[1, 2] = 1;
    
    let ok: trit = check_path(t, 0, 1, 2);
    match ok {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
