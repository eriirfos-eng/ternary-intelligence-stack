// proprietary/graph/adjacency_consensus_gate.tern
// Demonstrates: A consensus gate for adjacency matrix validation.
// Tier: 2

from "graph_utils.tern" import is_connected;

fn validate_symmetry(size: int, matrix: trit[]) -> trit {
    let i: int = 0;
    while i < size {
        let j: int = 0;
        while j < size {
            let direct: trit = is_connected(i, j, size, matrix);
            let reverse: trit = is_connected(j, i, size, matrix);
            
            if direct != reverse {
                return reject; // Non-symmetric adjacency
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return affirm;
}

fn main() -> trit {
    let size: int = 4;
    let m: trittensor<16>; // 4x4
    
    // Set some symmetric edges
    m[1] = 1; // (0,1)
    m[4] = 1; // (1,0)
    m[6] = 1; // (1,2)
    m[9] = 1; // (2,1)

    let valid: trit = validate_symmetry(size, m);

    match valid {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
