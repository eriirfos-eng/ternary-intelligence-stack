// stdlib/graph/cluster_assignment_mask.tern
// Demonstrates: masking nodes based on their cluster ID
// Tier: 3 — Industrial

fn filter_cluster(cluster_ids: trittensor<4>, target: int) -> trittensor<4> {
    let mask: trittensor<4>;
    let i: int = 0;
    while i < 4 {
        if cluster_ids[i] == target {
            mask[i] = 1;
        } else {
            mask[i] = -1;
        }
        i = i + 1;
    }
    return mask;
}

fn main() -> trit {
    let ids: trittensor<4>;
    ids[0] = 1;
    ids[1] = 1;
    ids[2] = 0;
    ids[3] = -1;
    
    let m: trittensor<4> = filter_cluster(ids, 1);
    match m[0] {
        1  => { return truth(); }
        0  => { return hold();  }
        -1 => { return conflict(); }
    }
}
