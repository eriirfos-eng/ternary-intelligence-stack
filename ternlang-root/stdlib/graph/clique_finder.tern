// stdlib/graph/clique_finder.tern
// Demonstrates: Ternary logic for clique_finder
// Tier: 2

fn clique_finder_process(a: trit, b: trit) -> trit {
    let state: trit = consensus(a, b);
    match state {
        -1 => { return conflict(); }
         0 => { return hold(); }
         1 => { return truth(); }
    }
}

fn main() -> trit {
    let val1: trit = 1;
    let val2: trit = 0;
    let res: trit = clique_finder_process(val1, val2);
    return truth();
}
