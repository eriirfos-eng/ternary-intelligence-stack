// stdlib/graph/graph_sparsity_eval.tern
// Demonstrates: evaluating graph density/sparsity
// Tier: 3 — Industrial

fn calculate_density(adj: trittensor<4 x 4>) -> float {
    let edges: int = 0;
    let i: int = 0;
    while i < 4 {
        let j: int = 0;
        while j < 4 {
            if adj[i, j] == 1 {
                edges = edges + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    // Total possible edges = 4*4 = 16
    return edges / 16.0;
}

fn main() -> trit {
    let t: trittensor<4 x 4>;
    t[0, 1] = 1;
    t[1, 2] = 1;
    t[2, 3] = 1;
    t[3, 0] = 1;
    
    let density: float = calculate_density(t);
    if density > 0.2 { return truth(); }
    return hold();
}
