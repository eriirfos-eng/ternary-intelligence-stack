// proprietary/graph/community_structure_consensus.tern
// Demonstrates: A consensus check between two community detection models.
// Tier: 2

fn check_consensus(u: int, v: int, model_a: trit[], model_b: trit[]) -> trit {
    // model[i] is the community ID (-1, 0, 1)
    let community_u_a: trit = model_a[u];
    let community_v_a: trit = model_a[v];
    let community_u_b: trit = model_b[u];
    let community_v_b: trit = model_b[v];

    // Does Model A say they are in the same community?
    let same_a: bool = (community_u_a == community_v_a);
    // Does Model B say they are in the same community?
    let same_b: bool = (community_u_b == community_v_b);

    if same_a == same_b {
        return affirm; // Consensus reached (either both same or both different)
    }
    
    // If one is unsure (tend), the whole thing is unsure
    if community_u_a == 0 { return tend; }
    if community_v_a == 0 { return tend; }
    if community_u_b == 0 { return tend; }
    if community_v_b == 0 { return tend; }

    return reject; // Conflict
}

fn main() -> trit {
    let a: trittensor<4>;
    let b: trittensor<4>;
    
    // Model A: {0, 1}, {2, 3}
    a[0] = 1; a[1] = 1; a[2] = -1; a[3] = -1;
    
    // Model B: {0, 2}, {1, 3} (Different structure)
    b[0] = 1; b[2] = 1; b[1] = -1; b[3] = -1;

    let result: trit = check_consensus(0, 1, a, b);

    match result {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
