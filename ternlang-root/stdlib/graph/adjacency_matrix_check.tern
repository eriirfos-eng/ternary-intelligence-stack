// stdlib/graph/adjacency_matrix_check.tern
// Demonstrates: checking connectivity between nodes in a 2D adjacency matrix
// Tier: 3 — Industrial

fn is_connected(adj: trittensor<4 x 4>, i: int, j: int) -> trit {
    let edge: trit = adj[i, j];
    return edge;
}

fn main() -> trit {
    let t: trittensor<4 x 4>;
    // Initialized to 0 (hold) by default
    t[0, 1] = 1;
    t[1, 0] = 1;
    t[2, 3] = -1; // Conflict / Blocked path
    
    let res: trit = is_connected(t, 0, 1);
    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
