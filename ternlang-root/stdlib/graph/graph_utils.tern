// proprietary/graph/graph_utils.tern
// Demonstrates: Common graph utility functions for ternary graph processing.
// Tier: 2

fn is_connected(n1: int, n2: int, size: int, adj_matrix: trit[]) -> trit {
    let idx: int = n1 * size + n2;
    let val: trit = adj_matrix[idx];
    return val;
}

fn edge_count(adj_matrix: trit[], size: int) -> int {
    let count: int = 0;
    let i: int = 0;
    while i < (size * size) {
        if adj_matrix[i] == 1 {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}
