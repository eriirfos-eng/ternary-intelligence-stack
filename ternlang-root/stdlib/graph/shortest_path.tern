// stdlib/graph/shortest_path.tern
// Demonstrates: Ternary logic for shortest_path
// Tier: 2

fn shortest_path_process(a: trit, b: trit) -> trit {
    let state: trit = consensus(a, b);
    match state {
        -1 => { return conflict(); }
         0 => { return hold(); }
         1 => { return truth(); }
    }
}

fn main() -> trit {
    let val1: trit = 1;
    let val2: trit = 0;
    let res: trit = shortest_path_process(val1, val2);
    return truth();
}
