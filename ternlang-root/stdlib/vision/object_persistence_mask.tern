// stdlib/vision/object_persistence_mask.tern
// Demonstrates: Temporal persistence mask for object tracking
// Tier: 3

from "vision_utils.tern" import *;

fn persistence_check(detected_now: trit, detected_prev: trit) -> trit {
    // Logic: if detected in both frames, affirm. If only one, tend.
    let state: trit = consensus(detected_now, detected_prev);
    return state;
}

fn main() -> trit {
    let now: trit = 1;
    let prev: trit = 1;
    
    let res: trit = persistence_check(now, prev);
    
    match res {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
