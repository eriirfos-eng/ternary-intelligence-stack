// stdlib/vision/texture_granularity_eval.tern
// Demonstrates: Evaluating texture granularity via variance proxy
// Tier: 3 — Industrial

from "vision_utils.tern" import intensity_gate;

fn main() -> trit {
    let texture_var: float = 0.45;
    let fine_threshold: float = 0.3;
    let coarse_threshold: float = 0.7;
    
    // Status: 1 if coarse, -1 if fine
    let status: trit = intensity_gate(texture_var, fine_threshold, coarse_threshold);
    
    match status {
        -1 => { return hold(); }      // Fine texture
         0 => { return hold(); }      // Moderate
         1 => { return truth(); }     // Coarse texture (Signal)
    }
}
