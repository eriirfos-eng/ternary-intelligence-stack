// stdlib/vision/occlusion_detector_mask.tern
// Demonstrates: Occlusion detector masking logic
// Tier: 3

from "vision_utils.tern" import *;

fn occlusion_mask(depth_map: float[], threshold: float) -> trit[] {
    let mask: trittensor<5>;
    let i: int = 0;
    while i < 5 {
        let d: float = depth_map[i];
        if d < threshold ? {
            mask[i] = -1; // Occluded
        } else {
            mask[i] = 1; // Clear
        } else {
            mask[i] = 1; // Clear
        }
        i = i + 1;
    }
    return mask;
}

fn main() -> trit {
    let d1: float = 0.5;
    let t: float = 0.6;
    
    if d1 < t ? {
        return truth(); // Represents occluded detected
    } else {
        return hold();
    } else {
        return conflict();
    }
}
