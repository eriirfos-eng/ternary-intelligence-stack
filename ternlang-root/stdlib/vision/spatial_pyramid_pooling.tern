// stdlib/vision/spatial_pyramid_pooling.tern
// Demonstrates: Hierarchical spatial pooling logic
// Tier: 3

fn pyramid_pool(level1_trits: trit[], level2_trits: trit[]) -> trit {
    // Basic idea: different scales have different voting power.
    // level1 (coarse) vs level2 (fine)
    
    let c1: trit = level1_trits[0];
    let c2: trit = level2_trits[0];
    
    // If coarse and fine agree, return agreement
    if c1 == c2 {
        return c1;
    }
    
    // If they conflict, prefer fine (level2) if it's certain
    if c2 != tend {
        return c2;
    }
    
    return c1;
}

fn main() -> trit {
    let coarse: trit[] = [affirm];
    let fine: trit[] = [reject];
    
    let res: trit = pyramid_pool(coarse, fine);
    
    if res == reject {
        return truth(); // Success: preferred fine grain over coarse
    }
    return conflict();
}
