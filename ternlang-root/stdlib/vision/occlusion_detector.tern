// stdlib/vision/occlusion_detector.tern
// Demonstrates: Estimate occlusion state between two objects based on depth
// Tier: 3

fn detect_occlusion(z_front: float, z_back: float, margin: float) -> trit {
    let diff: float = z_back - z_front;
    
    if diff > margin {
        return affirm; // clear separation, occlusion likely
    }
    
    if diff < -margin {
        return reject; // front object is actually behind back object
    }
    
    return tend; // potential intersection or thin overlap
}

fn main() -> trit {
    let state: trit = detect_occlusion(10.0, 15.0, 2.0);
    match state {
        reject => { return conflict(); }
        tend   => { return hold();    }
        affirm => { return truth();   }
    }
}
