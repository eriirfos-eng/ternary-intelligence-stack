// stdlib/vision/brightness_gate.tern
// Demonstrates: Adaptive brightness classification
// Tier: 3

fn classify_brightness(avg: int) -> trit {
    if avg > 200 {
        return affirm; // bright
    }
    if avg < 50 {
        return reject; // dark
    }
    return tend; // neutral
}

fn main() -> trit {
    let b: trit = classify_brightness(220);
    match b {
        reject => { return conflict(); }
        tend   => { return hold();    }
        affirm => { return truth();   }
    }
}
