// stdlib/vision/bounding_box_overlap.tern
// Demonstrates: Detection of overlap between two 1D segments (bounding box projection)
// Tier: 3

fn check_overlap(min_a: int, max_a: int, min_b: int, max_b: int) -> trit {
    // Standard AABB overlap logic
    if max_a < min_b || max_b < min_a {
        return reject; // No overlap
    }
    
    if min_a == min_b && max_a == max_b {
        return affirm; // Perfect match
    }
    
    return tend; // Partial overlap
}

fn main() -> trit {
    let result: trit = check_overlap(10, 50, 40, 80);
    match result {
        reject => { return conflict(); }
        tend   => { return hold();    }
        affirm => { return truth();   }
    }
}
