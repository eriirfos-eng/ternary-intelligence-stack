// stdlib/vision/depth_mask_consensus.tern
// Demonstrates: Depth map consensus gating
// Tier: 3

fn depth_consensus(d1: float, d2: float, threshold: float) -> trit {
    // If two depth sensors agree within threshold, affirm depth
    let diff: float = d1 - d2;
    if diff < 0.0 { diff = 0.0 - diff; }
    
    if diff < threshold {
        return affirm;
    }
    return tend;
}

fn main() -> trit {
    let d_sensor1: float = 1.5;
    let d_sensor2: float = 1.55;
    let result: trit = depth_consensus(d_sensor1, d_sensor2, 0.1);
    
    if result == affirm {
        return truth();
    }
    return hold();
}
