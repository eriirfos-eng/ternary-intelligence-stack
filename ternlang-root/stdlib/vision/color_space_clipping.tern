// stdlib/vision/color_space_clipping.tern
// Demonstrates: Clipping color values to valid ternary ranges
// Tier: 3 — Industrial

from "vision_utils.tern" import intensity_gate;

fn main() -> trit {
    let r_channel: float = 1.2;
    let valid_hi: float = 1.0;
    
    // Status: 1 if out of range high
    let status: trit = intensity_gate(r_channel, -1.0, valid_hi);
    
    match status {
        -1 => { return conflict(); }  // Underflow
         0 => { return truth(); }     // Valid
         1 => { return conflict(); }  // Overflow
    }
}
