// Module:  stdlib/network/optical_system.schema.tern
// Purpose: T-SON serialization schema for optical_system
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Optical_systemSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Optical_systemSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
