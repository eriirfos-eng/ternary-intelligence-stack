// Module:  stdlib/network/acoustic_solver.schema.tern
// Purpose: T-SON serialization schema for acoustic_solver
// Author:  RFI-IRFOS
// Ref:     https://ternlang.com

struct Acoustic_solverSchema {
    id: int,
    confidence: trit,
    weight: float
}

fn validate_schema(data: Acoustic_solverSchema) -> trit {
    if data.weight > 0.0 { return affirm; }
    if data.weight < 0.0 { return reject; }
    return tend;
}
