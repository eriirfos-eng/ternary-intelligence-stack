fn main() -> trit {
    let arr: int[4] = 0;
    arr[0] = 5;
    arr[1] = 5;
    arr[2] = 2;
    arr[3] = 5;
    let target: int = 5;
    let count: int = 0;
    let i: int = 0;
    while i < 4 {
        if arr[i] == target {
            count = count + 1;
        }
        i = i + 1;
    }
    if count == 3 {
        return 1;
    }
    return -1;
}
