// stdlib/std/stats_trit.tern
// Demonstrates: Basic statistical operations on trit tensors.
// Tier: 1 - Open Core

fn count_occurrences(data: trittensor<10>, val: trit) -> int {
    let count: int = 0;
    let i: int = 0;
    while i < 10 {
        if data[i] == val {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

fn majority_trit(data: trittensor<10>) -> trit {
    let c_pos: int = count_occurrences(data, 1);
    let c_zero: int = count_occurrences(data, 0);
    let c_neg: int = count_occurrences(data, -1);
    
    if c_pos > c_zero {
        if c_pos > c_neg { return 1; }
    }
    if c_neg > c_zero {
        if c_neg > c_pos { return -1; }
    }
    return 0;
}

fn main() -> trit {
    let data: trittensor<10> = [1, 1, 1, 0, 0, -1, -1, 1, 0, 1];
    
    println("Trit Statistics (10 elements):");
    println("Data: 1, 1, 1, 0, 0, -1, -1, 1, 0, 1");
    
    let pos: int = count_occurrences(data, 1);
    let zero: int = count_occurrences(data, 0);
    let neg: int = count_occurrences(data, -1);
    
    println("Affirm (+1) count:");
    println(pos);
    println("Tend (0) count:");
    println(zero);
    println("Reject (-1) count:");
    println(neg);
    
    let maj: trit = majority_trit(data);
    print("Majority trit: ");
    match maj {
        1 => { println("Affirm (+1)"); }
        0 => { println("Tend (0)"); }
       -1 => { println("Reject (-1)"); }
    }
    
    if pos == 5 {
        if maj == 1 {
            println("Stats verified. Success.");
            return truth();
        }
    }
    
    println("Stats failed.");
    return conflict();
}
