// stdlib/std/complex.tern
// Demonstrates: Complex number arithmetic emulation using float tensors.
// Tier: 1 - Open Core

fn complex_add(a: float[2], b: float[2], res: float[2]) -> trit {
    res[0] = a[0] + b[0];
    res[1] = a[1] + b[1];
    return truth();
}

fn complex_mul(a: float[2], b: float[2], res: float[2]) -> trit {
    // (a + bi)(c + di) = (ac - bd) + (ad + bc)i
    let ac: float = a[0] * b[0];
    let bd: float = a[1] * b[1];
    let ad: float = a[0] * b[1];
    let bc: float = a[1] * b[0];
    res[0] = ac - bd;
    res[1] = ad + bc;
    return truth();
}

fn main() -> trit {
    let a: float[2];
    a[0] = 1.0;
    a[1] = 2.0; // 1 + 2i
    
    let b: float[2];
    b[0] = 3.0;
    b[1] = 4.0; // 3 + 4i
    
    let res: float[2];
    res[0] = 0.0;
    res[1] = 0.0;

    println("Complex Add (1+2i) + (3+4i):");
    complex_add(a, b, res);
    println("Real:");
    println(res[0]);
    println("Imag:");
    println(res[1]);

    if res[0] == 4.0 {
        println("Real part 4.0 OK.");
    } else {
        println("Expected 4.0");
        return conflict();
    }

    println("Complex Mul (1+2i) * (3+4i):");
    // (1*3 - 2*4) + (1*4 + 2*3)i = (3 - 8) + (4 + 6)i = -5 + 10i
    complex_mul(a, b, res);
    println("Real:");
    println(res[0]);
    println("Imag:");
    println(res[1]);

    if res[0] == -5.0 {
        println("Real part -5.0 OK.");
    } else {
        println("Expected -5.0");
        return conflict();
    }
    
    if res[1] == 10.0 {
        println("Imag part 10.0 OK.");
    } else {
        println("Expected 10.0");
        return conflict();
    }

    println("Complex operations verified.");
    return truth();
}
