fn main() -> trit {
    let arr: int[2] = 0;
    arr[0] = 4;
    arr[1] = 9;
    let i: int = 0;
    while i < 2 {
        let f: float = cast<float>(arr[i]);
        let s: float = sqrt(f);
        arr[i] = cast<int>(s);
        i = i + 1;
    }
    if arr[0] == 2 && arr[1] == 3 { return 1; }
    return -1;
}
