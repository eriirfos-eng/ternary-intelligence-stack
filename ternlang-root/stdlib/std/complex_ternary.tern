/*
 * Complex Number Library for Ternlang — Basic arithmetic for complex numbers.
 * Represented as float[2]: [0]=real, [1]=imaginary.
 * 
 * RFI-IRFOS · PUBLIC repo · v1.0
 */

fn complex_add(a: float[2], b: float[2], res: float[2]) -> trit {
    res[0] = a[0] + b[0];
    res[1] = a[1] + b[1];
    return 1;
}

fn complex_sub(a: float[2], b: float[2], res: float[2]) -> trit {
    res[0] = a[0] - b[0];
    res[1] = a[1] - b[1];
    return 1;
}

fn complex_mul(a: float[2], b: float[2], res: float[2]) -> trit {
    // (a + bi)(c + di) = (ac - bd) + (ad + bc)i
    let ac: float = a[0] * b[0];
    let bd: float = a[1] * b[1];
    let ad: float = a[0] * b[1];
    let bc: float = a[1] * b[0];
    
    res[0] = ac - bd;
    res[1] = ad + bc;
    return 1;
}

fn main() -> trit {
    let a: float[2]; a[0] = 1.0; a[1] = 2.0; // 1 + 2i
    let b: float[2]; b[0] = 3.0; b[1] = 4.0; // 3 + 4i
    let res: float[2]; res[0] = 0.0; res[1] = 0.0;
    
    println("Adding (1+2i) + (3+4i):");
    let dummy: trit = complex_add(a, b, res);
    println(res[0]); // 4.0
    println(res[1]); // 6.0
    
    if res[0] == 4.0 && res[1] == 6.0 {
        println("Complex Addition: PASSED");
    } else {
        return -1;
    }
    
    println("Multiplying (1+2i) * (3+4i):");
    // (1*3 - 2*4) + (1*4 + 2*3)i = (3 - 8) + (4 + 6)i = -5 + 10i
    dummy = complex_mul(a, b, res);
    println(res[0]); // -5.0
    println(res[1]); // 10.0
    
    if res[0] == -5.0 && res[1] == 10.0 {
        println("Complex Multiplication: PASSED");
        return 1;
    }
    
    return -1;
}
