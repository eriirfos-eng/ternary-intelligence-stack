// stdlib/kernel/syscall_gate.tern
// Demonstrates: privilege checking for system calls
// Tier: 2

fn check_syscall(syscall_id: int, privilege_level: trit) -> trit {
    // Syscall 0: Print (Public)
    // Syscall 1: Write (Admin)
    // Syscall 2: Halt (System)
    
    if syscall_id == 0 {
        return 1;
    }
    
    if syscall_id == 1 {
        if privilege_level == 1 { return 1; }
        return -1;
    }
    
    if syscall_id == 2 {
        if privilege_level == 1 { return 1; }
        return -1;
    }
    
    return -1;
}

fn main() -> trit {
    let admin: trit = 1;
    let user: trit = 0;
    
    let ok_admin: trit = check_syscall(1, admin);
    let ok_user: trit = check_syscall(1, user);
    
    if ok_admin == 1 {
        if ok_user == -1 {
            return 1;
        }
    }
    return -1;
}
