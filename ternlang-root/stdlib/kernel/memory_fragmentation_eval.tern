// stdlib/kernel/memory_fragmentation_eval.tern
// Demonstrates: Memory fragmentation evaluation
// Tier: 3 — Industrial

fn eval_fragmentation(free_blocks: int, largest_block: int) -> trit {
    // If largest block is too small relative to total free, fragmented
    if largest_block < (free_blocks / 4) {
        return affirm; // High fragmentation
    }
    if largest_block < (free_blocks / 2) {
        return tend; // Moderate
    }
    return reject; // Healthy
}

fn main() -> trit {
    // Free: 1024, Largest: 128
    let status: trit = eval_fragmentation(1024, 128);
    
    // Status should be affirm (128 < 256)
    match status {
        affirm => { 
            // Trigger defragmentation
            return conflict(); 
        }
        tend => { 
            // Warn
            return hold(); 
        }
        reject => { 
            // Healthy
            return truth(); 
        }
    }
}
