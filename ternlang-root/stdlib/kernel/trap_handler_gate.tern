// stdlib/kernel/trap_handler_gate.tern
// Demonstrates: gating logic for kernel trap handlers
// Tier: 3 — Industrial

fn handle_trap(trap_id: int, is_privileged: trit) -> trit {
    if trap_id == 0 { return truth(); } // DivByZero handled
    if is_privileged == 1 { return truth(); }
    return conflict();
}

fn main() -> trit {
    let id: int = 14; // Page Fault
    let priv: trit = 0;
    
    let res: trit = handle_trap(id, priv);
    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
