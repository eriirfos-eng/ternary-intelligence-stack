// stdlib/kernel/priority_preemption_mask.tern
// Demonstrates: determining if a process can be preempted based on priority
// Tier: 3 — Industrial

fn can_preempt(cur: int, next: int) -> trit {
    if next > cur { return truth(); }
    if next == cur { return hold(); }
    return conflict();
}

fn main() -> trit {
    let current_p: int = 5;
    let next_p: int = 7;
    
    let res: trit = can_preempt(current_p, next_p);
    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
