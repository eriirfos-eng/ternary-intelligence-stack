// stdlib/kernel/signal_delivery_gate.tern
// Demonstrates: Process signal delivery control and filtering.
// Tier: 4 — Enterprise

fn should_deliver_signal(sig_num: int, is_root: trit, process_state: int) -> trit {
    if sig_num == 9 {
        return truth(); // SIGKILL always delivered
    }

    if is_root == 1 {
        return truth(); // Root signals bypass filters
    }

    if process_state == -1 {
        return conflict(); // Process is zombie or dying, drop signal
    }

    if process_state == 0 {
        return hold(); // Process is suspended, queue signal
    }

    return truth(); // Deliver to active process
}

fn main() -> trit {
    let s: int = 15;
    let r: trit = reject;
    let state: int = 0;

    let res: trit = should_deliver_signal(s, r, state);

    match res {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
