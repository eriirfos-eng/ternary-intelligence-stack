// stdlib/kernel/thread_context_switch_check.tern
// Demonstrates: Context switch necessity check based on time slice and priority.
// Tier: 4 — Enterprise

fn should_switch(consumed_ms: int, time_slice: int, higher_prio_waiting: trit) -> trit {
    if higher_prio_waiting == 1 {
        return truth(); // Preempt for higher priority
    }

    if consumed_ms >= time_slice {
        return truth(); // Time slice exhausted
    }

    if consumed_ms >= time_slice / 2 {
        return hold(); // Halfway there, check again soon
    }

    return conflict(); // Continue current thread
}

fn main() -> trit {
    let ms: int = 50;
    let slice: int = 100;
    let waiting: trit = reject;

    let res: trit = should_switch(ms, slice, waiting);

    match res {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
