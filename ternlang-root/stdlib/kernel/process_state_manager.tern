// stdlib/kernel/process_state_manager.tern
// Demonstrates: process state transitions
// Tier: 2

// States:
// 1 = Running
// 0 = Waiting/Ready
// -1 = Blocked/Zombie

fn transition(current: trit, signal: trit) -> trit {
    match current {
        1 => {
            // If running and signal is "pause" (0) -> Ready
            // If running and signal is "yield" (0) -> Ready
            // If running and signal is "block" (-1) -> Blocked
            if signal == 0 { return 0; }
            if signal == -1 { return -1; }
            return 1;
        }
        0 => {
            // If ready and signal is "scheduled" (1) -> Running
            // If ready and signal is "terminate" (-1) -> Blocked
            if signal == 1 { return 1; }
            if signal == -1 { return -1; }
            return 0;
        }
        -1 => {
            // If blocked and signal is "unblock" (0) -> Ready
            if signal == 0 { return 0; }
            return -1;
        }
    }
}

fn main() -> trit {
    let s: trit = 0; // Ready
    let next: trit = transition(s, 1); // Run
    
    if next == 1 {
        let next2: trit = transition(next, -1); // Block
        if next2 == -1 {
            return 1;
        }
    }
    return -1;
}
