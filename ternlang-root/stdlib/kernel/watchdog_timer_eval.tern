// stdlib/kernel/watchdog_timer_eval.tern
// Demonstrates: Watchdog timer monitoring and recovery action.
// Tier: 4 — Enterprise

fn watchdog_action(last_ping_ms: int, current_time: int, threshold_ms: int) -> trit {
    let elapsed: int = current_time - last_ping_ms;

    if elapsed >= threshold_ms {
        return conflict(); // System hung, trigger reboot
    }

    if elapsed >= threshold_ms / 2 {
        return hold(); // Warning: nearing threshold
    }

    return truth(); // System healthy, reset timer
}

fn main() -> trit {
    let last: int = 2000;
    let now: int = 4500;
    let limit: int = 5000;

    let res: trit = watchdog_action(last, now, limit);

    match res {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
