// stdlib/kernel/io_request_scheduler.tern
// Demonstrates: IO request prioritization based on process priority and deadline.
// Tier: 4 — Enterprise

fn prioritize_io(prio: int, deadline: int, current_time: int) -> trit {
    if current_time >= deadline {
        return truth(); // Critical priority, overdue
    }

    if prio > 10 {
        return truth(); // High priority process
    }

    if prio < 2 {
        return conflict(); // Low priority, background task
    }

    return hold(); // Standard priority
}

fn main() -> trit {
    let p: int = 12;
    let d: int = 5000;
    let now: int = 4000;

    let priority: trit = prioritize_io(p, d, now);

    match priority {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
