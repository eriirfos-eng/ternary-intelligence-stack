// stdlib/kernel/syscall_validator_mask.tern
// Demonstrates: Syscall parameter validation
// Tier: 3 — Industrial

fn validate_syscall(syscall_num: int, address: float) -> trit {
    // Valid syscalls: 0-64
    if syscall_num < 0 { return reject; }
    if syscall_num > 64 { return reject; }
    
    // Valid address range: 0.0 to 1000000.0
    if address < 0.0 { return reject; }
    if address > 1000000.0 { return reject; }
    
    // Warning for privileged syscalls (e.g. 0-10)
    if syscall_num < 10 { return tend; }
    
    return affirm;
}

fn main() -> trit {
    // Syscall 5 (privileged), Address 50000.0
    let status: trit = validate_syscall(5, 50000.0);
    
    // Status should be tend
    match status {
        affirm => { 
            // Allow
            return truth(); 
        }
        tend => { 
            // Allow with audit
            return hold(); 
        }
        reject => { 
            // Deny
            return conflict(); 
        }
    }
}
