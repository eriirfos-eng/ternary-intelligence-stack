// stdlib/kernel/scheduler_tick_quantum.tern
// Demonstrates: quantum expiration check
// Tier: 2

fn is_expired(elapsed: int, quantum: int) -> trit {
    if elapsed >= quantum {
        return 1;
    } else {
        if elapsed > (quantum / 2) {
            return 0; // Half-way
        } else {
            return -1; // Fresh
        }
    }
}

fn main() -> trit {
    let q: int = 100;
    
    let s1: trit = is_expired(110, q); // Expired
    let s2: trit = is_expired(10, q);  // Fresh
    
    if s1 == 1 {
        if s2 == -1 {
            return 1;
        }
    }
    return -1;
}
