// stdlib/kernel/buffer_overflow_gate.tern
// Demonstrates: Buffer overflow prevention logic
// Tier: 3 — Industrial

fn check_buffer_limit(input_len: int, buffer_capacity: int) -> trit {
    if input_len > buffer_capacity {
        return affirm; // Overflow!
    }
    // Warning at 90% capacity
    let threshold: int = buffer_capacity - 16; // 16-byte safety margin
    if input_len > threshold {
        return tend; // Warning
    }
    return reject; // Safe
}

fn main() -> trit {
    // Input: 1020, Capacity: 1024
    let status: trit = check_buffer_limit(1020, 1024);
    
    // Status should be tend (Warning)
    match status {
        affirm => { 
            // Abort operation
            return conflict(); 
        }
        tend => { 
            // Clamp or truncate
            return hold(); 
        }
        reject => { 
            // Normal operation
            return truth(); 
        }
    }
}
