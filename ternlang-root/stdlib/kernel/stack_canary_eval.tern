// stdlib/kernel/stack_canary_eval.tern
// Demonstrates: Stack canary integrity verification
// Tier: 3 — Industrial

fn verify_canary(expected: float, actual: float) -> trit {
    if expected == actual {
        return affirm; // Intact
    }
    // Minor drift (e.g. noise) - should not happen for canaries but mock it
    let diff: float = expected - actual;
    if diff < 0.001 {
        if diff > (0.0 - 0.001) {
            return tend; 
        }
    }
    return reject; // Corrupted
}

fn main() -> trit {
    // Expected: 1234.56, Actual: 1234.56
    let status: trit = verify_canary(1234.56, 1234.56);
    
    // Status should be affirm
    match status {
        affirm => { 
            // Stack safe
            return truth(); 
        }
        tend => { 
            // Warning: minor drift
            return hold(); 
        }
        reject => { 
            // Stack corruption! Panic
            return conflict(); 
        }
    }
}
