// stdlib/kernel/kernel_utils.tern
// Demonstrates: Low-level kernel management utilities
// Tier: 3 — Industrial

// Aggregates consensus across three hardware/driver signals
fn kernel_consensus(s1: trit, s2: trit, s3: trit) -> trit {
    let c12: trit = consensus(s1, s2);
    return consensus(c12, s3);
}

// Evaluates memory health: 1 (Critical), 0 (Warning), -1 (Healthy)
fn memory_health_eval(used_pct: float, threshold: float) -> trit {
    if used_pct > 95.0 {
        return affirm; // Critical
    }
    if used_pct > threshold {
        return tend; // Warning
    }
    return reject; // Healthy
}

// Checks if a process priority is within a valid range
fn priority_range_check(priority: int, max_priority: int) -> trit {
    if priority > max_priority {
        return affirm; // Over limit
    }
    if priority < 0 {
        return reject; // Under limit (invalid)
    }
    return tend; // Valid
}

fn main() -> trit {
    let h: trit = memory_health_eval(80.0, 90.0);
    match h {
        affirm => { return conflict(); }
        tend   => { return hold(); }
        reject => { return truth(); }
    }
}
