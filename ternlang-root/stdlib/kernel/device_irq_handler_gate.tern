// stdlib/kernel/device_irq_handler_gate.tern
// Demonstrates: Device IRQ routing and validation logic.
// Tier: 4 — Enterprise

fn route_irq(irq_num: int, is_registered: trit, is_masked: trit) -> trit {
    if is_masked == 1 {
        return hold(); // IRQ is masked, ignore but keep in queue
    }

    if is_registered == 1 {
        return truth(); // Route to handler
    }

    return conflict(); // Spurious IRQ, no handler registered
}

fn main() -> trit {
    let irq: int = 4;
    let reg: trit = truth();
    let mask: trit = reject;

    let action: trit = route_irq(irq, reg, mask);

    match action {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
