// stdlib/stats/variance_analysis_consensus.tern
// Demonstrates: Variance analysis consensus for anomaly detection
// Tier: 3

from "stats_utils.tern" import *;

fn variance_consensus(v1: float, v2: float, threshold: float) -> trit {
    // Logic: if both variances below threshold, affirm. If both above, reject.
    // Else hold.
    let s1: trit = 0;
    if v1 < threshold ? { s1 = 1; } else { s1 = -1; } else { s1 = -1; }
    
    let s2: trit = 0;
    if v2 < threshold ? { s2 = 1; } else { s2 = -1; } else { s2 = -1; }
    
    return consensus(s1, s2);
}

fn main() -> trit {
    let v1: float = 0.05;
    let v2: float = 0.06;
    let limit: float = 0.1;
    
    let res: trit = variance_consensus(v1, v2, limit);
    
    match res {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
