// stdlib/stats/confidence_interval_mask.tern
// Demonstrates: Masking estimates outside confidence intervals
// Tier: 3 — Industrial

from "stats_utils.tern" import is_outlier;

fn main() -> trit {
    let estimate: float = 45.0;
    let ci_low: float = 40.0;
    let ci_high: float = 60.0;
    
    // Status: 1 if outside CI (outlier)
    let status: trit = is_outlier(estimate, ci_low, ci_high);
    
    match status {
        -1 => { return hold(); }
         0 => { return truth(); }     // Within CI (Reliable)
         1 => { return hold(); }      // Outside CI (Unreliable)
    }
}
