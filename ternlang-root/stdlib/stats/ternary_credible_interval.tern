// stdlib/stats/ternary_credible_interval.tern
// Demonstrates: Credible interval gating with ternary ambiguity.
// Tier: 3 — Industrial
// A decision gate that holds when a value is in the statistical "gray zone".

fn credible_gate(value: float, mean: float, std_dev: float) -> trit {
    // 95% interval is roughly mean +/- 2*std_dev
    // 90% interval is roughly mean +/- 1.645*std_dev
    
    let diff: float = value - mean;
    if diff < 0.0 { diff = -diff; } // absolute diff
    
    let outer_bound: float = 2.0 * std_dev;
    let inner_bound: float = 1.645 * std_dev;
    
    if diff > outer_bound {
        // Outside 95% -> REJECT
        return conflict();
    }
    
    if diff > inner_bound {
        // Between 90% and 95% -> HOLD (Ambiguous)
        return hold();
    }
    
    // Inside 90% -> AFFIRM
    return truth();
}

fn main() -> trit {
    let mean: float = 100.0;
    let std: float = 10.0;
    
    // Case 1: Well inside (105)
    let res1: trit = credible_gate(105.0, mean, std);
    println("Value 105: ", res1);
    
    // Case 2: In gray zone (118) -> 1.8 * std
    let res2: trit = credible_gate(118.0, mean, std);
    println("Value 118: ", res2);
    
    // Case 3: Far outside (130) -> 3 * std
    let res3: trit = credible_gate(130.0, mean, std);
    println("Value 130: ", res3);

    if res1 == 1 {
        if res2 == 0 {
            if res3 == -1 {
                println("Credible Interval Gate Test Passed.");
                return truth();
            }
        }
    }
    
    return conflict();
}
