// stdlib/stats/outlier_detection_gate.tern
// Demonstrates: Gating outliers in data streams
// Tier: 3 — Industrial

from "stats_utils.tern" import is_outlier;

fn main() -> trit {
    let observation: float = 150.0;
    let lower_bound: float = 0.0;
    let upper_bound: float = 100.0;
    
    // Status: 1 if outlier, 0 if normal
    let status: trit = is_outlier(observation, lower_bound, upper_bound);
    
    match status {
        -1 => { return hold(); }      // Not used by is_outlier
         0 => { return truth(); }     // Normal data
         1 => { return conflict(); }  // Outlier (Reject)
    }
}
