// stdlib/stats/confidence_interval.tern
// Purpose: Confidence Intervals evaluation in ternary logic.
// Demonstrates: Determining if a float interval contains the neutral (hold) state.
// Tier: 3 — Industrial

fn evaluate_confidence_interval(mean: float, error_margin: float) -> trit {
    let lower: float = mean - error_margin;
    let upper: float = mean + error_margin;
    
    // If the entire interval is above 0.1, it's strictly truth
    if lower > 0.1 {
        return truth();
    }
    // If the entire interval is below -0.1, it's strictly conflict
    if upper < -0.1 {
        return conflict();
    }
    // If the interval contains zero, we lack confidence (hold)
    return hold();
}

fn main() -> trit {
    // Case 1: High confidence positive
    let res1: trit = evaluate_confidence_interval(0.5, 0.2); // [0.3, 0.7] -> truth
    
    // Case 2: High confidence negative
    let res2: trit = evaluate_confidence_interval(-0.5, 0.2); // [-0.7, -0.3] -> conflict
    
    // Case 3: Uncertain (contains zero)
    let res3: trit = evaluate_confidence_interval(0.1, 0.3); // [-0.2, 0.4] -> hold
    
    // Verify results
    if res1 == 1 {
        if res2 == -1 {
            if res3 == 0 {
                return truth();
            }
        }
    }
    
    return conflict();
}

// Entry point
let result: trit = main();
match result {
    -1 => { return conflict(); }
     0 => { return hold();    }
     1 => { return truth();   }
}
