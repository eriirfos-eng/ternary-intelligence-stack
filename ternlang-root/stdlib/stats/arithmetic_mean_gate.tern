// stdlib/stats/arithmetic_mean_gate.tern
// Demonstrates: signal mean comparison against target
// Tier: 3

fn mean(data: trit[]) -> float {
    let sum: int = 0;
    let count: int = 0;
    for x in data {
        match x {
            1  => { sum = sum + 1; }
            0  => { sum = sum + 0; }
            -1 => { sum = sum - 1; }
        }
        count = count + 1;
    }
    if count > 0 {
        return cast(sum) / cast(count);
    } else {
        return 0.0;
    }
}

fn check_mean_threshold(actual: float, expected: float, tolerance: float) -> trit {
    if actual > (expected + tolerance) {
        return conflict();
    }
    if actual < (expected - tolerance) {
        return conflict();
    }
    return truth();
}

fn main() -> trit {
    let signals: trit[] = [1, 1, 1, 0, 0];
    
    // Mean = 3/5 = 0.6
    let m: float = mean(signals);
    
    if m > 0.5 {
        return 1;
    } else {
        return -1;
    }
}
