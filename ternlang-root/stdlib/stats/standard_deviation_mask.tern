// stdlib/stats/standard_deviation_mask.tern
// Purpose: Masking values that are outside a variance-based bound.
// Demonstrates: Ternary outlier detection using floating-point comparisons.
// Tier: 3 — Industrial

fn check_is_outlier(val: trit, mean: float, variance: float) -> trit {
    let v: float = 0.0;
    match val {
        1  => { v = 1.0; }
        0  => { v = 0.0; }
        -1 => { v = -1.0; }
    }
    
    let diff: float = v - mean;
    let diff_sq: float = diff * diff;
    
    // If squared difference exceeds variance, it's an outlier (+1)
    if diff_sq > variance {
        return truth();
    }
    // Otherwise, it's a nominal value (-1)
    return conflict();
}

fn main() -> trit {
    let m: float = 0.5;
    let var: float = 0.25;
    
    // (-1 - 0.5)^2 = 2.25 > 0.25 -> truth
    let res1: trit = check_is_outlier(conflict(), m, var);
    
    // (1 - 0.5)^2 = 0.25 <= 0.25 -> conflict
    let res2: trit = check_is_outlier(truth(), m, var);
    
    // Verify results
    if res1 == 1 {
        if res2 == -1 {
            return truth();
        }
    }
    
    return conflict();
}

// Entry point
let result: trit = main();
match result {
    -1 => { return conflict(); }
     0 => { return hold();    }
     1 => { return truth();   }
}
