// stdlib/stats/variance_threshold_mask.tern
// Demonstrates: Masking data with excessive variance
// Tier: 3 — Industrial

from "stats_utils.tern" import is_outlier;

fn main() -> trit {
    let measured_var: float = 25.5;
    let max_var: float = 20.0;
    
    // Status: 1 if variance is too high
    let status: trit = is_outlier(measured_var, 0.0, max_var);
    
    match status {
        -1 => { return hold(); }
         0 => { return truth(); }     // Low variance (Reliable)
         1 => { return hold(); }      // High variance (Unreliable)
    }
}
