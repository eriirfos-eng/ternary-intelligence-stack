// stdlib/stats/skewness_indicator_mask.tern
// Demonstrates: skewness detection in trit distributions
// Tier: 3 — Industrial

fn skewness_indicator(signals: trit[]) -> trit {
    let sum: int = 0;
    let n: int = length(signals);
    
    if n == 0 {
        return hold();
    }
    
    for s in signals {
        match s {
            -1 => { sum = sum - 1; }
             0 => { sum = sum + 0; }
             1 => { sum = sum + 1; }
        }
    }
    
    // sum > 0 means more 1s than -1s (positively skewed toward affirm)
    if sum > 0 {
        return truth();
    }
    
    if sum < 0 {
        return conflict();
    }
    
    return hold();
}

fn main() -> trit {
    let signals: trit[] = [1, 1, 1, 0, -1]; // more 1s
    let skew: trit = skewness_indicator(signals);
    
    match skew {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
