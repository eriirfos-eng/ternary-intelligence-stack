// stdlib/stats/sample_bias_detector.tern
// Demonstrates: Detecting bias in sample distributions
// Tier: 3 — Industrial

from "stats_utils.tern" import prob_to_trit;

fn main() -> trit {
    let sample_proportion: float = 0.75;
    let expected_proportion: float = 0.5;
    let bias_tolerance: float = 0.1;
    
    // Status: 1 if biased high, -1 if biased low
    let diff: float = sample_proportion - expected_proportion;
    let bias_status: trit = prob_to_trit(diff, (0.0 - bias_tolerance), bias_tolerance);
    
    match bias_status {
        -1 => { return conflict(); }  // Biased low
         0 => { return truth(); }     // Representative
         1 => { return conflict(); }  // Biased high
    }
}
