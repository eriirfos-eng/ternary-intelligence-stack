// stdlib/stats/hypothesis_test_consensus.tern
// Demonstrates: Consensus on statistical hypothesis tests
// Tier: 3

from "stats_utils.tern" import *;

fn test_consensus(p1: float, p2: float, p3: float, alpha: float) -> trit {
    // Logic: if p-value < alpha, reject null (+1). If > 1-alpha, accept null (-1).
    // Else hold (0).
    let t1: trit = prob_to_trit(p1, alpha, 1.0 - alpha);
    let t2: trit = prob_to_trit(p2, alpha, 1.0 - alpha);
    let t3: trit = prob_to_trit(p3, alpha, 1.0 - alpha);
    
    // Reverse logic: prob_to_trit returns 1 if p > high.
    // In hypothesis testing, we want 1 if p < alpha.
    // So we negate or swap.
    
    let c: trit = consensus(t1, consensus(t2, t3));
    return -c; // Invert to match hypothesis rejection logic
}

fn main() -> trit {
    let p1: float = 0.01;
    let p2: float = 0.02;
    let p3: float = 0.95; // Conflicting test
    let alpha: float = 0.05;
    
    let res: trit = test_consensus(p1, p2, p3, alpha);
    
    match res {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
