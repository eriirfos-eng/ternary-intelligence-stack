// stdlib/stats/information_theory.tern
// Purpose: Entropy and Information Gain in ternary logic.
// Demonstrates: Evaluating information gain between two entropy states.
// Tier: 3 — Industrial

fn evaluate_information_gain(parent_entropy: trit, child_entropy: trit) -> trit {
    // If parent entropy was high (+1) and child entropy is low (-1), gain is high (+1)
    if parent_entropy == 1 {
        if child_entropy == -1 {
            return truth();
        }
        // If child entropy is also high, gain is low (-1)
        if child_entropy == 1 {
            return conflict();
        }
    }
    // If child entropy is neutral (0), gain is moderate (0)
    if child_entropy == 0 {
        return hold();
    }
    
    return hold();
}

fn main() -> trit {
    // Case 1: High information gain (uncertain to certain)
    let res1: trit = evaluate_information_gain(truth(), conflict()); // truth
    
    // Case 2: Low information gain (certain to certain)
    let res2: trit = evaluate_information_gain(truth(), truth());    // conflict
    
    // Case 3: Moderate information gain
    let res3: trit = evaluate_information_gain(truth(), hold());     // hold
    
    // Verify results
    if res1 == 1 {
        if res2 == -1 {
            if res3 == 0 {
                return truth();
            }
        }
    }
    
    return conflict();
}

// Entry point
let result: trit = main();
match result {
    -1 => { return conflict(); }
     0 => { return hold();    }
     1 => { return truth();   }
}
