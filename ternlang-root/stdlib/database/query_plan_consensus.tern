// stdlib/database/query_plan_consensus.tern
// Demonstrates: choosing between query execution plans based on cost estimates
// Tier: 3 — Industrial

fn evaluate_plans(plan1_cost: float, plan2_cost: float) -> trit {
    if plan1_cost < plan2_cost {
        return truth(); // Plan 1 is better
    }
    if plan1_cost > plan2_cost {
        return conflict(); // Plan 2 is better
    }
    return hold(); // Equal cost
}

fn main() -> trit {
    let p1: float = 120.5;
    let p2: float = 145.0;
    
    let res: trit = evaluate_plans(p1, p2);
    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
