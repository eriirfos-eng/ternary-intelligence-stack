// stdlib/database/view_materialization_eval.tern
// Demonstrates: View materialization cost-benefit logic
// Tier: 3 — Industrial

fn should_materialize(access_freq: float, storage_cost: float) -> trit {
    // If access frequency is high and storage is cheap, materialize (affirm)
    if access_freq > 100.0 {
        if storage_cost < 50.0 {
            return affirm;
        }
        return tend; // High access but expensive storage
    }
    return reject; // Low access
}

fn main() -> trit {
    // Freq: 120, Cost: 40
    let decision: trit = should_materialize(120.0, 40.0);
    
    // Status should be affirm
    match decision {
        affirm => { 
            // Materialize
            return truth(); 
        }
        tend => { 
            // Monitor
            return hold(); 
        }
        reject => { 
            // Compute on the fly
            return hold(); 
        }
    }
}
