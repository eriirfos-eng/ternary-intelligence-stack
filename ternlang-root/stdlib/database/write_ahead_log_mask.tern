// stdlib/database/write_ahead_log_mask.tern
// Demonstrates: Validating WAL log index consistency across cluster
// Tier: 3 - Industrial

fn check_log_consistency(local_idx: int, master_idx: int) -> trit {
    if local_idx == master_idx {
        return truth(); // Fully synced
    }
    
    if local_idx < master_idx {
        return hold(); // Lagging
    }
    
    return conflict(); // Local index ahead of master (Corruption!)
}

fn main() -> trit {
    let res: trit = check_log_consistency(100, 100);
    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
