// stdlib/database/write_ahead_log_mask.tern
// Demonstrates: ensuring that data writes only happen after log commits
// Tier: 3 — Industrial

fn wal_check(log_flushed: trit, buffer_dirty: trit, data_written: trit) -> trit {
    if data_written == 1 {
        if log_flushed == -1 {
            return conflict(); // Data written but log not flushed! Inconsistent.
        }
    }
    
    if buffer_dirty == 1 {
        if log_flushed == 1 { return truth(); } // Safe to write data
        return hold(); // Wait for log flush
    }
    
    return truth(); // Clean state
}

fn main() -> trit {
    let flushed: trit = 1;
    let dirty: trit = 1;
    let written: trit = 0;
    
    let res: trit = wal_check(flushed, dirty, written);
    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
