// stdlib/database/sharding_key_router.tern
// Demonstrates: Routing keys to shards based on ternary hash
// Tier: 3 — Industrial

fn calculate_hash_trit(key: float) -> trit {
    // Simple mock hashing: 1 (even range), -1 (odd range), 0 (zero)
    if key > 100.0 {
        return affirm;
    }
    if key < (0.0 - 100.0) {
        return reject;
    }
    return tend;
}

fn main() -> trit {
    // Key: 150.0
    let hash: trit = calculate_hash_trit(150.0);
    
    // Status should be affirm (Shard 1)
    match hash {
        affirm => { 
            // Route to Shard 1
            return truth(); 
        }
        tend => { 
            // Route to Shard 0
            return hold(); 
        }
        reject => { 
            // Route to Shard -1
            return conflict(); 
        }
    }
}
