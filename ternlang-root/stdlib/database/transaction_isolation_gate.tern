// stdlib/database/transaction_isolation_gate.tern
// Demonstrates: validating transaction isolation levels
// Tier: 3 — Industrial

fn check_isolation(level: int, allows_dirty_reads: trit, required_clean: trit) -> trit {
    if required_clean == 1 {
        // Isolation level 1 usually means read uncommitted
        if level == 1 { return conflict(); }
        if allows_dirty_reads == 1 { return conflict(); }
    }
    if level >= 3 { return truth(); } // Serializable or Repeatable Read
    return hold();
}

fn main() -> trit {
    let iso_level: int = 2; // Read committed
    let dirty: trit = 0;
    let req_clean: trit = 1;
    
    let ok: trit = check_isolation(iso_level, dirty, req_clean);
    match ok {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
