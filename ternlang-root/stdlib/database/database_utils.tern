// stdlib/database/database_utils.tern
// Demonstrates: Reusable database management utilities
// Tier: 3 — Industrial

// Aggregates consensus across three database nodes
fn transaction_consensus_3(node1: trit, node2: trit, node3: trit) -> trit {
    let c12: trit = consensus(node1, node2);
    return consensus(c12, node3);
}

// Evaluates query cost against a budget: 1 (over), 0 (at limit), -1 (under)
fn query_cost_eval(cost: float, budget: float) -> trit {
    if cost > budget {
        return affirm;
    }
    if cost < budget {
        return reject;
    }
    return tend;
}

// Evaluates replication lag between primary and replica
fn replication_lag_eval(primary_lsn: float, replica_lsn: float, threshold: float) -> trit {
    let diff: float = primary_lsn - replica_lsn;
    if diff > threshold {
        return affirm; // High lag
    }
    if diff < (0.0 - threshold) {
        return reject; // Replica ahead (anomaly)
    }
    return tend; // Healthy
}

// Evaluates lock compatibility: 1 (conflict), 0 (wait), -1 (grant)
fn lock_compatibility_eval(requested: trit, held: trit) -> trit {
    // Basic logic: if both affirm (+1), conflict.
    if requested == 1 {
        if held == 1 {
            return 1; // Conflict
        }
        return 0; // Wait
    }
    return -1; // Grant
}

fn main() -> trit {
    let c: trit = transaction_consensus_3(affirm, affirm, tend);
    match c {
        -1 => { return conflict(); }
         0 => { return hold(); }
         1 => { return truth(); }
    }
}
