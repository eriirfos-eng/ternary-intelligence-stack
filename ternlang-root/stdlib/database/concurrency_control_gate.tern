// stdlib/database/concurrency_control_gate.tern
// Demonstrates: Concurrency control using lock compatibility
// Tier: 3 — Industrial

from "database_utils.tern" import lock_compatibility_eval;

fn main() -> trit {
    // Current lock: affirm (+1) (Exclusive)
    let held_lock: trit = 1;
    
    // Requested lock: affirm (+1) (Exclusive)
    let requested_lock: trit = 1;
    
    // Evaluate compatibility
    let status: trit = lock_compatibility_eval(requested_lock, held_lock);
    
    // status should be 1 (conflict)
    match status {
        affirm => { 
            // Conflict
            return conflict(); 
        }
        tend => { 
            // Wait
            return hold(); 
        }
        reject => { 
            // Grant
            return truth(); 
        }
    }
}
