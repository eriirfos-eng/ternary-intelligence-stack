// stdlib/database/transaction_timeout_gate.tern
// Demonstrates: Transaction timeout rejection logic
// Tier: 3 — Industrial

fn check_timeout(elapsed_ms: float, limit_ms: float) -> trit {
    if elapsed_ms > limit_ms {
        return affirm; // Timeout!
    }
    // Warning at 80%
    if elapsed_ms > (limit_ms * 0.8) {
        return tend; // Warning
    }
    return reject; // OK
}

fn main() -> trit {
    // Current: 4500ms, Limit: 5000ms
    let status: trit = check_timeout(4500.0, 5000.0);
    
    // Status should be tend (Warning)
    match status {
        affirm => { 
            // Abort
            return conflict(); 
        }
        tend => { 
            // Continue with caution
            return hold(); 
        }
        reject => { 
            // Continue
            return truth(); 
        }
    }
}
