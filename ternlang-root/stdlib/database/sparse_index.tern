// stdlib/database/sparse_index.tern
// Demonstrates: sparse index where most entries are uncertainty (0)
// Tier: 2 — Pro Standard

fn query(index: trit[], key: int) -> trit {
    if key >= length(index) { return conflict(); }
    return index[key];
}

fn main() -> trit {
    // 10 entries, mostly 0
    let index: trit[] = [0, 0, 1, 0, -1, 0, 0, 0, 0, 0];
    
    let result1: trit = query(index, 2); // 1
    let result2: trit = query(index, 4); // -1
    let result3: trit = query(index, 0); // 0
    
    if result1 == 1 && result2 == -1 && result3 == 0 {
        return truth();
    }
    
    match result1 {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
