// stdlib/database/column_store_scan.tern
// Demonstrates: Column store scan using @sparseskip to skip null/neutral trits.
// Tier: 3 - Industrial

// Efficiently aggregate a column of trits, skipping zero (tend) states.
@sparseskip
fn fast_scan(column: trit[]) -> trit {
    let acc: trit = tend;
    
    for val in column {
        acc = consensus(acc, val);
    }
    
    return acc;
}

fn main() -> trit {
    let column: trittensor<5>;
    // Initializing with some values
    column[0] = affirm;
    column[1] = tend;
    column[2] = reject;
    column[3] = tend;
    column[4] = affirm;
    
    let summary: trit = fast_scan(column);
    
    match summary {
        -1 => { println("Negative signal detected"); }
         0 => { println("Balanced signal");          }
         1 => { println("Positive signal detected"); }
    }
    
    return summary;
}
