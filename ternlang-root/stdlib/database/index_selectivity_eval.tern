// stdlib/database/index_selectivity_eval.tern
// Demonstrates: evaluating if an index is selective enough to be used
// Tier: 3 — Industrial

fn eval_selectivity(distinct_values: float, total_rows: float) -> trit {
    if total_rows == 0.0 { return conflict(); }
    
    let selectivity: float = distinct_values / total_rows;
    
    // High selectivity means index is useful (e.g., primary key has selectivity 1.0)
    if selectivity > 0.8 { return truth(); }
    if selectivity > 0.1 { return hold(); }
    return conflict(); // Low selectivity, table scan might be faster
}

fn main() -> trit {
    let dist: float = 850.0;
    let rows: float = 1000.0;
    
    let res: trit = eval_selectivity(dist, rows);
    match res {
        -1 => { return conflict(); }
         0 => { return hold();     }
         1 => { return truth();    }
    }
}
