// stdlib/database/replica_sync_gate.tern
// Demonstrates: Replica synchronization gate comparing local/remote LSNs.
// Tier: 3 - Industrial

// Evaluates sync status based on LSN (Log Sequence Number) diff.
// returns: 1 (synced), 0 (lagging), -1 (divergent/error)
fn evaluate_sync(local_lsn: int, remote_lsn: int) -> trit {
    if local_lsn == remote_lsn {
        return affirm; // perfectly synced
    }
    
    let diff: int = local_lsn - remote_lsn;

    // Remote is ahead
    if diff < 0 {
        return tend;
    }

    // Remote is behind
    if diff > 0 {
        // If the gap is huge, maybe it's divergent or failed
        if diff > 1000000 {
            return reject;
        }
        return tend;
    }

    
    return hold();
}

fn main() -> trit {
    let local: int = 45000;
    let rem_val: int = 45000;
    
    let state: trit = evaluate_sync(local, rem_val);
    
    match state {
        -1 => { println("Divergent state"); }
         0 => { println("Lagging...");      }
         1 => { println("Synced.");         }
    }
    
    return state;
}
