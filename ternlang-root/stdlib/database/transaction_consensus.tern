// stdlib/database/transaction_consensus.tern
// Demonstrates: 3-node transaction consensus for commits
// Tier: 2 — Pro Standard

fn main() -> trit {
    let node1: trit = 1; // ready
    let node2: trit = 1; // ready
    let node3: trit = 0; // pending
    
    // Total consensus
    let commit: trit = consensus(node1, consensus(node2, node3));
    
    // Result should be 1 (consensus(1, consensus(1, 0)) = 1)
    if commit == 1 {
        return truth();
    }
    
    match commit {
        -1 => { return conflict(); }
         0 => { return hold();    }
         1 => { return truth();   }
    }
}
