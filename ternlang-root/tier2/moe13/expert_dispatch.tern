// Module: tier2/moe13/expert_dispatch.tern
// License: BSL 1.1 - Restricted API

fn dispatch_task(expert_available: trit) -> trit {
    if expert_available == affirm { return affirm; }
    return tend;
}

fn main() -> trit {
    let result: trit = dispatch_task(1);
    match result {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
