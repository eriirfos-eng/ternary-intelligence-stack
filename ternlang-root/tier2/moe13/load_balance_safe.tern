// --- RFI-IRFOS TIER 2 PROPRIETARY ---
// Safety wrapper for load_balance

fn is_balance_within_limits(diff: int) -> trit {
    if diff < 10 { return affirm; }
    return tend;
}

fn main() -> trit {
    let result: trit = is_balance_within_limits(5);
    match result {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
