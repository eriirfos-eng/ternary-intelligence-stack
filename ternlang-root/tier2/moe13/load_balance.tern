// Module: tier2/moe13/load_balance.tern
// License: BSL 1.1 - Restricted API

fn balance_load(queue_depth: int, threshold: int) -> trit {
    if queue_depth < threshold { return affirm; }
    if queue_depth > (threshold * 2) { return reject; }
    return tend;
}

fn main() -> trit {
    let result: trit = balance_load(5, 10);
    match result {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
