// License: BSL 1.1 - Restricted API

fn check_rate_limit(current_rate: float, limit: float) -> trit {
    if current_rate < limit { return affirm; }
    if current_rate > (limit * 1.2) { return reject; }
    return tend;
}

fn main() -> trit {
    let result: trit = check_rate_limit(50.0, 100.0);
    match result {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
