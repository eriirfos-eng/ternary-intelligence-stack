// --- RFI-IRFOS TIER 2 PROPRIETARY ---
// Safety wrapper for quota_enforcer

fn is_quota_secure(api_key_valid: trit) -> trit {
    if api_key_valid == affirm { return affirm; }
    return reject;
}

fn main() -> trit {
    let result: trit = is_quota_secure(1);
    match result {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
