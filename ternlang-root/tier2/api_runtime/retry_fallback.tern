// License: BSL 1.1 - Restricted API

fn should_retry(attempt: int, max_retries: int) -> trit {
    if attempt < max_retries { return affirm; }
    if attempt == max_retries { return tend; } // Final attempt
    return reject; // Stop retrying
}

fn main() -> trit {
    let result: trit = should_retry(1, 3);
    match result {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
