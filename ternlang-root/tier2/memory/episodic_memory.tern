// License: BSL 1.1 - Restricted API

fn recall_episode(confidence: float) -> trit {
    if confidence > 0.6 { return affirm; }
    return reject;
}

fn main() -> trit {
    let result: trit = recall_episode(0.9);
    match result {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
