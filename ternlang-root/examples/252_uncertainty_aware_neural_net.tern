// Example: 252_uncertainty_aware_neural_net.tern
// Purpose: Rigorous demonstration of TUANN (Triadic Uncertainty-Aware Neural Nets)
// Author:  RFI-IRFOS (ZVR: 1015608684)

use ml::tuann;

fn main() {
    println("=== RFI-IRFOS TUANN: UNCERTAINTY-AWARE NEURAL NETWORK ===");
    println("Standard: TIS Uncertainty Mapping");
    println("----------------------------------------------------");

    // Case 1: High Signal, High Confidence
    let res1: trit = tuann::forward_pass(100, 1, 90);
    println("HIGH SIGNAL:    Result (Confidence 90): ", res1);

    // Case 2: Noisy Signal, Low Confidence
    let res2: trit = tuann::forward_pass(5, 1, 10);
    println("NOISY SIGNAL:   Result (Confidence 10): ", res2);
    println("                [Note: System returned 'tend' (0) to avoid hallucination]");

    // Case 3: Contradictory Signal
    let res3: trit = tuann::forward_pass(-100, 1, 85);
    println("NEGATIVE SIGNAL: Result (Confidence 85): ", res3);

    println("----------------------------------------------------");
    println("TUANN STATUS: All gradients aligned with Triadic Equilibrium.");
    println("Sovereign AI readiness confirmed.");
}
