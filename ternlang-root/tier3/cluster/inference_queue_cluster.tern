// License: BSL 1.1 - Industrial

fn manage_cluster_queue(load: float) -> trit {
    if load < 0.7 { return affirm; }
    if load < 1.0 { return tend; }
    return reject;
}

fn main() -> trit {
    let result: trit = manage_cluster_queue(0.5);
    match result {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
