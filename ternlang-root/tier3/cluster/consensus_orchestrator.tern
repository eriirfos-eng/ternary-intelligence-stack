fn orchestrate_consensus(agreement_ratio: float) -> trit {
    if agreement_ratio > 0.8 { return affirm; }
    if agreement_ratio > 0.5 { return tend; }
    return reject;
}

fn main() -> trit {
    let result: trit = orchestrate_consensus(0.85);
    match result {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
