fn route_cluster_expert(node_id: int) -> trit {
    if node_id > 0 { return affirm; }
    return reject;
}

fn main() -> trit {
    let result: trit = route_cluster_expert(10);
    match result {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
