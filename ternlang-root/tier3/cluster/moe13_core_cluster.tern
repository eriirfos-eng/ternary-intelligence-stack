fn check_cluster_moe(experts_active: int) -> trit {
    if experts_active == 13 { return affirm; }
    if experts_active > 0 { return tend; }
    return reject;
}

fn main() -> trit {
    let result: trit = check_cluster_moe(13);
    match result {
        affirm => { return truth(); }
        tend   => { return hold(); }
        reject => { return conflict(); }
    }
}
