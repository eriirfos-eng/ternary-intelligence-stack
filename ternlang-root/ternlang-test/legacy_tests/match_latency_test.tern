// stdlib/bench/match_latency_test.tern
// Demonstrates: A simple latency benchmark for match statements.
// Tier: 1 - Open Core

fn run_match_bench(iterations: int) -> trit {
    let i: int = 0;
    let t: trit = 1;
    while i < iterations {
        match t {
            1 => { t = 0; }
            0 => { t = -1; }
           -1 => { t = 1; }
        }
        i = i + 1;
    }
    return 1;
}

fn main() -> trit {
    let iterations: int = 1000;
    println("Running match latency bench (1000 iterations)...");
    
    // We don't have real timer yet, so this is a functional bench
    let r: trit = run_match_bench(iterations);
    
    if r == 1 {
        println("Benchmark completed successfully.");
        return truth();
    }
    return conflict();
}
