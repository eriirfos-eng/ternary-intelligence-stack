fn calculate_burn(investment: float, efficiency_gap: float) -> float {
    let res: float = investment * efficiency_gap;
    return res;
}

fn main() -> trit {
    let waste: float = calculate_burn(1000000.0, 0.85);
    if waste > 0.0 {
        return truth();
    }
    return conflict();
}
