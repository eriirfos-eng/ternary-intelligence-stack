// compiler/packaging/license_guard.tern
// Purpose: License tier validation — ternary gate on API key presence.
// License: BSL-1.1

fn check_license(has_key: trit) -> trit {
    match has_key {
        -1 => { return reject; }
         0 => { return tend;   }
         1 => { return affirm; }
    }
}

fn main() -> trit {
    let status: trit = check_license(1);
    match status {
        -1 => { return reject; }
         0 => { return tend;   }
         1 => { return affirm; }
    }
}
