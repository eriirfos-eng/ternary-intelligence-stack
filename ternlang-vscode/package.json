{
  "name": "ternlang",
  "displayName": "Ternlang",
  "description": "Balanced ternary language support for .tern files — syntax highlighting, snippets, run command, hover docs, and live diagnostics via ternlang-lsp.",
  "version": "0.3.0",
  "publisher": "rfi-irfos",
  "license": "LGPL-3.0",
  "keywords": [
    "ternlang",
    "ternary",
    "balanced ternary",
    "trit",
    "ternary logic",
    "BET VM",
    "sparse inference",
    "actor model"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eriirfos-eng/ternary-intelligence-stack--tis-"
  },
  "homepage": "https://github.com/eriirfos-eng/ternary-intelligence-stack--tis-/blob/main/ternlang-vscode/README.md",
  "bugs": {
    "url": "https://github.com/eriirfos-eng/ternary-intelligence-stack--tis-/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Debuggers"
  ],
  "activationEvents": [
    "onLanguage:ternlang",
    "onCommand:ternlang.run"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ternlang",
        "aliases": ["Ternlang", "ternlang"],
        "extensions": [".tern"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ternlang",
        "scopeName": "source.ternlang",
        "path": "./syntaxes/ternlang.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "ternlang",
        "path": "./snippets/ternlang.json"
      }
    ],
    "commands": [
      {
        "command": "ternlang.run",
        "title": "Ternlang: Run File",
        "icon": "$(play)"
      },
      {
        "command": "ternlang.showStatus",
        "title": "Ternlang: Show Tier Status"
      },
      {
        "command": "ternlang.inlineTritHints",
        "title": "Ternlang Pro: Toggle Inline Trit Hints"
      },
      {
        "command": "ternlang.cloudDiagnostics",
        "title": "Ternlang Pro: Enable Cloud Diagnostics"
      },
      {
        "command": "ternlang.debugBetVm",
        "title": "Ternlang Industrial: Open BET VM Debugger"
      },
      {
        "command": "ternlang.viewTensor",
        "title": "Ternlang Industrial: Visualize Tensor"
      },
      {
        "command": "ternlang.sparseskipCoverage",
        "title": "Ternlang Industrial: @sparseskip Coverage"
      },
      {
        "command": "ternlang.clusterPanel",
        "title": "Ternlang Enterprise: Cluster Panel"
      },
      {
        "command": "ternlang.agentMonitor",
        "title": "Ternlang Enterprise: Agent Monitor"
      }
    ],
    "keybindings": [
      {
        "command": "ternlang.run",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorLangId == ternlang"
      }
    ],
    "configuration": {
      "title": "Ternlang",
      "properties": {
        "ternlang.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Your ternlang.com API key. Unlocks Pro (Tier 2), Industrial (Tier 3), or Enterprise (Tier 4) features. Get a key at [ternlang.com](https://ternlang.com/#pricing).\n\n- `tern_t2_…` → Pro (inline hints, cloud diagnostics)\n- `tern_t3_…` → Industrial (BET VM debugger, tensor viewer)\n- `tern_t4_…` → Enterprise (cluster panel, agent monitor)"
        },
        "ternlang.cliPath": {
          "type": "string",
          "default": "ternlang-cli",
          "description": "Path to the ternlang-cli binary. Defaults to 'ternlang-cli' (must be on PATH). Set to an absolute path if needed."
        },
        "ternlang.suppressLspWarning": {
          "type": "boolean",
          "default": false,
          "description": "Suppress the 'ternlang-lsp not found' warning message."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "ternlang.run",
          "when": "editorLangId == ternlang",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.22.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
