fn linear_expert(b_val: float, in_vec: int[3], w_vec: int[3]) -> float {
    let total: float = b_val;
    let i: int = 0;
    while i < 3 {
        let p: int = in_vec[i] * w_vec[i];
        total = total + cast(float)p;
        i = i + 1;
    }
    return total;
}

fn main() -> trit {
    let input: int[3];
    let weights: int[3];
    input[0] = 1; input[1] = -1; input[2] = 0;
    weights[0] = 1; weights[1] = 1; weights[2] = -1;
    
    let result: float = linear_expert(0.5, input, weights);
    
    if result == 0.5 {
        return 1;
    }
    return -1;
}
