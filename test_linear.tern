fn linear_expert(b_val: float, in_vec: int[3], w_vec: int[3]) -> float {
    let total: float = 0.0;
    let i: int = 0;
    let v: int = 0;
    let w_var: int = 0;
    let p_res: int = 0;
    let p_f: float = 0.0;
    
    total = b_val;
    i = 0;
    while i < 3 {
        v = in_vec[i];
        w_var = w_vec[i];
        p_res = v * w_var;
        p_f = cast(float)p_res;
        total = total + p_f;
        i = i + 1;
    }
    return total;
}

fn main() -> trit {
    let input: int[3];
    let weights: int[3];
    let bias: float = 0.5;
    let result: float = 0.0;

    input[0] = 1; input[1] = -1; input[2] = 0;
    weights[0] = 1; weights[1] = 1; weights[2] = -1;
    
    result = linear_expert(bias, input, weights);
    
    if result == 0.5 {
        return 1;
    }
    return -1;
}
