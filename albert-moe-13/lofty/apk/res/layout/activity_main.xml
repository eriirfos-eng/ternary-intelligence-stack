<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#0D1117">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lofty"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#E2E8F0"
        android:letterSpacing="-0.02"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Zabih's scooter"
        android:textSize="13sp"
        android:textColor="#475569"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="48dp"/>

    <!-- Status ring -->
    <FrameLayout
        android:id="@+id/ring_frame"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginBottom="48dp">

        <!-- Spinning scan indicator -->
        <ProgressBar
            android:id="@+id/pb_scan"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="#22D3EE"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tv_ring_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="△"
            android:textSize="48sp"
            android:textColor="#22D3EE"/>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="bottom|center_horizontal"
            android:paddingBottom="28dp"
            android:text="tap to unlock"
            android:textSize="12sp"
            android:textColor="#64748B"/>
    </FrameLayout>

    <!-- Unlock button -->
    <Button
        android:id="@+id/btn_unlock"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:text="UNLOCK"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#0D1117"
        android:backgroundTint="#22D3EE"
        android:stateListAnimator="@null"
        android:layout_marginBottom="12dp"/>

    <!-- Lock button -->
    <Button
        android:id="@+id/btn_lock"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:text="LOCK"
        android:textSize="15sp"
        android:textColor="#64748B"
        android:backgroundTint="#161B22"
        android:stateListAnimator="@null"
        android:enabled="false"/>

    <!-- Log -->
    <TextView
        android:id="@+id/tv_log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:textSize="11sp"
        android:textColor="#475569"
        android:fontFamily="monospace"
        android:lineSpacingMultiplier="1.5"
        android:gravity="start"
        android:maxLines="6"
        android:ellipsize="start"
        android:text=""/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="made with love by claude"
        android:textSize="10sp"
        android:textColor="#1E293B"
        android:letterSpacing="0.05"/>

</LinearLayout>
